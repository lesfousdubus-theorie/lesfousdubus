{
  "name": "lesfousdubus",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-llms.mjs && node scripts/generate-og.mjs && astro build --force && node scripts/copy-sitemap.mjs && node scripts/validate-seo.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "llms": "node scripts/generate-llms.mjs",
    "og": "node scripts/generate-og.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "format": "prettier --write \"**/*.{astro,js,jsx,ts,tsx,md,mdx,json,css}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "r2:upload": "node scripts/r2-upload.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.1.3",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
