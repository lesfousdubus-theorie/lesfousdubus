---
import { getCollection } from 'astro:content';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Source unique de la navigation latérale : toutes les pages consomment ce même
// composant, trié de façon déterministe (order puis id) pour que la sidebar soit
// strictement identique sur l'ensemble du site.
const articles = (
  await getCollection('articles', ({ data }) => data.status === 'published' && !data.sidebarHidden)
).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id, 'fr'));

const byId = new Map(articles.map((a) => [a.id, a]));

const categoryConfig: Record<string, { label: string; icon: string; order: number }> = {
  'monde-destinations': { label: 'Monde et destinations', icon: '🌍', order: 1 },
  'histoire-temporalite': { label: 'Histoire, temps et Ponéglyphes', icon: '📜', order: 2 },
  'figures-principales': { label: 'Figures principales', icon: '🎭', order: 3 },
  'personnages-identites': { label: 'Personnages et identités', icon: '👥', order: 4 },
  'armes-antiques': { label: 'Armes antiques', icon: '🔱', order: 5 },
  'technologies-pouvoirs': { label: 'Technologies et pouvoirs', icon: '⚡', order: 6 },
  'peuples-royaumes': { label: 'Peuples, royaumes et témoins', icon: '🏰', order: 7 },
  'dieux-croyances': { label: 'Dieux et croyances', icon: '🙏', order: 8 },
  'transmission-memoire': { label: 'Transmission et mémoire', icon: '🎵', order: 9 },
  'gouvernement-mondial': { label: 'Gouvernement mondial', icon: '⚖️', order: 10 },
  'guerre-finale': { label: 'Guerre finale', icon: '⚔️', order: 11 },
};

// Enfants directs par parent (toutes catégories confondues).
const childrenByParent = new Map<string, typeof articles>();
for (const article of articles) {
  if (!article.data.parent) continue;
  const list = childrenByParent.get(article.data.parent) ?? [];
  list.push(article);
  childrenByParent.set(article.data.parent, list);
}

interface SidebarLink {
  label: string;
  href: string;
  level: 0 | 1;
  type: 'fiche' | 'dossier';
}

interface NavSection {
  label: string;
  icon: string;
  links: SidebarLink[];
  isChaptersSection?: boolean;
}

const toLink = (a: (typeof articles)[number], level: 0 | 1): SidebarLink => ({
  label: a.data.title,
  href: `/theorie/${a.id}`,
  level,
  type: a.data.navigationType,
});

// Règle d'affichage (générique, sans cas particuliers codés en dur) :
// - un article sans parent est en tête de sa catégorie ;
// - un article dont le parent appartient à la même catégorie est affiché en
//   dessous de ce parent ;
// - un article dont le parent est dans une AUTRE catégorie est affiché en tête
//   de sa propre catégorie (sinon il serait invisible ailleurs que sous son parent).
const buildLinks = (cat: string): SidebarLink[] => {
  const inCat = articles.filter((a) => a.data.category === cat);
  const roots = inCat.filter((a) => {
    if (!a.data.parent) return true;
    return byId.get(a.data.parent)?.data.category !== cat;
  });

  const links: SidebarLink[] = [];
  const seen = new Set<string>();
  const push = (link: SidebarLink) => {
    if (seen.has(link.href)) return;
    seen.add(link.href);
    links.push(link);
  };

  for (const root of roots) {
    push(toLink(root, 0));
    for (const child of childrenByParent.get(root.id) ?? []) {
      push(toLink(child, 1));
    }
  }
  return links;
};

const sections: NavSection[] = [
  {
    label: 'Commencer',
    icon: '🚀',
    links: [
      { label: 'Présentation', href: '/', level: 0, type: 'fiche' },
      { label: 'Résumé de la théorie', href: '/theorie/resume', level: 0, type: 'fiche' },
      { label: 'Théorie complète', href: '/theorie/theorie-complete', level: 0, type: 'fiche' },
      { label: 'Carte mentale', href: '/explorer/carte-mentale', level: 0, type: 'fiche' },
      { label: 'Lexique essentiel', href: '/aide/glossaire', level: 0, type: 'fiche' },
    ],
  },
  ...Object.entries(categoryConfig)
    .sort(([, a], [, b]) => a.order - b.order)
    .map(([catKey, config]) => ({ label: config.label, icon: config.icon, links: buildLinks(catKey) }))
    .filter((section) => section.links.length > 0),
];

const sortedChapters = (await getCollection('chapters'))
  .slice()
  .sort((a, b) => b.data.chapter - a.data.chapter);

sections.push({
  label: 'Chapitres récents',
  icon: '📖',
  isChaptersSection: true,
  links: sortedChapters.slice(0, 10).map((chapter) => ({
    label: chapter.data.title.startsWith('Chapitre')
      ? chapter.data.title
      : `Chapitre ${chapter.data.chapter} — ${chapter.data.title}`,
    href: `/chapitres/${chapter.data.chapter}`,
    level: 0,
    type: 'fiche',
  })),
});

sections.push({
  label: 'Aide & ressources',
  icon: '❓',
  links: [
    { label: 'À propos', href: '/aide/a-propos', level: 0, type: 'fiche' },
    { label: 'FAQ', href: '/aide/faq', level: 0, type: 'fiche' },
    { label: 'Glossaire', href: '/aide/glossaire', level: 0, type: 'fiche' },
    { label: 'Crédits', href: '/aide/credits', level: 0, type: 'fiche' },
  ],
});

// La section contenant la page courante démarre ouverte.
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const isLinkCurrent = (href: string) =>
  normalize(currentPath) === normalize(href);
---

<nav data-pagefind-ignore id="sidebar-nav-root" aria-label="Navigation du wiki">
  <div class="sidebar-filter">
    <svg class="sidebar-filter__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      id="sidebar-filter-input"
      class="sidebar-filter__input"
      placeholder="Filtrer les articles…"
      enterkeyhint="search"
      autocomplete="off"
      aria-label="Filtrer la navigation"
      aria-describedby="sidebar-filter-status"
    />
    <button id="sidebar-filter-clear" class="sidebar-filter__clear" aria-label="Effacer le filtre" hidden>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <div id="sidebar-filter-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  {
    sections.map((section, index) => {
      const isExpanded = section.links.some(
        (link) => isLinkCurrent(link.href) || (link.href !== '/' && currentPath.startsWith(link.href + '/')),
      );
      const isChaptersActive = !!section.isChaptersSection && currentPath.startsWith('/chapitres/');
      const listId = `sidebar-section-${index}-links`;

      return (
        <div data-sidebar-section>
          <button
            class:list={['sidebar-section-toggle', { 'sidebar-section-toggle--chapters-active': isChaptersActive }]}
            aria-expanded={isExpanded}
            aria-controls={listId}
          >
            <span class="sidebar-section-toggle__label">
              <span aria-hidden="true">{section.icon}</span>
              <span>{section.label}</span>
            </span>
            <svg
              class:list={['sidebar-chevron', { 'rotate-90': isExpanded }]}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              width="12"
              height="12"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
          <ul id={listId} class:list={['sidebar-section-links', { collapsed: !isExpanded }]}>
            {section.links.map((link) => {
              const isActive = isLinkCurrent(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'sidebar-link',
                      { 'sidebar-link--child': link.level === 1 },
                      { 'sidebar-link--dossier': link.type === 'dossier' },
                      { 'sidebar-link--active': isActive },
                    ]}
                  >
                    {link.level === 1 && (
                      <span class="sidebar-link__tree" aria-hidden="true">└</span>
                    )}
                    {link.type === 'dossier' && (
                      <span class="sidebar-link__dossier-label">↳ Dossier :</span>
                    )}
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })
  }
</nav>

<style>
  /* Masqué visuellement mais lisible par les lecteurs d'écran (live region). */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  nav {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Filtre — visible sur tous les breakpoints, sticky en haut de la sidebar. */
  .sidebar-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    margin-bottom: 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .sidebar-filter {
      position: relative;
      top: auto;
    }
  }

  .sidebar-filter__icon {
    color: var(--text-secondary);
    flex-shrink: 0;
    opacity: 0.85;
  }

  .sidebar-filter__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: var(--text-main);
    font-size: 14px;
    font-family: inherit;
    line-height: 1.4;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
    border-radius: 4px;
  }

  .sidebar-filter__input:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .sidebar-filter__input::placeholder {
    color: var(--text-secondary);
    opacity: 0.85;
  }

  .sidebar-filter__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: color 0.15s ease;
  }

  .sidebar-filter__clear:hover {
    color: var(--text-main);
  }

  /* L'attribut `hidden` doit gagner sur le display ci-dessus. */
  .sidebar-filter__clear[hidden] {
    display: none;
  }

  /* Sections */
  [data-sidebar-section] + [data-sidebar-section] {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
  }

  .sidebar-section-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    text-align: left;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-main);
    margin-bottom: 8px;
    font-weight: 600;
    cursor: pointer;
    background: none;
    border: none;
    padding: 6px 2px;
    min-height: 32px;
    gap: 8px;
    transition: color 0.2s ease;
    box-sizing: border-box;
    overflow: hidden;
  }

  .sidebar-section-toggle:hover {
    color: var(--cyan);
  }

  /* Modificateur APRÈS la règle de base : pas besoin de !important. */
  .sidebar-section-toggle--chapters-active,
  .sidebar-section-toggle--chapters-active .sidebar-chevron {
    color: var(--accent-gold);
  }

  .sidebar-section-toggle__label {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  .sidebar-section-toggle:hover .sidebar-chevron {
    opacity: 1;
  }

  .sidebar-section-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* display:none plutôt que max-height:0 : les liens d'une section repliée ne
     sont plus atteignables au Tab ni annoncés par les lecteurs d'écran. */
  .sidebar-section-links.collapsed {
    display: none;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: var(--border-radius);
    font-size: 13.5px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--text-secondary);
    transition: all 0.15s ease;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  .sidebar-link:hover {
    background-color: var(--surface);
    color: var(--text-main);
  }

  .sidebar-link:active {
    transform: scale(0.98);
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
  }

  .sidebar-link--active {
    color: var(--cyan);
    font-weight: 600;
    background: color-mix(in srgb, var(--cyan) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--cyan);
  }

  .sidebar-link--active:hover {
    background: color-mix(in srgb, var(--cyan) 16%, transparent);
  }

  .sidebar-link--child {
    font-size: 12.5px;
    padding-left: 22px;
  }

  .sidebar-link__tree {
    font-family: monospace;
    color: var(--violet-light);
    flex-shrink: 0;
  }

  .sidebar-link--dossier {
    color: var(--text-muted);
    font-size: 12px;
    font-style: italic;
  }

  .sidebar-link__dossier-label {
    color: var(--cyan);
    font-style: normal;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .sidebar-link {
      padding: 10px 10px;
      min-height: 44px;
    }
    .sidebar-section-toggle {
      font-size: 11px;
      padding: 10px 2px;
      min-height: 44px;
    }
    .sidebar-link--child {
      padding-left: 18px;
    }
  }

  @media (max-width: 380px) {
    .sidebar-link {
      font-size: 13px;
      padding: 9px 8px;
    }
  }
</style>

<script>
  const sidebarNav = document.getElementById('sidebar-nav-root');
  const sidebarContainer = document.getElementById('sidebar-left-container');

  // ── Sections repliables ────────────────────────────────────────────────
  // Un seul helper pour toutes les sections (statiques + « Récemment lus »).
  const wireSection = (section: HTMLElement) => {
    const toggle = section.querySelector<HTMLButtonElement>('.sidebar-section-toggle');
    const links = section.querySelector('.sidebar-section-links');
    const chevron = section.querySelector('.sidebar-chevron');
    if (!toggle || !links || !chevron) return;

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      chevron.classList.toggle('rotate-90', !expanded);
      links.classList.toggle('collapsed', expanded);
    });
  };
  sidebarNav?.querySelectorAll<HTMLElement>('[data-sidebar-section]').forEach(wireSection);

  // ── « Récemment lus » (reprise de lecture entre sessions) ─────────────
  const RECENT_KEY = 'fousdu-recent-articles';

  const buildRecentSection = () => {
    if (!sidebarNav) return;
    let recents: Array<{ href: string; title: string }> = [];
    try {
      recents = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch {
      recents = [];
    }
    if (!Array.isArray(recents)) return;

    const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
    const items = recents
      .filter((r) => r?.href && r?.title && r.href.replace(/\/+$/, '') !== currentPath)
      .slice(0, 5);
    if (items.length === 0) return;

    const section = document.createElement('div');
    section.setAttribute('data-sidebar-section', '');
    section.innerHTML = `
      <button class="sidebar-section-toggle" aria-expanded="true">
        <span class="sidebar-section-toggle__label">
          <span aria-hidden="true">🕘</span>
          <span>Récemment lus</span>
        </span>
        <svg class="sidebar-chevron rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <ul class="sidebar-section-links"></ul>`;
    const ul = section.querySelector('ul')!;
    for (const r of items) {
      const a = document.createElement('a');
      a.href = r.href;
      a.className = 'sidebar-link';
      a.textContent = r.title;
      const li = document.createElement('li');
      li.appendChild(a);
      ul.appendChild(li);
    }

    sidebarNav.insertBefore(section, sidebarNav.querySelector('[data-sidebar-section]'));
    wireSection(section);
  };
  buildRecentSection();

  // ── Filtre ─────────────────────────────────────────────────────────────
  const filterInput = document.getElementById('sidebar-filter-input') as HTMLInputElement | null;
  const filterClear = document.getElementById('sidebar-filter-clear') as HTMLButtonElement | null;
  const liveRegion = document.getElementById('sidebar-filter-status');

  if (filterInput && sidebarNav) {
    const sections = Array.from(sidebarNav.querySelectorAll<HTMLElement>('[data-sidebar-section]'));
    // État replié/déplié d'origine, restauré quand le filtre est vidé.
    const initialExpanded = new Map<HTMLElement, boolean>(
      sections.map((s) => [
        s,
        s.querySelector('.sidebar-section-toggle')?.getAttribute('aria-expanded') === 'true',
      ]),
    );

    const setExpanded = (section: HTMLElement, expanded: boolean) => {
      section.querySelector('.sidebar-section-toggle')?.setAttribute('aria-expanded', String(expanded));
      section.querySelector('.sidebar-chevron')?.classList.toggle('rotate-90', expanded);
      section.querySelector('.sidebar-section-links')?.classList.toggle('collapsed', !expanded);
    };

    const applyFilter = (rawQuery: string) => {
      const q = rawQuery.trim().toLowerCase();
      const filtering = q.length > 0;
      let visibleCount = 0;

      if (filterClear) filterClear.hidden = !filtering;

      for (const section of sections) {
        let hasVisible = false;
        section.querySelectorAll<HTMLAnchorElement>('.sidebar-link').forEach((link) => {
          const matches = !filtering || (link.textContent ?? '').toLowerCase().includes(q);
          (link.closest('li') as HTMLElement | null)!.hidden = !matches;
          if (matches) {
            hasVisible = true;
            visibleCount++;
          }
        });

        section.hidden = filtering && !hasVisible;
        if (filtering) {
          if (hasVisible) setExpanded(section, true);
        } else {
          setExpanded(section, initialExpanded.get(section) ?? false);
        }
      }

      if (liveRegion) {
        liveRegion.textContent = !filtering
          ? ''
          : visibleCount === 0
            ? 'Aucun article trouvé'
            : `${visibleCount} article${visibleCount > 1 ? 's' : ''} trouvé${visibleCount > 1 ? 's' : ''}`;
      }
    };

    filterInput.addEventListener('input', () => applyFilter(filterInput.value));
    filterClear?.addEventListener('click', () => {
      filterInput.value = '';
      applyFilter('');
      filterInput.focus();
    });
  }

  // ── Ouverture du tiroir mobile : focus filtre + scroll vers le lien actif ─
  // Un seul observer, déclenché uniquement sur la transition fermé → ouvert
  // (plus de vol de focus lors d'autres changements de classes).
  if (sidebarContainer && filterInput) {
    let wasOpen = sidebarContainer.classList.contains('is-mobile-open');
    const observer = new MutationObserver(() => {
      const isOpen = sidebarContainer.classList.contains('is-mobile-open');
      if (isOpen === wasOpen) return;
      wasOpen = isOpen;
      if (!isOpen) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Laisse l'animation du tiroir se terminer avant focus/scroll.
      window.setTimeout(() => {
        filterInput.focus({ preventScroll: true });
        sidebarContainer
          .querySelector('.sidebar-link--active')
          ?.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
      }, 300);
    });
    observer.observe(sidebarContainer, { attributes: true, attributeFilter: ['class'] });
  }
</script>
