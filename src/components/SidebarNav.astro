---
import { getCollection } from 'astro:content';
import { categoryById, explorerHighlights, understandingPaths } from '../data/siteNavigation';

interface Props {
  currentPath: string;
}

interface NavLink {
  label: string;
  href: string;
  badge?: string;
}

interface NavSection {
  label: string;
  icon: string;
  links: NavLink[];
  open: boolean;
}

const { currentPath } = Astro.props;
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const normalizedPath = normalize(currentPath);
const isCurrent = (href: string) => normalize(href) === normalizedPath;

const articles = (
  await getCollection('articles', ({ data }) => data.status === 'published' && !data.sidebarHidden)
).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id, 'fr'));

const currentArticleId = normalizedPath.startsWith('/theorie/')
  ? normalizedPath.replace('/theorie/', '')
  : undefined;
const currentArticle = articles.find((article) => article.id === currentArticleId);
const currentCategory = currentArticle ? categoryById.get(currentArticle.data.category) : undefined;

const categoryLinks: NavLink[] = currentCategory
  ? articles
      .filter((article) => article.data.category === currentCategory.id)
      .map((article) => ({
        label: article.data.title,
        href: `/theorie/${article.id}`,
        badge: article.data.navigationType === 'dossier' ? 'Dossier' : undefined,
      }))
  : [];

const recentChapters = (await getCollection('chapters'))
  .sort((a, b) => b.data.chapter - a.data.chapter)
  .slice(0, 6)
  .map((chapter): NavLink => ({
    label: `Chapitre ${chapter.data.chapter} — ${chapter.data.title}`,
    href: `/chapitres/${chapter.data.chapter}`,
  }));

const startLinks: NavLink[] = [
  ...understandingPaths.map((path) => ({ label: path.label, href: path.href })),
  { label: 'Frise chronologique', href: '/theorie/chronologie' },
];

const sections: NavSection[] = [
  {
    label: 'Commencer',
    icon: '🚀',
    links: startLinks,
    open: startLinks.some((link) => isCurrent(link.href)),
  },
];

if (currentCategory && categoryLinks.length) {
  sections.push({
    label: currentCategory.label,
    icon: currentCategory.icon,
    links: categoryLinks,
    open: true,
  });
}

if (normalizedPath.startsWith('/chapitres/')) {
  sections.push({
    label: 'Chapitres récents',
    icon: '📖',
    links: recentChapters,
    open: true,
  });
}

sections.push(
  {
    label: 'Explorer visuellement',
    icon: '🧭',
    links: [
      { label: 'Vue d’ensemble', href: '/explorer' },
      ...explorerHighlights.map((item) => ({ label: item.label, href: item.href })),
    ],
    open: normalizedPath.startsWith('/explorer'),
  },
  {
    label: 'Parcourir le site',
    icon: '🗂️',
    links: [
      { label: 'Tous les dossiers', href: '/dossiers' },
      { label: 'Toutes les analyses', href: '/chapitres' },
      { label: 'Glossaire essentiel', href: '/aide/glossaire' },
      { label: 'À propos du projet', href: '/aide/a-propos' },
    ],
    open: false,
  },
);
---

<nav data-pagefind-ignore aria-label="Navigation contextuelle">
  {
    sections.map((section) => (
      <details class="nav-section" open={section.open}>
        <summary class="nav-section__summary">
          <span class="nav-section__title">
            <span aria-hidden="true">{section.icon}</span>
            <span>{section.label}</span>
          </span>
          <svg
            class="nav-section__chevron"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </summary>

        <ul class="nav-section__links">
          {section.links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="sidebar-link"
              >
                <span>{link.label}</span>
                {link.badge && <small>{link.badge}</small>}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</nav>

<style>
  nav {
    width: 100%;
    min-width: 0;
  }
  .nav-section {
    border-bottom: 1px solid var(--border-color);
  }
  .nav-section:last-child {
    border-bottom: 0;
  }

  .nav-section__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 48px;
    padding: 9px 7px;
    border-radius: var(--border-radius);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.045em;
    cursor: pointer;
    list-style: none;
  }

  .nav-section__summary::-webkit-details-marker {
    display: none;
  }
  .nav-section__summary:hover {
    color: var(--text-main);
    background: var(--surface);
  }
  .nav-section__summary:focus-visible {
    outline-offset: -2px;
  }
  .nav-section__title {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .nav-section__chevron {
    flex: 0 0 auto;
    transition: transform 160ms ease;
  }
  .nav-section[open] .nav-section__chevron {
    transform: rotate(90deg);
  }

  .nav-section__links {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 3px 0 12px;
    list-style: none;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 44px;
    padding: 10px 10px;
    border-left: 3px solid transparent;
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .sidebar-link:hover {
    color: var(--text-main);
    background: var(--surface);
  }
  .sidebar-link[aria-current='page'] {
    border-left-color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 12%, var(--bg-secondary));
    color: var(--text-main);
  }

  .sidebar-link small {
    flex: 0 0 auto;
    padding: 2px 6px;
    border: 1px solid color-mix(in srgb, var(--violet) 36%, transparent);
    border-radius: var(--border-radius-full);
    color: var(--violet-light);
    font-size: 11px;
    font-weight: 750;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-section__chevron {
      transition: none;
    }
  }
</style>
