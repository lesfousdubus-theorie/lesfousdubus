---
import { getCollection } from 'astro:content';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Fetch all published articles (excluding those marked as hidden from sidebar)
// Source unique de la navigation latérale : toutes les pages consomment ce même
// composant, et la collection est triée ici de façon déterministe (order puis id)
// pour que la sidebar soit strictement identique sur l'ensemble du site.
const articles = (
  await getCollection('articles', ({ data }) => data.status === 'published' && !data.sidebarHidden)
).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id, 'fr'));

// Category mapping with French labels and icons
const categoryConfig: Record<string, { label: string; icon: string; order: number }> = {
  'monde-destinations': { label: 'Monde et destinations', icon: '🌍', order: 1 },
  'histoire-temporalite': { label: 'Histoire, temps et Ponéglyphes', icon: '📜', order: 2 },
  'figures-principales': { label: 'Figures principales', icon: '🎭', order: 3 },
  'personnages-identites': { label: 'Personnages et identités', icon: '👥', order: 4 },
  'armes-antiques': { label: 'Armes antiques', icon: '🔱', order: 5 },
  'technologies-pouvoirs': { label: 'Technologies et pouvoirs', icon: '⚡', order: 6 },
  'peuples-royaumes': { label: 'Peuples, royaumes et témoins', icon: '🏰', order: 7 },
  'dieux-croyances': { label: 'Dieux et croyances', icon: '🙏', order: 8 },
  'transmission-memoire': { label: 'Transmission et mémoire', icon: '🎵', order: 9 },
  'gouvernement-mondial': { label: 'Gouvernement mondial', icon: '⚖️', order: 10 },
  'guerre-finale': { label: 'Guerre finale', icon: '⚔️', order: 11 },
};

// Group articles by category
const articlesByCategory = new Map<string, typeof articles>();
for (const article of articles) {
  const categories = [article.data.category];
  // Nika is primarily listed in "Figures principales".
  // "Dieux et croyances" will receive a manual cross-reference link (see below).
  if (article.id === 'nika') {
    // Primary placement in Figures principales.
    // Cross-link added manually in Dieux et croyances section below.
    if (!categories.includes('figures-principales')) {
      categories.push('figures-principales');
    }
  }
  for (const cat of categories) {
    if (!articlesByCategory.has(cat)) {
      articlesByCategory.set(cat, []);
    }
    articlesByCategory.get(cat)!.push(article);
  }
}

// Sort categories by order
const sortedCategories = Array.from(articlesByCategory.entries()).sort(
  ([catA], [catB]) =>
    (categoryConfig[catA]?.order ?? 99) - (categoryConfig[catB]?.order ?? 99) ||
    catA.localeCompare(catB, 'fr'),
);

interface SidebarLink {
  label: string;
  href: string;
  level: 0 | 1;
  type: 'fiche' | 'dossier';
}

interface NavSection {
  title: string;
  label: string;
  icon: string;
  links: SidebarLink[];
  isChaptersSection?: boolean;
}

// Build navigation sections with hierarchical structure:
// fiche canonique au niveau 0, article de démonstration rattaché (parent) au niveau 1.
// L'article parent peut se trouver dans une autre catégorie : on cherche les enfants
// dans toute la collection, puis on les rattache à la fiche parente rencontrée.
const childrenByParent = new Map<string, typeof articles>();
for (const article of articles) {
  if (article.data.parent) {
    if (!childrenByParent.has(article.data.parent)) {
      childrenByParent.set(article.data.parent, []);
    }
    childrenByParent.get(article.data.parent)!.push(article);
  }
}

// Tri déterministe : `order` puis `id`, afin que deux articles partageant le même
// `order` ne puissent jamais permuter d'un build (ou d'une page) à l'autre.
const byOrderThenId = (a: (typeof articles)[number], b: (typeof articles)[number]) =>
  a.data.order - b.data.order || a.id.localeCompare(b.id, 'fr');

const buildLinks = (catArticles: typeof articles): SidebarLink[] => {
  const topLevel = catArticles.filter((a) => !a.data.parent).sort(byOrderThenId);

  const links: SidebarLink[] = [];
  for (const article of topLevel) {
    links.push({
      label: article.data.title,
      href: `/theorie/${article.id}`,
      level: 0,
      type: article.data.navigationType,
    });
    const children = (childrenByParent.get(article.id) ?? []).slice().sort(byOrderThenId);
    for (const child of children) {
      links.push({
        label: child.data.title,
        href: `/theorie/${child.id}`,
        level: 1,
        type: child.data.navigationType,
      });
    }
  }
  return links;
};

const navSections: NavSection[] = [
  {
    title: 'COMMENCER',
    label: 'Commencer',
    icon: '🚀',
    links: [
      { label: 'Présentation', href: '/', level: 0, type: 'fiche' },
      { label: 'Résumé de la théorie', href: '/theorie/resume', level: 0, type: 'fiche' },
      { label: 'Théorie complète', href: '/theorie/theorie-complete', level: 0, type: 'fiche' },
      { label: 'Carte mentale', href: '/explorer/carte-mentale', level: 0, type: 'fiche' },
      { label: 'Lexique essentiel', href: '/aide/glossaire', level: 0, type: 'fiche' },
    ],
  },
  ...sortedCategories.map(([catKey, catArticles]) => {
    const config = categoryConfig[catKey];
    let links = buildLinks(catArticles);

    // P2 adjustments: explicit important entries (keep categories as-is)
    if (catKey === 'personnages-identites') {
      // Only manually surface Shirahoshi (child of poseidon-fiche).
      // Rocks D. Xebec and Gunko are top-level published articles → they appear naturally via buildLinks.
      links = [
        ...links,
        { label: 'Princesse Shirahoshi', href: '/theorie/shirahoshi', level: 0, type: 'fiche' },
      ];
    }
    if (catKey === 'gouvernement-mondial') {
      links = [
        ...links,
        { label: 'Chevaliers Divins', href: '/theorie/chevaliers-divins', level: 0, type: 'fiche' },
      ];
    }

    // P2: avoid visual duplication of Nika (primary in Figures principales)
    if (catKey === 'dieux-croyances') {
      links = [
        ...links,
        { label: '↳ Voir Nika', href: '/theorie/nika', level: 1, type: 'fiche' },
      ];
    }

    // Deduplicate links by href to avoid any duplicate entries (Rocks, Gunko, etc.)
    const seen = new Set();
    links = links.filter((link) => {
      if (seen.has(link.href)) return false;
      seen.add(link.href);
      return true;
    });

    return {
      title: catKey.toUpperCase().replace(/-/g, ' '),
      label: config?.label ?? catKey,
      icon: config?.icon ?? '📄',
      links,
    };
  }),
];

// Add chapters section
const chapters = await getCollection('chapters');
const sortedChapters = chapters.slice().sort((a, b) => b.data.chapter - a.data.chapter);

navSections.push({
  title: 'CHAPITRES',
  label: 'Chapitres récents',
  icon: '📖',
  links: sortedChapters.slice(0, 10).map((chapter) => ({
    label: chapter.data.title.startsWith('Chapitre')
      ? chapter.data.title
      : `Chapitre ${chapter.data.chapter} — ${chapter.data.title}`,
    href: `/chapitres/${chapter.data.chapter}`,
    level: 0,
    type: 'fiche',
  })),
  // Marqueur pour identifier la section chapitres
  isChaptersSection: true,
});

// Add help section
navSections.push({
  title: 'AIDE',
  label: 'Aide & ressources',
  icon: '❓',
  links: [
    { label: 'À propos', href: '/aide/a-propos', level: 0, type: 'fiche' },
    { label: 'FAQ', href: '/aide/faq', level: 0, type: 'fiche' },
    { label: 'Glossaire', href: '/aide/glossaire', level: 0, type: 'fiche' },
    { label: 'Crédits', href: '/aide/credits', level: 0, type: 'fiche' },
  ],
});
---

<nav data-pagefind-ignore id="sidebar-nav-root">
  <!-- Mobile filter — only visible in the drawer -->
  <div class="sidebar-filter" id="sidebar-filter">
    <svg class="sidebar-filter__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      id="sidebar-filter-input"
      class="sidebar-filter__input"
      placeholder="Filtrer les articles…"
      enterkeyhint="search"
      autocomplete="off"
      aria-label="Filtrer la navigation"
      aria-describedby="sidebar-filter-status"
    />
    <button id="sidebar-filter-clear" class="sidebar-filter__clear" aria-label="Effacer le filtre" style="display:none">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <div id="sidebar-filter-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
  {
    navSections.map((section, index) => {
      const isExpanded = section.links.some(
        (link) =>
          currentPath === link.href ||
          currentPath === link.href + '/' ||
          (link.href !== '/' && currentPath.startsWith(link.href)),
      );
      // Vérifier si on est sur une page chapitre pour mettre en évidence la section
      const isChaptersActive = section.isChaptersSection && currentPath.startsWith('/chapitres/');
      
      return (
        <div class={index > 0 ? 'mt-5' : ''} data-sidebar-section>
          <button
            class={`sidebar-section-toggle ${isChaptersActive ? 'sidebar-section-toggle--chapters-active' : ''}`}
            aria-expanded={isExpanded ? 'true' : 'false'}
            aria-label={section.label}
          >
            <span class="flex items-center gap-2">
              <span class="text-base" aria-hidden="true">{section.icon}</span>
              <span>{section.label}</span>
            </span>
            <svg
              class="sidebar-chevron"
              class:list={[{ 'rotate-90': isExpanded }]}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              width="12"
              height="12"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
          <ul
            class="sidebar-section-links"
            class:list={[{ collapsed: !isExpanded }, { expanded: isExpanded }]}
          >
            {section.links.map((link) => {
              const isActive = currentPath === link.href || currentPath === link.href + '/';
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`sidebar-link ${link.level === 1 ? 'sidebar-link--child' : ''} ${link.type === 'dossier' ? 'sidebar-link--dossier' : ''} ${isActive ? 'sidebar-link--active' : ''}`}
                  >
                    {link.level === 1 && (
                      <span class="sidebar-link__tree" aria-hidden="true">
                        └
                      </span>
                    )}
                    {link.type === 'dossier' && (
                      <span class="sidebar-link__dossier-label">↳ Dossier :</span>
                    )}
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })
  }
</nav>

<style>
  /* Visually hidden but accessible to screen readers (live region) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* Ensure sidebar never causes horizontal scroll */
  nav {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Filter — visible on all breakpoints, sticky top */
  .sidebar-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    margin-bottom: 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .sidebar-filter {
      position: relative;
      top: auto;
    }
  }

  .sidebar-filter__icon {
    color: var(--text-secondary);
    flex-shrink: 0;
    opacity: 0.85;
  }

  .sidebar-filter__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: var(--text-main);
    font-size: 14px;
    font-family: inherit;
    line-height: 1.4;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
    border-radius: 4px;
  }

  .sidebar-filter__input:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .sidebar-filter__input::placeholder {
    color: var(--text-secondary);
    opacity: 0.85;
  }

  .sidebar-filter__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: color 0.15s ease;
  }

  .sidebar-filter__clear:hover {
    color: var(--text-main);
  }

  /* Séparateur visuel entre les sections */
  [data-sidebar-section] + [data-sidebar-section] {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
  }

  /* Section Chapitres active - indicateur visuel */
  .sidebar-section-toggle--chapters-active {
    color: var(--accent-gold) !important;
  }

  .sidebar-section-toggle--chapters-active .sidebar-chevron {
    color: var(--accent-gold);
  }

  .sidebar-section-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    text-align: left;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-main);
    margin-bottom: 8px;
    font-weight: 600;
    cursor: pointer;
    background: none;
    border: none;
    padding: 6px 2px;
    min-height: 32px;
    gap: 8px;
    transition: color 0.2s ease;
    box-sizing: border-box;
    overflow: hidden;
  }

  .sidebar-section-toggle span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-section-toggle:hover {
    color: var(--cyan);
  }

  .sidebar-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  .sidebar-section-toggle:hover .sidebar-chevron {
    opacity: 1;
  }

  .sidebar-section-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
    overflow-x: hidden;
    transition:
      max-height 0.25s ease,
      opacity 0.2s ease;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .sidebar-section-links.collapsed {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .sidebar-section-links.expanded {
    max-height: 2000px;
    opacity: 1;
  }

  .sidebar-link--dossier {
    color: var(--text-muted);
    font-size: 12px;
    font-style: italic;
  }

  .sidebar-link__dossier-label {
    color: var(--cyan);
    font-style: normal;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--text-secondary);
    transition: all 0.15s ease;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  .sidebar-link:hover {
    background-color: var(--surface);
    color: var(--text-main);
  }

  .sidebar-link:active {
    transform: scale(0.98);
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
  }

  .sidebar-link--active {
    color: var(--cyan);
    font-weight: 600;
    background: color-mix(in srgb, var(--cyan) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--cyan);
    border-radius: 8px;
  }

  .sidebar-link--active:hover {
    background: color-mix(in srgb, var(--cyan) 16%, transparent);
  }

  /* Sous-niveau : fiche canonique parente → article de démonstration rattaché. */
  .sidebar-link--child {
    font-size: 12.5px;
    color: var(--text-secondary);
    padding-left: 22px;
    margin-left: 0;
  }

  /* Glyphe purement décoratif (aria-hidden) : il ne porte aucune information,
     mais il reste au-dessus de 3:1 pour ne pas disparaître visuellement. */
  .sidebar-link--child .sidebar-link__tree {
    font-family: monospace;
    color: var(--violet-light);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .sidebar-link {
      padding: 10px 10px;
      font-size: 13.5px;
      min-height: 44px;
    }
    .sidebar-section-toggle {
      font-size: 11px;
      padding: 10px 2px;
      min-height: 44px;
    }
    .sidebar-link--child {
      padding-left: 18px;
    }
  }

  @media (max-width: 380px) {
    .sidebar-link {
      font-size: 13px;
      padding: 9px 8px;
    }
  }
</style>

<script>
  // Sidebar collapsible sections
  document.querySelectorAll('[data-sidebar-section]').forEach((section) => {
    const toggle = section.querySelector('.sidebar-section-toggle');
    const links = section.querySelector('.sidebar-section-links');
    const chevron = section.querySelector('.sidebar-chevron');

    if (!toggle || !links || !chevron) return;

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute('aria-expanded', String(expanded));
      chevron.classList.toggle('rotate-90', expanded);
      links.classList.toggle('expanded', expanded);
      links.classList.toggle('collapsed', !expanded);
    };

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      setExpanded(!isExpanded);
    });
  });

  // « Récemment lus » — reprise de lecture entre sessions (localStorage).
  // Construite côté client pour rester 100 % statique ; insérée AVANT l'init du
  // filtre pour que celui-ci la prenne en compte.
  const RECENT_ARTICLES_KEY = 'fousdu-recent-articles';
  const sidebarNav = document.getElementById('sidebar-nav-root');

  const buildRecentSection = () => {
    if (!sidebarNav) return;
    let recents: Array<{ href: string; title: string }> = [];
    try {
      const raw = localStorage.getItem(RECENT_ARTICLES_KEY);
      if (raw) recents = JSON.parse(raw);
    } catch {
      recents = [];
    }
    if (!Array.isArray(recents) || recents.length === 0) return;

    const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
    const items = recents
      .filter((r) => r && r.href && r.title)
      .filter((r) => r.href.replace(/\/+$/, '') !== currentPath)
      .slice(0, 5);
    if (items.length === 0) return;

    const section = document.createElement('div');
    section.setAttribute('data-sidebar-section', '');
    section.setAttribute('data-recent-section', '');
    section.innerHTML = `
      <button class="sidebar-section-toggle" aria-expanded="true" aria-label="Récemment lus">
        <span class="flex items-center gap-2">
          <span class="text-base" aria-hidden="true">🕘</span>
          <span>Récemment lus</span>
        </span>
        <svg class="sidebar-chevron rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <ul class="sidebar-section-links expanded"></ul>`;
    const ul = section.querySelector('ul')!;
    items.forEach((r) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = r.href;
      a.className = 'sidebar-link';
      a.textContent = r.title;
      li.appendChild(a);
      ul.appendChild(li);
    });

    const firstSection = sidebarNav.querySelector('[data-sidebar-section]');
    if (firstSection) sidebarNav.insertBefore(section, firstSection);
    else sidebarNav.appendChild(section);

    // Câblage du bouton de repli (même comportement que les sections statiques)
    const toggle = section.querySelector('.sidebar-section-toggle');
    const links = section.querySelector('.sidebar-section-links');
    const chevron = section.querySelector('.sidebar-chevron');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      chevron?.classList.toggle('rotate-90', !expanded);
      links?.classList.toggle('expanded', !expanded);
      links?.classList.toggle('collapsed', expanded);
    });
  };
  buildRecentSection();

  // Sidebar filter — desktop + mobile, with state restore + recent
  const filterInput = document.getElementById('sidebar-filter-input') as HTMLInputElement | null;
  const filterClear = document.getElementById('sidebar-filter-clear');

  if (filterInput && sidebarNav) {
    const allSections = sidebarNav.querySelectorAll<HTMLDivElement>('[data-sidebar-section]');
    const liveRegion = document.getElementById('sidebar-filter-status');
    // Save initial expanded state to restore after clear
    const initialState = new Map<string, boolean>();
    allSections.forEach((section, idx) => {
      const toggle = section.querySelector('.sidebar-section-toggle');
      if (toggle) initialState.set(String(idx), toggle.getAttribute('aria-expanded') === 'true');
    });

    const applyFilter = (query: string) => {
      const q = query.trim().toLowerCase();
      const hasFilter = q.length > 0;
      let visibleCount = 0;

      if (filterClear) filterClear.style.display = hasFilter ? 'inline-flex' : 'none';

      allSections.forEach((section, idx) => {
        const links = section.querySelectorAll<HTMLAnchorElement>('.sidebar-link');
        const toggle = section.querySelector('.sidebar-section-toggle');
        const linksList = section.querySelector('.sidebar-section-links');
        const chevron = section.querySelector('.sidebar-chevron');
        let hasVisible = false;

        links.forEach((link) => {
          const text = link.textContent?.toLowerCase() ?? '';
          const matches = !hasFilter || text.includes(q);
          (link.closest('li') as HTMLElement | null)?.style.setProperty('display', matches ? '' : 'none');
          if (matches) {
            hasVisible = true;
            visibleCount++;
          }
        });

        section.style.display = hasVisible || !hasFilter ? '' : 'none';

        if (hasFilter && hasVisible && toggle && linksList && chevron) {
          toggle.setAttribute('aria-expanded', 'true');
          chevron.classList.add('rotate-90');
          linksList.classList.add('expanded');
          linksList.classList.remove('collapsed');
        } else if (!hasFilter && toggle && linksList && chevron) {
          const wasExpanded = initialState.get(String(idx));
          toggle.setAttribute('aria-expanded', wasExpanded ? 'true' : 'false');
          chevron.classList.toggle('rotate-90', !!wasExpanded);
          linksList.classList.toggle('expanded', !!wasExpanded);
          linksList.classList.toggle('collapsed', !wasExpanded);
          // Ensure all items visible again
          links.forEach((link) => {
            (link.closest('li') as HTMLElement | null)?.style.setProperty('display', '');
          });
        }
      });

      // Announce to screen readers
      if (liveRegion) {
        if (!hasFilter) liveRegion.textContent = '';
        else if (visibleCount === 0) liveRegion.textContent = 'Aucun article trouvé';
        else liveRegion.textContent = `${visibleCount} article${visibleCount > 1 ? 's' : ''} trouvé${visibleCount > 1 ? 's' : ''}`;
      }
    };

    filterInput.addEventListener('input', () => applyFilter(filterInput.value));

    filterClear?.addEventListener('click', () => {
      filterInput.value = '';
      applyFilter('');
      filterInput.focus();
    });

    // Auto-focus filter when drawer opens (a11y)
    const sidebarContainer = document.getElementById('sidebar-left-container');
    if (sidebarContainer) {
      const observerFilter = new MutationObserver(() => {
        if (sidebarContainer.classList.contains('is-mobile-open')) {
          setTimeout(() => filterInput.focus(), 100);
        }
      });
      observerFilter.observe(sidebarContainer, { attributes: true, attributeFilter: ['class'] });
    }
  }

  // Auto-scroll to the active link when the mobile drawer opens
  const sidebarContainer = document.getElementById('sidebar-left-container');
  if (sidebarContainer) {
    const scrollToActive = () => {
      const activeLink = sidebarContainer.querySelector<HTMLAnchorElement>('.sidebar-link--active');
      if (activeLink) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Small delay to let the drawer animation finish
        setTimeout(() => {
          activeLink.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
        }, 300);
      }
    };

    // Observe the drawer opening
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.type === 'attributes' && (m.target as HTMLElement).classList.contains('is-mobile-open')) {
          scrollToActive();
        }
      }
    });
    observer.observe(sidebarContainer, { attributes: true, attributeFilter: ['class'] });
  }
</script>
