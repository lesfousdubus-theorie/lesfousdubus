---
import { getCollection } from 'astro:content';

const currentYear = new Date().getFullYear();

// Dernier chapitre analysé pour affichage dans le footer
const chapters = await getCollection('chapters');
const lastChapter = chapters
  .slice()
  .sort((a, b) => b.data.chapter - a.data.chapter)[0];
---

<footer class="footer" data-pagefind-ignore role="contentinfo">
  <div class="footer__inner">
    <div class="footer__left">
      <div class="footer__brand">
        <img
          src="/logo.png"
          alt=""
          class="footer__logo-img"
          width="28"
          height="28"
          aria-hidden="true"
        />
        <span class="footer__copyright">© {currentYear} Les Fous du Bus</span>
      </div>
      <p class="footer__note">
        Projet fan-made non officiel. One Piece © Eiichiro Oda / Shueisha / Toei Animation.
      </p>
      {lastChapter && (
        <p class="footer__updated">
          Dernière analyse : <a href={`/chapitres/${lastChapter.data.chapter}`}>chapitre {lastChapter.data.chapter}</a>
        </p>
      )}
    </div>

    <div class="footer__right">
      <div class="footer__links">
        <a href="/aide/a-propos">À propos</a>
        <a href="/aide/glossaire">Glossaire</a>
        <a href="/aide/faq">FAQ</a>
        <a href="/aide/plan-du-site">Plan du site</a>
        <a href="/theorie/chronologie">Chronologie</a>
        <a href="/explorer/carte-mentale">Carte mentale</a>
        <a href="/dossiers">Dossiers</a>
        <a href="/explorer">Explorer</a>
      </div>
      <div class="footer__social">
        <a
          href="https://github.com/lesfousdubus-theorie/lesfousdubus"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="GitHub (s’ouvre dans un nouvel onglet)"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          <span class="sr-only">nouvel onglet</span>
        </a>
        <a
          href="https://x.com/FoudubusTV_"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="X / Twitter (s’ouvre dans un nouvel onglet)"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
          <span class="sr-only">nouvel onglet</span>
        </a>
        <span class="footer__social-separator" aria-hidden="true"></span>
        <a href="#main-content" class="footer__social-link footer__back-to-top" aria-label="Retour en haut de la page">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
          <span class="footer__back-to-top-label">Haut</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* sr-only utility for visually hidden but accessible text */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .footer {
    margin-top: auto;
    padding: 24px 0 28px;
    border-top: 1px solid var(--border-color);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .footer__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer__left {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer__left {
      align-items: flex-start;
      text-align: left;
    }
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer__copyright {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-main);
  }

  .footer__note {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .footer__updated {
    font-size: 11.5px;
    color: var(--text-muted);
    margin: 2px 0 0;
  }

  .footer__updated a {
    color: var(--cyan);
    text-decoration: none;
  }

  .footer__updated a:hover {
    text-decoration: underline;
  }

  .footer__right {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .footer__right {
      align-items: flex-end;
    }
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .footer__links {
      justify-content: flex-end;
    }
  }

  .footer__links a {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 24px;
  }

  .footer__links a:hover {
    color: var(--cyan);
  }

  .footer__inline-icon {
    flex-shrink: 0;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer__social-separator {
    width: 1px;
    height: 20px;
    background: var(--border-color);
    margin: 0 4px;
  }

  .footer__social-link {
    /* 44x44 minimum tap target on mobile */
    width: 44px;
    height: 44px;
    border-radius: var(--border-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    background: color-mix(in srgb, var(--surface) 50%, transparent);
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .footer__social-link {
      width: 36px;
      height: 36px;
    }
  }

  .footer__social-link:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 10%, transparent);
    box-shadow: 0 0 12px var(--glow-cyan);
  }
  .footer__social-link:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .footer__social-link:active {
    transform: translateY(0) scale(0.95);
  }

  .footer__back-to-top {
    width: auto;
    padding: 0 14px;
    gap: 6px;
    min-height: 44px;
  }

  @media (min-width: 768px) {
    .footer__back-to-top {
      min-height: 36px;
      padding: 0 10px;
    }
  }

  .footer__back-to-top-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
