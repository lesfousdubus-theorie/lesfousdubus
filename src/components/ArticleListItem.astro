---
interface Props {
  badge: string;
  badgeColor: 'cyan' | 'violet' | 'gold' | 'textSecondary';
  title: string;
  category: string;
  chapter?: string;
  href: string;
  summary?: string;
}

const { badge, badgeColor, title, category, chapter, href, summary } = Astro.props;
---

<a href={href} class="article-item">
  <span class="article-item__accent" aria-hidden="true"></span>
  <div class="article-item__body">
    <div class="article-item__main">
      <span class={`article-item__badge article-item__badge--${badgeColor}`}>{badge}</span>
      <strong class="article-item__title">{title}</strong>
    </div>
    {summary && <p class="article-item__summary">{summary}</p>}
    <div class="article-item__meta">
      <span>{category}</span>
      {chapter && <span class="article-item__dot">•</span>}
      {chapter && <span>Suite au chap. {chapter}</span>}
    </div>
  </div>
  <span class="article-item__arrow" aria-hidden="true">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg
    >
  </span>
</a>

<style>
  .article-item {
    position: relative;
    display: flex;
    min-height: 112px;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background-color: var(--bg-main);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .article-item:hover {
    border-color: color-mix(in srgb, var(--violet) 45%, var(--border-color));
    background-color: var(--bg-secondary);
    box-shadow: 0 4px 20px var(--shadow-color);
    transform: translateY(-2px);
  }

  .article-item:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .article-item__accent {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--gradient-border);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .article-item:hover .article-item__accent {
    opacity: 1;
  }

  .article-item__body {
    display: grid;
    min-width: 0;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-5);
    align-content: center;
    padding: var(--space-4) var(--space-2) var(--space-4) var(--space-5);
  }

  .article-item__main {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .article-item__badge {
    display: inline-flex;
    min-height: 26px;
    flex: 0 0 auto;
    align-items: center;
    padding: 3px 9px;
    border: 1px solid;
    border-radius: var(--border-radius-full);
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .article-item__badge--cyan {
    border-color: color-mix(in srgb, var(--cyan) 25%, transparent);
    background-color: color-mix(in srgb, var(--cyan) 12%, transparent);
    color: var(--cyan);
  }

  .article-item__badge--violet {
    border-color: color-mix(in srgb, var(--violet) 25%, transparent);
    background-color: color-mix(in srgb, var(--violet) 12%, transparent);
    color: var(--violet-light);
  }

  .article-item__badge--gold {
    border-color: color-mix(in srgb, var(--accent-gold) 25%, transparent);
    background-color: color-mix(in srgb, var(--accent-gold) 12%, transparent);
    color: var(--accent-gold);
  }

  .article-item__badge--textSecondary {
    border-color: color-mix(in srgb, var(--text-secondary) 38%, transparent);
    background-color: color-mix(in srgb, var(--text-secondary) 20%, transparent);
    color: var(--text-secondary);
  }

  .article-item__title {
    min-width: min(100%, 180px);
    color: var(--text-main);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .article-item:hover .article-item__title {
    color: var(--cyan);
  }

  .article-item__summary {
    display: -webkit-box;
    grid-column: 1;
    margin: 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .article-item__meta {
    display: flex;
    grid-column: 2;
    grid-row: 1 / 3;
    max-width: 170px;
    flex-wrap: wrap;
    align-items: center;
    align-self: center;
    justify-content: flex-end;
    gap: var(--space-2);
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.45;
    text-align: right;
  }

  .article-item__dot {
    color: color-mix(in srgb, var(--text-secondary) 45%, transparent);
  }

  .article-item__arrow {
    display: flex;
    width: var(--control-size);
    flex: 0 0 var(--control-size);
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .article-item:hover .article-item__arrow {
    color: var(--cyan);
    transform: translateX(2px);
  }

  @media (max-width: 680px) {
    .article-item__body {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-4) var(--space-2) var(--space-4) var(--space-4);
    }

    .article-item__meta {
      grid-column: 1;
      grid-row: auto;
      max-width: none;
      justify-content: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 400px) {
    .article-item__arrow {
      width: 32px;
      flex-basis: 32px;
    }
  }
</style>
