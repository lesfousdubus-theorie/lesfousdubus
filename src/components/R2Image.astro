---
interface Props {
  src: string;
  alt: string;
  class?: string;
  caption?: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className = '', caption, width, height, loading = 'lazy' } = Astro.props;

// Public media origin; configurable in `.env` via `PUBLIC_MEDIA_URL`.
const R2_BASE_URL = import.meta.env.PUBLIC_MEDIA_URL || 'https://media.lesfousdubus.sbs';

// On s'assure de ne pas avoir de double slash si src commence par un /
const imagePath = src.startsWith('/') ? src : `/${src}`;
const fullUrl = `${R2_BASE_URL}${imagePath}`;
---

<figure class="r2-figure my-6">
  <img
    src={fullUrl}
    alt={alt}
    class={`rounded-lg border border-borderColor shadow-lg object-cover w-full ${className}`}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    style={`aspect-ratio: ${width}/${height}`}
  />
  {
    caption && (
      <figcaption class="text-center text-[13px] text-textSecondary mt-2 italic">
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .r2-figure img {
    height: auto;
    max-width: 100%;
    display: block;
  }
</style>
