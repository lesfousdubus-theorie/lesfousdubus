---
const steps = [
  {
    id: 'present',
    number: '01',
    label: 'Le présent écrit l’Histoire',
    shortLabel: 'Présent',
    title: 'Luffy et ses alliés vivent les événements fondateurs',
    text: 'La guerre finale, les promesses tenues et la transformation du monde ne seraient pas la répétition du Siècle oublié : elles en constitueraient les événements réels.',
    status: 'Thèse centrale',
  },
  {
    id: 'future',
    number: '02',
    label: 'La légende prend forme',
    shortLabel: 'Futur proche',
    title: 'Luffy devient Joy Boy et le récit peut être consigné',
    text: 'À l’issue de l’aventure, Luffy serait retenu comme Joy Boy. Robin et Momonosuke pourraient alors participer à la rédaction et à la gravure des Ponéglyphes.',
    status: 'Développement de la théorie',
  },
  {
    id: 'transmission',
    number: '03',
    label: 'L’information rejoint le passé',
    shortLabel: 'Transmission',
    title: 'Les Ponéglyphes sont transmis environ neuf siècles plus tôt',
    text: 'Le passé reçoit le récit et les instructions du futur. Le moyen exact de cette transmission reste non résolu : c’est le principal point ouvert de la théorie.',
    status: 'Mécanisme non résolu',
  },
  {
    id: 'preparation',
    number: '04',
    label: 'Huit siècles de préparation',
    shortLabel: 'Accomplissement',
    title: 'Les peuples préparent le monde jusqu’au retour de Joy Boy',
    text: 'Noah, Wa no Kuni, les croyances autour de Nika et les héritages protégés convergent vers le présent. Le futur devient mémoire, puis cette mémoire aide le présent à l’accomplir.',
    status: 'Boucle d’information',
  },
];
---

<section class="mechanism" aria-labelledby="mechanism-title" data-theory-mechanism>
  <div class="mechanism__heading">
    <div>
      <p class="mechanism__eyebrow">Le mécanisme minimal</p>
      <h2 id="mechanism-title">Comment le futur devient-il le « passé » du monde ?</h2>
    </div>
    <a href="/theorie/chronologie"
      >Voir les mécanismes envisagés <span aria-hidden="true">→</span></a
    >
  </div>

  <p class="mechanism__intro">
    Le noyau de la théorie n’impose pas une boucle physique généralisée. Il décrit d’abord une
    <strong>boucle d’information</strong> : une histoire vécue dans le présent ou le futur est transmise
    au passé, qui se prépare ensuite à son accomplissement.
  </p>

  <div class="mechanism__tabs" role="tablist" aria-label="Les quatre étapes du mécanisme temporel">
    {
      steps.map((step, index) => (
        <button
          type="button"
          id={`mechanism-tab-${step.id}`}
          class:list={['mechanism__tab', { 'is-active': index === 0 }]}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`mechanism-panel-${step.id}`}
          tabindex={index === 0 ? 0 : -1}
          data-mechanism-tab
        >
          <span class="mechanism__number" aria-hidden="true">
            {step.number}
          </span>
          <span class="mechanism__tab-copy">
            <span class="mechanism__short">{step.shortLabel}</span>
            <span class="mechanism__label">{step.label}</span>
          </span>
        </button>
      ))
    }
  </div>

  <div class="mechanism__panels">
    {
      steps.map((step, index) => (
        <article
          id={`mechanism-panel-${step.id}`}
          class:list={['mechanism__panel', { 'is-active': index === 0 }]}
          role="tabpanel"
          aria-labelledby={`mechanism-tab-${step.id}`}
          tabindex="0"
          data-mechanism-panel
        >
          <span class="mechanism__status">{step.status}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))
    }
  </div>

  <p class="mechanism__formula">
    <span>Le présent produit l’Histoire</span>
    <span aria-hidden="true">→</span>
    <span>l’Histoire rejoint le passé</span>
    <span aria-hidden="true">→</span>
    <span>le passé prépare le présent</span>
  </p>
</section>

<script>
  const initTheoryMechanism = (root: HTMLElement) => {
    if (root.dataset.enhanced === 'true') return;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mechanism-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-mechanism-panel]'));
    if (!tabs.length || tabs.length !== panels.length) return;

    root.dataset.enhanced = 'true';

    const activate = (nextIndex: number, moveFocus = false) => {
      tabs.forEach((tab, index) => {
        const isActive = index === nextIndex;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        panels[index].classList.toggle('is-active', isActive);
        panels[index].hidden = !isActive;
      });

      if (moveFocus) tabs[nextIndex].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown')
          nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;

        event.preventDefault();
        activate(nextIndex, true);
      });
    });

    activate(0);
  };

  document.querySelectorAll<HTMLElement>('[data-theory-mechanism]').forEach(initTheoryMechanism);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-theory-mechanism]').forEach(initTheoryMechanism);
  });
</script>

<style>
  .mechanism {
    margin: var(--space-6) 0 40px;
    padding: clamp(20px, 4vw, 32px);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-xl);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--violet) 14%, transparent),
        transparent 42%
      ),
      var(--bg-secondary);
    box-shadow: 0 18px 48px color-mix(in srgb, var(--shadow-color) 55%, transparent);
  }

  .mechanism__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .mechanism__heading h2 {
    max-width: 560px;
    margin: 0;
    color: var(--text-main);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.25;
  }

  .mechanism__heading > a {
    flex-shrink: 0;
    margin-top: var(--space-1);
    color: var(--cyan);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .mechanism__heading > a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mechanism__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--violet-light);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mechanism__intro {
    max-width: 760px;
    margin: var(--space-4) 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .mechanism__intro strong {
    color: var(--text-main);
  }

  .mechanism__tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .mechanism__tab {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 74px;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    background: color-mix(in srgb, var(--surface) 68%, transparent);
    color: var(--text-secondary);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .mechanism__tab:hover {
    border-color: color-mix(in srgb, var(--cyan) 55%, var(--border-color));
    transform: translateY(-1px);
  }

  .mechanism__tab.is-active {
    border-color: color-mix(in srgb, var(--cyan) 72%, var(--border-color));
    background: color-mix(in srgb, var(--cyan) 10%, var(--surface));
    color: var(--text-main);
  }

  .mechanism__number {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border-radius: var(--border-radius-full);
    background: color-mix(in srgb, var(--violet) 16%, transparent);
    color: var(--violet-light);
    font-size: 11px;
    font-weight: 800;
  }

  .mechanism__tab.is-active .mechanism__number {
    background: var(--cyan);
    color: var(--bg-main);
  }

  .mechanism__tab-copy {
    display: block;
    min-width: 0;
  }

  .mechanism__short,
  .mechanism__label {
    display: block;
  }

  .mechanism__short {
    margin-bottom: 3px;
    color: inherit;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .mechanism__label {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .mechanism__panels {
    margin-top: var(--space-3);
  }

  .mechanism__panel {
    padding: 20px 22px;
    border: 1px solid color-mix(in srgb, var(--cyan) 30%, var(--border-color));
    border-radius: var(--border-radius-lg);
    background: color-mix(in srgb, var(--bg-main) 58%, transparent);
  }

  .mechanism:not([data-enhanced='true']) .mechanism__panel + .mechanism__panel {
    margin-top: var(--space-3);
  }

  .mechanism__status {
    display: inline-flex;
    margin-bottom: var(--space-2);
    padding: 3px 9px;
    border-radius: var(--border-radius-full);
    background: color-mix(in srgb, var(--accent-gold) 13%, transparent);
    color: var(--accent-gold);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mechanism__panel h3 {
    margin: 0 0 var(--space-2);
    color: var(--text-main);
    font-size: 17px;
    line-height: 1.35;
  }

  .mechanism__panel p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.65;
  }

  .mechanism__formula {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    color: var(--text-muted);
    font-size: 11.5px;
    font-weight: 600;
    text-align: center;
  }

  .mechanism__formula span[aria-hidden='true'] {
    color: var(--cyan);
  }

  @media (max-width: 760px) {
    .mechanism {
      padding: 20px 16px;
    }

    .mechanism__heading {
      display: block;
    }

    .mechanism__heading > a {
      display: inline-block;
      margin-top: var(--space-3);
    }

    .mechanism__tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mechanism__tab {
      min-height: 68px;
    }

    .mechanism__formula {
      align-items: stretch;
      flex-direction: column;
    }

    .mechanism__formula span[aria-hidden='true'] {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 420px) {
    .mechanism__tabs {
      grid-template-columns: 1fr;
    }

    .mechanism__tab {
      min-height: 58px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mechanism__tab {
      transition: none;
    }
  }
</style>
