---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
  count?: number;
}

const { icon, title, description, href, count } = Astro.props;
---

<a href={href} class="card">
  <div class="card__header">
    <span class="card__icon" aria-hidden="true">{icon}</span>
    {count !== undefined && <span class="card__count">{count} articles</span>}
  </div>
  <h3 class="card__title">{title}</h3>
  <p class="card__desc">{description}</p>
  <div class="card__arrow">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg
    >
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 208px;
    flex-direction: column;
    padding: var(--card-padding);
    background: var(--gradient-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: var(--gradient-border);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 12px 36px var(--shadow-color),
      0 0 22px var(--glow-violet);
    border-color: transparent;
  }

  .card:hover::before {
    opacity: 1;
  }

  .card:active {
    transform: translateY(0) scale(0.98);
    box-shadow:
      0 4px 16px var(--shadow-color),
      0 0 10px var(--glow-violet);
  }

  .card:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .card__icon {
    font-size: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-size);
    height: var(--control-size);
    border-radius: var(--border-radius);
    background: color-mix(in srgb, var(--violet) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--violet) 15%, transparent);
    transition: all 0.3s ease;
  }

  .card:hover .card__icon {
    background: color-mix(in srgb, var(--violet) 18%, transparent);
    border-color: color-mix(in srgb, var(--violet) 30%, transparent);
    box-shadow: 0 0 12px var(--glow-violet);
  }

  .card__count {
    display: inline-flex;
    min-height: 26px;
    align-items: center;
    padding: 3px 9px;
    border-radius: var(--border-radius-full);
    background-color: var(--surface);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  .card__title {
    margin: 0 0 var(--space-2);
    color: var(--text-main);
    font-size: 16px;
    font-weight: 650;
    transition: color 0.25s ease;
  }

  .card:hover .card__title {
    color: var(--cyan);
  }

  .card__desc {
    flex: 1;
    margin: 0;
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .card__arrow {
    display: flex;
    width: 32px;
    height: 32px;
    align-items: center;
    align-self: flex-end;
    justify-content: center;
    margin-top: var(--space-3);
    border-radius: var(--border-radius-full);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--text-secondary);
    opacity: 0.7;
    transform: translateX(-2px);
    transition: all 0.25s ease;
  }

  .card:hover .card__arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--cyan);
  }
</style>
