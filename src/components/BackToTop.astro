<button
  id="back-to-top"
  class="back-to-top"
  aria-label="Retour en haut de la page"
  title="Retour en haut"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const checkScroll = () => {
      if (window.scrollY > 300) {
        btn.classList.add('back-to-top--visible');
      } else {
        btn.classList.remove('back-to-top--visible');
      }
    };

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: max(24px, env(safe-area-inset-bottom));
    right: max(24px, env(safe-area-inset-right));
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-main);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px var(--shadow-color);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: all 0.25s ease;
    /* Au-dessus du contenu, mais sous les tiroirs et les modales. */
    z-index: 35;
  }

  /* Les superpositions verrouillent le document : le bouton ne doit alors
     ni chevaucher leurs contrôles, ni rester atteignable à la souris. */
  :global(html.nav-drawer-open) #back-to-top,
  :global(html.toc-drawer-open) #back-to-top,
  :global(html.search-modal-open) #back-to-top,
  :global(html.timeline-dialog-open) #back-to-top {
    opacity: 0 !important;
    visibility: hidden !important;
    transform: translateY(12px) !important;
    pointer-events: none !important;
  }

  /* Le bouton du sommaire occupe le coin inférieur droit tant que son panneau
     latéral est replié. Les deux contrôles sont empilés, jamais superposés. */
  @media (max-width: 1399px) {
    #back-to-top {
      bottom: max(76px, calc(env(safe-area-inset-bottom) + 60px));
    }
  }

  .back-to-top:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    background: color-mix(in srgb, var(--surface) 90%, var(--cyan) 10%);
    box-shadow: 0 0 16px var(--glow-cyan);
  }
  .back-to-top:active {
    transform: scale(0.92);
  }
  .back-to-top:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .back-to-top--visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .back-to-top {
      right: max(16px, env(safe-area-inset-right));
    }
  }
</style>
