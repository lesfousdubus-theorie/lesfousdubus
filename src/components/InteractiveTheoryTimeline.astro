      bottom: 9px;
    }

    .timeline-console {
      align-items: stretch;
      flex-direction: column;
    }

    .timeline-console__current {
      flex-basis: auto;
    }

    .timeline-scrubber {
      flex-basis: auto;
    }

    .timeline-console__count {
      display: flex;
