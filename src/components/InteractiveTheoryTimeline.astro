      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .mobile-era-select select {
      width: 100%;
      min-height: 48px;
      padding: 8px 38px 8px 12px;
      border: 1px solid var(--border-color);
      border-radius: 11px;
      background: var(--bg-secondary);
      color: var(--text-main);
      font: 650 14px/1.2 var(--font-sans);
    }

    .control-deck {
      margin-right: -4px;
      margin-left: -4px;
      padding: 8px;
    }

    .control-deck__right {
      align-items: stretch;
      flex-direction: column;
    }

    .thread-select {
      justify-content: space-between;
    }

    .thread-select select {
      flex: 1;
      max-width: none;
    }

    .timeline-actions {
      justify-content: flex-end;
    }

    .timeline-actions button {
      flex: 1;
      width: auto;
      min-height: 44px;
    }

    .timeline-stage {
      min-height: 664px;
      margin-right: -8px;
      margin-left: -8px;
      border-radius: 16px;
    }

    .timeline-track {
      padding-right: 34px;
      padding-left: 34px;
    }

    .event-card__visual {
      height: 102px;
    }

    .edge-fade {
