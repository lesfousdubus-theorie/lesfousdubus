    .paradox-map {
      grid-template-columns: minmax(118px, 1fr) auto minmax(118px, 1fr) auto minmax(132px, 1fr);
      overflow-x: auto;
    }

    .era-strip {
      display: none;
    }

    .mobile-era-select {
      display: grid;
      gap: 5px;
      margin-bottom: 10px;
      color: var(--text-muted);
