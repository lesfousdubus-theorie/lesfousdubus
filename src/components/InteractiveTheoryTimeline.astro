    .time-star,
    .event-card,
    .event-node,
    .event-card__visual img {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const initialiseTimeline = () => {
    const root = document.querySelector<HTMLElement>('[data-timeline-root]');
    if (!root || root.dataset.enhanced === 'true') return;
    root.dataset.enhanced = 'true';

    const viewport = root.querySelector<HTMLElement>('[data-timeline-viewport]');
    const track = root.querySelector<HTMLElement>('[data-timeline-track]');
    const range = root.querySelector<HTMLInputElement>('[data-timeline-range]');
    const threadFilter = root.querySelector<HTMLSelectElement>('[data-thread-filter]');
    const eraSelect = root.querySelector<HTMLSelectElement>('[data-era-select]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-event-dialog]');
    const dialogContent = dialog?.querySelector<HTMLElement>('[data-dialog-content]');
    if (!viewport || !track || !range) return;

    const events = Array.from(root.querySelectorAll<HTMLElement>('[data-event]'));
    const statusButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-status-filter]'),
    );
    const eraButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-era-button]'));
    const storyButton = root.querySelector<HTMLButtonElement>('[data-story-toggle]');
    const storyLabel = root.querySelector<HTMLElement>('[data-story-label]');
    const storyIcon = root.querySelector<HTMLElement>('.story-button__icon');
    const currentIndex = root.querySelector<HTMLElement>('[data-current-index]');
    const currentDate = root.querySelector<HTMLElement>('[data-current-date]');
    const currentTitle = root.querySelector<HTMLElement>('[data-current-title]');
    const visibleCount = root.querySelector<HTMLElement>('[data-visible-count]');
    const live = root.querySelector<HTMLElement>('[data-timeline-live]');
    const emptyState = root.querySelector<HTMLElement>('[data-timeline-empty]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeStatus = 'all';
    let activeThread = 'all';
    let zoomIndex = 1;
    let dragging = false;
    let dragStartX = 0;
    let dragStartScroll = 0;
    let activeOpener: HTMLElement | null = null;
    let storyTimer: number | undefined;
    let updateFrame = 0;

    const visibleEvents = () => events.filter((event) => !event.hidden);
    const maxScroll = () => Math.max(0, viewport.scrollWidth - viewport.clientWidth);
    const eventCenter = (event: HTMLElement) => event.offsetLeft + event.offsetWidth / 2;
    const viewportCenter = () => viewport.scrollLeft + viewport.clientWidth / 2;

    const closestVisibleIndex = () => {
      const visible = visibleEvents();
      if (!visible.length) return -1;
      const center = viewportCenter();
      let closest = 0;
      let distance = Number.POSITIVE_INFINITY;
      visible.forEach((event, index) => {
        const nextDistance = Math.abs(eventCenter(event) - center);
        if (nextDistance < distance) {
          distance = nextDistance;
          closest = index;
        }
      });
      return closest;
    };

    const stopStory = () => {
      window.clearInterval(storyTimer);
      storyTimer = undefined;
      storyButton?.setAttribute('aria-pressed', 'false');
      if (storyLabel) storyLabel.textContent = 'Lire la théorie';
      if (storyIcon) storyIcon.textContent = '▶';
    };

    const scrollToEvent = (event: HTMLElement, announce = true) => {
      const left = Math.max(0, eventCenter(event) - viewport.clientWidth / 2);
      viewport.scrollTo({ left, behavior: reducedMotion ? 'auto' : 'smooth' });
      if (announce && live) {
        const button = event.querySelector<HTMLButtonElement>('[data-event-open]');
        live.textContent =
          button?.getAttribute('aria-label')?.replace(' Ouvrir les détails.', '') ?? '';
      }
    };

    const updatePosition = () => {
      updateFrame = 0;
      const maximum = maxScroll();
      range.value = maximum ? String(Math.round((viewport.scrollLeft / maximum) * 1000)) : '0';

      const visible = visibleEvents();
      const index = closestVisibleIndex();
      const selected = visible[index];
      events.forEach((event) => event.classList.toggle('is-current', event === selected));
      if (!selected) return;

      const selectedDate =
        selected.querySelector<HTMLElement>('[data-event-date]')?.textContent?.trim() ?? '';
      const selectedTitle =
        selected.querySelector<HTMLElement>('.event-card__body > strong')?.textContent?.trim() ??
        '';
      if (currentIndex)
        currentIndex.textContent = `${String(index + 1).padStart(2, '0')}/${visible.length}`;
      if (currentDate) currentDate.textContent = selectedDate;
      if (currentTitle) currentTitle.textContent = selectedTitle;

      eraButtons.forEach((button) => {
        const isCurrent = button.dataset.eraButton === selected.dataset.era;
        if (isCurrent) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
      if (eraSelect && selected.dataset.era) eraSelect.value = selected.dataset.era;
    };

    const requestPositionUpdate = () => {
      if (updateFrame) return;
      updateFrame = requestAnimationFrame(updatePosition);
    };

    const applyFilters = () => {
      stopStory();
      events.forEach((event) => {
        const statusMatches = activeStatus === 'all' || event.dataset.status === activeStatus;
        const threadMatches = activeThread === 'all' || event.dataset.thread === activeThread;
        event.hidden = !(statusMatches && threadMatches);
      });

      const visible = visibleEvents();
      if (visibleCount) visibleCount.textContent = String(visible.length);
      if (emptyState) emptyState.hidden = visible.length > 0;
      eraButtons.forEach((button) => {
        const hasVisibleEvent = visible.some(
          (event) => event.dataset.era === button.dataset.eraButton,
        );
        button.disabled = !hasVisibleEvent;
      });
      if (eraSelect) {
        Array.from(eraSelect.options).forEach((option) => {
          option.disabled = !visible.some((event) => event.dataset.era === option.value);
        });
      }

      requestAnimationFrame(() => {
        viewport.scrollLeft = 0;
        if (visible[0]) scrollToEvent(visible[0], false);
        updatePosition();
      });

      if (live) live.textContent = `${visible.length} événements affichés.`;
    };

    statusButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeStatus = button.dataset.statusFilter ?? 'all';
        statusButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
      });
    });

    threadFilter?.addEventListener('change', () => {
      activeThread = threadFilter.value;
      applyFilters();
    });

    eraButtons.forEach((button) => {
      button.addEventListener('click', () => {
        stopStory();
        const event = visibleEvents().find((item) => item.dataset.era === button.dataset.eraButton);
        if (event) scrollToEvent(event);
      });
    });

    eraSelect?.addEventListener('change', () => {
      stopStory();
      const event = visibleEvents().find((item) => item.dataset.era === eraSelect.value);
      if (event) scrollToEvent(event);
    });

    const jump = (direction: number) => {
      const visible = visibleEvents();
      if (!visible.length) return;
      const current = closestVisibleIndex();
      const next = Math.max(0, Math.min(visible.length - 1, current + direction));
      scrollToEvent(visible[next]);
    };

    root.querySelector('[data-jump-prev]')?.addEventListener('click', () => {
      stopStory();
      jump(-1);
    });
    root.querySelector('[data-jump-next]')?.addEventListener('click', () => {
      stopStory();
      jump(1);
    });
    root.querySelector('[data-loop-start]')?.addEventListener('click', () => {
      stopStory();
      viewport.scrollTo({ left: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
    });

    const setZoom = (index: number) => {
      const zooms = ['compact', 'normal', 'large'];
      const zoomLabels: Record<string, string> = {
        compact: 'Cartes réduites',
        normal: 'Cartes en taille normale',
        large: 'Cartes agrandies',
      };
      zoomIndex = Math.max(0, Math.min(zooms.length - 1, index));
      const current = visibleEvents()[closestVisibleIndex()];
      root.dataset.zoom = zooms[zoomIndex];
      if (live) live.textContent = zoomLabels[zooms[zoomIndex]];
      requestAnimationFrame(() => {
        if (current) scrollToEvent(current, false);
        updatePosition();
      });
    };

    root.querySelector('[data-zoom-out]')?.addEventListener('click', () => setZoom(zoomIndex - 1));
    root.querySelector('[data-zoom-in]')?.addEventListener('click', () => setZoom(zoomIndex + 1));

    storyButton?.addEventListener('click', () => {
      if (storyTimer) {
        stopStory();
        return;
      }
      const visible = visibleEvents();
      if (!visible.length) return;
      storyButton.setAttribute('aria-pressed', 'true');
      if (storyLabel) storyLabel.textContent = 'Mettre en pause';
      if (storyIcon) storyIcon.textContent = 'Ⅱ';
      let index = closestVisibleIndex();
      if (index >= visible.length - 1) index = -1;
      scrollToEvent(visible[index + 1]);
      // Cadence plus lente pour les personnes sensibles au mouvement.
      const interval = reducedMotion ? 9000 : 4200;
      storyTimer = window.setInterval(() => {
        index += 1;
        if (index >= visible.length - 1) {
          stopStory();
          return;
        }
        scrollToEvent(visible[index + 1]);
      }, interval);
    });

    range.addEventListener('input', () => {
      stopStory();
      viewport.scrollLeft = (Number(range.value) / 1000) * maxScroll();
    });

    viewport.addEventListener('scroll', requestPositionUpdate, { passive: true });
    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || (event.target as Element).closest('button, a, input'))
        return;
      dragging = true;
      dragStartX = event.clientX;
      dragStartScroll = viewport.scrollLeft;
      viewport.setPointerCapture(event.pointerId);
      stopStory();
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      viewport.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
    });
    const stopDragging = () => {
      dragging = false;
    };
    viewport.addEventListener('pointerup', stopDragging);
    viewport.addEventListener('pointercancel', stopDragging);

    // Les flèches fonctionnent dès que le focus est dans la frise (cartes, onglets,
    // filtres), pas seulement sur la zone de défilement. Les contrôles natifs
    // (range, select) gardent leur comportement clavier propre.
    root.addEventListener('keydown', (event) => {
      const target = event.target as Element;
      if (target.closest('input, select, textarea')) return;
      if (event.key === 'ArrowRight') jump(1);
      else if (event.key === 'ArrowLeft') jump(-1);
      else if (event.key === 'Home')
        viewport.scrollTo({ left: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
      else if (event.key === 'End')
        viewport.scrollTo({ left: maxScroll(), behavior: reducedMotion ? 'auto' : 'smooth' });
      else return;
      event.preventDefault();
      stopStory();
    });

    root.querySelectorAll<HTMLElement>('[data-event-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const eventId = button.dataset.eventOpen;
        const template = document.getElementById(
          `timeline-detail-${eventId}`,
        ) as HTMLTemplateElement | null;
        if (!template || !dialog || !dialogContent || !eventId) return;
        stopStory();
        dialogContent.replaceChildren(template.content.cloneNode(true));
        dialog.removeAttribute('aria-label');
        dialog.setAttribute('aria-labelledby', `event-detail-title-${eventId}`);
        activeOpener = button;
        dialog.showModal();
        document.documentElement.classList.add('timeline-dialog-open');
        requestAnimationFrame(() =>
          dialog.querySelector<HTMLElement>('[data-dialog-close]')?.focus(),
        );
      });
    });

    dialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('close', () => {
      document.documentElement.classList.remove('timeline-dialog-open');
      dialog.removeAttribute('aria-labelledby');
      dialog.setAttribute('aria-label', 'Détail de la chronologie');
      activeOpener?.focus();
      activeOpener = null;
    });

    window.addEventListener('resize', requestPositionUpdate, { passive: true });
    updatePosition();
  };

  initialiseTimeline();
  document.addEventListener('astro:page-load', initialiseTimeline);
</script>
