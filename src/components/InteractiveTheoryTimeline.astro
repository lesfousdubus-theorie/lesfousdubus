---
import {
  theoryTimeline,
  timelineEras,
  timelineStatus,
  type TimelineStatus,
} from '../data/theoryTimeline';

const statusOrder: Array<'all' | TimelineStatus> = [
  'all',
  'canon',
  'central',
  'hypothese',
  'projection',
];
---

<section class="timeline-experience" data-timeline-root data-zoom="normal">
  <div class="timeline-intro">
    <div>
      <p class="timeline-kicker">Une histoire qui se lit dans les deux sens</p>
      <h2>De −900 ans jusqu’à la boucle finale</h2>
    </div>
    <button class="present-button" type="button" data-era-target="nika-eveil">
      <span aria-hidden="true">◎</span>
      Revenir au présent
    </button>
  </div>

  <div class="era-nav" aria-label="Aller directement à une époque">
    {
      timelineEras.map((era, index) => (
        <button
          type="button"
          class="era-button"
          data-era-target={theoryTimeline.find((event) => event.era === era.id)?.id}
          data-era={era.id}
          aria-current={index === 0 ? 'step' : undefined}
        >
          <span>{era.label}</span>
          <small>{era.range}</small>
        </button>
      ))
    }
  </div>

  <div class="timeline-toolbar">
    <div class="filter-group" role="group" aria-label="Filtrer les événements">
      {
        statusOrder.map((status) => (
          <button
            type="button"
            class:list={['filter-button', { 'is-active': status === 'all' }]}
            data-filter={status}
            aria-pressed={status === 'all' ? 'true' : 'false'}
          >
            {status === 'all' ? 'Tout voir' : timelineStatus[status].shortLabel}
          </button>
        ))
      }
    </div>

    <div class="view-controls" aria-label="Contrôles de la frise">
      <button type="button" data-zoom-out aria-label="Réduire la frise" title="Réduire">−</button>
      <span class="zoom-label" aria-hidden="true">Zoom</span>
      <button type="button" data-zoom-in aria-label="Agrandir la frise" title="Agrandir">+</button>
      <span class="control-separator" aria-hidden="true"></span>
      <button type="button" data-scroll-prev aria-label="Événements précédents" title="Précédents">
        ←
      </button>
      <button type="button" data-scroll-next aria-label="Événements suivants" title="Suivants">
        →
      </button>
    </div>
  </div>

  <div class="timeline-frame">
    <div class="timeline-sky" aria-hidden="true">
      <span class="orb orb--past"></span>
      <span class="orb orb--future"></span>
      <span class="star star--one"></span>
      <span class="star star--two"></span>
      <span class="star star--three"></span>
    </div>

    <div
      class="timeline-viewport"
      data-timeline-viewport
      tabindex="0"
      role="region"
      aria-label="Frise chronologique interactive. Faites défiler horizontalement ou utilisez les flèches du clavier."
    >
      <div class="timeline-track" data-timeline-track>
        <div class="timeline-rail" aria-hidden="true">
          <span class="rail-light"></span>
        </div>

        {
          theoryTimeline.map((event, index) => (
            <article
              id={`event-${event.id}`}
              class:list={[
                'timeline-event',
                `timeline-event--${index % 2 === 0 ? 'above' : 'below'}`,
              ]}
              data-event={event.id}
              data-era={event.era}
              data-status={event.status}
            >
              <div class="event-connector" aria-hidden="true" />
              <div class="event-marker" aria-hidden="true">
                <span>{event.icon}</span>
              </div>
              <span class="event-date">{event.date}</span>

              <button
                class="event-card"
                type="button"
                data-event-open={event.id}
                aria-label={`${event.date} — ${event.title}. Ouvrir les détails.`}
              >
                <span class:list={['event-status', `event-status--${event.status}`]}>
                  {timelineStatus[event.status].shortLabel}
                </span>
                <strong>{event.title}</strong>
                <span class="event-summary">{event.summary}</span>
                {event.chapter && <small>{event.chapter}</small>}
                <span class="event-more">
                  Explorer l’événement <span aria-hidden="true">↗</span>
                </span>
              </button>
            </article>
          ))
        }

        <div class="loop-gate" aria-hidden="true">
          <span>La fin rejoint le début</span>
          <strong>↺ −800</strong>
        </div>
      </div>
    </div>

    <p class="drag-hint" aria-hidden="true">
      <span>↔</span> Glissez pour voyager dans le temps
    </p>
  </div>

  <div class="timeline-navigator">
    <span class="current-date" data-current-date>{theoryTimeline[0].date}</span>
    <input
      type="range"
      min="0"
      max="1000"
      value="0"
      step="1"
      data-timeline-range
      aria-label="Position dans la frise chronologique"
    />
    <span class="event-count" data-event-count>{theoryTimeline.length} événements</span>
  </div>

  <div class="timeline-legend" aria-label="Niveaux de lecture">
    {
      (
        Object.entries(timelineStatus) as Array<
          [TimelineStatus, (typeof timelineStatus)[TimelineStatus]]
        >
      ).map(([status, meta]) => (
        <span>
          <i class={`legend-dot legend-dot--${status}`} />
          {meta.label}
        </span>
      ))
    }
  </div>

  <p class="timeline-live" data-timeline-live aria-live="polite"></p>
</section>

<dialog class="event-dialog" data-event-dialog aria-labelledby="event-dialog-title">
  <div class="event-dialog__surface">
    <h2 id="event-dialog-title" class="event-dialog__sr-only">
      Détails de l’événement chronologique
    </h2>
    <button
      class="event-dialog__close"
      type="button"
      data-dialog-close
      aria-label="Fermer les détails"
    >
      ×
    </button>
    <div data-dialog-content></div>
  </div>
</dialog>

{
  theoryTimeline.map((event) => (
    <template id={`timeline-detail-${event.id}`}>
      <article class="event-detail">
        <div class="event-detail__meta">
          <span class={`event-detail__status event-detail__status--${event.status}`}>
            {timelineStatus[event.status].label}
          </span>
          {event.chapter && <span>{event.chapter}</span>}
        </div>
        <p class="event-detail__date">{event.date}</p>
        <div class="event-detail__title-row">
          <span class="event-detail__icon" aria-hidden="true">
            {event.icon}
          </span>
          <h3>{event.title}</h3>
        </div>
        <p class="event-detail__lead">{event.summary}</p>
        <p class="event-detail__body">{event.detail}</p>
        <div class="event-detail__links">
          {event.links.map((link) => (
            <a href={link.href}>
              {link.label}
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </article>
    </template>
  ))
}

<style>
  .timeline-experience {
    --event-width: 300px;
    --event-gap: 22px;
    position: relative;
    width: 100%;
    margin: 28px 0 42px;
  }

  .timeline-experience[data-zoom='compact'] {
    --event-width: 250px;
    --event-gap: 14px;
  }

  .timeline-experience[data-zoom='large'] {
    --event-width: 360px;
    --event-gap: 30px;
  }

  .timeline-intro,
  .timeline-toolbar,
  .timeline-navigator {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .timeline-intro {
    margin-bottom: 18px;
  }

  .timeline-kicker {
    margin: 0 0 4px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline-intro h2 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
  }

  .present-button,
  .filter-button,
  .view-controls button,
  .era-button {
    border: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--bg-secondary) 88%, transparent);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .present-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 9px 13px;
    border-radius: var(--border-radius-full);
    color: var(--text-main);
    font-size: 12px;
    font-weight: 750;
    white-space: nowrap;
  }

  .present-button span {
    color: var(--cyan);
    font-size: 18px;
  }

  .present-button:hover,
  .present-button:focus-visible {
    border-color: var(--cyan);
  }

  .era-nav {
    display: grid;
    grid-template-columns: repeat(6, minmax(112px, 1fr));
    gap: 7px;
    margin-bottom: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .era-nav::-webkit-scrollbar {
    display: none;
  }

  .era-button {
    min-height: 54px;
    padding: 8px 10px;
    border-radius: 9px;
    text-align: left;
    white-space: nowrap;
  }

  .era-button span,
  .era-button small {
    display: block;
  }

  .era-button span {
    color: var(--text-main);
    font-size: 11px;
    font-weight: 750;
  }

  .era-button small {
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 9px;
  }

  .era-button:hover,
  .era-button:focus-visible,
  .era-button[aria-current='step'] {
    border-color: color-mix(in srgb, var(--violet-light) 70%, var(--border-color));
    background: color-mix(in srgb, var(--violet) 15%, var(--bg-secondary));
  }

  .timeline-toolbar {
    margin-bottom: 10px;
  }

  .filter-group,
  .view-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .filter-group {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filter-group::-webkit-scrollbar {
    display: none;
  }

  .filter-button {
    min-height: 36px;
    padding: 7px 10px;
    border-radius: var(--border-radius-full);
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  .filter-button.is-active {
    border-color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 12%, var(--bg-secondary));
    color: var(--text-main);
  }

  .view-controls button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 9px;
    color: var(--text-main);
    font-size: 17px;
    font-weight: 800;
  }

  .view-controls button:hover,
  .view-controls button:focus-visible {
    border-color: var(--violet-light);
  }

  .zoom-label {
    color: var(--text-muted);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .control-separator {
    width: 1px;
    height: 22px;
    margin: 0 2px;
    background: var(--border-color);
  }

  .timeline-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--violet) 9%, transparent), transparent 42%),
      var(--bg-secondary);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 5%, transparent);
  }

  .timeline-sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.13;
  }

  .orb--past {
    top: -120px;
    left: -90px;
    background: var(--violet);
  }

  .orb--future {
    right: -110px;
    bottom: -130px;
    background: var(--cyan);
  }

  .star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-main);
    box-shadow: 0 0 8px var(--cyan);
    opacity: 0.25;
  }

  .star--one {
    top: 16%;
    left: 18%;
  }
  .star--two {
    top: 24%;
    right: 31%;
  }
  .star--three {
    bottom: 18%;
    left: 43%;
  }

  .timeline-viewport {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 590px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--violet) transparent;
    touch-action: pan-x pan-y;
    cursor: grab;
  }

  .timeline-viewport:active {
    cursor: grabbing;
  }

  .timeline-viewport:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -3px;
  }

  .timeline-track {
    position: relative;
    display: flex;
    gap: var(--event-gap);
    width: max-content;
    min-width: 100%;
    min-height: 590px;
    padding: 22px 44px;
  }

  .timeline-rail {
    position: absolute;
    top: 50%;
    right: 60px;
    left: 60px;
    height: 4px;
    border-radius: 99px;
    background: linear-gradient(
      90deg,
      var(--violet),
      var(--accent-gold) 33%,
      var(--cyan) 64%,
      var(--violet-light)
    );
    box-shadow: 0 0 22px color-mix(in srgb, var(--cyan) 28%, transparent);
  }

  .rail-light {
    position: absolute;
    inset: -2px auto -2px 0;
    width: 14%;
    border-radius: inherit;
    background: white;
    opacity: 0.32;
    filter: blur(4px);
    animation: rail-travel 8s linear infinite;
  }

  @keyframes rail-travel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(620%);
    }
  }

  .timeline-event {
    position: relative;
    flex: 0 0 var(--event-width);
    min-height: 546px;
    scroll-snap-align: center;
  }

  .timeline-event[hidden] {
    display: none;
  }

  .event-marker {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 3px solid var(--bg-secondary);
    border-radius: 50%;
    background: var(--surface);
    box-shadow:
      0 0 0 2px var(--violet-light),
      0 0 20px color-mix(in srgb, var(--violet-light) 30%, transparent);
    font-size: 18px;
    transform: translate(-50%, -50%);
  }

  .event-date {
    position: absolute;
    z-index: 4;
    top: calc(50% - 15px);
    left: calc(50% + 31px);
    max-width: 150px;
    padding: 5px 8px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-full);
    background: var(--bg-main);
    color: var(--text-main);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.15;
    white-space: nowrap;
  }

  .event-connector {
    position: absolute;
    z-index: 1;
    left: 50%;
    width: 1px;
    height: 38px;
    background: linear-gradient(var(--violet-light), var(--border-color));
  }

  .timeline-event--above .event-connector {
    top: calc(50% - 71px);
  }

  .timeline-event--below .event-connector {
    top: calc(50% + 32px);
    transform: rotate(180deg);
  }

  .event-card {
    position: absolute;
    right: 8px;
    left: 8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 200px;
    padding: 17px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-main) 93%, transparent);
    color: var(--text-main);
    text-align: left;
    box-shadow: 0 14px 32px color-mix(in srgb, var(--shadow-color) 68%, transparent);
    cursor: pointer;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .timeline-event--above .event-card {
    bottom: calc(50% + 58px);
  }

  .timeline-event--below .event-card {
    top: calc(50% + 58px);
  }

  .event-card:hover,
  .event-card:focus-visible {
    border-color: var(--violet-light);
    box-shadow:
      0 18px 40px color-mix(in srgb, var(--shadow-color) 82%, transparent),
      0 0 0 1px color-mix(in srgb, var(--violet-light) 25%, transparent);
    transform: translateY(-4px);
  }

  .event-card:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .event-status {
    display: inline-flex;
    margin-bottom: 10px;
    padding: 3px 7px;
    border: 1px solid currentColor;
    border-radius: var(--border-radius-full);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .event-status--canon,
  .event-detail__status--canon {
    color: var(--cyan);
  }
  .event-status--central,
  .event-detail__status--central {
    color: var(--violet-light);
  }
  .event-status--hypothese,
  .event-detail__status--hypothese {
    color: var(--accent-gold);
  }
  .event-status--projection,
  .event-detail__status--projection {
    color: #f68fd1;
  }

  .event-card strong {
    display: block;
    margin-bottom: 7px;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.25;
  }

  .event-summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 11.5px;
    line-height: 1.48;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .event-card small {
    margin-top: 7px;
    color: var(--text-muted);
    font-size: 9px;
  }

  .event-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: auto;
    padding-top: 10px;
    color: var(--cyan);
    font-size: 10px;
    font-weight: 750;
  }

  .loop-gate {
    position: relative;
    flex: 0 0 190px;
    min-height: 546px;
  }

  .loop-gate::before {
    content: '';
    position: absolute;
    top: calc(50% - 75px);
    left: 28px;
    width: 120px;
    height: 120px;
    border: 3px dashed var(--violet-light);
    border-left-color: transparent;
    border-radius: 50%;
  }

  .loop-gate::after {
    content: '‹';
    position: absolute;
    top: calc(50% + 28px);
    left: 18px;
    color: var(--violet-light);
    font-size: 34px;
  }

  .loop-gate span,
  .loop-gate strong {
    position: absolute;
    left: 16px;
    display: block;
    width: 150px;
    text-align: center;
  }

  .loop-gate span {
    top: calc(50% - 20px);
    color: var(--text-muted);
    font-size: 9px;
    text-transform: uppercase;
  }

  .loop-gate strong {
    top: calc(50% + 1px);
    color: var(--text-main);
    font-size: 14px;
  }

  .drag-hint {
    position: absolute;
    z-index: 4;
    right: 16px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 6px 9px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-full);
    background: color-mix(in srgb, var(--bg-main) 85%, transparent);
    color: var(--text-muted);
    font-size: 9px;
    pointer-events: none;
  }

  .drag-hint span {
    color: var(--cyan);
  }

  .timeline-navigator {
    margin-top: 11px;
  }

  .timeline-navigator input {
    flex: 1;
    height: 4px;
    min-width: 80px;
    accent-color: var(--violet-light);
    cursor: ew-resize;
  }

  .current-date,
  .event-count {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
  }

  .current-date {
    min-width: 92px;
    color: var(--cyan);
  }

  .timeline-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 14px;
    color: var(--text-muted);
    font-size: 9.5px;
  }

  .timeline-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .legend-dot--canon {
    color: var(--cyan);
  }
  .legend-dot--central {
    color: var(--violet-light);
  }
  .legend-dot--hypothese {
    color: var(--accent-gold);
  }
  .legend-dot--projection {
    color: #f68fd1;
  }

  .timeline-live {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .event-dialog {
    width: min(620px, calc(100vw - 28px));
    max-height: min(760px, calc(100dvh - 28px));
    padding: 0;
    overflow: visible;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--bg-secondary);
    color: var(--text-main);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.5);
  }

  .event-dialog::backdrop {
    background: rgba(3, 8, 15, 0.75);
    backdrop-filter: blur(5px);
  }

  :global(html.timeline-dialog-open),
  :global(html.timeline-dialog-open body) {
    overflow: hidden;
  }

  .event-dialog__surface {
    position: relative;
    max-height: min(760px, calc(100dvh - 28px));
    padding: 26px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .event-dialog__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .event-dialog__close {
    position: sticky;
    z-index: 2;
    top: 0;
    float: right;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin: -10px -10px 8px 12px;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-main);
    font-size: 24px;
    cursor: pointer;
  }

  .event-detail__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--text-muted);
    font-size: 10px;
  }

  .event-detail__status {
    padding: 4px 8px;
    border: 1px solid currentColor;
    border-radius: var(--border-radius-full);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .event-detail__date {
    margin: 0 0 7px;
    color: var(--cyan);
    font-size: 12px;
    font-weight: 800;
  }

  .event-detail__title-row {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .event-detail__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border: 1px solid color-mix(in srgb, var(--violet-light) 50%, var(--border-color));
    border-radius: 14px;
    background: color-mix(in srgb, var(--violet) 14%, var(--surface));
    font-size: 23px;
  }

  .event-detail h3 {
    margin: 0;
    font-size: clamp(1.35rem, 4vw, 1.85rem);
    line-height: 1.15;
  }

  .event-detail__lead {
    margin: 18px 0 10px;
    color: var(--text-main);
    font-size: 15px;
    font-weight: 650;
    line-height: 1.55;
  }

  .event-detail__body {
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.7;
  }

  .event-detail__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--border-color);
  }

  .event-detail__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 12px;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 750;
    text-decoration: none;
  }

  .event-detail__links a:hover,
  .event-detail__links a:focus-visible {
    border-color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 8%, transparent);
  }

  @media (max-width: 760px) {
    .timeline-experience {
      --event-width: min(78vw, 286px);
      margin-top: 22px;
    }

    .timeline-experience[data-zoom='compact'] {
      --event-width: min(68vw, 248px);
    }
    .timeline-experience[data-zoom='large'] {
      --event-width: min(86vw, 318px);
    }

    .timeline-intro {
      align-items: flex-start;
    }

    .timeline-intro h2 {
      max-width: 290px;
    }

    .present-button {
      width: 42px;
      min-width: 42px;
      padding: 0;
      justify-content: center;
      font-size: 0;
    }

    .present-button span {
      font-size: 19px;
    }

    .era-nav {
      grid-template-columns: repeat(6, 124px);
      margin-right: -16px;
      padding-right: 16px;
    }

    .timeline-toolbar {
      align-items: flex-end;
    }

    .filter-group {
      margin-right: -4px;
      padding-right: 4px;
    }

    .zoom-label,
    .control-separator,
    [data-zoom-out],
    [data-zoom-in] {
      display: none !important;
    }

    .timeline-viewport,
    .timeline-track {
      min-height: 570px;
    }

    .timeline-track {
      padding-inline: 28px;
    }

    .timeline-event,
    .loop-gate {
      min-height: 526px;
    }

    .event-card {
      min-height: 194px;
      padding: 15px;
    }

    .event-date {
      left: calc(50% + 27px);
      max-width: 120px;
      font-size: 9px;
    }

    .drag-hint {
      right: 10px;
      bottom: 9px;
    }

    .timeline-legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .event-dialog__surface {
      padding: 20px;
    }

    .event-detail__links {
      flex-direction: column;
    }

    .event-detail__links a {
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-light {
      animation: none;
    }

    .event-card,
    .timeline-viewport {
      scroll-behavior: auto !important;
      transition: none;
    }
  }
</style>

<script>
  // @ts-nocheck
  const roots = document.querySelectorAll('[data-timeline-root]');

  roots.forEach((root) => {
    const viewport = root.querySelector('[data-timeline-viewport]');
    const range = root.querySelector('[data-timeline-range]');
    const currentDate = root.querySelector('[data-current-date]');
    const eventCount = root.querySelector('[data-event-count]');
    const live = root.querySelector('[data-timeline-live]');
    const events = [...root.querySelectorAll('[data-event]')];
    const filterButtons = [...root.querySelectorAll('[data-filter]')];
    const eraButtons = [...root.querySelectorAll('[data-era-target]')];
    const dialog = document.querySelector('[data-event-dialog]');
    const dialogContent = dialog?.querySelector('[data-dialog-content]');
    const zoomLevels = ['compact', 'normal', 'large'];
    let zoomIndex = 1;
    let activeOpener = null;
    let frameRequested = false;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartScroll = 0;

    if (!viewport || !range) return;

    const visibleEvents = () => events.filter((event) => !event.hidden);
    const maxScroll = () => Math.max(0, viewport.scrollWidth - viewport.clientWidth);

    const updatePosition = () => {
      frameRequested = false;
      const max = maxScroll();
      range.value = String(max > 0 ? Math.round((viewport.scrollLeft / max) * 1000) : 0);

      const center = viewport.scrollLeft + viewport.clientWidth / 2;
      const visible = visibleEvents();
      const closest = visible.reduce((winner, event) => {
        const eventCenter = event.offsetLeft + event.offsetWidth / 2;
        const distance = Math.abs(eventCenter - center);
        return !winner || distance < winner.distance ? { event, distance } : winner;
      }, null)?.event;

      if (!closest) return;
      const card = closest.querySelector('[data-event-open]');
      const date = closest.querySelector('.event-date')?.textContent?.trim();
      if (date) currentDate.textContent = date;

      events.forEach((event) => event.classList.toggle('is-current', event === closest));
      eraButtons.forEach((button) => {
        const isCurrentEra = button.dataset.era === closest.dataset.era;
        if (button.dataset.era) {
          if (isCurrentEra) button.setAttribute('aria-current', 'step');
          else button.removeAttribute('aria-current');
        }
      });
      card?.setAttribute('data-nearest', 'true');
      events
        .filter((event) => event !== closest)
        .forEach((event) =>
          event.querySelector('[data-event-open]')?.removeAttribute('data-nearest'),
        );
    };

    const requestPositionUpdate = () => {
      if (frameRequested) return;
      frameRequested = true;
      requestAnimationFrame(updatePosition);
    };

    const goToEvent = (id) => {
      const target = root.querySelector(`[data-event="${id}"]`);
      if (!target) return;
      if (target.hidden) {
        filterButtons.find((button) => button.dataset.filter === 'all')?.click();
      }
      const left = target.offsetLeft - (viewport.clientWidth - target.offsetWidth) / 2;
      viewport.scrollTo({ left, behavior: 'smooth' });
    };

    eraButtons.forEach((button) => {
      button.addEventListener('click', () => goToEvent(button.dataset.eraTarget));
    });

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        filterButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        events.forEach((event) => {
          event.hidden = filter !== 'all' && event.dataset.status !== filter;
        });
        const count = visibleEvents().length;
        eventCount.textContent = `${count} événement${count > 1 ? 's' : ''}`;
        live.textContent = `${count} événements affichés.`;
        viewport.scrollTo({ left: 0, behavior: 'smooth' });
        requestPositionUpdate();
      });
    });

    root.querySelector('[data-scroll-prev]')?.addEventListener('click', () => {
      viewport.scrollBy({ left: -viewport.clientWidth * 0.78, behavior: 'smooth' });
    });
    root.querySelector('[data-scroll-next]')?.addEventListener('click', () => {
      viewport.scrollBy({ left: viewport.clientWidth * 0.78, behavior: 'smooth' });
    });

    const setZoom = (nextIndex) => {
      const currentMax = maxScroll();
      const progress = currentMax > 0 ? viewport.scrollLeft / currentMax : 0;
      zoomIndex = Math.max(0, Math.min(zoomLevels.length - 1, nextIndex));
      root.dataset.zoom = zoomLevels[zoomIndex];
      requestAnimationFrame(() => {
        viewport.scrollLeft = maxScroll() * progress;
        updatePosition();
      });
    };

    root.querySelector('[data-zoom-out]')?.addEventListener('click', () => setZoom(zoomIndex - 1));
    root.querySelector('[data-zoom-in]')?.addEventListener('click', () => setZoom(zoomIndex + 1));

    range.addEventListener('input', () => {
      viewport.scrollLeft = (Number(range.value) / 1000) * maxScroll();
    });

    viewport.addEventListener('scroll', requestPositionUpdate, { passive: true });
    viewport.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        const next = viewport.scrollLeft + event.deltaY;
        const canMove = next > 0 && next < maxScroll();
        if (!canMove) return;
        event.preventDefault();
        viewport.scrollLeft = next;
      },
      { passive: false },
    );

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.target.closest('button, a')) return;
      isDragging = true;
      dragStartX = event.clientX;
      dragStartScroll = viewport.scrollLeft;
      viewport.setPointerCapture(event.pointerId);
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!isDragging) return;
      viewport.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
    });
    const stopDragging = () => {
      isDragging = false;
    };
    viewport.addEventListener('pointerup', stopDragging);
    viewport.addEventListener('pointercancel', stopDragging);

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') viewport.scrollBy({ left: 260, behavior: 'smooth' });
      else if (event.key === 'ArrowLeft') viewport.scrollBy({ left: -260, behavior: 'smooth' });
      else if (event.key === 'Home') viewport.scrollTo({ left: 0, behavior: 'smooth' });
      else if (event.key === 'End') viewport.scrollTo({ left: maxScroll(), behavior: 'smooth' });
      else return;
      event.preventDefault();
    });

    root.querySelectorAll('[data-event-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const template = document.getElementById(`timeline-detail-${button.dataset.eventOpen}`);
        if (!template || !dialog || !dialogContent) return;
        dialogContent.replaceChildren(template.content.cloneNode(true));
        activeOpener = button;
        dialog.showModal();
        document.documentElement.classList.add('timeline-dialog-open');
      });
    });

    dialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('close', () => {
      document.documentElement.classList.remove('timeline-dialog-open');
      activeOpener?.focus();
      activeOpener = null;
    });

    updatePosition();
  });
</script>
