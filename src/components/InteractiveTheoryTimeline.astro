---
import {
  theoryTimeline,
  timelineDateCertainty,
  timelineEras,
  timelineMotifs,
  timelineStatus,
  timelineThreads,
  type TimelineStatus,
  type TimelineThread,
} from '../data/theoryTimeline';

const statusOrder: Array<'all' | TimelineStatus> = [
  'all',
  'canon',
  'central',
  'extension',
  'hypothese',
  'projection',
];

const eraFirstEvent = new Map(
  timelineEras.map((era) => [era.id, theoryTimeline.find((event) => event.era === era.id)?.id]),
);

const seenEras = new Set<string>();
---

<section
  class="chronoscope"
  data-timeline-root
  data-zoom="normal"
  aria-keyshortcuts="ArrowLeft ArrowRight Home End"
>
  <div class="chronoscope__topline">
    <div>
      <p class="chronoscope__eyebrow">Chronoscope des Fous du Bus</p>
      <h2>Du passé apparent au futur qui pourrait l’avoir créé</h2>
    </div>
    <button class="story-button" type="button" data-story-toggle aria-pressed="false">
      <span class="story-button__icon" aria-hidden="true">▶</span>
      <span data-story-label>Lire la théorie</span>
    </button>
  </div>

  <div class="paradox-map" aria-label="Schéma permanent du paradoxe chronologique">
    <span><strong>Passé apparent</strong><small>← informations du futur</small></span>
    <i aria-hidden="true">→</i>
    <span><strong>Présent</strong><small>← événements vécus</small></span>
    <i aria-hidden="true">⇢</i>
    <span><strong>Futur projeté</strong><small>← création de la mémoire</small></span>
  </div>

  <nav class="era-strip" aria-label="Aller à une période de la chronologie">
    {
      timelineEras.map((era, index) => (
        <button
          type="button"
          class="era-tab"
          data-era-target={eraFirstEvent.get(era.id)}
          data-era-button={era.id}
          aria-current={index === 0 ? 'true' : undefined}
          title={era.description}
        >
          <span>{era.label}</span>
          <small>{era.range}</small>
        </button>
      ))
    }
  </nav>

  <label class="mobile-era-select">
    <span>Époque</span>
    <select data-era-select aria-label="Aller à une époque de la chronologie">
      {
        timelineEras.map((era) => (
          <option value={era.id}>
            {era.label} · {era.range}
          </option>
        ))
      }
    </select>
  </label>

  <div class="timeline-uncertainties" aria-label="Incertitudes sur l’ordre des événements">
    {
      timelineEras
        .filter((era) => era.note)
        .map((era) => (
          <p>
            <strong>{era.label} :</strong> {era.note}
          </p>
        ))
    }
  </div>

  <div class="control-deck">
    <div class="status-filters" role="group" aria-label="Filtrer par niveau de certitude">
      {
        statusOrder.map((status) => (
          <button
            type="button"
            class:list={['filter-chip', { 'is-active': status === 'all' }]}
            data-status-filter={status}
            aria-pressed={status === 'all' ? 'true' : 'false'}
          >
            {status === 'all' ? 'Toute la frise' : timelineStatus[status].shortLabel}
          </button>
        ))
      }
    </div>

    <div class="control-deck__right">
      <label class="thread-select">
        <span>Fil narratif</span>
        <select data-thread-filter aria-label="Filtrer par fil narratif">
          <option value="all">Tous les fils</option>
          {
            (
              Object.entries(timelineThreads) as Array<
                [TimelineThread, (typeof timelineThreads)[TimelineThread]]
              >
            ).map(([thread, meta]) => <option value={thread}>{meta.label}</option>)
          }
        </select>
      </label>

      <div class="timeline-actions" aria-label="Contrôles de la frise">
        <button type="button" data-jump-prev aria-label="Événement précédent" title="Précédent">
          ←
        </button>
        <button type="button" data-jump-next aria-label="Événement suivant" title="Suivant">
          →
        </button>
        <span class="timeline-actions__separator" aria-hidden="true"></span>
        <button type="button" data-zoom-out aria-label="Réduire les cartes" title="Réduire">
          −
        </button>
        <button type="button" data-zoom-in aria-label="Agrandir les cartes" title="Agrandir">
          +
        </button>
      </div>
    </div>
  </div>

  <div class="timeline-stage">
    <div class="timeline-stage__atmosphere" aria-hidden="true">
      <span class="time-orb time-orb--past"></span>
      <span class="time-orb time-orb--future"></span>
      <span class="time-star time-star--one"></span>
      <span class="time-star time-star--two"></span>
      <span class="time-star time-star--three"></span>
    </div>

    <div
      class="timeline-viewport"
      data-timeline-viewport
      tabindex="0"
      role="region"
      aria-label="Frise chronologique interactive. Faites défiler horizontalement, glissez ou utilisez les flèches du clavier."
    >
      <div class="timeline-track" data-timeline-track>
        <div class="timeline-rail" aria-hidden="true">
          <span></span>
        </div>

        {
          theoryTimeline.map((event, index) => {
            const isEraStart = !seenEras.has(event.era);
            seenEras.add(event.era);
            const era = timelineEras.find((item) => item.id === event.era);

            return (
              <article
                id={`event-${event.id}`}
                class:list={[
                  'timeline-event',
                  `timeline-event--${index % 2 === 0 ? 'above' : 'below'}`,
                  { 'timeline-event--era-start': isEraStart },
                ]}
                data-event={event.id}
                data-era={event.era}
                data-status={event.status}
                data-thread={event.thread}
                data-motif={event.motif}
              >
                {isEraStart && (
                  <span class="era-flag" aria-hidden="true">
                    <strong>{era?.label}</strong>
                    <small>{era?.range}</small>
                  </span>
                )}

                <span class="event-connector" aria-hidden="true" />
                <span class="event-node" aria-hidden="true">
                  <i>{event.icon}</i>
                </span>
                <time class="event-date">
                  <span data-event-date>{event.date}</span>
                  <small>{timelineDateCertainty[event.dateCertainty]}</small>
                </time>

                <button
                  class="event-card"
                  type="button"
                  data-event-open={event.id}
                  aria-label={`${event.date} — ${event.title}. Ouvrir les détails.`}
                >
                  {event.segment ? (
                    <span class="event-card__visual brook-segment">
                      <span class="brook-segment__heading">
                        <strong>{event.segment.label}</strong>
                        <small>{event.segment.range}</small>
                      </span>
                      <span class="brook-segment__stops" aria-label="Étapes du parcours de Brook">
                        {event.segment.stops.map((stop) => (
                          <span>{stop}</span>
                        ))}
                      </span>
                    </span>
                  ) : event.image ? (
                    <span class="event-card__visual">
                      <img
                        src={event.image}
                        alt={event.imageAlt ?? ''}
                        loading="lazy"
                        decoding="async"
                        width="640"
                        height="360"
                      />
                      <span class="event-card__image-shade" />
                    </span>
                  ) : (
                    <span class="event-card__visual event-card__visual--symbol" aria-hidden="true">
                      {event.icon}
                    </span>
                  )}

                  <span class="event-card__body">
                    <span class="event-card__meta">
                      <span class:list={['status-pill', `status-pill--${event.status}`]}>
                        {timelineStatus[event.status].shortLabel}
                      </span>
                      <span>{timelineThreads[event.thread].shortLabel}</span>
                    </span>
                    {event.motif && <span class="motif-pill">≠ {timelineMotifs[event.motif]}</span>}
                    {event.evolution && <span class="evolution-pill">{event.evolution}</span>}
                    <strong>{event.title}</strong>
                    <span class="event-card__summary">{event.summary}</span>
                    <span class="event-card__footer">
                      <small>{event.source}</small>
                      <span aria-hidden="true">↗</span>
                    </span>
                  </span>
                </button>
              </article>
            );
          })
        }

        <aside
          class="time-loop"
          aria-label="Les informations futures pourraient atteindre le passé apparent"
        >
          <span class="time-loop__rings" aria-hidden="true">←</span>
          <p>Transmission de la mémoire</p>
          <strong>Le futur pourrait avoir créé ce passé</strong>
          <button type="button" data-loop-start>Revenir à −900 ans</button>
        </aside>
      </div>
    </div>

    <div class="edge-fade edge-fade--left" aria-hidden="true"></div>
    <div class="edge-fade edge-fade--right" aria-hidden="true"></div>
    <p class="drag-instruction">
      <span aria-hidden="true">↔</span>
      Glissez la frise ou utilisez les flèches
    </p>
    <p class="timeline-empty" data-timeline-empty hidden>
      Aucun événement ne correspond à ces filtres.
    </p>
  </div>

  <div class="timeline-console">
    <div class="timeline-console__current">
      <span data-current-index>01/{theoryTimeline.length}</span>
      <div>
        <small data-current-date>{theoryTimeline[0].date}</small>
        <strong data-current-title>{theoryTimeline[0].title}</strong>
      </div>
    </div>

    <label class="timeline-scrubber">
      <span class="sr-only">Position dans la chronologie</span>
      <input
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        data-timeline-range
        aria-label="Position dans la frise chronologique"
      />
      <span class="timeline-scrubber__ticks" aria-hidden="true"></span>
    </label>

    <div class="timeline-console__count">
      <strong data-visible-count>{theoryTimeline.length}</strong>
      <span>événements visibles</span>
    </div>
  </div>

  <div class="timeline-legend" aria-label="Légende des niveaux de lecture">
    {
      (
        Object.entries(timelineStatus) as Array<
          [TimelineStatus, (typeof timelineStatus)[TimelineStatus]]
        >
      ).map(([status, meta]) => (
        <span>
          <i class={`legend-line legend-line--${status}`} aria-hidden="true" />
          {meta.label}
        </span>
      ))
    }
    <span class="legend-motif"><i aria-hidden="true">≠</i> Imu se trompe d’identité</span>
  </div>

  <div class="date-certainty-key" aria-label="Légende de certitude des dates">
    <strong>Placement :</strong>
    {Object.values(timelineDateCertainty).map((label) => <span>{label}</span>)}
  </div>

  <p class="sr-only" data-timeline-live aria-live="polite"></p>
</section>

<noscript>
  <div class="timeline-nojs">
    <p class="timeline-nojs__note">
      Cette frise est interactive. Voici son contenu complet, lisible sans JavaScript.
    </p>
    {
      theoryTimeline.map((event) => {
        const era = timelineEras.find((item) => item.id === event.era);
        return (
          <article class="timeline-nojs__event">
            <p class="timeline-nojs__meta">
              {event.date} · {timelineDateCertainty[event.dateCertainty]} · {era?.label} ·{' '}
              {timelineStatus[event.status].label} · {timelineThreads[event.thread].label} ·{' '}
              {event.source}
              {event.motif ? ` · ${timelineMotifs[event.motif]}` : ''}
              {event.evolution ? ` · ${event.evolution}` : ''}
            </p>
            <h3>
              {event.icon} {event.title}
            </h3>
            <p>{event.summary}</p>
            <p>{event.detail}</p>
            {event.links.length > 0 && (
              <ul>
                {event.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        );
      })
    }
  </div>
</noscript>

<dialog class="event-dialog" data-event-dialog aria-label="Détail de la chronologie">
  <div class="event-dialog__surface">
    <button
      class="event-dialog__close"
      type="button"
      data-dialog-close
      aria-label="Fermer les détails"
    >
      ×
    </button>
    <div data-dialog-content></div>
  </div>
</dialog>

{
  theoryTimeline.map((event) => (
    <template id={`timeline-detail-${event.id}`}>
      <article class="event-detail">
        {event.image && (
          <figure class="event-detail__visual">
            <img src={event.image} alt={event.imageAlt ?? ''} width="960" height="540" />
          </figure>
        )}
        <div class="event-detail__meta">
          <span class={`status-pill status-pill--${event.status}`}>
            {timelineStatus[event.status].label}
          </span>
          <span>{timelineThreads[event.thread].label}</span>
          <span>{event.source}</span>
          {event.motif && <span>≠ {timelineMotifs[event.motif]}</span>}
          {event.evolution && <span>{event.evolution}</span>}
        </div>
        <p class="event-detail__date">
          {event.date} · {timelineDateCertainty[event.dateCertainty]}
        </p>
        <div class="event-detail__title-row">
          <span aria-hidden="true">{event.icon}</span>
          <h3 id={`event-detail-title-${event.id}`}>{event.title}</h3>
        </div>
        <p class="event-detail__lead">{event.summary}</p>
        <p class="event-detail__body">{event.detail}</p>
        <div class="event-detail__links">
          {event.links.map((link) => (
            <a href={link.href}>
              {link.label}
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </article>
    </template>
  ))
}

<style>
  /* La frise et sa modale restent en thème sombre quel que soit le thème de la
     page : les couleurs de fils et de statuts (rose, or, bleu) sont dessinées
     pour un fond sombre et perdraient leur contraste en thème clair. */
  .chronoscope,
  .event-dialog {
    color-scheme: dark;
    --bg-main: #0e1722;
    --bg-secondary: #13202e;
    --surface: #1c2a3a;
    --violet: #8091cf;
    --violet-light: #9face0;
    --cyan: #5fb9c2;
    --text-main: #f3efe6;
    --text-secondary: #aeb7c2;
    --text-muted: color-mix(in srgb, #aeb7c2 74%, transparent);
    --accent-gold: #e0ab4e;
    --border-color: rgba(243, 239, 230, 0.16);
    --shadow-color: rgba(3, 8, 15, 0.45);
  }

  .chronoscope {
    --card-width: 304px;
    --event-gap: 22px;
    --rail-y: 315px;
    position: relative;
    width: 100%;
    margin: 30px 0 46px;
  }

  .chronoscope[data-zoom='compact'] {
    --card-width: 258px;
    --event-gap: 14px;
  }

  .chronoscope[data-zoom='large'] {
    --card-width: 360px;
    --event-gap: 30px;
  }

  .chronoscope__topline,
  .control-deck,
  .control-deck__right,
  .timeline-actions,
  .timeline-console,
  .timeline-console__current,
  .event-card__meta,
  .event-card__footer,
  .event-detail__meta,
  .event-detail__title-row,
  .event-detail__links,
  .timeline-legend {
    display: flex;
    align-items: center;
  }

  .chronoscope__topline {
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .chronoscope__eyebrow {
    margin: 0 0 4px;
    color: var(--cyan);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .chronoscope__topline h2 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    letter-spacing: -0.025em;
  }

  .paradox-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    padding: 9px 12px;
    border: 1px solid color-mix(in srgb, var(--violet-light) 26%, var(--border-color));
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg-secondary) 93%, transparent);
  }

  .paradox-map span,
  .paradox-map strong,
  .paradox-map small {
    display: block;
  }

  .paradox-map span {
    min-width: 0;
  }

  .paradox-map strong {
    color: var(--text-main);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .paradox-map small {
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 10px;
  }

  .paradox-map i {
    color: var(--accent-gold);
    font-style: normal;
  }

  .story-button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 9px 14px;
    border: 1px solid color-mix(in srgb, var(--cyan) 45%, var(--border-color));
    border-radius: var(--border-radius-full);
    background: color-mix(in srgb, var(--cyan) 9%, var(--bg-secondary));
    color: var(--text-main);
    font: 750 12px/1 var(--font-sans);
    cursor: pointer;
  }

  .story-button__icon {
    color: var(--cyan);
  }

  .story-button[aria-pressed='true'] {
    border-color: var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 12%, var(--bg-secondary));
  }

  .era-strip {
    display: grid;
    grid-template-columns: repeat(8, minmax(126px, 1fr));
    gap: 7px;
    margin-bottom: 10px;
    padding-bottom: 2px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .era-tab {
    min-height: 58px;
    padding: 9px 11px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg-secondary) 90%, transparent);
    color: var(--text-secondary);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }

  .era-tab span,
  .era-tab small {
    display: block;
  }

  .era-tab span {
    color: var(--text-main);
    font-size: 11px;
    font-weight: 780;
  }

  .era-tab small {
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 11px;
  }

  .mobile-era-select {
    display: none;
  }

  .timeline-uncertainties {
    display: grid;
    gap: 5px;
    margin: -1px 0 10px;
    padding: 9px 12px;
    border-left: 2px solid color-mix(in srgb, var(--accent-gold) 70%, transparent);
    background: color-mix(in srgb, var(--accent-gold) 5%, transparent);
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.45;
  }

  .timeline-uncertainties p {
    margin: 0;
  }

  .timeline-uncertainties strong {
    color: var(--text-secondary);
  }

  .era-tab:hover,
  .era-tab:focus-visible,
  .era-tab[aria-current='true'] {
    border-color: color-mix(in srgb, var(--violet-light) 65%, var(--border-color));
    background: color-mix(in srgb, var(--violet) 15%, var(--bg-secondary));
  }

  .control-deck {
    position: sticky;
    z-index: 12;
    top: calc(var(--nav-h) + 8px);
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    padding: 10px;
    border: 1px solid var(--border-color);
    border-radius: 13px;
    background: color-mix(in srgb, var(--bg-secondary) 92%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--shadow-color) 55%, transparent);
  }

  .status-filters {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .status-filters::-webkit-scrollbar {
    display: none;
  }

  .filter-chip {
    min-height: 44px;
    padding: 7px 11px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-full);
    background: var(--bg-main);
    color: var(--text-secondary);
    font: 700 12px/1 var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
  }

  .filter-chip:hover,
  .filter-chip:focus-visible,
  .filter-chip.is-active {
    border-color: var(--cyan);
    color: var(--text-main);
  }

  .filter-chip.is-active {
    background: color-mix(in srgb, var(--cyan) 12%, var(--bg-main));
  }

  .control-deck__right {
    flex: 0 0 auto;
    gap: 8px;
  }

  .thread-select {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .thread-select select {
    min-height: 44px;
    max-width: 178px;
    padding: 6px 30px 6px 10px;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--bg-main);
    color: var(--text-main);
    font: 650 12px/1 var(--font-sans);
  }

  .timeline-actions {
    gap: 5px;
  }

  .timeline-actions button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--bg-main);
    color: var(--text-main);
    font: 800 17px/1 var(--font-sans);
    cursor: pointer;
  }

  .timeline-actions button:hover,
  .timeline-actions button:focus-visible {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .timeline-actions__separator {
    width: 1px;
    height: 22px;
    margin: 0 2px;
    background: var(--border-color);
  }

  .timeline-stage {
    position: relative;
    min-height: 664px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--violet-light) 26%, var(--border-color));
    border-radius: 20px;
    background:
      radial-gradient(
        circle at 10% 16%,
        color-mix(in srgb, var(--cyan) 10%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at 92% 80%,
        color-mix(in srgb, var(--violet) 20%, transparent),
        transparent 30%
      ),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-main) 97%, #09142b), var(--bg-secondary));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 4%, transparent),
      0 16px 46px color-mix(in srgb, var(--shadow-color) 58%, transparent);
  }

  .timeline-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.24;
    background-image: radial-gradient(circle, var(--text-muted) 0.7px, transparent 0.8px);
    background-size: 24px 24px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
    pointer-events: none;
  }

  .timeline-stage__atmosphere,
  .time-orb,
  .time-star {
    position: absolute;
    pointer-events: none;
  }

  .timeline-stage__atmosphere {
    inset: 0;
    overflow: hidden;
  }

  .time-orb {
    border-radius: 50%;
    filter: blur(1px);
  }

  .time-orb--past {
    top: 88px;
    left: 7%;
    width: 92px;
    height: 92px;
    border: 1px solid color-mix(in srgb, var(--cyan) 30%, transparent);
    box-shadow:
      0 0 46px color-mix(in srgb, var(--cyan) 18%, transparent),
      inset 0 0 34px color-mix(in srgb, var(--cyan) 11%, transparent);
  }

  .time-orb--future {
    right: 8%;
    bottom: 80px;
    width: 138px;
    height: 138px;
    border: 1px solid color-mix(in srgb, var(--violet-light) 27%, transparent);
    box-shadow: 0 0 58px color-mix(in srgb, var(--violet) 22%, transparent);
  }

  .time-star {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
    animation: twinkle 3s ease-in-out infinite;
  }

  .time-star--one {
    top: 12%;
    left: 34%;
  }
  .time-star--two {
    top: 28%;
    right: 22%;
    animation-delay: -1.2s;
  }
  .time-star--three {
    bottom: 17%;
    left: 24%;
    animation-delay: -2s;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.6);
    }
  }

  .timeline-viewport {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 620px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-color: color-mix(in srgb, var(--cyan) 46%, var(--border-color)) transparent;
    scrollbar-width: thin;
    touch-action: pan-x pan-y;
    cursor: grab;
  }

  .timeline-viewport:active {
    cursor: grabbing;
  }

  .timeline-viewport:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -4px;
  }

  .timeline-track {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: var(--event-gap);
    width: max-content;
    min-width: 100%;
    height: 620px;
    padding: 0 72px;
  }

  .timeline-rail {
    position: absolute;
    z-index: 0;
    top: var(--rail-y);
    left: 38px;
    right: 38px;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--border-color) 82%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--violet) 24%, transparent);
  }

  .timeline-rail span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--cyan),
      var(--violet-light) 44%,
      var(--accent-gold) 72%,
      #f58ac8
    );
    opacity: 0.7;
  }

  .timeline-event {
    --thread-color: var(--cyan);
    position: relative;
    flex: 0 0 var(--card-width);
    width: var(--card-width);
    height: 620px;
    scroll-snap-align: center;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .timeline-event[data-thread='joyboy'] {
    --thread-color: #f5c35f;
  }
  .timeline-event[data-thread='figures'] {
    --thread-color: #ed86bd;
  }
  .timeline-event[data-thread='armes'] {
    --thread-color: #82b8ff;
  }
  .timeline-event[data-thread='memoire'] {
    --thread-color: var(--violet-light);
  }

  .timeline-event[hidden] {
    display: none;
  }

  .timeline-event.is-current {
    z-index: 2;
  }

  .era-flag {
    position: absolute;
    z-index: 3;
    top: 8px;
    left: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 5px 8px;
    border-left: 2px solid var(--thread-color);
    color: var(--text-main);
    background: color-mix(in srgb, var(--bg-main) 76%, transparent);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .era-flag small {
    color: var(--text-muted);
  }

  .event-connector {
    position: absolute;
    z-index: 0;
    left: 50%;
    width: 2px;
    height: 58px;
    background: linear-gradient(var(--thread-color), transparent);
    opacity: 0.78;
  }

  .timeline-event[data-status='canon'] .event-connector {
    width: 2px;
    background: var(--thread-color);
  }

  .timeline-event[data-status='central'] .event-connector {
    width: 4px;
    background: linear-gradient(var(--thread-color) 70%, transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--thread-color) 46%, transparent);
    opacity: 0.95;
  }

  .timeline-event[data-status='hypothese'] .event-connector {
    width: 2px;
    background: repeating-linear-gradient(
      to bottom,
      var(--thread-color) 0 6px,
      transparent 6px 11px
    );
  }

  .timeline-event[data-status='projection'] .event-connector {
    width: 2px;
    background: linear-gradient(var(--thread-color), transparent);
  }

  .timeline-event[data-status='projection'] .event-connector::before,
  .timeline-event[data-status='projection'] .event-connector::after {
    position: absolute;
    bottom: 0;
    width: 18px;
    height: 1px;
    background: var(--thread-color);
    content: '';
    opacity: 0.7;
  }

  .timeline-event[data-status='projection'] .event-connector::before {
    right: 0;
    transform: rotate(-28deg);
    transform-origin: right;
  }

  .timeline-event[data-status='projection'] .event-connector::after {
    left: 0;
    transform: rotate(28deg);
    transform-origin: left;
  }

  .timeline-event[data-status='hypothese'] .event-node {
    border-style: dashed;
  }

  .timeline-event[data-status='central'] .event-node {
    border-width: 3px;
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--bg-main) 78%, transparent),
      0 0 28px color-mix(in srgb, var(--thread-color) 52%, transparent);
  }

  .timeline-event[data-status='projection'] .event-node {
    outline: 1px solid color-mix(in srgb, var(--thread-color) 52%, transparent);
    outline-offset: 4px;
  }

  .timeline-event--above .event-connector {
    top: 258px;
    transform: rotate(180deg);
  }

  .timeline-event--below .event-connector {
    top: 318px;
  }

  .event-node {
    position: absolute;
    z-index: 3;
    top: calc(var(--rail-y) - 18px);
    left: calc(50% - 18px);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 2px solid var(--thread-color);
    border-radius: 50%;
    background: var(--bg-main);
    color: var(--thread-color);
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--bg-main) 78%, transparent),
      0 0 22px color-mix(in srgb, var(--thread-color) 34%, transparent);
    transition: transform 180ms ease;
  }

  .event-node i {
    font: 800 12px/1 var(--font-sans);
    font-style: normal;
  }

  .timeline-event.is-current .event-node {
    transform: scale(1.17);
    background: color-mix(in srgb, var(--thread-color) 14%, var(--bg-main));
  }

  .event-date {
    position: absolute;
    z-index: 2;
    left: 50%;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 2px;
    color: var(--thread-color);
    font-size: 11px;
    font-style: normal;
    font-weight: 850;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .event-date small {
    color: var(--text-muted);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .timeline-event--above .event-date {
    top: 344px;
    transform: translateX(-50%);
  }

  .timeline-event--below .event-date {
    top: 286px;
    transform: translate(-50%, -100%);
  }

  .event-card {
    position: absolute;
    left: 0;
    width: 100%;
    min-height: 238px;
    padding: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--thread-color) 34%, var(--border-color));
    border-radius: 15px;
    background: color-mix(in srgb, var(--bg-secondary) 96%, transparent);
    color: var(--text-main);
    text-align: left;
    box-shadow: 0 12px 28px color-mix(in srgb, var(--shadow-color) 56%, transparent);
    cursor: pointer;
    transition:
      transform 190ms ease,
      border-color 190ms ease,
      box-shadow 190ms ease;
  }

  .timeline-event--above .event-card {
    bottom: 362px;
  }
  .timeline-event--below .event-card {
    top: 362px;
  }

  .event-card:hover,
  .event-card:focus-visible,
  .timeline-event.is-current .event-card {
    border-color: var(--thread-color);
    box-shadow:
      0 16px 36px color-mix(in srgb, var(--shadow-color) 72%, transparent),
      0 0 24px color-mix(in srgb, var(--thread-color) 16%, transparent);
    transform: translateY(-4px);
  }

  .event-card:focus-visible {
    outline: 2px solid var(--thread-color);
    outline-offset: 3px;
  }

  .event-card__visual {
    position: relative;
    display: block;
    width: 100%;
    height: 112px;
    overflow: hidden;
    background: color-mix(in srgb, var(--thread-color) 10%, var(--bg-main));
  }

  .event-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.04);
    transition:
      transform 300ms ease,
      filter 300ms ease;
  }

  .event-card:hover .event-card__visual img,
  .event-card:focus-visible .event-card__visual img {
    transform: scale(1.045);
    filter: saturate(1) contrast(1.05);
  }

  .event-card__image-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg-secondary), transparent 58%);
  }

  .event-card__visual--symbol {
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--thread-color) 75%, white);
    font: 850 44px/1 var(--font-sans);
    background:
      radial-gradient(
        circle,
        color-mix(in srgb, var(--thread-color) 22%, transparent),
        transparent 56%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--thread-color) 9%, var(--bg-main)),
        var(--bg-main)
      );
  }

  .brook-segment {
    display: flex;
    flex-direction: column;
    gap: 7px;
    height: 112px;
    padding: 9px 10px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--thread-color) 15%, var(--bg-main)),
      var(--bg-main)
    );
  }

  .brook-segment__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    color: var(--text-main);
  }

  .brook-segment__heading strong {
    font-size: 10px;
    text-transform: uppercase;
  }

  .brook-segment__heading small {
    color: var(--thread-color);
    font-size: 9px;
    font-weight: 800;
  }

  .brook-segment__stops {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5px 7px;
  }

  .brook-segment__stops::before {
    position: absolute;
    top: 6px;
    right: 5px;
    left: 5px;
    height: 1px;
    background: color-mix(in srgb, var(--thread-color) 55%, transparent);
    content: '';
  }

  .brook-segment__stops > span {
    position: relative;
    padding-top: 11px;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 7px;
    line-height: 1.15;
    text-align: center;
    text-overflow: ellipsis;
  }

  .brook-segment__stops > span::before {
    position: absolute;
    top: 3px;
    left: calc(50% - 3px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--thread-color);
    box-shadow: 0 0 5px var(--thread-color);
    content: '';
  }

  .event-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 13px 14px 14px;
  }

  .event-card__meta {
    justify-content: space-between;
    gap: 8px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 3px 7px;
    border: 1px solid currentColor;
    border-radius: var(--border-radius-full);
    font-size: 10px;
    font-weight: 850;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-pill--canon {
    color: var(--cyan);
  }
  .status-pill--central {
    color: var(--violet-light);
  }
  .status-pill--extension {
    color: color-mix(in srgb, var(--cyan) 58%, var(--accent-gold));
  }
  .status-pill--hypothese {
    color: var(--accent-gold);
  }
  .status-pill--projection {
    color: #ef86bd;
  }

  .motif-pill,
  .evolution-pill {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 3px 6px;
    border-radius: 5px;
    font-size: 8px;
    font-weight: 800;
    line-height: 1.25;
  }

  .motif-pill {
    border: 1px solid color-mix(in srgb, #ed86bd 48%, var(--border-color));
    background: color-mix(in srgb, #ed86bd 8%, transparent);
    color: #f2a5cf;
  }

  .evolution-pill {
    border-left: 2px solid var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 8%, transparent);
    color: color-mix(in srgb, var(--accent-gold) 88%, white);
  }

  .timeline-event[data-motif='confusion-imu'] .event-card {
    border-left-color: #ed86bd;
    border-left-width: 3px;
  }

  .event-card__body > strong {
    display: -webkit-box;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.27;
    letter-spacing: -0.012em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .event-card__summary {
    display: -webkit-box;
    min-height: 39px;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 11px;
    line-height: 1.42;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .event-card__footer {
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 7px;
    border-top: 1px solid color-mix(in srgb, var(--border-color) 75%, transparent);
    color: var(--text-muted);
  }

  .event-card__footer small {
    display: -webkit-box;
    overflow: hidden;
    font-size: 9px;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .event-card__footer > span {
    color: var(--thread-color);
    font-size: 14px;
  }

  .time-loop {
    position: relative;
    flex: 0 0 286px;
    align-self: center;
    margin: 0 40px 0 24px;
    padding: 28px 22px;
    overflow: hidden;
    border: 1px dashed color-mix(in srgb, #f58ac8 58%, var(--border-color));
    border-radius: 24px;
    background:
      radial-gradient(
        circle at 80% 18%,
        color-mix(in srgb, #f58ac8 18%, transparent),
        transparent 35%
      ),
      color-mix(in srgb, var(--bg-secondary) 94%, transparent);
    text-align: center;
    scroll-snap-align: center;
  }

  .time-loop__rings {
    display: block;
    margin-bottom: 12px;
    color: #f58ac8;
    font-size: 58px;
    line-height: 1;
    text-shadow: 0 0 28px color-mix(in srgb, #f58ac8 40%, transparent);
  }

  .time-loop p {
    margin: 0 0 4px;
    color: #f58ac8;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .time-loop strong {
    display: block;
    margin-bottom: 16px;
    font-size: 17px;
  }

  .time-loop button {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid color-mix(in srgb, #f58ac8 45%, var(--border-color));
    border-radius: var(--border-radius-full);
    background: var(--bg-main);
    color: var(--text-main);
    font: 750 10px/1 var(--font-sans);
    cursor: pointer;
  }

  .edge-fade {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 25px;
    width: 44px;
    pointer-events: none;
  }

  .edge-fade--left {
    left: 0;
    background: linear-gradient(90deg, var(--bg-secondary), transparent);
  }

  .edge-fade--right {
    right: 0;
    background: linear-gradient(-90deg, var(--bg-secondary), transparent);
  }

  .drag-instruction {
    position: absolute;
    z-index: 3;
    right: 16px;
    bottom: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 5px 8px;
    border-radius: var(--border-radius-full);
    background: color-mix(in srgb, var(--bg-main) 82%, transparent);
    color: var(--text-muted);
    font-size: 10px;
    pointer-events: none;
  }

  .timeline-empty {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 24px;
    color: var(--text-secondary);
    font-size: 13px;
    text-align: center;
  }

  .timeline-empty[hidden] {
    display: none;
  }

  .timeline-nojs {
    margin: 30px 0 46px;
    padding: 22px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--bg-secondary);
  }

  .timeline-nojs__note {
    margin: 0 0 18px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .timeline-nojs__event {
    padding: 16px 0;
    border-top: 1px solid var(--border-color);
  }

  .timeline-nojs__event:first-of-type {
    border-top: 0;
  }

  .timeline-nojs__meta {
    margin: 0 0 6px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 750;
  }

  .timeline-nojs__event h3 {
    margin: 0 0 8px;
    font-size: 17px;
  }

  .timeline-nojs__event p {
    margin: 0 0 8px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }

  .timeline-nojs__event ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }

  .timeline-nojs__event li {
    margin-bottom: 4px;
  }

  .timeline-nojs__event a {
    color: var(--cyan);
    text-decoration: none;
  }

  .timeline-console {
    justify-content: space-between;
    gap: 14px;
    margin-top: 10px;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    border-radius: 13px;
    background: var(--bg-secondary);
  }

  .timeline-console__current {
    flex: 0 1 260px;
    min-width: 0;
    gap: 10px;
  }

  .timeline-console__current > span {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    min-width: 44px;
    height: 38px;
    padding: 0 6px;
    border: 1px solid color-mix(in srgb, var(--cyan) 40%, var(--border-color));
    border-radius: 10px;
    color: var(--cyan);
    font: 850 11px/1 var(--font-sans);
    white-space: nowrap;
  }

  .timeline-console__current div {
    min-width: 0;
  }

  .timeline-console__current small,
  .timeline-console__current strong {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline-console__current small {
    margin-bottom: 2px;
    color: var(--cyan);
    font-size: 10px;
    font-weight: 750;
  }

  .timeline-console__current strong {
    font-size: 11px;
  }

  .timeline-scrubber {
    position: relative;
    flex: 1 1 260px;
  }

  .timeline-scrubber input {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 24px;
    margin: 0;
    accent-color: var(--cyan);
    cursor: ew-resize;
  }

  .timeline-scrubber__ticks {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 5px;
    left: 5px;
    height: 7px;
    transform: translateY(-50%);
    opacity: 0.32;
    background: repeating-linear-gradient(90deg, var(--text-muted) 0 1px, transparent 1px 8%);
    pointer-events: none;
  }

  .timeline-console__count {
    flex: 0 0 auto;
    text-align: right;
  }

  .timeline-console__count strong,
  .timeline-console__count span {
    display: block;
  }

  .timeline-console__count strong {
    color: var(--text-main);
    font-size: 16px;
  }

  .timeline-console__count span {
    color: var(--text-muted);
    font-size: 10px;
  }

  .timeline-legend {
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 10px;
  }

  .timeline-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-line {
    width: 20px;
    height: 2px;
    background: currentColor;
    box-shadow: 0 0 5px currentColor;
  }

  .legend-line--canon {
    color: var(--cyan);
  }
  .legend-line--central {
    height: 4px;
    color: var(--violet-light);
  }
