---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="breadcrumb-nav">
  <ol class="breadcrumb-list">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="breadcrumb-item">
            {item.href && !isLast ? (
              <a href={item.href} class="breadcrumb-link">
                {item.label}
              </a>
            ) : (
              <span class="breadcrumb-current" aria-current={isLast ? 'page' : undefined}>
                {item.label}
              </span>
            )}
            {!isLast && (
              <span class="breadcrumb-sep" aria-hidden="true">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb-nav {
    max-width: 100%;
    margin-bottom: var(--space-5);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }
  .breadcrumb-list {
    display: flex;
    width: max-content;
    min-width: 100%;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    white-space: nowrap;
  }
  .breadcrumb-link {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 4px 6px;
    border-radius: var(--border-radius-sm);
  }
  .breadcrumb-link:hover {
    color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 8%, transparent);
  }
  .breadcrumb-link:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  .breadcrumb-current {
    color: var(--text-main);
    font-weight: 500;
  }
  .breadcrumb-sep {
    opacity: 0.4;
    color: var(--text-secondary);
  }

  @media (max-width: 767px) {
    .breadcrumb-link {
      min-height: var(--control-size);
    }
  }
</style>
