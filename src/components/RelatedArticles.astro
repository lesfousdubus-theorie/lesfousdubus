---
import { categoryLabel } from '@utils/labels';

interface Article {
  title: string;
  href: string;
  category: string;
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">Articles liés</h2>
      <div class="related__grid">
        {articles.map((article) => (
          <a href={article.href} class="related__card">
            <span>{categoryLabel(article.category)}</span>
            <strong>{article.title}</strong>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related {
    margin: var(--space-7) 0;
  }

  .related h2 {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-color);
    font-size: 18px;
    font-weight: 600;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-3);
  }

  .related__card {
    display: flex;
    min-height: 104px;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--card-padding);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .related__card:hover {
    border-color: var(--violet);
    background: color-mix(in srgb, var(--bg-secondary) 92%, var(--violet) 8%);
    transform: translateY(-2px);
  }

  .related__card:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .related__card span {
    color: var(--text-secondary);
    font-size: 12.5px;
  }

  .related__card strong {
    color: var(--text-main);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.4;
  }

  .related__card:hover strong {
    color: var(--cyan);
  }

  @media (max-width: 640px) {
    .related {
      margin: var(--space-6) 0;
    }
  }
</style>
