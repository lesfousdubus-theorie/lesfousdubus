---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
---

<nav class="toc">
  <h3 class="toc__title">
    <span class="toc__title-dot"></span>
    Sur cette page
  </h3>
  <ul class="toc__list">
    {
      headings
        .filter((h) => h.depth < 4)
        .map((heading) => (
          <li class={`toc__item ${heading.depth === 3 ? 'toc__item--nested' : ''}`}>
            <a
              href={`#${heading.slug}`}
              class="toc__link"
              data-toc-link
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))
    }
  </ul>
</nav>

<script>
  // Highlight active TOC section on scroll
  (function initTocHighlight() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    if (tocLinks.length === 0) return;

    const headingIds = Array.from(tocLinks)
      .map((link) => link.getAttribute('data-slug'))
      .filter((id): id is string => id !== null);
    const headings = headingIds
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    if (headings.length === 0) return;

    let activeId: string | null = null;

    const setActive = (id: string | null) => {
      if (id === activeId) return;
      activeId = id;
      tocLinks.forEach((link) => {
        link.classList.toggle('toc__link--active', link.getAttribute('data-slug') === id);
      });
    };

    if (reduce || !('IntersectionObserver' in window)) {
      // Fallback: highlight based on scroll position
      const onScroll = () => {
        let current: string | null = null;
        for (const heading of headings) {
          const rect = heading.getBoundingClientRect();
          if (rect.top <= 100) {
            current = heading.id;
          }
        }
        setActive(current);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    } else {
      // IntersectionObserver for smooth highlighting
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: '-10% 0px -60% 0px', threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));
    }
  })();
</script>

<style>
  .toc__title {
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-main);
    margin-bottom: 14px;
    font-weight: 600;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc__title-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gradient-border);
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13.5px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 1px solid var(--border-color);
    padding-left: 12px;
  }

  .toc__item {
    margin: 0;
  }

  .toc__item--nested {
    margin-left: 12px;
  }

  .toc__link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
    padding: 1px 0;
    border-bottom: 1px solid transparent;
  }

  .toc__link:hover {
    color: var(--text-main);
    border-bottom-color: color-mix(in srgb, var(--cyan) 40%, transparent);
  }

  .toc__link--active {
    color: var(--cyan) !important;
    font-weight: 600;
    border-bottom-color: var(--cyan) !important;
  }

  .toc__link:active {
    transform: scale(0.98);
  }
</style>
