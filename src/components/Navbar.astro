---
import { getCollection } from 'astro:content';
import { effectLabel } from '@utils/labels';
import SearchModal from './SearchModal.tsx';

interface SubLink {
  label: string;
  href: string;
}
interface SubGroup {
  title: string;
  links: SubLink[];
}
interface NavItem {
  label: string;
  href: string;
  groups: SubGroup[];
}

const latestChapters = (await getCollection('chapters'))
  .sort((a, b) => b.data.chapter - a.data.chapter)
  .slice(0, 4);

const nav: NavItem[] = [
  {
    label: 'La théorie',
    href: '/theorie',
    groups: [
      {
        title: 'Lire',
        links: [
          { label: 'Résumé de la théorie', href: '/theorie/resume' },
          { label: 'Théorie complète', href: '/theorie/theorie-complete' },
          { label: 'Chronologie', href: '/theorie/chronologie' },
        ],
      },
      {
        title: 'Outils',
        links: [
          { label: 'Carte mentale', href: '/explorer/carte-mentale' },
          { label: 'Lexique essentiel', href: '/aide/glossaire' },
        ],
      },
    ],
  },
  {
    label: 'Dossiers',
    href: '/dossiers',
    groups: [
      {
        title: 'Thématiques',
        links: [
          { label: 'Monde et destinations', href: '/dossiers#monde-destinations' },
          { label: 'Histoire et temporalité', href: '/dossiers#histoire-temporalite' },
          { label: 'Figures principales', href: '/dossiers#figures-principales' },
          { label: 'Armes antiques', href: '/dossiers#armes-antiques' },
          { label: 'Technologies et pouvoirs', href: '/dossiers#technologies-pouvoirs' },
          { label: 'Gouvernement & guerre finale', href: '/dossiers#gouvernement-mondial' },
          { label: 'Peuples, royaumes et témoins', href: '/dossiers#peuples-royaumes' },
          { label: 'Dieux et croyances', href: '/dossiers#dieux-croyances' },
          { label: 'Transmission et mémoire', href: '/dossiers#transmission-memoire' },
        ],
      },
    ],
  },
  {
    label: 'Chapitres',
    href: '/chapitres',
    groups: [
      {
        title: 'Dernières analyses',
        links: latestChapters.map((chapter) => ({
          label: `Chapitre ${chapter.data.chapter} · ${effectLabel(chapter.data.effect)}`,
          href: `/chapitres/${chapter.data.chapter}`,
        })),
      },
      {
        title: 'Tout voir',
        links: [{ label: 'Tous les chapitres', href: '/chapitres' }],
      },
    ],
  },
  {
    label: 'Explorer',
    href: '/explorer',
    groups: [
      {
        title: 'Explorer',
        links: [
          { label: 'Vue d’ensemble', href: '/explorer' },
          { label: 'Carte mentale', href: '/explorer/carte-mentale' },
          { label: 'Chronologie', href: '/theorie/chronologie' },
          { label: 'Graphe des correspondances', href: '/explorer/correspondances' },
          { label: 'Schéma des Ponéglyphes', href: '/explorer/poneglyphes' },
        ],
      },
    ],
  },
];

// Active top-level section, resolved at build time per page
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<nav class="navbar" data-pagefind-ignore>
  <!-- Left: Sidebar toggle button + Brand Logo -->
  <div class="nav-left">
    <button
      id="navbar-sidebar-toggle"
      class="navbar-sidebar-toggle"
      aria-label="Basculer la barre latérale"
      aria-expanded="false"
      title="Réduire / Ouvrir la barre latérale"
    >
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="9" y1="3" x2="9" y2="21"></line>
      </svg>
    </button>

    <a href="/" class="logo">
      <img src="/logo.png" alt="Les Fous du Bus" class="logo-img" width="34" height="34" />
      <span class="logo-text font-bold">Les Fous du Bus</span>
    </a>
  </div>

  <!-- Center: Perfectly Centered Desktop Nav links -->
  <div class="nav-center">
    <div class="nav-links">
      {
        nav.map((item) => (
          <div class="nav-item">
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
              aria-haspopup="true"
              aria-current={isActive(item.href) ? 'true' : undefined}
            >
              {item.label}
              <svg
                class="nav-caret"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </a>
            <div class="nav-dropdown" role="menu">
              {item.groups.map((group) => (
                <div class="nav-dropdown__group">
                  <div class="nav-dropdown__title">{group.title}</div>
                  {group.links.map((link) => (
                    <a href={link.href} class="nav-dropdown__link" role="menuitem">
                      {link.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Right: Actions & Mobile Hamburger -->
  <div class="nav-right">
    <div class="nav-actions">
      <button
        onclick="window.dispatchEvent(new Event('openSearch'))"
        class="search-trigger"
        aria-label="Rechercher"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-label hidden sm:inline">Rechercher…</span>
        <span class="search-shortcut hidden sm:inline">Ctrl K</span>
      </button>

      <button data-theme-toggle class="theme-btn theme-btn--desktop" aria-label="Changer le thème">
        <svg
          class="ico-sun hidden"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line
            x1="12"
            y1="21"
            x2="12"
            y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line
            x1="18.36"
            y1="18.36"
            x2="19.78"
            y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line
            x1="21"
            y1="12"
            x2="23"
            y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line
            x1="18.36"
            y1="5.64"
            x2="19.78"
            y2="4.22"></line></svg
        >
        <svg
          class="ico-moon hidden"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
        >
      </button>
    </div>

    <!-- Mobile: hamburger -->
    <button
      id="mobile-menu-toggle"
      class="icon-btn lg:hidden"
      aria-label="Menu"
      aria-expanded="false"
    >
      <svg
        id="hamburger-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line
          x1="3"
          y1="18"
          x2="21"
          y2="18"></line></svg
      >
      <svg
        id="close-icon"
        class="hidden"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg
      >
    </button>
  </div>
</nav>

<!-- Search modal: MUST live outside <nav> -->
<SearchModal client:idle />
<!-- Mobile drawer is now the single SidebarNav in WikiLayout (no duplicate DOM) -->

<style>
  .navbar {
    height: var(--nav-h);
    min-height: var(--nav-h);
    background-color: var(--bg-main);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 50;
    animation: nav-fade-in 0.4s ease-out;
    box-sizing: border-box;
    width: 100%;
    max-width: 100vw;
    overflow: visible;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 1 auto;
    min-width: 0;
    justify-content: flex-start;
  }

  .logo {
    font-weight: 700;
    font-size: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-main);
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
  }

  .logo-img {
    width: 34px;
    height: 34px;
    object-fit: contain;
    border-radius: 6px;
    flex-shrink: 0;
    transition:
      transform 0.25s ease,
      filter 0.25s ease;
  }

  .logo:hover .logo-img {
    transform: scale(1.08) translateY(-1px);
    filter: drop-shadow(0 0 10px var(--glow-cyan));
  }

  .logo-text {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 12px;
    min-width: 0;
  }

  /* Desktop nav links + dropdowns */
  .nav-links {
    display: none;
    gap: 6px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--text-main);
    background-color: var(--surface);
  }

  .nav-link--active {
    color: var(--cyan);
    font-weight: 600;
  }

  .nav-caret {
    opacity: 0.5;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .nav-item:hover .nav-caret,
  .nav-item:focus-within .nav-caret {
    opacity: 1;
    transform: rotate(180deg);
  }

  /* Dropdown menu */
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 6px);
    margin-top: 6px;
    min-width: 220px;
    background-color: color-mix(in srgb, var(--bg-secondary) 95%, var(--surface));
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 16px 36px color-mix(in srgb, var(--bg-main) 60%, rgba(0, 0, 0, 0.4));
    padding: 12px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    z-index: 60;
  }

  .nav-item:hover .nav-dropdown,
  .nav-item:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .nav-dropdown__title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 4px 8px;
    margin-bottom: 4px;
  }

  .nav-dropdown__link {
    display: block;
    padding: 6px 10px;
    font-size: 13.5px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 6px;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .nav-dropdown__link:hover {
    color: var(--cyan);
    background-color: var(--surface);
    transform: translateX(3px);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-size: 13px;
    color: var(--text-secondary);
    background-color: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    cursor: pointer;
    outline: none !important;
    box-shadow: none !important;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .search-trigger:hover,
  .search-trigger:focus,
  .search-trigger:focus-visible,
  .search-trigger:active {
    color: var(--text-main);
    border-color: var(--border-color) !important;
    background-color: var(--surface);
    outline: none !important;
    outline-offset: 0 !important;
    box-shadow: none !important;
  }

  .search-shortcut {
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: var(--surface);
    border: 1px solid var(--border-color);
  }

  .navbar-sidebar-toggle {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    background-color: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px solid var(--border-color);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .navbar-sidebar-toggle:hover {
    color: var(--text-main);
    border-color: var(--violet);
    background-color: var(--surface);
  }

  .theme-btn,
  .icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    background-color: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px solid var(--border-color);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .theme-btn:hover,
  .icon-btn:hover {
    color: var(--text-main);
    border-color: var(--violet);
    background-color: var(--surface);
  }

  #mobile-menu-toggle {
    display: none;
  }

  @media (max-width: 1023px) {
    /* The hamburger owns mobile navigation; the desktop sidebar toggle would be redundant. */
    .navbar-sidebar-toggle {
      display: none !important;
    }

    #mobile-menu-toggle {
      display: flex;
    }

    .nav-center {
      display: none;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 641px) and (max-width: 1023px) {
    .navbar {
      padding: 0 16px;
      gap: 10px;
    }
    .logo-img {
      width: 32px;
      height: 32px;
    }
    .logo {
      font-size: 15px;
      gap: 8px;
    }
    .nav-right {
      gap: 10px;
    }
  }

  /* Mobile — compact navbar to prevent overflow */
  @media (max-width: 640px) {
    .navbar {
      padding: 0 12px;
      gap: 8px;
      --nav-h: 52px;
      height: var(--nav-h);
      min-height: var(--nav-h);
    }

    .nav-left {
      gap: 8px;
      flex: 1 1 auto;
      min-width: 0;
    }

    .logo {
      gap: 8px;
      font-size: 14px;
    }

    .logo-img {
      width: 28px;
      height: 28px;
    }

    .logo-text {
      font-size: 14px;
      max-width: 118px;
    }

    .nav-right {
      gap: 8px;
    }

    .nav-actions {
      gap: 6px;
    }

    .search-trigger {
      width: 34px;
      height: 34px;
      min-width: 34px;
      padding: 0;
      justify-content: center;
      gap: 0;
      border-radius: 8px;
      font-size: 0;
    }

    .search-trigger svg {
      width: 16px;
      height: 16px;
    }

    .search-label,
    .search-shortcut {
      display: none !important;
    }

    .theme-btn {
      width: 34px;
      height: 34px;
      min-width: 34px;
    }
  }

  @media (max-width: 380px) {
    .logo-text {
      display: none;
    }
    .navbar {
      padding: 0 10px;
    }
  }

  @media (max-width: 320px) {
    .logo-img {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  // Theme toggle logic
  const themeBtns = document.querySelectorAll('[data-theme-toggle]');

  const updateIcons = (theme: string) => {
    document.querySelectorAll('.ico-sun').forEach((el) => {
      if (theme === 'dark') el.classList.remove('hidden');
      else el.classList.add('hidden');
    });
    document.querySelectorAll('.ico-moon').forEach((el) => {
      if (theme === 'light') el.classList.remove('hidden');
      else el.classList.add('hidden');
    });
  };

  const currentTheme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
  updateIcons(currentTheme);

  themeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';

      if (nextTheme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }

      localStorage.setItem('theme', nextTheme);
      updateIcons(nextTheme);
    });
  });

  // Mobile drawer is handled in WikiLayout (single navigation DOM) — no duplicate handling needed here
</script>
