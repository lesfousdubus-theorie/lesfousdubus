---
import { getCollection } from 'astro:content';
import SearchModal from './SearchModal.astro';

interface Props {
  /** Les pages sans sidebar ouvrent une navigation globale dans un dialogue mobile. */
  useGlobalMobileMenu?: boolean;
}
const { useGlobalMobileMenu = false } = Astro.props;

interface SubLink {
  label: string;
  href: string;
}
interface SubGroup {
  title: string;
  links: SubLink[];
}
interface NavItem {
  label: string;
  href: string;
  groups: SubGroup[];
}

const latestChapters = (await getCollection('chapters'))
  .sort((a, b) => b.data.chapter - a.data.chapter)
  .slice(0, 4);

const nav: NavItem[] = [
  {
    label: 'La théorie',
    href: '/theorie',
    groups: [
      {
        title: 'Lire',
        links: [
          { label: 'Résumé de la théorie', href: '/theorie/resume' },
          { label: 'Frise chronologique', href: '/theorie/chronologie' },
          { label: 'Théorie complète', href: '/theorie/theorie-complete' },
        ],
      },
      {
        title: 'Outils',
        links: [
          { label: 'Carte mentale', href: '/explorer/carte-mentale' },
          { label: 'Lexique essentiel', href: '/aide/glossaire' },
        ],
      },
    ],
  },
  {
    label: 'Dossiers',
    href: '/dossiers',
    groups: [
      {
        title: 'Thématiques',
        links: [
          { label: 'Monde et destinations', href: '/dossiers#monde-destinations' },
          { label: 'Histoire et temporalité', href: '/dossiers#histoire-temporalite' },
          { label: 'Figures principales', href: '/dossiers#figures-principales' },
          { label: 'Armes antiques', href: '/dossiers#armes-antiques' },
          { label: 'Technologies et pouvoirs', href: '/dossiers#technologies-pouvoirs' },
          { label: 'Peuples, royaumes et témoins', href: '/dossiers#peuples-royaumes' },
          { label: 'Dieux et croyances', href: '/dossiers#dieux-croyances' },
          { label: 'Transmission et mémoire', href: '/dossiers#transmission-memoire' },
          { label: 'Gouvernement mondial', href: '/dossiers#gouvernement-mondial' },
          { label: 'Guerre finale', href: '/dossiers#guerre-finale' },
        ],
      },
    ],
  },
  {
    label: 'Chapitres',
    href: '/chapitres',
    groups: [
      {
        title: 'Dernières analyses',
        links: latestChapters.map((chapter) => ({
          label: `Chapitre ${chapter.data.chapter}`,
          href: `/chapitres/${chapter.data.chapter}`,
        })),
      },
      {
        title: 'Tout voir',
        links: [{ label: 'Tous les chapitres', href: '/chapitres' }],
      },
    ],
  },
  {
    label: 'Explorer',
    href: '/explorer',
    groups: [
      {
        title: 'Explorer',
        links: [
          { label: 'Vue d’ensemble', href: '/explorer' },
          { label: 'Carte mentale', href: '/explorer/carte-mentale' },
          { label: 'Chronologie', href: '/theorie/chronologie' },
          { label: 'Correspondances interactives', href: '/explorer/correspondances' },
          { label: 'Schéma des Ponéglyphes', href: '/explorer/poneglyphes' },
        ],
      },
    ],
  },
  {
    label: 'Aide',
    href: '/aide',
    groups: [
      {
        title: 'Ressources',
        links: [
          { label: 'Glossaire', href: '/aide/glossaire' },
          { label: 'FAQ', href: '/aide/faq' },
          { label: 'À propos', href: '/aide/a-propos' },
          { label: 'Plan du site', href: '/aide/plan-du-site' },
        ],
      },
    ],
  },
];

// Active top-level section, resolved at build time per page
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
const isExact = (href: string) => pathname.replace(/\/+$/, '') === href.replace(/\/+$/, '');
---

<nav class="navbar" data-pagefind-ignore aria-label="Navigation principale">
  <!-- Left: Brand Logo -->
  <div class="nav-left">
    <a href="/" class="logo">
      <img src="/logo.png" alt="Les Fous du Bus" class="logo-img" width="34" height="34" />
      <span class="logo-text font-bold">Les Fous du Bus</span>
    </a>
  </div>

  <!-- Center: Perfectly Centered Desktop Nav links -->
  <div class="nav-center">
    <div class="nav-links">
      {
        nav.map((item, index) => (
          <div class="nav-item">
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
              aria-current={isExact(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
            <button
              class="nav-menu-trigger"
              type="button"
              aria-label={`Ouvrir le menu ${item.label}`}
              aria-expanded="false"
              aria-controls={`nav-dropdown-${index}`}
            >
              <svg
                class="nav-caret"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div
              id={`nav-dropdown-${index}`}
              class="nav-dropdown"
              role="group"
              aria-label={item.label}
            >
              {item.groups.map((group) => (
                <div class="nav-dropdown__group">
                  <div class="nav-dropdown__title">{group.title}</div>
                  {group.links.map((link) => (
                    <a href={link.href} class="nav-dropdown__link">
                      {link.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Right: Actions & Mobile Hamburger -->
  <div class="nav-right">
    <div class="nav-actions">
      <button
        onclick="window.dispatchEvent(new Event('openSearch'))"
        class="search-trigger"
        aria-label="Rechercher"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-label hidden sm:inline">Rechercher…</span>
        <span class="search-shortcut hidden sm:inline">Ctrl K</span>
      </button>

      <button
        data-theme-toggle
        class="theme-btn theme-btn--desktop"
        aria-label="Activer le thème clair"
      >
        <svg
          class="ico-sun"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line
            x1="12"
            y1="21"
            x2="12"
            y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line
            x1="18.36"
            y1="18.36"
            x2="19.78"
            y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line
            x1="21"
            y1="12"
            x2="23"
            y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line
            x1="18.36"
            y1="5.64"
            x2="19.78"
            y2="4.22"></line></svg
        >
        <svg
          class="ico-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
        >
      </button>
    </div>

    <!-- Sur les hubs, ce bouton ouvre le menu global ; dans un article, la navigation contextuelle. -->
    <button
      id="mobile-menu-toggle"
      class="icon-btn"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls={useGlobalMobileMenu ? 'global-mobile-nav' : 'sidebar-left'}
      data-global-menu-trigger={useGlobalMobileMenu ? true : undefined}
    >
      <svg
        id="hamburger-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line
          x1="3"
          y1="18"
          x2="21"
          y2="18"></line></svg
      >
      <svg
        id="close-icon"
        class="hidden"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg
      >
    </button>
  </div>
</nav>

{
  useGlobalMobileMenu && (
    <dialog id="global-mobile-nav" class="global-mobile-nav" aria-labelledby="global-nav-title">
      <div class="global-mobile-nav__surface">
        <div class="global-mobile-nav__header">
          <div>
            <small>Les Fous du Bus</small>
            <strong id="global-nav-title">Où voulez-vous aller ?</strong>
          </div>
          <button type="button" data-global-menu-close aria-label="Fermer le menu">
            ×
          </button>
        </div>
        <div class="global-mobile-nav__body">
          {nav.map((item) => (
            <section>
              <a class="global-mobile-nav__section" href={item.href}>
                {item.label}
              </a>
              <div>
                {item.groups
                  .flatMap((group) => group.links)
                  .slice(0, 6)
                  .map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
              </div>
            </section>
          ))}
          <a class="global-mobile-nav__help" href="/aide/glossaire">
            Glossaire essentiel
          </a>
        </div>
      </div>
    </dialog>
  )
}

<!-- La recherche vit hors de <nav> et charge Pagefind uniquement à la première requête. -->
<SearchModal />
<!-- Mobile drawer is now the single SidebarNav in WikiLayout (no duplicate DOM) -->

<style>
  .navbar {
    --nav-control-size: 36px;
    height: var(--nav-h);
    min-height: var(--nav-h);
    background-color: color-mix(in srgb, var(--bg-main) 92%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 20px;
    position: sticky;
    top: 0;
    z-index: 60;
    animation: nav-fade-in 0.4s ease-out;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 1 auto;
    min-width: 0;
    justify-content: flex-start;
  }

  .logo {
    display: flex;
    min-height: var(--nav-control-size);
    align-items: center;
    font-weight: 700;
    font-size: 15px;
    gap: 8px;
    text-decoration: none;
    color: var(--text-main);
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
  }

  .logo-img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    border-radius: var(--border-radius-sm);
    flex-shrink: 0;
    transition:
      transform 0.25s ease,
      filter 0.25s ease;
  }

  .logo:hover .logo-img {
    transform: scale(1.08) translateY(-1px);
    filter: drop-shadow(0 0 10px var(--glow-cyan));
  }

  .logo-text {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    letter-spacing: -0.01em;
  }

  .nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 8px;
    min-width: 0;
  }

  /* Desktop nav links + dropdowns */
  .nav-links {
    display: none;
    gap: 2px;
    align-items: center;
    flex-wrap: nowrap;
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    min-height: var(--nav-control-size);
    padding: 5px 30px 5px 10px;
    border-radius: var(--border-radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--text-main);
    background-color: var(--surface);
  }

  .nav-link:active {
    transform: scale(0.96);
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
  }

  .nav-link--active {
    color: var(--cyan);
    font-weight: 600;
  }

  .nav-menu-trigger {
    position: absolute;
    right: 2px;
    display: grid;
    place-items: center;
    width: 28px;
    min-width: 28px;
    min-height: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--border-radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .nav-menu-trigger:hover,
  .nav-menu-trigger:focus-visible {
    background: var(--surface);
    color: var(--text-main);
  }

  .nav-caret {
    opacity: 0.5;
    width: 11px;
    height: 11px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .nav-item:hover .nav-caret,
  .nav-item:focus-within .nav-caret {
    opacity: 1;
    transform: rotate(180deg);
  }

  /* Dropdown menu — flip logic to avoid viewport overflow on edges */
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 6px);
    margin-top: 6px;
    min-width: 220px;
    max-width: min(320px, calc(100vw - 32px));
    background-color: color-mix(in srgb, var(--bg-secondary) 95%, var(--surface));
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 16px 36px color-mix(in srgb, var(--bg-main) 60%, rgba(0, 0, 0, 0.4));
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    z-index: 70;
  }

  /* First nav item aligns left to prevent left overflow, last aligns right */
  .nav-item:first-child .nav-dropdown {
    left: 0;
    transform: translate(0, 6px);
  }
  .nav-item:first-child:hover .nav-dropdown,
  .nav-item:first-child:focus-within .nav-dropdown,
  .nav-item:first-child.nav-item--open .nav-dropdown {
    transform: translate(0, 0);
  }
  .nav-item:last-child .nav-dropdown {
    left: auto;
    right: 0;
    transform: translate(0, 6px);
  }
  .nav-item:last-child:hover .nav-dropdown,
  .nav-item:last-child:focus-within .nav-dropdown,
  .nav-item:last-child.nav-item--open .nav-dropdown {
    transform: translate(0, 0);
  }

  .nav-item:hover .nav-dropdown,
  .nav-item:focus-within .nav-dropdown,
  .nav-item.nav-item--open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .nav-item.nav-item--open .nav-caret {
    opacity: 1;
    transform: rotate(180deg);
  }

  .nav-dropdown__title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 4px 8px;
    margin-bottom: 4px;
  }

  .nav-dropdown__link {
    display: block;
    padding: 7px 10px;
    min-height: 32px;
    font-size: 13px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-dropdown__link:hover {
    color: var(--cyan);
    background-color: var(--surface);
  }

  .nav-dropdown__link:active {
    transform: scale(0.98);
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
  }

  .nav-dropdown__link:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -2px;
  }

  .global-mobile-nav {
    width: min(92vw, 430px);
    max-height: calc(100dvh - 28px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--bg-secondary);
    color: var(--text-main);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.42);
  }

  .global-mobile-nav::backdrop {
    background: rgba(3, 8, 15, 0.68);
  }
  .global-mobile-nav__surface {
    max-height: calc(100dvh - 28px);
    overflow-y: auto;
  }
  .global-mobile-nav__header {
    position: sticky;
    z-index: 2;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }
  .global-mobile-nav__header small,
  .global-mobile-nav__header strong {
    display: block;
  }
  .global-mobile-nav__header small {
    color: var(--cyan);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .global-mobile-nav__header strong {
    margin-top: 2px;
    font-size: 18px;
  }
  .global-mobile-nav__header button {
    width: var(--touch-target);
    min-width: var(--touch-target);
    height: var(--touch-target);
    min-height: var(--touch-target);
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text-main);
    font-size: 25px;
    cursor: pointer;
  }
  .global-mobile-nav__body {
    display: grid;
    gap: 10px;
    padding: 14px;
  }
  .global-mobile-nav__body section {
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-main);
  }
  .global-mobile-nav__section {
    display: flex;
    min-height: var(--touch-target);
    align-items: center;
    color: var(--text-main);
    font-weight: 800;
    text-decoration: none;
  }
  .global-mobile-nav__body section div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 12px;
  }
  .global-mobile-nav__body section div a,
  .global-mobile-nav__help {
    display: flex;
    min-height: var(--touch-target);
    align-items: center;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.35;
    text-decoration: none;
  }
  .global-mobile-nav__body section div a:hover,
  .global-mobile-nav__help:hover {
    color: var(--cyan);
  }
  .global-mobile-nav__help {
    padding: 0 12px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    background: color-mix(in srgb, var(--surface) 48%, transparent);
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 7px;
    height: var(--nav-control-size);
    min-height: var(--nav-control-size);
    padding: 0 8px 0 10px;
    font-size: 12.5px;
    color: var(--text-secondary);
    background: transparent;
    border: 0;
    border-radius: calc(var(--border-radius-md) - 3px);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
    max-width: 220px;
  }

  .search-trigger:hover {
    color: var(--text-main);
    background-color: var(--surface);
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 1px;
    color: var(--text-main);
    background-color: var(--surface);
  }

  .search-trigger:active {
    transform: scale(0.97);
  }

  .search-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
  }

  .search-shortcut {
    font-size: 10.5px;
    padding: 2px 5px;
    border-radius: 4px;
    background-color: var(--bg-main);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 0.02em;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .theme-btn,
  .icon-btn {
    width: var(--nav-control-size);
    min-width: var(--nav-control-size);
    height: var(--nav-control-size);
    min-height: var(--nav-control-size);
    border-radius: calc(var(--border-radius-md) - 3px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    background-color: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px solid var(--border-color);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .theme-btn {
    border-color: transparent;
    background: transparent;
  }

  .theme-btn:hover,
  .icon-btn:hover {
    color: var(--text-main);
    border-color: var(--violet);
    background-color: var(--surface);
  }

  .theme-btn:hover {
    border-color: transparent;
  }

  /* Theme icons — pure CSS initial state, no FOUC */
  .ico-sun,
  .ico-moon {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  html.dark .ico-sun {
    display: flex;
  }
  html.dark .ico-moon {
    display: none;
  }
  html.light .ico-sun {
    display: none;
  }
  html.light .ico-moon {
    display: flex;
  }
  /* JS fallback class .hidden still works */
  .ico-sun.hidden,
  .ico-moon.hidden {
    display: none !important;
  }

  #mobile-menu-toggle {
    display: none;
  }

  /* Pages sans sidebar (404/500) : le hamburger n'a pas de tiroir à ouvrir. */
  #mobile-menu-toggle.mobile-toggle--disabled {
    display: none !important;
  }

  /* Large desktop: roomier nav */
  @media (min-width: 1280px) {
    .navbar {
      padding: 0 28px;
      gap: 16px;
    }
    .nav-link {
      font-size: 14px;
      padding: 6px 24px 6px 12px;
    }
    .nav-links {
      gap: 4px;
    }
    .search-trigger {
      min-width: 180px;
      max-width: 240px;
    }
    .logo {
      font-size: 16px;
      gap: 10px;
    }
    .logo-img {
      width: 32px;
      height: 32px;
    }
  }

  /* Mid desktop — tighten links so they don't collide with search */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .navbar {
      padding: 0 16px;
      gap: 8px;
    }
    .nav-link {
      font-size: 12.5px;
      padding: 5px 20px 5px 6px;
    }
    .search-trigger {
      max-width: 160px;
      padding: 0 8px 0 10px;
    }
    .search-label {
      max-width: 72px;
    }
    .logo-text {
      font-size: 14px;
    }
  }

  @media (max-width: 1023px) {
    #mobile-menu-toggle {
      display: flex;
    }

    .nav-center {
      display: none;
    }

    .navbar {
      padding: 0 14px;
      gap: 10px;
    }

    .nav-left {
      flex: 1 1 auto;
      min-width: 0;
    }

    .nav-right {
      gap: 8px;
    }

    .search-trigger {
      max-width: none;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 641px) and (max-width: 1023px) {
    .logo-img {
      width: 30px;
      height: 30px;
    }
    .logo {
      font-size: 14.5px;
      gap: 8px;
    }
    .search-trigger {
      min-width: 140px;
    }
  }

  /* Mobile — compact, balanced icon row, no overflow */
  @media (max-width: 640px) {
    .navbar {
      --nav-control-size: var(--touch-target);
      padding: 0 12px;
      gap: 8px;
      height: var(--nav-h);
      min-height: var(--nav-h);
    }

    .nav-left {
      gap: 0;
      flex: 1 1 auto;
      min-width: 0;
    }

    .logo {
      gap: 8px;
      font-size: 14px;
    }

    .logo-img {
      width: 28px;
      height: 28px;
    }

    .logo-text {
      font-size: 13.5px;
      max-width: min(42vw, 140px);
    }

    .nav-right {
      gap: 4px;
      flex-shrink: 0;
    }

    .nav-actions {
      gap: 2px;
    }

    /* Icon-only search button on small screens */
    .search-trigger {
      width: var(--nav-control-size);
      height: var(--nav-control-size);
      min-width: var(--nav-control-size);
      max-width: var(--nav-control-size);
      padding: 0;
      justify-content: center;
      gap: 0;
      border-radius: var(--border-radius-sm);
      font-size: 0;
    }

    .search-trigger svg {
      width: 16px;
      height: 16px;
    }

    .search-label,
    .search-shortcut {
      display: none !important;
    }

    .theme-btn,
    .icon-btn {
      width: var(--nav-control-size);
      height: var(--nav-control-size);
      min-width: var(--nav-control-size);
      min-height: var(--nav-control-size);
      border-radius: var(--border-radius-sm);
    }
  }

  @media (max-width: 400px) {
    .logo-text {
      max-width: min(32vw, 108px);
    }
    .navbar {
      padding: 0 10px;
      gap: 5px;
    }
  }

  @media (max-width: 360px) {
    .global-mobile-nav__header {
      padding: 12px;
    }

    .global-mobile-nav__body {
      padding: 10px;
    }

    .global-mobile-nav__body section div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 340px) {
    .logo-text {
      display: none;
    }
    .navbar {
      padding: 0 8px;
    }
    .logo-img {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  // Theme toggle logic
  // Étiquette du raccourci clavier selon la plateforme : ⌘K sur macOS, Ctrl K ailleurs.
  const isMacPlatform = /Mac|iPhone|iPad|iPod/.test(
    (typeof navigator !== 'undefined' && navigator.userAgent) || '',
  );
  if (isMacPlatform) {
    document.querySelectorAll('.search-shortcut').forEach((el) => {
      el.textContent = '⌘ K';
    });
  }

  const themeBtns = document.querySelectorAll('[data-theme-toggle]');

  const updateIcons = (theme: string) => {
    document.querySelectorAll('.ico-sun').forEach((el) => {
      if (theme === 'dark') el.classList.remove('hidden');
      else el.classList.add('hidden');
    });
    document.querySelectorAll('.ico-moon').forEach((el) => {
      if (theme === 'light') el.classList.remove('hidden');
      else el.classList.add('hidden');
    });
    document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
      el.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Activer le thème clair' : 'Activer le thème sombre',
      );
    });
  };

  const currentTheme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
  updateIcons(currentTheme);

  themeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';

      if (nextTheme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }

      // Choix explicite de l'utilisateur : on « épingle » le thème pour qu'il
      // ne soit plus écrasé par les changements du système.
      localStorage.setItem('theme', nextTheme);
      document.documentElement.setAttribute('data-theme-pinned', 'true');
      updateIcons(nextTheme);
    });
  });

  // Mobile drawer is handled in WikiLayout (single navigation DOM) — no duplicate handling needed here

  // Dropdown click support for touch/tablet devices
  // On touch devices, :hover doesn't work for dropdowns, so we toggle on click
  const navItems = document.querySelectorAll<HTMLDivElement>('.nav-item');
  let openDropdown: HTMLDivElement | null = null;

  const closeAllDropdowns = () => {
    navItems.forEach((item) => {
      item.classList.remove('nav-item--open');
      const trigger = item.querySelector('.nav-menu-trigger');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    });
    openDropdown = null;
  };

  navItems.forEach((item) => {
    const navTrigger = item.querySelector<HTMLButtonElement>('.nav-menu-trigger');
    if (!navTrigger) return;

    navTrigger.addEventListener('click', () => {
      const isOpen = item.classList.contains('nav-item--open');
      if (isOpen) {
        closeAllDropdowns();
        return;
      }
      closeAllDropdowns();
      item.classList.add('nav-item--open');
      navTrigger.setAttribute('aria-expanded', 'true');
      openDropdown = item;
    });

    // Synchronise `aria-expanded` quand l'ouverture passe par le survol / le focus
    // (desktop souris), pour que l'état annoncé corresponde à l'état visuel.
    const hoverCapable = window.matchMedia('(hover: hover)').matches;
    const syncHover = (on: boolean) => {
      if (item.classList.contains('nav-item--open')) return; // l'état clic gagne
      navTrigger.setAttribute('aria-expanded', on ? 'true' : 'false');
    };
    if (hoverCapable) {
      item.addEventListener('pointerenter', () => syncHover(true));
      item.addEventListener('pointerleave', () => syncHover(false));
    }
    item.addEventListener('focusin', () => syncHover(true));
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) syncHover(false);
    });
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!openDropdown) return;
    const target = e.target as Node;
    if (!openDropdown.contains(target)) {
      closeAllDropdowns();
    }
  });

  // Keyboard navigation for dropdowns: ArrowDown opens from trigger,
  // ArrowUp/ArrowDown cycle between menuitems, Home/End jump, Escape closes,
  // Tab closes and moves on.
  const focusItem = (item: HTMLAnchorElement | null) => {
    if (item) item.focus();
  };

  const getVisibleItems = (): HTMLAnchorElement[] => {
    if (!openDropdown) return [];
    return Array.from(openDropdown.querySelectorAll<HTMLAnchorElement>('.nav-dropdown__link'));
  };

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.key === 'Escape') {
      if (openDropdown) {
        // Return focus to its trigger
        const trigger = openDropdown.querySelector<HTMLButtonElement>('.nav-menu-trigger');
        closeAllDropdowns();
        trigger?.focus();
      }
      return;
    }

    // ArrowDown on a trigger opens that dropdown and focuses first item
    if (
      e.key === 'ArrowDown' &&
      target.classList.contains('nav-menu-trigger') &&
      target.getAttribute('aria-expanded') !== null
    ) {
      const item = target.closest<HTMLDivElement>('.nav-item');
      if (!item) return;
      e.preventDefault();
      if (item !== openDropdown) {
        closeAllDropdowns();
        item.classList.add('nav-item--open');
        target.setAttribute('aria-expanded', 'true');
        openDropdown = item;
      }
      // Focus first item on next frame (so DOM is visible)
      requestAnimationFrame(() => focusItem(getVisibleItems()[0] ?? null));
      return;
    }

    // ArrowUp/ArrowDown/Home/End within a dropdown
    if (openDropdown && openDropdown.contains(target)) {
      const items = getVisibleItems();
      if (items.length === 0) return;
      const idx = items.indexOf(target as HTMLAnchorElement);

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        focusItem(items[(idx + 1) % items.length] ?? items[0]);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (idx <= 0) {
          // Return to trigger
          const trigger = openDropdown.querySelector<HTMLButtonElement>('.nav-menu-trigger');
          closeAllDropdowns();
          trigger?.focus();
        } else {
          focusItem(items[idx - 1]);
        }
      } else if (e.key === 'Home') {
        e.preventDefault();
        focusItem(items[0]);
      } else if (e.key === 'End') {
        e.preventDefault();
        focusItem(items[items.length - 1]);
      }
    }
  });

  const globalMenu = document.getElementById('global-mobile-nav') as HTMLDialogElement | null;
  const globalMenuTrigger = document.querySelector<HTMLButtonElement>('[data-global-menu-trigger]');
  const globalMenuClose = globalMenu?.querySelector<HTMLButtonElement>('[data-global-menu-close]');

  globalMenuTrigger?.addEventListener('click', () => {
    globalMenu?.showModal();
    globalMenuTrigger.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('global-nav-open');
    requestAnimationFrame(() => globalMenuClose?.focus());
  });

  globalMenuClose?.addEventListener('click', () => globalMenu?.close());
  globalMenu?.addEventListener('click', (event) => {
    if (event.target === globalMenu) globalMenu.close();
  });
  globalMenu?.addEventListener('close', () => {
    document.documentElement.classList.remove('global-nav-open');
    globalMenuTrigger?.setAttribute('aria-expanded', 'false');
    globalMenuTrigger?.focus();
  });
</script>
