---
interface ChapterItem {
  id: string;
  data: {
    chapter: number;
    title: string;
    themes: string[];
    updatedArticles: string[];
    summary?: string;
  };
}

interface Props {
  items: ChapterItem[];
}

const { items } = Astro.props;
---

<section class="mt-8 mb-8" aria-labelledby="chapter-refs-heading">
  <h3
    id="chapter-refs-heading"
    class="font-sans text-sm uppercase tracking-wider text-textSecondary mb-4 border-b border-borderColor pb-2"
  >
    Chapitres clés
  </h3>
  <div class="flex flex-wrap gap-2">
    {
      items.map((item) => (
        <a
          href={`/chapitres/${item.data.chapter}`}
          class="chapter-badge inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium transition-colors"
        >
          <span>Ch. {item.data.chapter}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .chapter-badge {
    min-height: var(--control-size);
    border: 1px solid var(--border-color);
    background: var(--surface);
    color: var(--text-main);
  }

  .chapter-badge:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
</style>
