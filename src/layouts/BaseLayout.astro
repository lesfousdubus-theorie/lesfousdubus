---
import '../styles/global.css';
import BackgroundScene from '@components/BackgroundScene.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  seoTitle?: string;
}

const {
  title,
  description = 'Wiki éditorial consacré à la théorie du Siècle oublié dans One Piece : le passé serait le présent.',
  image,
  type = 'website',
  seoTitle,
} = Astro.props;
// Titre SEO riche (ex: "Joy Boy dans One Piece : identité, indices et théorie") vs H1 court ("Joy Boy")
// Si seoTitle est fourni, on l'utilise tel quel (déjà avec suffixe), sinon fallback historique.
const fullTitle = seoTitle ?? `${title} | Les Fous du Bus`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
// Canonical normalisé : trailing slash pour les routes répertoires (cohérent avec sitemap)
let canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
if (!canonicalUrl.endsWith('/') && !canonicalUrl.split('/').pop()?.includes('.')) {
  canonicalUrl += '/';
}
// Description 140–160c : tronquée si trop longue, conservée telle quelle si fournie
const metaDescription =
  description.length > 160 ? description.slice(0, 157).trimEnd() + '…' : description;
const ogImage = image ? new URL(image, siteUrl).toString() : `${siteUrl}/og-default.png`;
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Les Fous du Bus — Le Siècle oublié est le présent" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Les Fous du Bus" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Les Fous du Bus — Le Siècle oublié est le présent" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- PWA & Theme -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0e1722" />
    <meta name="color-scheme" content="dark light" />

    <!-- SEO extras -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Les Fous du Bus" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="keywords"
      content="One Piece, théorie, Siècle oublié, Void Century, Joy Boy, Luffy, Eiichiro Oda, manga, analyse"
    />

    <!-- AI discoverability -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site summary" />

    <!-- JSON-LD Structured Data — WebSite + Organization (Home) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            name: 'Les Fous du Bus',
            url: siteUrl,
            description: 'Wiki éditorial consacré à la théorie du Siècle oublié dans One Piece',
            inLanguage: 'fr-FR',
            publisher: { '@id': `${siteUrl}/#organization` },
          },
          {
            '@type': 'Organization',
            '@id': `${siteUrl}/#organization`,
            name: 'Les Fous du Bus',
            url: siteUrl,
            logo: {
              '@type': 'ImageObject',
              url: `${siteUrl}/logo.png`,
            },
          },
        ],
      })}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization (inline to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }

      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu</a>
    <BackgroundScene />
    <div class="app">
      <slot />
    </div>

    <script>
      // Scroll-reveal: gently fade/slide content blocks into view.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const REVEAL_SELECTOR = [
        '.card',
        '.article-item',
        '.chapter-banner',
        '.section-title',
        '.ev-card',
        '.meta-row',
        '.content h2',
        '.content h3',
        '.footer',
        '[data-reveal]',
        // Blocks & cards used across index pages
        '.nav-card',
        '.explorer-card',
        '.article-row',
        '.article-link',
        '.chapter-item',
        '.faq-item',
        '.principle',
        '.timeline-content',
        '.empty-state',
        '.placeholder-box',
        '.themes-box',
        '.info-box',
        '.summary-box',
      ].join(', ');

      // Sibling card types revealed with a staggered cascade
      const STAGGER_SELECTOR = [
        '.card',
        '.article-item',
        '.nav-card',
        '.explorer-card',
        '.article-row',
        '.article-link',
        '.chapter-item',
        '.faq-item',
        '.principle',
        '.timeline-content',
        '.ev-card',
      ].join(', ');

      const targets = document.querySelectorAll(REVEAL_SELECTOR);

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        targets.forEach((target) => {
          const el = target as HTMLElement;
          el.classList.add('reveal');
          if (el.matches(STAGGER_SELECTOR) && el.parentElement) {
            const siblings = Array.from(el.parentElement.children).filter((c) =>
              c.matches(STAGGER_SELECTOR),
            );
            const index = siblings.indexOf(el);
            if (index > 0) {
              el.style.transitionDelay = `${Math.min(index, 8) * 55}ms`;
              el.dataset.staggered = 'true';
            }
          }
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.classList.add('is-visible');
                io.unobserve(el);
                if (el.dataset.staggered) {
                  // Clear the delay once revealed so hover transitions stay snappy
                  const wait = Number.parseInt(el.style.transitionDelay || '0', 10) + 700;
                  setTimeout(() => {
                    el.style.transitionDelay = '';
                  }, wait);
                }
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
