---
import '../styles/global.css';
import BackgroundScene from '@components/BackgroundScene.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  seoTitle?: string;
}

const {
  title,
  description = 'Wiki éditorial consacré à la théorie du Siècle oublié dans One Piece : le passé serait le présent.',
  image,
  type = 'website',
  seoTitle,
} = Astro.props;
// Titre SEO riche (ex: "Joy Boy dans One Piece : identité, indices et théorie") vs H1 court ("Joy Boy")
// Si seoTitle est fourni, on l'utilise tel quel (déjà avec suffixe), sinon fallback historique.
const fullTitle = seoTitle ?? `${title} | Les Fous du Bus`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
// Canonical normalisé : trailing slash pour les routes répertoires (cohérent avec sitemap)
let canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
if (!canonicalUrl.endsWith('/') && !canonicalUrl.split('/').pop()?.includes('.')) {
  canonicalUrl += '/';
}
// Description 140–160c : tronquée si trop longue, conservée telle quelle si fournie
const metaDescription =
  description.length > 160 ? description.slice(0, 157).trimEnd() + '…' : description;
const ogImage = image ? new URL(image, siteUrl).toString() : `${siteUrl}/og-default.jpg`;
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Les Fous du Bus — passé apparent, présent vécu, futur projeté" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Les Fous du Bus" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Les Fous du Bus — passé apparent, présent vécu, futur projeté" />

    <!-- Favicon — SVG moderne prioritaire, PNG fallback -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <!-- PWA & Theme -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0e1722" />
    <meta name="color-scheme" content="dark light" />

    <!-- SEO extras -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Les Fous du Bus" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="keywords"
      content="One Piece, théorie, Siècle oublié, Void Century, Joy Boy, Luffy, Eiichiro Oda, manga, analyse"
    />

    <!-- AI discoverability -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Index complet LLM" />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Les Fous du Bus — Flux RSS"
      href="/rss.xml"
    />

    <!-- JSON-LD Structured Data — WebSite + Organization (Home) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            name: 'Les Fous du Bus',
            url: siteUrl,
            description: 'Wiki éditorial consacré à la théorie du Siècle oublié dans One Piece',
            inLanguage: 'fr-FR',
            publisher: { '@id': `${siteUrl}/#organization` },
          },
          {
            '@type': 'Organization',
            '@id': `${siteUrl}/#organization`,
            name: 'Les Fous du Bus',
            url: siteUrl,
            logo: {
              '@type': 'ImageObject',
              url: `${siteUrl}/logo.png`,
            },
          },
        ],
      })}
    />

    <!-- Fonts — self-hosted via @fontsource for perf + privacy (no Google roundtrip) -->

    <!-- Theme initialization (inline to prevent flash)
         On ne « pin » PAS la préférence en localStorage à l'init : tant que
         l'utilisateur n'a pas choisi explicitement (bouton), on suit le système. -->
    <script is:inline>
      (function () {
        var stored = null;
        if (typeof localStorage !== 'undefined') {
          stored = localStorage.getItem('theme');
        }
        var theme = stored;
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
        // Révèle au reste du code si la préférence est « épinglée » (choix explicite).
        document.documentElement.setAttribute('data-theme-pinned', stored ? 'true' : 'false');
      })();
    </script>

    <!-- Listen to OS theme changes in real-time (only when no explicit user preference).
         Ne persiste pas en localStorage : le thème suit le système tant que
         l'utilisateur n'a pas cliqué sur le bouton de bascule. -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined' || !window.matchMedia) return;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var onSystemChange = function (e) {
          // Only auto-switch if the user hasn't pinned a preference (theme button)
          if (document.documentElement.getAttribute('data-theme-pinned') === 'true') return;
          if (localStorage.getItem('theme')) return;
          var newTheme = e.matches ? 'dark' : 'light';
          document.documentElement.classList.remove('dark', 'light');
          document.documentElement.classList.add(newTheme);
          // Update theme toggle icons
          document.querySelectorAll('.ico-sun').forEach(function (el) {
            if (newTheme === 'dark') el.classList.remove('hidden');
            else el.classList.add('hidden');
          });
          document.querySelectorAll('.ico-moon').forEach(function (el) {
            if (newTheme === 'light') el.classList.remove('hidden');
            else el.classList.add('hidden');
          });
        };
        mq.addEventListener('change', onSystemChange);
      })();
    </script>

    <!-- theme-color dynamique : suit le thème actif (chrome navigateur).
         Un MutationObserver sur la classe <html> couvre l'init, le bouton de
         bascule ET les changements OS, sans toucher au reste du code. -->
    <script is:inline>
      (function () {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        var update = function () {
          var light = document.documentElement.classList.contains('light');
          meta.setAttribute('content', light ? '#f8f5ed' : '#0e1722');
        };
        if (typeof MutationObserver === 'function') {
          new MutationObserver(update).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class'],
          });
        }
        update();
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu</a>
    <BackgroundScene />
    <div class="app">
      <slot />
    </div>

    <script>
      // Scroll-reveal: gently fade/slide content blocks into view.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const REVEAL_SELECTOR = [
        '.card',
        '.article-item',
        '.chapter-banner',
        '.section-title',
        '.ev-card',
        '.meta-row',
        '.content h2',
        '.content h3',
        '.footer',
        '[data-reveal]',
        // Blocks & cards used across index pages
        '.nav-card',
        '.explorer-card',
        '.article-row',
        '.article-link',
        '.chapter-item',
        '.faq-item',
        '.principle',
        '.timeline-content',
        '.empty-state',
        '.placeholder-box',
        '.themes-box',
        '.info-box',
        '.summary-box',
      ].join(', ');

      // Sibling card types revealed with a staggered cascade
      const STAGGER_SELECTOR = [
        '.card',
        '.article-item',
        '.nav-card',
        '.explorer-card',
        '.article-row',
        '.article-link',
        '.chapter-item',
        '.faq-item',
        '.principle',
        '.timeline-content',
        '.ev-card',
      ].join(', ');

      const targets = document.querySelectorAll(REVEAL_SELECTOR);

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        targets.forEach((target) => {
          const el = target as HTMLElement;
          el.classList.add('reveal');
          if (el.matches(STAGGER_SELECTOR) && el.parentElement) {
            const siblings = Array.from(el.parentElement.children).filter((c) =>
              c.matches(STAGGER_SELECTOR),
            );
            const index = siblings.indexOf(el);
            if (index > 0) {
              el.style.transitionDelay = `${Math.min(index, 8) * 55}ms`;
              el.dataset.staggered = 'true';
            }
          }
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.classList.add('is-visible');
                io.unobserve(el);
                if (el.dataset.staggered) {
                  // Clear the delay once revealed so hover transitions stay snappy
                  const wait = Number.parseInt(el.style.transitionDelay || '0', 10) + 700;
                  setTimeout(() => {
                    el.style.transitionDelay = '';
                  }, wait);
                }
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
