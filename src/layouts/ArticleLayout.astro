---
import WikiLayout from '@layouts/WikiLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import RelatedArticles from '@components/RelatedArticles.astro';
import ChapterReferences from '@components/ChapterReferences.astro';
import ReadingProgressBar from '@components/ReadingProgressBar.astro';
import BackToTop from '@components/BackToTop.astro';
import ParcoursNav from '@components/ParcoursNav.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';
import { effectLabel, categoryLabel } from '@utils/labels';

const { title, description, currentPath, headings, frontmatter } = Astro.props;
// Image sociale de la page : on privilégie `ogImage` du frontmatter si fourni,
// sinon l'image par défaut.
const socialImagePath = frontmatter.ogImage ?? '/og-default.png';
const socialImage = new URL(socialImagePath, Astro.site).toString();
const seoTitle = frontmatter.seoTitle ?? undefined;

// Fetch related articles from the articles collection
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const currentSlug = currentPath.replace('/theorie/', '');
const relatedArticleEntries = allArticles.filter(
  (a) => frontmatter.related?.includes(a.id) && a.id !== currentSlug,
);
const relatedArticles = relatedArticleEntries.map((entry) => ({
  title: entry.data.title,
  href: `/theorie/${entry.id}`,
  category: entry.data.category,
}));

// Fetch chapter references related to this article.
const chapterEntries = await getCollection('chapters');
const articleChapters = chapterEntries
  .filter((c) => c.data.updatedArticles?.includes(currentSlug))
  .sort((a, b) => b.data.chapter - a.data.chapter);

// Breadcrumb dynamique basé sur le chemin de la page
const generateBreadcrumb = (path: string): Array<{ label: string; href?: string }> => {
  const segments = path.split('/').filter(Boolean);
  const items: Array<{ label: string; href?: string }> = [{ label: 'Accueil', href: '/' }];

  if (segments.length === 0) return items;

  // Pages spéciales avec breadcrumb personnalisé
  if (path.startsWith('/theorie/')) {
    items.push({ label: 'La théorie', href: '/theorie' });
    // Insert category between "La théorie" and the article title
    if (path !== '/theorie' && path !== '/theorie/' && frontmatter.category) {
      const catLabel = categoryLabel(frontmatter.category);
      items.push({ label: catLabel, href: `/dossiers#${frontmatter.category}` });
    }
    if (path !== '/theorie' && path !== '/theorie/') {
      items.push({ label: title });
    }
  } else if (path.startsWith('/dossiers')) {
    items.push({ label: 'Dossiers', href: '/dossiers' });
  } else if (path.startsWith('/chapitres')) {
    items.push({ label: 'Chapitres', href: '/chapitres' });
    if (path !== '/chapitres' && path !== '/chapitres/') {
      items.push({ label: title });
    }
  } else if (path.startsWith('/explorer')) {
    items.push({ label: 'Explorer', href: '/explorer' });
    if (path !== '/explorer' && path !== '/explorer/') {
      items.push({ label: title });
    }
  } else if (path.startsWith('/aide')) {
    items.push({ label: 'Aide', href: '/aide' });
    if (path !== '/aide' && path !== '/aide/') {
      items.push({ label: title });
    }
  } else {
    items.push({ label: title });
  }

  return items;
};

const breadcrumbItems = generateBreadcrumb(currentPath);

// Reading time — improved heuristic: base 150w + 260w per H2 + 120w per H3, /220 wpm
const computeReadingTime = (headings: any[] | undefined, desc?: string): string | null => {
  if (!headings || headings.length === 0) {
    if (desc) {
      const words = desc.trim().split(/\s+/).length;
      const mins = Math.max(1, Math.ceil(words / 220));
      return `${mins} min`;
    }
    return null;
  }
  const h2 = headings.filter((h: any) => h.depth === 2).length;
  const h3 = headings.filter((h: any) => h.depth === 3).length;
  const baseWords = desc ? desc.trim().split(/\s+/).length : 80;
  const estWords = 150 + baseWords + h2 * 260 + h3 * 120;
  const mins = Math.max(2, Math.ceil(estWords / 220));
  return `${mins} min`;
};
const readingTime = computeReadingTime(headings, description);

// JSON-LD for Article — enrichi (headline court = H1, description, section, publisher)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
const canonicalArticleUrl = new URL(
  currentPath.endsWith('/') ? currentPath : currentPath + '/',
  siteUrl,
).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonicalArticleUrl,
  image: socialImage,
  articleSection: frontmatter.category,
  inLanguage: 'fr-FR',
  author: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', siteUrl).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalArticleUrl,
  },
};
---

<WikiLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  image={socialImage}
  type="article"
  currentPath={currentPath}
  headings={headings}
>
  <ReadingProgressBar />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: new URL(item.href ?? currentPath, siteUrl).toString(),
      })),
    })}
  />

  <Breadcrumb items={breadcrumbItems} />

  <article data-pagefind-body>
    <h1 class="article-title">{title}</h1>

    <div class="article-top-meta">
      {
        readingTime && (
          <p class="article-reading-time">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <>
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </>
            </svg>
            Lecture : ~{readingTime}
          </p>
        )
      }
      <button
        id="zen-toggle"
        class="zen-toggle"
        aria-label="Activer le mode lecture zen"
        aria-pressed="false">Mode zen</button
      >
    </div>

    {
      articleChapters.length > 0 && (
        <p class="article-updated-meta">
          Dernière mise à jour de la fiche : chapitre{' '}
          <strong>{articleChapters[0].data.chapter}</strong>
          <span class="article-updated-meta__effect">
            · {effectLabel(articleChapters[0].data.effect)}
          </span>
        </p>
      )
    }

    <div class="content">
      <slot />
    </div>
  </article>

  <ParcoursNav slug={currentSlug} />

  <!-- Article Reading Continuation Navigation -->
  <nav class="article-reading-nav" aria-label="Poursuite de lecture">
    <a href="/theorie" class="btn-read-nav">
      <span>← Sommaire de la théorie</span>
    </a>
  </nav>

  {relatedArticles.length > 0 && <RelatedArticles articles={relatedArticles} />}
  {articleChapters.length > 0 && <ChapterReferences items={articleChapters} />}

  <!-- Social share buttons -->
  <div class="article-share" aria-label="Partager cet article">
    <span class="article-share__label">Partager</span>
    <button
      class="article-share__btn"
      id="share-native-btn"
      aria-label="Partager cet article"
      title="Partager"
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle
          cx="18"
          cy="19"
          r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line
          x1="15.41"
          y1="6.51"
          x2="8.59"
          y2="10.49"></line></svg
      >
    </button>
    <a
      class="article-share__btn"
      href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalArticleUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Partager sur X (Twitter)"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path></svg
      >
    </a>
    <button
      class="article-share__btn"
      id="share-copy-btn"
      aria-label="Copier le lien de l'article"
      title="Copier le lien"
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path
          d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg
      >
    </button>
  </div>

  <BackToTop />
  <Footer />

  <!-- Image Lightbox Modal -->
  <div
    id="image-lightbox"
    class="lightbox-overlay hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Vue agrandie de l'image"
    aria-hidden="true"
  >
    <div class="lightbox-container">
      <img id="lightbox-img" src="" alt="" />
      <button id="lightbox-close" aria-label="Fermer (Échap)">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
          ></line></svg
        >
      </button>
      <button id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Image précédente">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg
        >
      </button>
      <button id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Image suivante">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
      <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>
  </div>

  <script>
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const mainContent = document.getElementById('main-content');

    if (lightbox && lightboxImg) {
      // Ferme le tiroir de navigation mobile s'il était ouvert, afin d'éviter
      // la superposition de deux overlays (tiroir + lightbox).
      const closeMobileNavIfOpen = () => {
        const drawer = document.getElementById('sidebar-left-container');
        if (drawer?.classList.contains('is-mobile-open')) {
          drawer.classList.remove('is-mobile-open');
          document.getElementById('sidebar-mobile-overlay')?.classList.remove('is-open');
          document.documentElement.classList.remove('mobile-nav-open');
          document.body.classList.remove('mobile-nav-open');
          document.documentElement.removeAttribute('data-nav-open');
          document.body.removeAttribute('data-nav-open');
        }
        // Also close TOC drawer if open
        (document.getElementById('toc-drawer') as any)?.classList.remove('is-open');
        document.getElementById('toc-overlay')?.classList.remove('is-open');
      };

      const galleryImgs = Array.from(document.querySelectorAll<HTMLImageElement>('.content img'));
      let currentIndex = -1;

      const setLightboxImage = (index: number) => {
        if (index < 0 || index >= galleryImgs.length) return;
        currentIndex = index;
        const img = galleryImgs[index];
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt || '';
        if (lightboxCaption) {
          lightboxCaption.textContent = img.alt || '';
        }
      };

      const openLightbox = (index: number) => {
        closeMobileNavIfOpen();
        setLightboxImage(index);
        lightbox.classList.remove('hidden');
        lightbox.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('lightbox-open');
        document.body.classList.add('lightbox-open');
        mainContent?.setAttribute('inert', '');
        mainContent?.setAttribute('aria-hidden', 'true');
        // Focus close button after the frame paints
        requestAnimationFrame(() => closeBtn?.focus());
      };

      const closeLightbox = () => {
        lightbox.classList.add('hidden');
        lightbox.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('lightbox-open');
        document.body.classList.remove('lightbox-open');
        mainContent?.removeAttribute('inert');
        mainContent?.removeAttribute('aria-hidden');
        lightboxImg.src = '';
        // Return focus to previously focused thumbnail if possible
        if (currentIndex >= 0) {
          const previouslyFocused = galleryImgs[currentIndex];
          previouslyFocused?.focus();
        }
        currentIndex = -1;
      };

      const prev = () => {
        if (currentIndex < 0) return;
        setLightboxImage((currentIndex - 1 + galleryImgs.length) % galleryImgs.length);
      };
      const next = () => {
        if (currentIndex < 0) return;
        setLightboxImage((currentIndex + 1) % galleryImgs.length);
      };

      galleryImgs.forEach((htmlImg, idx) => {
        htmlImg.style.cursor = 'zoom-in';
        htmlImg.title = 'Cliquer pour agrandir';
        htmlImg.loading = 'lazy';
        // Make image keyboard-focusable for a11y
        htmlImg.tabIndex = 0;
        htmlImg.setAttribute('role', 'button');
        htmlImg.setAttribute(
          'aria-label',
          `Agrandir l'image : ${htmlImg.alt || 'sans description'}`,
        );
        htmlImg.addEventListener('click', () => openLightbox(idx));
        htmlImg.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLightbox(idx);
          }
        });
      });

      closeBtn?.addEventListener('click', closeLightbox);
      prevBtn?.addEventListener('click', prev);
      nextBtn?.addEventListener('click', next);
      // Click on image advances to next (common pattern)
      lightboxImg.addEventListener('click', (e) => {
        e.stopPropagation();
        next();
      });
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      // Focus trap within dialog
      lightbox.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeLightbox();
          return;
        }
        if (!lightbox.classList.contains('hidden')) {
          const focusable = Array.from(
            lightbox.querySelectorAll<HTMLElement>(
              'button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          ).filter((el) => el.offsetParent !== null);
          if (focusable.length === 0) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.key === 'Tab') {
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            prev();
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            next();
          }
        }
      });
    }

    // Share buttons — use native Web Share when available, fallback to copy
    const nativeShareBtn = document.getElementById('share-native-btn');
    const copyBtn = document.getElementById('share-copy-btn');

    const doCopiedFeedback = (btn: HTMLElement) => {
      const originalLabel = btn.getAttribute('aria-label') ?? '';
      btn.setAttribute('aria-label', 'Lien copié !');
      btn.style.color = 'var(--cyan)';
      btn.style.borderColor = 'var(--cyan)';
      setTimeout(() => {
        btn.setAttribute('aria-label', originalLabel);
        btn.style.color = '';
        btn.style.borderColor = '';
      }, 2000);
    };

    const copyLink = async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        return true;
      } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = window.location.href;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          return true;
        } catch {
          window.prompt('Copiez ce lien :', window.location.href);
          return false;
        }
      }
    };

    // Native share (mobile-first)
    if (nativeShareBtn) {
      if (navigator.share) {
        nativeShareBtn.addEventListener('click', async () => {
          try {
            await navigator.share({
              title: document.title,
              text:
                (document.querySelector('meta[name="description"]') as HTMLMetaElement | null)
                  ?.content || '',
              url: window.location.href,
            });
          } catch {
            // User cancelled or failed
          }
        });
      } else {
        // Not supported — hide native share button
        nativeShareBtn.style.display = 'none';
      }
    }

    copyBtn?.addEventListener('click', async () => {
      const ok = await copyLink();
      if (ok && copyBtn) doCopiedFeedback(copyBtn);
    });

    // Zen button wiring is handled by the inline script below

    // Zen mode button (if present in article header later)
    const zenBtn = document.getElementById('zen-toggle');
    if (zenBtn) {
      const updateZenLabel = () => {
        const isZen = document.documentElement.classList.contains('zen-mode');
        zenBtn.textContent = isZen ? 'Quitter zen' : 'Mode zen';
        zenBtn.setAttribute('aria-pressed', String(isZen));
      };
      zenBtn.addEventListener('click', () => {
        (window as any).toggleZenMode?.();
        updateZenLabel();
      });
      updateZenLabel();
    }
  </script>
</WikiLayout>

<style>
  .article-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 12px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* article-lead supprimé : les summaries restent uniquement en meta/SEO et listes */

  .article-reading-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 40px 0 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .btn-read-nav {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    color: var(--text-main);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-read-nav:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-2px);
  }

  .btn-read-nav--highlight {
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
    border-color: color-mix(in srgb, var(--cyan) 30%, transparent);
    color: var(--cyan);
  }

  .article-sources {
    color: var(--text-secondary);
    font-size: 13px;
    margin: -0.8rem 0 1.5rem;
  }

  .article-updated-meta {
    font-size: 13px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-gold);
    border-radius: var(--border-radius);
    padding: 10px 14px;
    margin: -6px 0 0;
  }
  .article-updated-meta strong {
    color: var(--accent-gold);
  }
  .article-updated-meta__effect {
    font-size: 12px;
    color: var(--text-muted);
  }

  .article-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 6px;
  }

  .article-reading-time svg {
    opacity: 0.6;
  }

  .content {
    margin-top: 32px;
    line-height: 1.8;
    font-size: 16px;
  }

  .content :global(h2) {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    position: relative;
    display: block;
  }

  /* Pastilles de statut au niveau des blocs : Canon, Interprétation, Hypothèse.
     Usage dans le markdown : <div class="section-pill section-pill--canon">Canon</div> juste après le H2. */
  .content :global(.section-pill) {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid;
    margin: -6px 0 18px;
  }

  .content :global(.section-pill--canon) {
    color: var(--cyan);
    border-color: color-mix(in srgb, var(--cyan) 40%, transparent);
    background: color-mix(in srgb, var(--cyan) 10%, transparent);
  }

  .content :global(.section-pill--interpretation) {
    color: var(--violet-light);
    border-color: color-mix(in srgb, var(--violet) 40%, transparent);
    background: color-mix(in srgb, var(--violet) 10%, transparent);
  }

  .content :global(.section-pill--hypothese) {
    color: var(--accent-gold);
    border-color: color-mix(in srgb, var(--accent-gold) 40%, transparent);
    background: color-mix(in srgb, var(--accent-gold) 10%, transparent);
  }

  .content :global(h2::before) {
    content: '';
    display: inline-block;
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-border);
    flex-shrink: 0;
    margin-right: 10px;
    vertical-align: middle;
  }

  .content :global(h3) {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .content :global(p) {
    margin-bottom: 1.1rem;
  }

  .content :global(strong) {
    color: var(--text-main);
