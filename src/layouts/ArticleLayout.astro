---
import WikiLayout from '@layouts/WikiLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ArticleMeta from '@components/ArticleMeta.astro';
import RelatedArticles from '@components/RelatedArticles.astro';
import EvidenceSection from '@components/EvidenceSection.astro';
import ChapterReferences from '@components/ChapterReferences.astro';
import ReadingProgressBar from '@components/ReadingProgressBar.astro';
import BackToTop from '@components/BackToTop.astro';
import ParcoursNav from '@components/ParcoursNav.astro';
import RelationMap from '@components/RelationMap.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';

const { title, description, currentPath, headings, frontmatter } = Astro.props;
const lastUpdatedChapter = String(frontmatter.lastUpdatedChapter ?? '?');

// Fetch related articles from the articles collection
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const currentSlug = currentPath.replace('/theorie/', '');
const relatedArticleEntries = allArticles.filter(
  (a) => frontmatter.related?.includes(a.id) && a.id !== currentSlug,
);
const relatedArticles = relatedArticleEntries.map((entry) => ({
  title: entry.data.title,
  href: `/theorie/${entry.id}`,
  category: entry.data.category,
}));

// Fetch evidence related to this article
const evidenceEntries = await getCollection('evidence');
const articleEvidence = evidenceEntries.filter((e) => e.data.articles?.includes(currentSlug));

// Fetch chapter references related to this article
const chapterEntries = await getCollection('chapters');
const articleChapters = chapterEntries.filter((c) => c.data.updatedArticles?.includes(currentSlug));

// Article d'analyse rattaché à une fiche neutre : on affiche explicitement le
// rattachement pour que son titre affirmatif soit lu comme une lecture de la
// théorie, et non comme un fait canonique.
const parentEntry = frontmatter.parent
  ? allArticles.find((a) => a.id === frontmatter.parent)
  : undefined;

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'La théorie', href: '/theorie' },
  ...(parentEntry ? [{ label: parentEntry.data.title, href: `/theorie/${parentEntry.id}` }] : []),
  { label: title },
];

// JSON-LD for Article
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: new URL(currentPath, Astro.site).toString(),
  author: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(currentPath, Astro.site).toString(),
  },
};
---

<WikiLayout title={title} description={description} currentPath={currentPath} headings={headings}>
  <ReadingProgressBar />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <Breadcrumb items={breadcrumbItems} />

  <article data-pagefind-body>
    <h1 class="article-title">{title}</h1>
    {description && <p class="article-lead">{description}</p>}
    <ArticleMeta
      lastUpdatedChapter={lastUpdatedChapter}
      editorialStatus={frontmatter.editorialStatus}
    />



    {
      parentEntry && (
        <aside class="analysis-notice">
          <span class="analysis-notice__tag">Article d’analyse</span>
          <p>
            Ce texte développe une lecture des Fous du Bus et non un fait établi par le manga. Il
            est rattaché à la fiche neutre{' '}
            <a href={`/theorie/${parentEntry.id}`}>{parentEntry.data.title}</a>, qui présente ce que
            l’œuvre montre effectivement.
          </p>
        </aside>
      )
    }

    <div class="content">
      <slot />
    </div>
  </article>

  <ParcoursNav slug={currentSlug} />

  <!-- Article Reading Continuation Navigation -->
  <nav class="article-reading-nav" aria-label="Poursuite de lecture">
    <a href="/theorie" class="btn-read-nav">
      <span>← Sommaire de la théorie</span>
    </a>
    <a href="/verifier" class="btn-read-nav btn-read-nav--highlight">
      <span>🧩 Méthodes de vérification →</span>
    </a>
  </nav>

  {articleEvidence.length > 0 && <EvidenceSection items={articleEvidence} />}
  {articleChapters.length > 0 && <ChapterReferences items={articleChapters} />}

  <BackToTop />
  <Footer />

  <!-- Image Lightbox Modal -->
  <div id="image-lightbox" class="lightbox-overlay hidden" aria-hidden="true">
    <div class="lightbox-container">
      <img id="lightbox-img" src="" alt="" />
      <button id="lightbox-close" aria-label="Fermer (Échap)">✕</button>
    </div>
  </div>

  <script>
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('lightbox-close');

    if (lightbox && lightboxImg) {
      const openLightbox = (src: string, alt: string) => {
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightbox.classList.remove('hidden');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const closeLightbox = () => {
        lightbox.classList.add('hidden');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        lightboxImg.src = '';
      };

      document.querySelectorAll('.content img').forEach((img) => {
        const htmlImg = img as HTMLImageElement;
        htmlImg.style.cursor = 'zoom-in';
        htmlImg.title = 'Cliquer pour agrandir';
        htmlImg.addEventListener('click', () => {
          openLightbox(htmlImg.src, htmlImg.alt);
        });
      });

      closeBtn?.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
          closeLightbox();
        }
      });
    }
  </script>
</WikiLayout>

<style>
  .analysis-notice {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 20px 0 28px;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--violet) 30%, transparent);
    background: color-mix(in srgb, var(--violet) 7%, transparent);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .analysis-notice__tag {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--violet-light);
  }

  .analysis-notice p {
    margin: 0;
  }

  .analysis-notice a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 12px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .article-lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 8px;
  }

  .article-reading-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 40px 0 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .btn-read-nav {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    color: var(--text-main);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-read-nav:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-2px);
  }

  .btn-read-nav--highlight {
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
    border-color: color-mix(in srgb, var(--cyan) 30%, transparent);
    color: var(--cyan);
  }

  .article-sources {
    color: var(--text-secondary);
    font-size: 13px;
    margin: -0.8rem 0 1.5rem;
  }

  .content {
    margin-top: 32px;
    line-height: 1.8;
    font-size: 16px;
  }

  .content :global(h2) {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .content :global(h2::before) {
    content: '';
    display: inline-block;
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-border);
    flex-shrink: 0;
  }

  .content :global(h3) {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .content :global(p) {
    margin-bottom: 1.1rem;
  }

  .content :global(strong) {
    color: var(--text-main);
    font-weight: 600;
  }

  .content :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--cyan) 30%, transparent);
    transition: text-decoration-color 0.2s ease;
  }

  .content :global(a:hover) {
    text-decoration-color: var(--cyan);
  }

  .content :global(img) {
    border-radius: 10px;
    margin: 1.5rem auto;
    border: 1px solid var(--border-color);
    max-height: 450px;
    width: auto;
    object-fit: contain;
    display: block;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--violet);
    padding: 12px 16px;
    margin: 1.5rem 0;
    color: var(--text-secondary);
    font-style: italic;
    background: color-mix(in srgb, var(--violet) 5%, transparent);
    border-radius: 0 8px 8px 0;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }

  .content :global(li) {
    margin-bottom: 0.35rem;
  }

  .content :global(li::marker) {
    color: var(--violet-light);
  }

  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 14px;
    overflow-x: auto;
    display: block;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .content :global(th),
  .content :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--border-color);
    text-align: left;
  }

  .content :global(th) {
    background-color: var(--surface);
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .content :global(hr) {
    border: none;
    height: 1px;
    background: var(--gradient-border);
    margin: 2rem 0;
    opacity: 0.4;
  }

  .content :global(code) {
    background: var(--surface);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  @media (max-width: 480px) {
    .content {
      margin-top: 24px;
      font-size: 15px;
    }
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .lightbox-overlay.hidden {
    display: none;
    opacity: 0;
    pointer-events: none;
  }

  .lightbox-container {
    position: relative;
    max-width: 92vw;
    max-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-container img {
    max-width: 90vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.9);
    border: 1px solid var(--border-color);
  }

  #lightbox-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  #lightbox-close:hover {
    background: var(--violet);
    color: white;
    transform: scale(1.1);
  }
</style>
