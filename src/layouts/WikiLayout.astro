---
import BaseLayout from '@layouts/BaseLayout.astro';
import SidebarNav from '@components/SidebarNav.astro';
import SidebarToc from '@components/SidebarToc.astro';
import Navbar from '@components/Navbar.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  currentPath: string;
  headings?: Heading[];
  image?: string;
  type?: 'website' | 'article';
  seoTitle?: string;
}

const { title, description, currentPath, headings, image, type, seoTitle } = Astro.props;

// Pages without headings must not reserve an empty 240px gutter
// or show a "Sommaire" drawer with no entries.
const hasToc = !!(headings && headings.length > 0);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
const isCollectionPage = ['/theorie', '/dossiers', '/chapitres', '/explorer', '/aide'].some(
  (p) => currentPath === p || currentPath === p + '/',
);
const canonicalWikiUrl = new URL(
  currentPath.endsWith('/') ? currentPath : currentPath + '/',
  siteUrl,
).toString();
---

<BaseLayout title={title} description={description} image={image} type={type} seoTitle={seoTitle}>
  <script is:inline>
    (function () {
      const collapsed = localStorage.getItem('sidebar-left-collapsed') === 'true';
      if (collapsed) {
        document.documentElement.classList.add('sidebar-left-collapsed');
      }
      const storedWidth = localStorage.getItem('sidebar-left-width');
      if (storedWidth) {
        // The grid gutter keeps its width while the sidebar is visually hidden,
        // so restoring it here prevents the reading column from jumping.
        document.documentElement.style.setProperty('--sidebar-left-width', storedWidth);
      }
    })();
  </script>

  {
    isCollectionPage && (
      <>
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'CollectionPage',
            name: title,
            description: description,
            url: canonicalWikiUrl,
            inLanguage: 'fr-FR',
            isPartOf: { '@id': `${siteUrl}/#website` },
          })}
        />
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
              { '@type': 'ListItem', position: 2, name: title, item: canonicalWikiUrl },
            ],
          })}
        />
      </>
    )
  }

  {/* Article JSON-LD for theory pages */}
  {
    !isCollectionPage && currentPath.startsWith('/theorie/') && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title,
          description: description,
          url: canonicalWikiUrl,
          author: { '@type': 'Organization', name: 'Les Fous du Bus' },
          publisher: { '@id': `${siteUrl}/#organization` },
          inLanguage: 'fr-FR',
        })}
      />
    )
  }

  <Navbar />

  <!-- Mobile overlay — unique navigation DOM, affiché uniquement sur mobile quand le tiroir est ouvert -->
  <div id="sidebar-mobile-overlay" class="sidebar-mobile-overlay" aria-hidden="true"></div>

  <div class:list={['layout', { 'layout--no-toc': !hasToc }]}>
    <div class="sidebar-left-container" id="sidebar-left-container">
      <aside class="sidebar sidebar-left" id="sidebar-left" aria-label="Navigation des articles">
        <SidebarNav currentPath={currentPath} />
      </aside>

      <!-- Vertical Resizer Handle for mouse drag width adjustment -->
      <div
        id="sidebar-resizer"
        class="sidebar-resizer"
        title="Glisser pour redimensionner la barre latérale"
        aria-label="Redimensionner la barre latérale"
      >
      </div>
    </div>

    <main class="main-content" id="main-content">
      <slot />
    </main>

    {
      hasToc && (
        <aside class="sidebar sidebar-right" aria-label="Table des matières">
          <SidebarToc headings={headings} />
        </aside>
      )
    }
  </div>

  {/* Floating TOC button for tablet/mobile (only when a TOC exists) */}
</BaseLayout>

<style>
  /* Prevent any horizontal scroll caused by off-screen drawer or long words.
     Prefer 100% over 100vw — 100vw includes the classic scrollbar width and
     is a frequent source of 1-axis "phantom" slide bars on mobile. */
  :global(html),
  :global(body) {
    overflow-x: clip;
    max-width: 100%;
  }

  .layout {
    display: grid;
    grid-template-columns:
      var(--sidebar-left-width, 260px)
      minmax(0, 1fr)
      var(--sidebar-left-width, 260px);
    flex: 1;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    min-width: 0;
  }

  .layout--no-toc {
    grid-template-columns: var(--sidebar-left-width, 260px) minmax(0, 1fr);
  }

  .sidebar-left-container {
    position: relative;
    width: var(--sidebar-left-width, 260px);
    min-width: 0;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    overflow: hidden;
  }

  /* Keep the grid gutter when the sidebar is hidden. The reading column must
     retain its position instead of recentering into the newly freed space. */
  .sidebar-left-container.collapsed,
  :global(.sidebar-left-collapsed) .sidebar-left-container {
    width: var(--sidebar-left-width, 260px);
  }

  /* Header inside sidebar containing title & collapse button */
  .sidebar-left-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .sidebar-left-title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sidebar-collapse-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sidebar-collapse-btn:hover {
    background: var(--surface);
    color: var(--cyan);
    border-color: var(--cyan);
    transform: scale(1.08);
  }

  /* Expand button visible on left margin when collapsed */
  .sidebar-expand-btn {
    position: fixed;
    top: calc(var(--nav-h) + 16px);
    left: 12px;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 45;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    transition: all 0.2s ease;
  }

  .sidebar-expand-btn:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 12px var(--glow-cyan);
    transform: scale(1.08);
  }

  :global(.sidebar-left-collapsed) .sidebar-expand-btn {
    display: flex;
  }

  /* Resizer handle on the right edge of sidebar-left */
  .sidebar-resizer {
    position: absolute;
    top: 0;
    right: -4px;
    width: 8px;
    height: 100%;
    cursor: col-resize;
    z-index: 40;
    touch-action: none;
  }

  .sidebar-resizer::after {
    content: '';
    position: absolute;
    top: 0;
    left: 3px;
    width: 2px;
    height: 100%;
    background-color: transparent;
    transition: background-color 0.2s ease;
  }

  .sidebar-resizer:hover::after,
  :global(body.is-resizing) .sidebar-resizer::after {
    background-color: var(--cyan);
    box-shadow: 0 0 8px var(--glow-cyan);
  }

  :global(.sidebar-left-collapsed) .sidebar-resizer {
    display: none;
  }

  :global(body.is-resizing) {
    user-select: none !important;
    cursor: col-resize !important;
  }

  :global(body.is-resizing) .sidebar-left-container,
  :global(body.is-resizing) .sidebar-left {
    transition: none !important;
  }

  .sidebar {
    padding: 24px 16px;
    height: calc(100vh - var(--nav-h));
    height: calc(100dvh - var(--nav-h));
    position: sticky;
    top: var(--nav-h);
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    box-sizing: border-box;
    overscroll-behavior: contain;
  }

  .sidebar-left {
    width: var(--sidebar-left-width, 260px);
    max-width: 100%;
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
    background-color: var(--bg-secondary);
    overflow-x: hidden;
  }

  .sidebar-left-container.collapsed .sidebar-left,
  :global(.sidebar-left-collapsed) .sidebar-left-container .sidebar-left {
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .sidebar-right {
    width: 100%;
    border-left: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    overflow-x: hidden;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    padding: 32px 40px;
    width: 100%;
    margin: 0 auto;
    min-width: 0;
    max-width: min(860px, 100%);
    flex-grow: 1;
    overflow-wrap: break-word;
    word-break: break-word;
    box-sizing: border-box;
  }

  /* Ensure any wide element inside main-content scrolls internally, not page */
  .main-content :global(img),
  .main-content :global(table),
  .main-content :global(pre),
  .main-content :global(code) {
    max-width: 100%;
  }
  .main-content :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .main-content :global(pre) {
    overflow-x: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  /* Tablet: hide right sidebar */
  @media (max-width: 1200px) {
    .sidebar-right {
      display: none;
    }
    .layout {
      grid-template-columns: var(--sidebar-left-width, 260px) minmax(0, 1fr);
    }
    .layout--no-toc {
      grid-template-columns: var(--sidebar-left-width, 260px) minmax(0, 1fr);
    }
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .layout {
      grid-template-columns: var(--sidebar-left-width, 240px) minmax(0, 1fr);
    }
    .layout--no-toc {
      grid-template-columns: var(--sidebar-left-width, 240px) minmax(0, 1fr);
    }
    .sidebar-left {
      width: var(--sidebar-left-width, 240px);
    }
    .sidebar-left-container {
      width: var(--sidebar-left-width, 240px);
    }
  }

  /* Mobile overlay — single navigation DOM, rendered differently with CSS */
  .sidebar-mobile-overlay {
    display: none;
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    width: 100%;
    max-width: 100%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 45;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
    /* Never participate in page scroll metrics */
    touch-action: none;
    overscroll-behavior: none;
  }

  .sidebar-mobile-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Mobile: single navigation becomes drawer, no duplicate DOM */
  @media (max-width: 768px) {
    /*
     * Critical: the drawer must never participate in layout metrics.
     * - position:fixed + left:0 takes it out of flow
     * - when closed, translate fully off-screen AND visibility:hidden
     * - box-shadow only when open, clipped by html overflow-x:clip
     * - background page must NOT move (no width/padding changes on open)
     */
    .sidebar-left-container {
      position: fixed !important;
      top: var(--nav-h);
      left: 0;
      right: auto;
      bottom: 0;
      width: min(86%, 300px);
      max-width: 300px;
      height: calc(100vh - var(--nav-h));
      height: calc(100dvh - var(--nav-h));
      /* Évite que le contenu du tiroir ne passe sous la barre d'accueil iOS */
      padding-bottom: env(safe-area-inset-bottom, 0);
      margin: 0;
      z-index: 50;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border-color);
      transform: translate3d(-100%, 0, 0);
      /* Only animate transform — never width (desktop rule would reflow the page) */
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      display: block;
      /* paint isolation without affecting page size */
      contain: layout style paint;
      visibility: hidden;
      pointer-events: none;
      box-shadow: none;
      touch-action: pan-y;
    }

    .sidebar-left-container.is-mobile-open {
      transform: translate3d(0, 0, 0);
      visibility: visible;
      pointer-events: auto;
      /* Soft shadow that does not expand document width (html clips x) */
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.35);
    }

    .sidebar-left {
      position: relative;
      top: 0;
      height: auto;
      min-height: 100%;
      max-height: none;
      width: 100% !important;
      max-width: 100%;
      border-right: none;
      transform: none !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      overflow: visible !important;
      padding: 16px 12px 28px;
      scrollbar-width: none;
      /* Kill desktop slide/opacity transitions that could fight the drawer */
      transition: none !important;
    }

    .sidebar-left::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .sidebar-resizer {
      display: none !important;
    }

    .sidebar-mobile-overlay {
      display: block;
    }

    /*
     * Single block layout: the drawer is position:fixed so it must not
     * reserve any grid track. display:block keeps main at full width
     * whether the drawer is open or closed — zero width delta.
     */
    .layout,
    .layout--no-toc {
      display: block !important;
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
    }

    .main-content {
      display: block;
      padding: 24px 16px;
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
      min-width: 0;
      /* Page content stays put under the overlay — never translated */
      transform: none !important;
      margin: 0;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .main-content {
      padding: 20px 14px;
    }
    .sidebar-left-container {
      width: min(88%, 280px);
      max-width: 280px;
    }
    .sidebar-left {
      padding: 14px 10px 24px;
    }
  }

  @media (max-width: 360px) {
    .main-content {
      padding: 16px 12px;
    }
    .sidebar-left-container {
      width: min(92%, 260px);
      max-width: 260px;
    }
  }

  /*
   * Scroll lock WITHOUT position:fixed on <body>.
   * position:fixed was causing a subtle horizontal/vertical shift of the
   * background page (sticky navbar reflow + width recalculation).
   * We only freeze overflow; scroll position is preserved natively.
   * scrollbar-gutter: stable (global) keeps the width identical if a classic
   * scrollbar would otherwise appear/disappear.
   */
  :global(html.mobile-nav-open) {
    overflow: hidden !important;
    overscroll-behavior: none;
  }

  :global(body.mobile-nav-open) {
    overflow: hidden !important;
    overscroll-behavior: none;
    /* Do NOT set position/top/width/left — any of these reflow the page. */
  }

  /* Keep background content inert visually; no transform/filter that reflows */
  :global(body.mobile-nav-open) .layout,
  :global(body.mobile-nav-open) .main-content {
    pointer-events: none;
    user-select: none;
  }

  /* Drawer + overlay must remain interactive above the frozen page */
  :global(body.mobile-nav-open) .sidebar-left-container,
  :global(body.mobile-nav-open) .sidebar-mobile-overlay,
  :global(body.mobile-nav-open) .navbar {
    pointer-events: auto;
    user-select: auto;
  }

  /* Tant que le tiroir mobile est ouvert, les actions de la navbar (recherche,
     thème) sont neutralisées visuellement pour éviter qu'un second overlay ne
     vienne se superposer au tiroir. Le bouton hamburger de fermeture reste actif. */
  :global([data-nav-open='mobile']) .navbar .nav-actions {
    opacity: 0.45;
    pointer-events: none;
  }
  :global([data-nav-open='mobile']) #mobile-menu-toggle {
    color: var(--cyan);
    border-color: color-mix(in srgb, var(--cyan) 45%, var(--border-color));
    background-color: color-mix(in srgb, var(--cyan) 12%, var(--surface));
  }
  :global([data-nav-open='mobile']) .navbar {
    border-bottom-color: color-mix(in srgb, var(--cyan) 25%, var(--border-color));
  }
</style>


<script>
  // @ts-nocheck
  // Left sidebar collapse / expand logic controlled by the single navbar button
  const navbarSidebarToggle = document.getElementById('navbar-sidebar-toggle');
  const sidebarContainer = document.getElementById('sidebar-left-container');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileOverlay = document.getElementById('sidebar-mobile-overlay');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mainContent = document.getElementById('main-content');

  // --- État du tiroir mobile (déclaré tôt : utilisé à l'initialisation) ---
  const isMobileOpen = () => sidebarContainer?.classList.contains('is-mobile-open');

  const syncToggleButtons = () => {
    const mobile = window.innerWidth <= 768;
    const mobileOpen = isMobileOpen();
    const desktopCollapsed =
      document.documentElement.classList.contains('sidebar-left-collapsed');

    if (mobileToggle) {
      hamburgerIcon?.classList.toggle('hidden', mobileOpen);
      closeIcon?.classList.toggle('hidden', !mobileOpen);
      mobileToggle.setAttribute('aria-expanded', String(mobileOpen));
      mobileToggle.setAttribute('aria-pressed', String(mobileOpen));
    }
    if (navbarSidebarToggle) {
      navbarSidebarToggle.setAttribute(
        'aria-expanded',
        mobile ? String(mobileOpen) : String(!desktopCollapsed),
      );
    }
  };

  const updateAriaState = () => {
    syncToggleButtons();
  };

  updateAriaState();

  const toggleSidebar = () => {
    const isCollapsed = !document.documentElement.classList.contains('sidebar-left-collapsed');
    if (isCollapsed) {
      document.documentElement.classList.add('sidebar-left-collapsed');
      sidebarContainer?.classList.add('collapsed');
    } else {
      document.documentElement.classList.remove('sidebar-left-collapsed');
      sidebarContainer?.classList.remove('collapsed');
    }
    localStorage.setItem('sidebar-left-collapsed', String(isCollapsed));
    syncToggleButtons();
  };

  navbarSidebarToggle?.addEventListener('click', () => {
    // Sur mobile, le bouton desktop est masqué : on délègue au tiroir mobile
    if (window.innerWidth <= 768) {
      toggleMobile(true);
      return;
    }
    toggleSidebar();
  });

  // --- Mobile drawer : single navigation DOM, pas de duplication ---
  let scrollLocked = false;
  let touchMoveHandler = null;

  /**
   * Freeze background scroll with zero layout shift.
   * - No position:fixed on body (that was shifting blocks slightly)
   * - No paddingRight compensation
   * - overflow:hidden only; native scrollY is kept
   * - touchmove blocked outside the drawer (iOS rubber-band)
   */
  const lockScroll = () => {
    if (scrollLocked) return;
    scrollLocked = true;
    document.documentElement.classList.add('mobile-nav-open');
    document.body.classList.add('mobile-nav-open');
    mainContent?.setAttribute('inert', '');
    mainContent?.setAttribute('aria-hidden', 'true');

    touchMoveHandler = (e) => {
      if (!isMobileOpen()) return;
      const target = e.target;
      // Allow scrolling inside the drawer only
      if (sidebarContainer && sidebarContainer.contains(target)) return;
      e.preventDefault();
    };
    document.addEventListener('touchmove', touchMoveHandler, { passive: false });
  };

  const unlockScroll = () => {
    if (!scrollLocked) return;
    scrollLocked = false;
    document.documentElement.classList.remove('mobile-nav-open');
    document.body.classList.remove('mobile-nav-open');
    mainContent?.removeAttribute('inert');
    mainContent?.removeAttribute('aria-hidden');

    if (touchMoveHandler) {
      document.removeEventListener('touchmove', touchMoveHandler);
      touchMoveHandler = null;
    }
  };

  const toggleMobile = (force) => {
    const willOpen = force !== undefined ? force : !isMobileOpen();
    if (willOpen) {
      // Lock first so the open animation never races a layout shift
      lockScroll();
      // Double-rAF: apply open class after lock styles are committed
      requestAnimationFrame(() => {
        sidebarContainer?.classList.add('is-mobile-open');
        mobileOverlay?.classList.add('is-open');
        mobileOverlay?.setAttribute('aria-hidden', 'false');
        document.documentElement.setAttribute('data-nav-open', 'mobile');
        document.body.setAttribute('data-nav-open', 'mobile');
        syncToggleButtons();
      });
    } else {
      sidebarContainer?.classList.remove('is-mobile-open');
      mobileOverlay?.classList.remove('is-open');
      mobileOverlay?.setAttribute('aria-hidden', 'true');
      document.documentElement.removeAttribute('data-nav-open');
      document.body.removeAttribute('data-nav-open');
      // Unlock after the close transition starts (layout stays put either way)
      unlockScroll();
      syncToggleButtons();
    }
  };

  mobileToggle?.addEventListener('click', () => toggleMobile());
  mobileOverlay?.addEventListener('click', () => toggleMobile(false));

  // Quand le tiroir mobile est ouvert, tout déclenchement de la recherche
  // (bouton loupe de la navbar ou raccourci Ctrl/Cmd+K) doit d'abord fermer
  // le tiroir pour éviter la superposition de deux overlays.
  const closeMobileForOverlay = () => {
    if (window.innerWidth <= 768 && isMobileOpen()) {
      toggleMobile(false);
    }
  };
  document.addEventListener('openSearch', closeMobileForOverlay, true);
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      closeMobileForOverlay();
    }
  });

  // Focus trap minimal dans le tiroir pour les utilisateurs clavier.
  sidebarContainer?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isMobileOpen()) return;
    const focusable = sidebarContainer.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled])',
    );
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Fermer le tiroir lors d'une navigation (clic sur un lien de la sidebar)
  sidebarContainer?.addEventListener('click', (e) => {
    const target = e.target;
    if (target.closest('a') && window.innerWidth <= 768) {
      toggleMobile(false);
    }
  });

  // Swipe left to close the mobile drawer
  let swipeStartX = 0;
  let swipeStartY = 0;
  const SWIPE_THRESHOLD = 60;

  sidebarContainer?.addEventListener('touchstart', (e) => {
    if (window.innerWidth > 768 || !isMobileOpen()) return;
    swipeStartX = e.touches[0].clientX;
    swipeStartY = e.touches[0].clientY;
  }, { passive: true });

  sidebarContainer?.addEventListener('touchend', (e) => {
    if (window.innerWidth > 768 || !isMobileOpen()) return;
    const deltaX = e.changedTouches[0].clientX - swipeStartX;
    const deltaY = Math.abs(e.changedTouches[0].clientY - swipeStartY);
    // Only trigger on horizontal swipe (left) with minimal vertical movement
    if (deltaX < -SWIPE_THRESHOLD && deltaY < 40) {
      toggleMobile(false);
    }
  }, { passive: true });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMobileOpen()) toggleMobile(false);
  });

  // Fermer automatiquement le drawer si on repasse en desktop (resize).
  // On réinitialise aussi l'état replié desktop pour éviter qu'un tiroir
  // mobile laissé ouvert ne se transforme en sidebar repliée (icône ↔ incohérente).
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      if (window.innerWidth > 768 && isMobileOpen()) {
        toggleMobile(false);
      }
      // Sur desktop, la sidebar de contenu doit rester visible par défaut,
      // même si elle a été manipulée pendant une session mobile.
      if (window.innerWidth > 768) {
        document.documentElement.classList.remove('sidebar-left-collapsed');
        sidebarContainer?.classList.remove('collapsed');
        localStorage.setItem('sidebar-left-collapsed', 'false');
      }
      syncToggleButtons();
    }, 100);
  });

  // Sidebar drag resizer logic
  const resizer = document.getElementById('sidebar-resizer');
  const MIN_WIDTH = 200;
  const MAX_WIDTH = 480;

  if (resizer) {
    let isDragging = false;

    const startDragging = (e) => {
      if (document.documentElement.classList.contains('sidebar-left-collapsed')) return;
      if (window.innerWidth <= 768) return;
      isDragging = true;
      document.body.classList.add('is-resizing');
      e.preventDefault();
    };

    const onMove = (e) => {
      if (!isDragging) return;
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const newWidth = Math.min(MAX_WIDTH, Math.max(MIN_WIDTH, clientX));
      document.documentElement.style.setProperty('--sidebar-left-width', newWidth + 'px');
    };

    const stopDragging = () => {
      if (!isDragging) return;
      isDragging = false;
      document.body.classList.remove('is-resizing');
      const currentWidth = getComputedStyle(document.documentElement)
        .getPropertyValue('--sidebar-left-width')
        .trim();
      if (currentWidth && currentWidth !== '0px') {
        localStorage.setItem('sidebar-left-width', currentWidth);
      }
    };

    resizer.addEventListener('mousedown', startDragging);
    resizer.addEventListener('touchstart', startDragging, { passive: false });

    window.addEventListener('mousemove', onMove);
    window.addEventListener('touchmove', onMove, { passive: false });

    window.addEventListener('mouseup', stopDragging);
    window.addEventListener('touchend', stopDragging);
  }
</script>
