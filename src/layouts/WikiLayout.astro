---
import BaseLayout from '@layouts/BaseLayout.astro';
import SidebarNav from '@components/SidebarNav.astro';
import SidebarToc from '@components/SidebarToc.astro';
import Navbar from '@components/Navbar.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  currentPath: string;
  headings?: Heading[];
  image?: string;
  type?: 'website' | 'article';
  seoTitle?: string;
  noBreadcrumb?: boolean;
  noSidebar?: boolean;
}

const {
  title,
  description,
  currentPath,
  headings,
  image,
  type,
  seoTitle,
  noBreadcrumb = false,
  noSidebar: requestedNoSidebar = false,
} = Astro.props;

const noSidebar = requestedNoSidebar;
const hasToc = Boolean(headings?.length);
const breadcrumbLabels: Record<string, string> = {
  '/dossiers': 'Dossiers',
  '/explorer': 'Explorer',
  '/chapitres': 'Chapitres',
  '/aide': 'Aide',
  '/theorie': 'La théorie',
};

const buildGenericBreadcrumb = () => {
  const segments = currentPath.split('/').filter(Boolean);
  if (segments.length === 0) return [];

  const items: { label: string; href?: string }[] = [{ label: 'Accueil', href: '/' }];
  let path = '';

  segments.forEach((segment, index) => {
    path += `/${segment}`;
    const isLast = index === segments.length - 1;
    const sectionLabel = index === 0 ? breadcrumbLabels[`/${segment}`] : undefined;
    const label = /^\d+$/.test(segment)
      ? `Chapitre ${segment}`
      : (sectionLabel ?? (isLast ? title : segment.replace(/-/g, ' ')));
    items.push({ label, href: isLast ? undefined : path });
  });

  return items;
};

const genericBreadcrumb = buildGenericBreadcrumb();
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
const isCollectionPage = ['/theorie', '/dossiers', '/chapitres', '/explorer', '/aide'].some(
  (path) => currentPath === path || currentPath === `${path}/`,
);
const canonicalWikiUrl = new URL(
  currentPath.endsWith('/') ? currentPath : `${currentPath}/`,
  siteUrl,
).toString();
---

<BaseLayout title={title} description={description} image={image} type={type} seoTitle={seoTitle}>
  {
    isCollectionPage && (
      <>
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'CollectionPage',
            name: title,
            description,
            url: canonicalWikiUrl,
            inLanguage: 'fr-FR',
            isPartOf: { '@id': `${siteUrl}/#website` },
          })}
        />
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
              { '@type': 'ListItem', position: 2, name: title, item: canonicalWikiUrl },
            ],
          })}
        />
      </>
    )
  }

  {
    !isCollectionPage && currentPath.startsWith('/theorie/') && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title,
          description,
          url: canonicalWikiUrl,
          author: { '@type': 'Organization', name: 'Les Fous du Bus' },
          publisher: { '@id': `${siteUrl}/#organization` },
          inLanguage: 'fr-FR',
        })}
      />
    )
  }

  <Navbar useGlobalMobileMenu={noSidebar} />

  {!noSidebar && <div id="sidebar-overlay" class="sidebar-overlay" aria-hidden="true" />}

  <div
    class:list={[
      'wiki-layout',
      { 'wiki-layout--no-toc': !hasToc, 'wiki-layout--no-sidebar': noSidebar },
    ]}
  >
    {
      !noSidebar && (
        <aside
          id="sidebar-left"
          class="sidebar-left"
          aria-label="Navigation des articles"
          aria-hidden="false"
        >
          <div class="sidebar-mobile-header">
            <span>Navigation</span>
            <button id="sidebar-close" type="button" aria-label="Fermer la navigation">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <div
            class="sidebar-scroll"
            data-sidebar-scroll
            role="region"
            aria-label="Liste des articles"
            tabindex="0"
          >
            <SidebarNav currentPath={currentPath} />
          </div>
        </aside>
      )
    }

    <main class:list={['main-content', { 'main-content--centered': noSidebar }]} id="main-content">
      {
        !noBreadcrumb &&
          genericBreadcrumb.length > 1 &&
          currentPath !== '/' &&
          !currentPath.startsWith('/theorie/') && <Breadcrumb items={genericBreadcrumb} />
      }
      <slot />
    </main>

    {
      hasToc && (
        <aside class="sidebar-right" aria-label="Table des matières">
          <SidebarToc headings={headings} />
        </aside>
      )
    }
  </div>

  {
    hasToc && (
      <>
        <button
          id="toc-fab"
          class="toc-fab"
          type="button"
          aria-label="Ouvrir le sommaire"
          aria-expanded="false"
          aria-controls="toc-drawer"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
          <span>Sommaire</span>
        </button>
        <div id="toc-overlay" class="toc-overlay" aria-hidden="true" />
        <aside id="toc-drawer" class="toc-drawer" aria-label="Sommaire" aria-hidden="true">
          <div class="toc-drawer__header">
            <span>Sur cette page</span>
            <button id="toc-close" type="button" aria-label="Fermer le sommaire">
              ×
            </button>
          </div>
          <div class="toc-drawer__body">
            <SidebarToc headings={headings} />
          </div>
        </aside>
      </>
    )
  }

  <slot name="overlays" />
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    max-width: 100%;
    overflow-x: clip;
  }

  .wiki-layout {
    display: grid;
    grid-template-columns:
      var(--sidebar-left-width) minmax(0, 1fr)
      var(--sidebar-right-width);
    width: 100%;
    min-width: 0;
    flex: 1;
  }

  .wiki-layout--no-toc {
    grid-template-columns: var(--sidebar-left-width) minmax(0, 1fr);
  }

  .wiki-layout--no-sidebar {
    grid-template-columns: minmax(0, 1fr);
  }

  .sidebar-left,
  .sidebar-right {
    position: sticky;
    top: var(--nav-h);
    align-self: start;
    height: calc(100vh - var(--nav-h));
    height: calc(100dvh - var(--nav-h));
    background: var(--bg-secondary);
  }

  .sidebar-left {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid var(--border-color);
  }

  .sidebar-scroll {
    position: relative;
    flex: 1 1 0;
    height: 100%;
    min-width: 0;
    min-height: 0;
    max-height: 100%;
    padding: 20px 14px 32px;
    overflow-x: hidden;
    overflow-y: scroll;
    overscroll-behavior-y: contain;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
  }

  .sidebar-right {
    padding: 24px 16px;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    border-left: 1px solid var(--border-color);
  }

  .sidebar-mobile-header {
    display: none;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--page-block-start) var(--page-gutter) var(--space-6);
    overflow-wrap: anywhere;
  }

  .main-content--centered {
    max-width: var(--content-max);
  }

  .main-content :global(img),
  .main-content :global(video),
  .main-content :global(iframe),
  .main-content :global(pre),
  .main-content :global(table) {
    max-width: 100%;
  }

  .main-content :global(table),
  .main-content :global(pre) {
    overflow-x: auto;
  }

  .main-content :global(table) {
    display: block;
  }

  .sidebar-overlay,
  .toc-overlay {
    position: fixed;
    inset: var(--nav-h) 0 0;
    z-index: 55;
    background: rgba(3, 8, 15, 0.58);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  .sidebar-overlay.is-open,
  .toc-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Keep the reading column comfortable: showing the TOC before there is room
     for all three columns used to compress article text between 1201–1399 px. */
  @media (max-width: 1399px) {
    .wiki-layout,
    .wiki-layout--no-toc {
      grid-template-columns: var(--sidebar-left-width) minmax(0, 1fr);
    }

    .sidebar-right {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .wiki-layout,
    .wiki-layout--no-toc,
    .wiki-layout--no-sidebar {
      display: block;
    }

    .sidebar-left {
      position: fixed;
      z-index: 60;
      top: var(--nav-h);
      left: 0;
      bottom: auto;
      width: min(88vw, 320px);
      height: calc(100vh - var(--nav-h));
      height: calc(100dvh - var(--nav-h));
      max-height: calc(100vh - var(--nav-h));
      max-height: calc(100dvh - var(--nav-h));
      contain: layout paint;
      border-right: 1px solid var(--border-color);
      transform: translateX(-100%);
      visibility: hidden;
      pointer-events: none;
      transition:
        transform 220ms ease,
        visibility 220ms ease;
    }

    .sidebar-scroll {
      flex: 1 1 0;
      height: 0;
      min-height: 0;
      max-height: none;
      padding: 0 14px max(28px, env(safe-area-inset-bottom));
      overflow-y: scroll;
    }

    .sidebar-left.is-open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
      box-shadow: 8px 0 28px var(--shadow-color);
    }

    .sidebar-mobile-header {
      position: relative;
      z-index: 2;
      display: flex;
      flex: 0 0 56px;
      align-items: center;
      justify-content: space-between;
      min-height: 56px;
      margin: 0 0 12px;
      padding: 8px 14px;
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-secondary);
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    #sidebar-close {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      background: var(--surface);
      color: var(--text-main);
      cursor: pointer;
    }

    .main-content {
      max-width: var(--content-max);
      padding: 28px 24px var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .sidebar-left {
      width: min(92vw, 304px);
    }

    .main-content {
      padding: 22px 16px;
    }
  }

  :global(html.nav-drawer-open body),
  :global(html.toc-drawer-open body) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html.nav-drawer-open),
  :global(html.toc-drawer-open) {
    overscroll-behavior: none;
  }

  .toc-fab {
    display: none;
    position: fixed;
    right: 20px;
    bottom: 24px;
    z-index: 45;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-full);
    background: var(--bg-secondary);
    color: var(--text-main);
    box-shadow: 0 6px 22px var(--shadow-color);
    font: 700 13px/1 var(--font-sans);
    cursor: pointer;
  }

  .toc-drawer {
    position: fixed;
    z-index: 60;
    top: var(--nav-h);
    right: 0;
    bottom: 0;
    width: min(88vw, 340px);
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 220ms ease,
      visibility 220ms ease;
  }

  .toc-drawer.is-open {
    transform: translateX(0);
    visibility: visible;
    box-shadow: -8px 0 28px var(--shadow-color);
  }

  .toc-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border-color);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  #toc-close {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    background: var(--surface);
    color: var(--text-main);
    font-size: 24px;
    cursor: pointer;
  }

  .toc-drawer__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px 16px max(28px, env(safe-area-inset-bottom));
  }

  @media (max-width: 1399px) {
    .toc-fab {
      display: inline-flex;
    }
  }

  @media (max-width: 640px) {
    .toc-fab {
      right: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }

  :global(html.nav-drawer-open) .toc-fab,
  :global(html.search-modal-open) .toc-fab {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(html.zen-mode) .sidebar-left,
  :global(html.zen-mode) .sidebar-right,
  :global(html.zen-mode) .toc-fab {
    display: none;
  }

  :global(html.zen-mode) .wiki-layout {
    display: block;
  }

  :global(html.zen-mode) .main-content {
    max-width: 780px;
    margin: 0 auto;
  }
</style>

<script>
  // @ts-nocheck
  const mobileMedia = window.matchMedia('(max-width: 1023px)');
  const navDrawer = document.getElementById('sidebar-left');
  const navToggle = document.getElementById('mobile-menu-toggle');
  const navClose = document.getElementById('sidebar-close');
  const navOverlay = document.getElementById('sidebar-overlay');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mainContent = document.getElementById('main-content');
  const navBackground = document.querySelectorAll(
    '.navbar .nav-left, .navbar .nav-center, .navbar .nav-actions',
  );

  const isNavOpen = () => navDrawer?.classList.contains('is-open') ?? false;
  const setInert = (elements, inert) => {
    elements.forEach((element) => element.toggleAttribute('inert', inert));
  };

  const syncNavViewport = () => {
    if (!navDrawer) return;
    if (!mobileMedia.matches) {
      navDrawer.classList.remove('is-open');
      navDrawer.setAttribute('aria-hidden', 'false');
      navOverlay?.classList.remove('is-open');
      navOverlay?.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('nav-drawer-open');
      mainContent?.removeAttribute('inert');
      setInert(navBackground, false);
    } else if (!isNavOpen()) {
      navDrawer.setAttribute('aria-hidden', 'true');
    }
    navToggle?.setAttribute('aria-expanded', String(isNavOpen()));
    hamburgerIcon?.classList.toggle('hidden', isNavOpen());
    closeIcon?.classList.toggle('hidden', !isNavOpen());
  };

  const setNavOpen = (open, restoreFocus = false) => {
    if (!navDrawer || (!mobileMedia.matches && open)) return;
    navDrawer.classList.toggle('is-open', open);
    navDrawer.setAttribute('aria-hidden', String(!open));
    navOverlay?.classList.toggle('is-open', open);
    navOverlay?.setAttribute('aria-hidden', String(!open));
    document.documentElement.classList.toggle('nav-drawer-open', open);
    mainContent?.toggleAttribute('inert', open);
    setInert(navBackground, open);
    syncNavViewport();

    if (open) {
      requestAnimationFrame(() => {
        const target = navDrawer.querySelector('[aria-current="page"], summary, button, a');
        target?.focus({ preventScroll: true });
        navDrawer.querySelector('[aria-current="page"]')?.scrollIntoView({ block: 'center' });
      });
    } else if (restoreFocus) {
      navToggle?.focus();
    }
  };

  navToggle?.addEventListener('click', () => setNavOpen(!isNavOpen()));
  navClose?.addEventListener('click', () => setNavOpen(false, true));
  navOverlay?.addEventListener('click', () => setNavOpen(false, true));
  navDrawer?.addEventListener('click', (event) => {
    if (mobileMedia.matches && event.target.closest('a')) setNavOpen(false);
  });
  mobileMedia.addEventListener('change', syncNavViewport);
  window.addEventListener('openSearch', () => {
    setNavOpen(false);
    setTocOpen(false);
  });

  navDrawer?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !isNavOpen()) return;
    const focusable = [...navDrawer.querySelectorAll('a[href], summary, button:not([disabled])')];
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  const tocMedia = window.matchMedia('(max-width: 1399px)');
  const tocFab = document.getElementById('toc-fab');
  const tocDrawer = document.getElementById('toc-drawer');
  const tocClose = document.getElementById('toc-close');
  const tocOverlay = document.getElementById('toc-overlay');
  const isTocOpen = () => tocDrawer?.classList.contains('is-open') ?? false;

  const setTocOpen = (open, restoreFocus = false) => {
    if (!tocDrawer || (!tocMedia.matches && open)) return;
    tocDrawer.classList.toggle('is-open', open);
    tocDrawer.setAttribute('aria-hidden', String(!open));
    tocOverlay?.classList.toggle('is-open', open);
    tocOverlay?.setAttribute('aria-hidden', String(!open));
    tocFab?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('toc-drawer-open', open);
    document.querySelector('.wiki-layout')?.toggleAttribute('inert', open);
    document.querySelector('.navbar')?.toggleAttribute('inert', open);
    if (open) requestAnimationFrame(() => tocClose?.focus());
    else if (restoreFocus) tocFab?.focus();
  };

  tocFab?.addEventListener('click', () => setTocOpen(!isTocOpen()));
  tocClose?.addEventListener('click', () => setTocOpen(false, true));
  tocOverlay?.addEventListener('click', () => setTocOpen(false, true));
  tocDrawer?.addEventListener('click', (event) => {
    if (event.target.closest('a')) setTocOpen(false);
  });
  tocDrawer?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !isTocOpen()) return;
    const focusable = [...tocDrawer.querySelectorAll('a[href], button:not([disabled])')];
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  tocMedia.addEventListener('change', ({ matches }) => {
    if (!matches && isTocOpen()) setTocOpen(false);
  });

  window.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (isNavOpen()) setNavOpen(false, true);
    else if (isTocOpen()) setTocOpen(false, true);
  });

  (window as any).closeWikiDrawers = () => {
    setNavOpen(false);
    setTocOpen(false);
  };

  (window as any).toggleZenMode = () => {
    const enabled = document.documentElement.classList.toggle('zen-mode');
    localStorage.setItem('zen-mode', String(enabled));
    return enabled;
  };
  document.documentElement.classList.toggle(
    'zen-mode',
    localStorage.getItem('zen-mode') === 'true',
  );
  syncNavViewport();
</script>
