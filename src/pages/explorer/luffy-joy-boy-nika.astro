---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface Facet {
  nom: string;
  href: string;
  qui: string;
  usage: string;
  tonalite: string;
}

const facets: Facet[] = [
  {
    nom: 'Luffy',
    href: '/theorie/luffy',
    qui: 'Monkey D. Luffy, le capitaine des Mugiwara au présent du manga.',
    usage: 'Le nom intime, celui que l’équipage et les proches utilisent.',
    tonalite: 'Le garçon de Fusha, sans titre divin.',
  },
  {
    nom: 'Joy Boy',
    href: '/theorie/joy-boy',
    qui: 'Figure légendaire citée par le Ponéglyphe de Ryūgū et par Imu.',
    usage: 'Manga : personne historique du Royaume antique. Extension : nom ou rôle qui pourrait aussi être appliqué à Luffy.',
    tonalite: 'Mémoire historique et promesse inachevée ; identité future non confirmée.',
  },
  {
    nom: 'Nika',
    href: '/theorie/nika',
    qui: 'Le « Guerrier de la Libération » du mythe et le modèle du Fruit éveillé par Luffy.',
    usage: 'Nom du mythe, du modèle du Hito Hito no Mi et de la forme associée au Gear 5.',
    tonalite: 'Foi ancienne et pouvoir ; pas le nom personnel choisi par Luffy.',
  },
];

const tonalityColors: Record<string, string> = {
  Luffy: 'var(--cyan)',
  'Joy Boy': 'var(--violet-light)',
  Nika: 'var(--accent-gold)',
};
---

<WikiLayout
  title="Luffy, Joy Boy, Nika : trois notions à distinguer"
  seoTitle="Luffy, Joy Boy et Nika : faits et théorie | Les Fous du Bus"
  description="Comparaison de Luffy, du Joy Boy historique et du mythe ou modèle Nika ; leur convergence future reste une extension de la théorie."
  currentPath="/explorer/luffy-joy-boy-nika"
>
  <div class="page-header">
    <p class="eyebrow">🎭 Identités</p>
    <h1>Luffy · Joy Boy · Nika</h1>
    <p class="page-desc">
      Le manga rapproche Luffy de Joy Boy et de Nika sans effacer leurs différences : Joy Boy a une existence
      historique, Nika est un mythe et un modèle de Fruit, Luffy affirme être Monkey D. Luffy. Leur convergence
      future est une <strong>extension</strong>, pas une identité déjà établie.
    </p>
  </div>

  <div class="cards">
    {facets.map((f) => (
      <div class="card" style={`border-top: 3px solid ${tonalityColors[f.nom]}`}>
        <h2 class="card__nom" style={`color:${tonalityColors[f.nom]}`}>{f.nom}</h2>
        <div class="card__row">
          <span class="card__label">Qui ?</span>
          <p>{f.qui}</p>
        </div>
        <div class="card__row">
          <span class="card__label">Usage</span>
          <p>{f.usage}</p>
        </div>
        <div class="card__row">
          <span class="card__label">Tonalité</span>
          <p>{f.tonalite}</p>
        </div>
        <a class="card__link" href={f.href}>Fiche {f.nom} →</a>
      </div>
    ))}
  </div>

  <div class="note-box">
    <p>
      <strong>Point clé :</strong> à Elbaf, Imu appelle Luffy « Joy Boy » et Luffy répond qu'il est Monkey D. Luffy.
      La théorie propose que Joy Boy puisse devenir une conséquence de huit siècles de récits convergents, non une
      origine que Luffy reproduirait à l'identique. Réincarnation, identité personnelle et simple rôle restent distincts.
    </p>
  </div>

  <Footer />
</WikiLayout>

<style>
  .page-header { margin-bottom: 28px; }
  .eyebrow { color: var(--violet-light); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
  .page-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 800; margin: 0 0 12px; line-height: 1.15; }
  .page-desc { font-size: 15px; color: var(--text-secondary); max-width: 780px; line-height: 1.65; }
  .page-desc strong { color: var(--text-main); }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 24px 0 20px; }
  .card { padding: 20px; border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); background: var(--gradient-card); display: flex; flex-direction: column; gap: 14px; }
  .card__nom { font-size: 22px; font-weight: 800; margin: 0; }
  .card__row { display: flex; flex-direction: column; gap: 3px; }
  .card__label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
  .card__row p { font-size: 13.5px; color: var(--text-secondary); line-height: 1.55; margin: 0; }
  .card__link { margin-top: auto; color: var(--cyan); text-decoration: none; font-size: 13.5px; font-weight: 600; }
  .card__link:hover { text-decoration: underline; }

  .note-box { padding: 18px; border: 1px solid var(--border-color); border-left: 3px solid var(--accent-gold); border-radius: var(--border-radius-lg); background: var(--bg-secondary); }
  .note-box p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .note-box strong { color: var(--text-main); }
</style>
