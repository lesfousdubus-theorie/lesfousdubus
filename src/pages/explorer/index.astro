---
import Footer from '@components/Footer.astro';
import WikiLayout from '@layouts/WikiLayout.astro';
import { explorerHighlights } from '../../data/siteNavigation';

const secondaryTools = [
  {
    title: 'Fresque d’Elbaf',
    description: 'Observer les zones et interprétations de la fresque.',
    href: '/explorer/fresque-elbaf',
    icon: '🎨',
    group: 'Monde',
  },
  {
    title: 'Peuples et missions',
    description: 'Relier chaque peuple à son rôle final.',
    href: '/explorer/peuples-missions',
    icon: '🏰',
    group: 'Monde',
  },
  {
    title: 'Boucle des Ponéglyphes',
    description: 'Voir comment l’information rejoint le passé.',
    href: '/explorer/poneglyphes',
    icon: '📜',
    group: 'Temps',
  },
  {
    title: 'Road Ponéglyphes et temps',
    description: 'Comprendre la quatrième coordonnée.',
    href: '/explorer/road-poneglyphes-temps',
    icon: '🧭',
    group: 'Temps',
  },
  {
    title: 'Luffy · Joy Boy · Nika',
    description: 'Comparer les trois identités proposées.',
    href: '/explorer/luffy-joy-boy-nika',
    icon: '🎭',
    group: 'Identités',
  },
  {
    title: 'Chemin de Pluton',
    description: 'Water Seven, Wa no Kuni, Zunesha et les géants.',
    href: '/explorer/schema-pluton',
    icon: '⚓',
    group: 'Guerre finale',
  },
  {
    title: 'Déluge et All Blue',
    description: 'La transformation géographique du monde.',
    href: '/explorer/deluge-all-blue',
    icon: '🌊',
    group: 'Guerre finale',
  },
  {
    title: 'Omen, Mother Flame et Imu',
    description: 'La branche spéculative autour d’Uranus.',
    href: '/explorer/omen-imu',
    icon: '⚠️',
    group: 'Guerre finale',
  },
];
---

<WikiLayout
  title="Explorer"
  seoTitle="Explorer la théorie One Piece : frise et cartes | Les Fous du Bus"
  description="Quatre outils principaux pour explorer visuellement la théorie, puis des schémas spécialisés sur les Ponéglyphes, les identités et la guerre finale."
  image="/og-explorer.png"
  currentPath="/explorer"
>
  <header class="explorer-hero">
    <p class="eyebrow">Laboratoire visuel</p>
    <h1>Ne lisez plus seulement la théorie.<br /><em>Manipulez-la.</em></h1>
    <p>
      Choisissez d’abord ce que vous voulez comprendre : l’ordre des événements, la géographie du
      monde, les liens entre personnages ou la chaîne complète du raisonnement.
    </p>
  </header>

  <section class="primary-tools" aria-labelledby="primary-tools-title">
    <h2 id="primary-tools-title" class="sr-only">Outils principaux</h2>
    {
      explorerHighlights.map((tool, index) => (
        <a href={tool.href} class:list={['primary-tool', { 'primary-tool--wide': index === 0 }]}>
          <span class="primary-tool__number">0{index + 1}</span>
          <span class="primary-tool__icon" aria-hidden="true">
            {tool.icon}
          </span>
          <div>
            <>
              <h3>{tool.label}</h3>
              <p>{tool.description}</p>
              <strong>
                Explorer <span aria-hidden="true">→</span>
              </strong>
            </>
          </div>
        </a>
      ))
    }
  </section>

  <details class="tool-library">
    <summary>
      <span
        ><small>Pour aller plus loin</small><strong>Afficher les 8 schémas spécialisés</strong
        ></span
      >
      <span aria-hidden="true">＋</span>
    </summary>
    <div class="tool-library__grid">
      {
        secondaryTools.map((tool) => (
          <a href={tool.href}>
            <span aria-hidden="true">{tool.icon}</span>
            <div>
              <>
                <small>{tool.group}</small>
                <strong>{tool.title}</strong>
                <p>{tool.description}</p>
              </>
            </div>
          </a>
        ))
      }
    </div>
  </details>

  <aside class="explorer-note">
    <span aria-hidden="true">✦</span>
    <p>
      <strong>Besoin d’une réponse précise ?</strong> Les visualisations synthétisent les liens. Les <a
        href="/dossiers">dossiers thématiques</a
      > conservent les arguments détaillés, objections et références.
    </p>
  </aside>

  <Footer />
</WikiLayout>

<style>
  .explorer-hero {
    max-width: 880px;
    margin: 12px 0 38px;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .explorer-hero h1 {
    margin: 0;
    font-size: clamp(2.35rem, 7vw, 5rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.05em;
  }
  .explorer-hero h1 em {
    color: var(--cyan);
    font-style: normal;
  }
  .explorer-hero > p:last-child {
    max-width: 720px;
    margin: 21px 0 0;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.7;
  }

  .primary-tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }
  .primary-tool {
    position: relative;
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 18px;
    min-height: 210px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }
  .primary-tool:hover {
    transform: translateY(-4px);
    border-color: var(--cyan);
  }
  .primary-tool--wide {
    background:
      radial-gradient(
        circle at 90% 0,
        color-mix(in srgb, var(--cyan) 16%, transparent),
        transparent 38%
      ),
      var(--bg-secondary);
  }
  .primary-tool__number {
    position: absolute;
    top: 15px;
    right: 18px;
    color: var(--border-strong);
    font-size: 12px;
    font-weight: 800;
  }
  .primary-tool__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: var(--surface);
    font-size: 29px;
  }
  .primary-tool h3 {
    margin: 4px 0 9px;
    font-size: 23px;
  }
  .primary-tool p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }
  .primary-tool strong {
    display: block;
    margin-top: 22px;
    color: var(--cyan);
    font-size: 13px;
  }

  .tool-library {
    margin-top: 32px;
    border: 1px solid var(--border-color);
    border-radius: 17px;
    background: var(--surface);
  }
  .tool-library > summary {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 16px 22px;
    cursor: pointer;
    list-style: none;
  }
  .tool-library > summary::-webkit-details-marker {
    display: none;
  }
  .tool-library > summary small,
  .tool-library > summary strong {
    display: block;
  }
  .tool-library > summary small {
    color: var(--text-muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .tool-library > summary strong {
    margin-top: 3px;
    font-size: 16px;
  }
  .tool-library[open] > summary > span:last-child {
    transform: rotate(45deg);
  }
  .tool-library__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 0 18px 18px;
  }
  .tool-library__grid a {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 11px;
    min-height: 112px;
    padding: 15px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
  }
  .tool-library__grid a:hover {
    border-color: var(--violet);
  }
  .tool-library__grid a > span {
    font-size: 23px;
  }
  .tool-library__grid small,
  .tool-library__grid strong {
    display: block;
  }
  .tool-library__grid small {
    color: var(--violet-light);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tool-library__grid strong {
    margin-top: 3px;
    font-size: 15px;
  }
  .tool-library__grid p {
    margin: 5px 0 0;
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .explorer-note {
    display: flex;
    gap: 12px;
    margin: 26px 0 10px;
    padding: 16px;
    border-left: 3px solid var(--cyan);
    background: color-mix(in srgb, var(--cyan) 6%, transparent);
  }
  .explorer-note > span {
    color: var(--cyan);
  }
  .explorer-note p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.6;
  }
  .explorer-note a {
    color: var(--cyan);
  }

  @media (max-width: 700px) {
    .primary-tools,
    .tool-library__grid {
      grid-template-columns: 1fr;
    }
    .primary-tool {
      min-height: 0;
      padding: 21px;
    }
    .explorer-hero h1 br {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .primary-tool {
      transition: none;
    }
  }
</style>
