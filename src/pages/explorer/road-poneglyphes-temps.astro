---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import DiagramViewport from '@components/DiagramViewport.astro';
---

<WikiLayout
  title="Les quatre Road Ponéglyphes et le temps"
  seoTitle="Road Ponéglyphes et temps : coordonnées | Les Fous du Bus"
  description="Schéma des quatre Road Ponéglyphes : quatre coordonnées spatiales localisent Laugh Tale ; une lecture temporelle distincte reste une hypothèse de mécanisme."
  currentPath="/explorer/road-poneglyphes-temps"
>
  <div class="page-header">
    <p class="eyebrow">🧭 Road Ponéglyphes</p>
    <h1>Quatre pierres, quatre coordonnées</h1>
    <p class="page-desc">
      <strong>Manga :</strong> les quatre Road Ponéglyphes fournissent quatre positions spatiales ; le croisement
      des lignes reliant les points opposés localise Laugh Tale. <strong>Hypothèse distincte :</strong> leur contenu,
      Laugh Tale ou un autre dispositif pourrait aussi intervenir dans une transmission temporelle. La quatrième
      pierre reste une coordonnée spatiale dans la géométrie établie.
    </p>
  </div>

  <div class="schema">
    <DiagramViewport id="road-poneglyphes-map" label="Schéma détaillé des quatre Road Ponéglyphes" minWidth={680}>
    <svg viewBox="0 0 800 560" class="schema-svg" role="img"
      aria-label="Schéma des quatre coordonnées spatiales des Road Ponéglyphes, dont les diagonales se croisent à Laugh Tale, avec une hypothèse temporelle séparée">
      <defs>
        <linearGradient id="sea" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#0c1b2b" />
          <stop offset="100%" stop-color="#081420" />
        </linearGradient>
        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="#e0ab4e" />
        </marker>
      </defs>
      <rect x="0" y="0" width="800" height="560" rx="16" fill="url(#sea)" />

      <!-- Intersection lines -->
      <line x1="190" y1="120" x2="610" y2="440" stroke="#5fb9c2" stroke-width="2" stroke-dasharray="6,4" opacity="0.4" />
      <line x1="610" y1="120" x2="190" y2="440" stroke="#5fb9c2" stroke-width="2" stroke-dasharray="6,4" opacity="0.4" />

      <!-- Laugh Tale at center -->
      <circle cx="400" cy="280" r="40" fill="#0e1722" stroke="#e0ab4e" stroke-width="2.5" />
      <text x="400" y="276" text-anchor="middle" fill="#e0ab4e" font-size="13" font-weight="800" font-family="Inter,system-ui,sans-serif">LAUGH</text>
      <text x="400" y="294" text-anchor="middle" fill="#e0ab4e" font-size="13" font-weight="800" font-family="Inter,system-ui,sans-serif">TALE</text>

      <!-- Four stones -->
      <g>
        <circle cx="190" cy="120" r="34" fill="#0e1722" stroke="#5fb9c2" stroke-width="2" />
        <text x="190" y="116" text-anchor="middle" fill="#5fb9c2" font-size="11" font-weight="700" font-family="Inter,system-ui,sans-serif">ROAD 1</text>
        <text x="190" y="132" text-anchor="middle" fill="#f3efe6" font-size="10" font-family="Inter,system-ui,sans-serif">Coordonnée</text>
        <text x="190" y="178" text-anchor="middle" fill="#8899aa" font-size="10" font-family="Inter,system-ui,sans-serif">point 1</text>
      </g>
      <g>
        <circle cx="610" cy="120" r="34" fill="#0e1722" stroke="#5fb9c2" stroke-width="2" />
        <text x="610" y="116" text-anchor="middle" fill="#5fb9c2" font-size="11" font-weight="700" font-family="Inter,system-ui,sans-serif">ROAD 2</text>
        <text x="610" y="132" text-anchor="middle" fill="#f3efe6" font-size="10" font-family="Inter,system-ui,sans-serif">Coordonnée</text>
        <text x="610" y="178" text-anchor="middle" fill="#8899aa" font-size="10" font-family="Inter,system-ui,sans-serif">point 2</text>
      </g>
      <g>
        <circle cx="190" cy="440" r="34" fill="#0e1722" stroke="#5fb9c2" stroke-width="2" />
        <text x="190" y="436" text-anchor="middle" fill="#5fb9c2" font-size="11" font-weight="700" font-family="Inter,system-ui,sans-serif">ROAD 3</text>
        <text x="190" y="452" text-anchor="middle" fill="#f3efe6" font-size="10" font-family="Inter,system-ui,sans-serif">Coordonnée</text>
        <text x="190" y="498" text-anchor="middle" fill="#8899aa" font-size="10" font-family="Inter,system-ui,sans-serif">point 3</text>
      </g>
      <g>
        <circle cx="610" cy="440" r="34" fill="#0e1722" stroke="#5fb9c2" stroke-width="2" />
        <text x="610" y="436" text-anchor="middle" fill="#5fb9c2" font-size="11" font-weight="700" font-family="Inter,system-ui,sans-serif">ROAD 4</text>
        <text x="610" y="452" text-anchor="middle" fill="#f3efe6" font-size="10" font-family="Inter,system-ui,sans-serif">Coordonnée</text>
        <text x="610" y="498" text-anchor="middle" fill="#8899aa" font-size="10" font-family="Inter,system-ui,sans-serif">point 4</text>
      </g>

      <!-- Temporal axis note -->
      <line x1="400" y1="90" x2="400" y2="40" stroke="#e0ab4e" stroke-width="2" marker-end="url(#arrow)" />
      <text x="400" y="30" text-anchor="middle" fill="#e0ab4e" font-size="11" font-weight="700" font-family="Inter,system-ui,sans-serif">mécanisme temporel ? (hypothèse séparée)</text>

      <text x="400" y="530" text-anchor="middle" fill="#8899aa" font-size="11" font-family="Inter,system-ui,sans-serif">Les quatre points sont spatiaux. Leur rôle temporel éventuel n'est pas confirmé.</text>
    </svg>
    </DiagramViewport>
    <figcaption>Géométrie établie : quatre positions spatiales et deux diagonales. L'axe temporel est affiché à part comme hypothèse de mécanisme, sans remplacer le quatrième point.</figcaption>
  </div>

  <div class="legend">
    <span><i class="dot" style="background:#5fb9c2"></i> 4 Road Ponéglyphes · coordonnées spatiales (manga)</span>
    <span><i class="dot" style="background:#e0ab4e"></i> Laugh Tale · croisement spatial (manga)</span>
    <span><i class="dot" style="background:#b07cc6"></i> Fonction temporelle éventuelle (hypothèse)</span>
  </div>

  <div class="linked">
    <a href="/theorie/road-poneglyphes">Fiche : Road Ponéglyphes →</a>
    <a href="/theorie/laugh-tale">Laugh Tale →</a>
    <a href="/theorie/lodestar">Lodestar →</a>
    <a href="/explorer/carte-blue-star">Carte de Blue Star →</a>
  </div>

  <Footer />
</WikiLayout>

<style>
  .page-header { margin-bottom: 28px; }
  .eyebrow { color: var(--violet-light); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
  .page-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 800; margin: 0 0 12px; line-height: 1.15; }
  .page-desc { font-size: 15px; color: var(--text-secondary); max-width: 780px; line-height: 1.65; }
  .page-desc strong { color: var(--text-main); }
  .schema { margin: 20px 0 12px; }
  .schema-svg { width: 100%; height: auto; border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); }
  figcaption { font-size: 12.5px; color: var(--text-muted); margin-top: 10px; }
  .legend { display: flex; flex-wrap: wrap; gap: 18px; padding: 12px 16px; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); font-size: 13px; color: var(--text-secondary); margin-bottom: 20px; }
  .legend span { display: inline-flex; align-items: center; gap: 7px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .linked { display: flex; flex-wrap: wrap; gap: 12px; }
  .linked a { color: var(--cyan); text-decoration: none; font-size: 14px; font-weight: 500; }
  .linked a:hover { text-decoration: underline; }
</style>
