---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface Row {
  id: string;
  sujet: string;
  traditionnel: string;
  fousDuBus: string;
  status: 'canon' | 'interpretation' | 'hypothese';
}

// Les deux lectures face à face. « Lecture traditionnelle » = comment l'histoire
// est généralement comprise sans la théorie ; « Fous du Bus » = la lecture proposée
// par le site. La colonne de statut indique le degré de certitude.
const rows: Row[] = [
  {
    id: 'siecle',
    sujet: 'Le Siècle oublié',
    traditionnel: 'Une période de 100 ans, effacée de l’histoire il y a environ 800 ans.',
    fousDuBus: 'Une période qui n’a pas encore eu lieu : l’histoire que Luffy est en train d’écrire.',
    status: 'interpretation',
  },
  {
    id: 'joyboy',
    sujet: 'Joy Boy',
    traditionnel: 'Un pirate légendaire du passé, auteur d’une promesse non tenue.',
    fousDuBus: 'Le nom que le monde donnera à Luffy après sa libération des peuples.',
    status: 'interpretation',
  },
  {
    id: 'poneglyphes',
    sujet: 'Les Ponéglyphes',
    traditionnel: 'Des stèles gravées dans le passé pour transmettre l’histoire et les coordonnées de Laugh Tale.',
    fousDuBus: 'Des textes rédigés dans le futur, transmis vers le passé : le mécanisme central de transmission.',
    status: 'interpretation',
  },
  {
    id: 'roger',
    sujet: 'Gol D. Roger',
    traditionnel: 'Le premier à atteindre Laugh Tale, « trop tôt » seulement par rapport à son époque.',
    fousDuBus: 'Roger est arrivé à Laugh Tale avant que le « présent » de la théorie ne soit écrit : il a vu le One Piece mais pas la fin.',
    status: 'hypothese',
  },
  {
    id: 'royaume',
    sujet: 'Le Royaume antique',
    traditionnel: 'Une civilisation ancienne, vaincue par le Gouvernement mondial.',
    fousDuBus: 'Le monde futur né après la guerre, que l’histoire appellera plus tard « antique ».',
    status: 'hypothese',
  },
  {
    id: 'vivi-lili',
    sujet: 'Vivi et Lili',
    traditionnel: 'Nefertari Vivi et Nefertari Lili sont deux membres éloignés de la même lignée.',
    fousDuBus: 'Vivi serait le nom sous lequel Lili est connue : une seule personne, lue à deux époques.',
    status: 'hypothese',
  },
  {
    id: 'davy',
    sujet: 'Davy Jones',
    traditionnel: 'Un pirate légendaire des profondeurs, origine du Davy Back Fight.',
    fousDuBus: 'Le titre que l’Histoire donnera à Marshall D. Teach, dernier héritier du clan Davy.',
    status: 'hypothese',
  },
  {
    id: 'grande-guerre',
    sujet: 'La Grande Guerre',
    traditionnel: 'Un événement passé qui a façonné le monde, et/ou une menace à venir.',
    fousDuBus: 'L’affrontement final en cours, entre la coalition de Luffy et le Gouvernement mondial d’Imu.',
    status: 'interpretation',
  },
];

const statusLabels: Record<string, string> = {
  canon: 'Établi par le manga',
  interpretation: 'Lecture de la théorie',
  hypothese: 'Hypothèse',
};

const statusColors: Record<string, string> = {
  canon: 'var(--cyan)',
  interpretation: 'var(--violet-light)',
  hypothese: 'var(--accent-gold)',
};
---

<WikiLayout
  title="Double chronologie : lecture traditionnelle et lecture des Fous du Bus"
  seoTitle="Double chronologie One Piece : lecture traditionnelle vs lecture des Fous du Bus | Les Fous du Bus"
  description="Face-à-face des deux lectures de l'histoire de One Piece : la lecture traditionnelle et la lecture des Fous du Bus, point par point, avec leur degré de certitude."
  currentPath="/explorer/chronologie-comparative"
>
  <div class="page-header">
    <p class="eyebrow">🕰️ Double lecture</p>
    <h1>Deux lectures de la même histoire</h1>
    <p class="page-desc">
      Le Siècle oublié se lit de deux façons. La <strong>lecture traditionnelle</strong> suit ce que le récit
      laisse croire au premier abord ; la <strong>lecture des Fous du Bus</strong> renverse plusieurs repères.
      Ce tableau les confronte, sujet par sujet, en précisant le degré de certitude de chaque lecture.
    </p>
  </div>

  <div class="table" role="table" aria-label="Comparaison des deux lectures de l'histoire">
    <div class="thead" role="row">
      <span class="col-sujet">Sujet</span>
      <span class="col-trad">Lecture traditionnelle</span>
      <span class="col-fdb">Lecture des Fous du Bus</span>
    </div>
    {rows.map((r) => (
      <div class="trow" role="row">
        <div class="cell cell--sujet">
          <strong>{r.sujet}</strong>
          <span class="cell--status" style={`color:${statusColors[r.status]}`}>{statusLabels[r.status]}</span>
        </div>
        <div class="cell cell--trad" data-label="Lecture traditionnelle">{r.traditionnel}</div>
        <div class="cell cell--fdb" data-label="Lecture des Fous du Bus">{r.fousDuBus}</div>
      </div>
    ))}
  </div>

  <p class="note">
    Ce tableau est un outil de lecture de la théorie. La colonne « Fous du Bus » rassemble des
    interprétations et des hypothèses, pas des faits canoniques — à distinguer de la colonne
    « traditionnelle », qui reprend le sens commun du récit.
  </p>

  <Footer />
</WikiLayout>

<style>
  .page-header { margin-bottom: 32px; }
  .eyebrow { color: var(--violet-light); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
  .page-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 800; margin: 0 0 12px; line-height: 1.15; }
  .page-desc { font-size: 15px; color: var(--text-secondary); max-width: 820px; line-height: 1.65; }
  .page-desc strong { color: var(--text-main); }

  .table { border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); overflow: hidden; margin: 24px 0 16px; }
  .thead, .trow { display: grid; grid-template-columns: 1fr 1.4fr 1.4fr; }
  .thead { background: var(--bg-secondary); border-bottom: 1px solid var(--border-color); }
  .thead span { padding: 12px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .thead .col-trad { border-left: 1px solid var(--border-color); }
  .thead .col-fdb { border-left: 1px solid var(--border-color); color: var(--violet-light); }
  .trow { border-bottom: 1px solid var(--border-color); }
  .trow:last-child { border-bottom: none; }
  .trow:hover { background: var(--bg-secondary); }
  .cell { padding: 14px; font-size: 13.5px; color: var(--text-secondary); line-height: 1.55; }
  .cell--sujet { display: flex; flex-direction: column; gap: 6px; }
  .cell--sujet strong { color: var(--text-main); font-size: 14px; }
  .cell--status { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .cell--trad { border-left: 1px solid var(--border-color); }
  .cell--fdb { border-left: 1px solid var(--border-color); color: var(--text-main); }
  .note { font-size: 12.5px; color: var(--text-muted); font-style: italic; line-height: 1.5; }

  @media (max-width: 760px) {
    .thead { display: none; }
    .trow { grid-template-columns: 1fr; gap: 6px; padding: 14px; }
    .cell { padding: 6px 0; border-left: none !important; }
    .cell--trad { border-top: 1px dashed var(--border-color); }
    .cell--trad::before, .cell--fdb::before {
      content: attr(data-label);
      display: block;
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
  }
</style>
