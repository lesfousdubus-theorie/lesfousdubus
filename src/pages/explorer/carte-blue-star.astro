---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import DiagramViewport from '@components/DiagramViewport.astro';
---

<WikiLayout
  title="Carte de Blue Star"
  seoTitle="Carte de Blue Star One Piece : Red Line et mers | Les Fous du Bus"
  description="Carte interactive de Blue Star : Red Line, les quatre mers, Grand Line, Reverse Mountain, Lodestar et la représentation de l'hypothèse Laugh Tale selon la théorie."
  currentPath="/explorer/carte-blue-star"
>
  <div class="page-header">
    <p class="eyebrow">🗺️ Géographie</p>
    <h1>La carte de Blue Star</h1>
    <p class="page-desc">
      Red Line et Grand Line découpent le globe en quatre Blues. Reverse Mountain donne accès à
      Grand Line ; Lodestar est la dernière destination indiquée par le Log Pose, après laquelle
      Roger a recherché l'île manquante. Le dessin est schématique : Red Line n'interdit pas à elle
      seule une circumnavigation.
    </p>
  </div>

  <figure class="map-wrap">
    <DiagramViewport id="blue-star-map" label="Carte détaillée de Blue Star" minWidth={680}>
      <svg
        viewBox="0 0 800 620"
        class="map-svg"
        role="img"
        aria-label="Schéma de Blue Star : Red Line verticale, Grand Line horizontale, les quatre mers, Reverse Mountain et Lodestar"
      >
        <defs>
          <radialGradient id="sea" cx="50%" cy="50%" r="60%">
            <stop offset="0%" stop-color="#0e2033"></stop>
            <stop offset="100%" stop-color="#081420"></stop>
          </radialGradient>
          <linearGradient id="redline" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#b0563a"></stop>
            <stop offset="100%" stop-color="#8f3b24"></stop>
          </linearGradient>
        </defs>

        <!-- Ocean -->
        <rect x="0" y="0" width="800" height="620" rx="18" fill="url(#sea)"></rect>

        <!-- Calm Belts (shadow zones) -->
        <rect x="330" y="0" width="18" height="620" fill="#1a2f44" opacity="0.55"></rect>
        <rect x="452" y="0" width="18" height="620" fill="#1a2f44" opacity="0.55"></rect>

        <!-- Grand Line (horizontal ocean) -->
        <rect x="0" y="292" width="800" height="48" fill="#163a54" opacity="0.85"></rect>
        <text
          x="12"
          y="322"
          fill="#5fb9c2"
          font-size="12"
          font-weight="700"
          font-family="Inter,system-ui,sans-serif">GRAND LINE</text
        >

        <!-- Red Line (vertical continent) -->
        <rect x="386" y="0" width="28" height="620" fill="url(#redline)"></rect>
        <text
          x="400"
          y="40"
          fill="#f3efe6"
          font-size="11"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif"
          transform="rotate(90 400 40)">RED LINE</text
        >
        <circle cx="400" cy="300" r="16" fill="#f3efe6" stroke="#b0563a" stroke-width="2"></circle>
        <text
          x="400"
          y="304"
          fill="#8f3b24"
          font-size="9"
          font-weight="800"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">MG</text
        >

        <!-- Four seas -->
        <text
          x="180"
          y="150"
          fill="#9fc8d8"
          font-size="13"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">North Blue</text
        >
        <text
          x="600"
          y="150"
          fill="#9fc8d8"
          font-size="13"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">West Blue</text
        >
        <text
          x="180"
          y="500"
          fill="#9fc8d8"
          font-size="13"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">East Blue</text
        >
        <text
          x="600"
          y="500"
          fill="#9fc8d8"
          font-size="13"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">South Blue</text
        >

        <!-- Reverse Mountain (top) -->
        <circle cx="400" cy="40" r="14" fill="#e0ab4e" stroke="#c98d2e" stroke-width="2"></circle>
        <text
          x="400"
          y="16"
          fill="#e0ab4e"
          font-size="10"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">Reverse Mountain</text
        >

        <!-- Lodestar: schematic point on Grand Line -->
        <circle cx="720" cy="316" r="11" fill="#b07cc6" stroke="#9a5fc0" stroke-width="2"></circle>
        <text
          x="720"
          y="286"
          fill="#b07cc6"
          font-size="10"
          font-weight="700"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">Lodestar</text
        >
        <text
          x="720"
          y="299"
          fill="#8a6f9e"
          font-size="9"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">position schématique</text
        >

        <!-- Laugh Tale: spatial position unknown -->
        <circle
          cx="665"
          cy="220"
          r="14"
          fill="none"
          stroke="#e0ab4e"
          stroke-width="1.5"
          stroke-dasharray="4,3"></circle>
        <text
          x="665"
          y="245"
          fill="#e0ab4e"
          font-size="10"
          font-weight="600"
          text-anchor="middle"
          font-family="Inter,system-ui,sans-serif">Laugh Tale : position inconnue</text
        >

        <!-- After Red Line falls -->
        <rect
          x="12"
          y="540"
          width="776"
          height="64"
          rx="12"
          fill="#0e1722"
          stroke="#e0ab4e"
          stroke-width="1"
          opacity="0.9"></rect>
        <text
          x="24"
          y="566"
          fill="#e0ab4e"
          font-size="12"
          font-weight="700"
          font-family="Inter,system-ui,sans-serif">Évolution géographique possible</text
        >
        <text x="24" y="586" fill="#aeb7c2" font-size="11" font-family="Inter,system-ui,sans-serif"
          >Une ouverture de Red Line pourrait relier des mers et contribuer à All Blue ; l'ordre et
          le mécanisme restent ouverts.</text
        >
      </svg>
    </DiagramViewport>
    <figcaption>
      Schéma non à l'échelle. Lodestar est placée sur Grand Line à titre pédagogique ; la position
      de Laugh Tale reste inconnue. Le pointillé et le bandeau bas restent schématiques.
    </figcaption>
  </figure>

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: 32px;
  }
  .eyebrow {
    color: var(--violet-light);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 12px;
    line-height: 1.15;
  }
  .page-desc {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.65;
  }
  .map-wrap {
    margin: 24px 0 16px;
  }
  .map-svg {
    width: 100%;
    height: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
  }
  figcaption {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: 10px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding: 12px 16px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    font-size: 13px;
    color: var(--text-secondary);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  @media (prefers-reduced-motion: reduce) {
    .map-svg {
      animation: none;
    }
  }
</style>
