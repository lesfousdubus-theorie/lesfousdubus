---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface Identity {
  label: string;
  href: string;
  type: 'moderne' | 'legendaire' | 'divin';
}

interface Pair {
  id: string;
  description: string;
  status: 'canon' | 'theorie-noyau' | 'theorie-consequence';
  modern: Identity;
  legendary: Identity;
  divine?: Identity;
  note?: string;
}

const pairs: Pair[] = [
  {
    id: 'luffy-joy-boy-nika',
    description:
      "Trois noms pour un même homme : le garçon de Fusha (Luffy), le nom sous lequel l'Histoire le retiendra (Joy Boy), et le nom sous lequel les croyants le vénèrent (Nika).",
    status: 'theorie-noyau',
    modern: { label: 'Monkey D. Luffy', href: '/theorie/luffy', type: 'moderne' },
    legendary: { label: 'Joy Boy', href: '/theorie/joy-boy', type: 'legendaire' },
    divine: { label: 'Nika', href: '/theorie/nika', type: 'divin' },
    note: 'Luffy ne devient pas Joy Boy : Joy Boy est le nom que le monde donnera à Luffy après son aventure. Nika est le nom de la foi que les peuples opprimés placent en lui.',
  },
  {
    id: 'shirahoshi-poseidon',
    description:
      "La princesse sirène du royaume Ryugu est l'arme antique Poséidon, capable de commander les Rois des Mers.",
    status: 'canon',
    modern: { label: 'Shirahoshi', href: '/theorie/shirahoshi', type: 'moderne' },
    legendary: { label: 'Poséidon', href: '/theorie/poseidon-fiche', type: 'legendaire' },
    note: 'Canon établi par le manga. Shirahoshi est la réincarnation actuelle de Poséidon, un pouvoir qui se transmet dans la lignée royale de Ryugu tous les quelques siècles.',
  },
  {
    id: 'vivi-lili',
    description:
      "La reine d'Alabasta qui refusa Mary Geoise et dispersa les Ponéglyphes. Selon la théorie, Lili pourrait être le nom sous lequel Vivi entrera dans l'Histoire.",
    status: 'theorie-consequence',
    modern: { label: 'Nefertari Vivi', href: '/theorie/nefertari-vivi', type: 'moderne' },
    legendary: { label: 'Nefertari D. Lili', href: '/theorie/lili', type: 'legendaire' },
    note: 'La ressemblance visuelle (cheveux bleus, silhouette au ch. 1085) et le parallèle narratif (disparition après le conseil des rois) sont les principaux indices.',
  },
  {
    id: 'teach-davy-jones',
    description:
      "Le démon des mers, roi du monde légendaire. Selon la théorie, Davy Jones serait le titre que l'Histoire donnera à Marshall D. Teach.",
    status: 'theorie-consequence',
    modern: { label: 'Marshall D. Teach', href: '/theorie/teach', type: 'moderne' },
    legendary: { label: 'Davy Jones', href: '/theorie/davy-jones-fiche', type: 'legendaire' },
    note: 'Imu aurait confondu Rocks D. Xebec avec Davy Jones sur God Valley — la même mécanique de confusion générationnelle que pour Roger/Joy Boy.',
  },
  {
    id: 'zoro-ryuma',
    description:
      'Le dieu des lames de Wa no Kuni. La théorie propose que Ryuma soit la légende que les exploits de Zoro auront transmise vers le passé.',
    status: 'theorie-consequence',
    modern: { label: 'Roronoa Zoro', href: '/theorie/zoro', type: 'moderne' },
    legendary: { label: 'Shimotsuki Ryuma', href: '/theorie/shimotsuki-ryuma', type: 'legendaire' },
    note: 'Identification plus spéculative que le noyau géographique ou la lecture des Ponéglyphes. Zoro descend du clan Shimotsuki et a déjà affronté un dragon comme Ryuma.',
  },
  {
    id: 'brook-dozan',
    description:
      'Une piste récente suggère que Brook pourrait avoir composé Binks no Sake sous le nom de Dōzan, expliquant la présence universelle de cette chanson.',
    status: 'theorie-consequence',
    modern: { label: 'Brook', href: '/theorie/brook', type: 'moderne' },
    legendary: { label: 'Dōzan', href: '/theorie/dozan', type: 'legendaire' },
    note: 'Piste ouverte par les chapitres 1183-1184. Binks no Sake aurait été composée dans le futur, puis transmise vers le passé.',
  },
  {
    id: 'loki-nidhogg',
    description:
      "Le prince maudit d'Elbaf et le serpent qui ronge les racines de l'arbre-monde. La théorie lit Nidhogg comme la trace laissée dans la mythologie des géants par ce que Loki fera.",
    status: 'theorie-consequence',
    modern: { label: 'Loki', href: '/theorie/loki', type: 'moderne' },
    legendary: { label: 'Nidhogg', href: '/theorie/nidhogg-ratatoskr', type: 'legendaire' },
    note: "Elbaf traite déjà Loki comme une figure démoniaque annoncée par ses propres textes sacrés : la prophétie et l'accusation se confondent.",
  },
  {
    id: 'usopp-louis-arnot',
    description:
      "Le corpus sacré d'Elbaf décrit un passé, un présent et un futur. La théorie propose qu'il ait été écrit par Usopp, sous le nom d'auteur Louis Arnot.",
    status: 'theorie-consequence',
    modern: { label: 'Usopp', href: '/theorie/elbaf-harley', type: 'moderne' },
    legendary: { label: 'Louis Arnot', href: '/theorie/elbaf-harley', type: 'legendaire' },
    note: "Le Harley est consultable par les doyens d'Elbaf : ce n'est pas un vestige enfoui mais un texte vivant, ce qui rend possible une rédaction récente projetée vers le passé.",
  },
  {
    id: 'momonosuke-rio-poneglyphe',
    description:
      "L'héritier des Kozuki, seul clan capable de graver les Ponéglyphes, et le texte qui rassemble toute l'Histoire vraie.",
    status: 'theorie-consequence',
    modern: { label: 'Kozuki Momonosuke', href: '/theorie/momonosuke', type: 'moderne' },
    legendary: { label: 'Rio Ponéglyphe', href: '/theorie/rio-poneglyphe', type: 'legendaire' },
    note: "Si le Rio Ponéglyphe est le récit de l'aventure en cours, il faut quelqu'un pour le graver : le dernier Kozuki est le seul à en avoir la compétence.",
  },
  {
    id: 'franky-emeth',
    description:
      "Le charpentier des Mugiwaras et le robot géant de l'Ancien Royaume, présenté par la théorie comme son dernier Battle Franky envoyé dans le passé.",
    status: 'theorie-consequence',
    modern: { label: 'Franky', href: '/theorie/emeth-futur', type: 'moderne' },
    legendary: { label: 'Emeth', href: '/theorie/emeth-futur', type: 'legendaire' },
    note: "Armature, engrenages et épaulières rapprochent Emeth du Franky Shogun ; son énergie autonome est celle qu'aucun savant contemporain ne sait reproduire.",
  },
];

const statusLabels: Record<string, string> = {
  canon: 'Établi par le manga',
  'theorie-noyau': 'Noyau de la théorie',
  'theorie-consequence': 'Conséquence de la théorie',
};

const statusColors: Record<string, string> = {
  canon: 'var(--cyan)',
  'theorie-noyau': 'var(--violet-light)',
  'theorie-consequence': 'var(--accent-gold)',
};
---

<WikiLayout
  title="Correspondances interactives"
  seoTitle="Correspondances : Luffy/Joy Boy, Vivi/Lili | Les Fous du Bus"
  description="Correspondances interactives de la théorie : qui est qui ? Filtrez Luffy → Joy Boy → Nika, Vivi → Lili, Teach → Davy Jones, Zoro → Ryuma et les autres identités."
  currentPath="/explorer/correspondances"
>
  <div class="page-header">
    <p class="eyebrow">🔗 Tableau des identités</p>
    <h1>Correspondances proposées par la théorie</h1>
    <p class="page-desc">
      La théorie propose plusieurs correspondances entre personnages du présent et figures
      légendaires du passé. Chaque relation est accompagnée d’un niveau de certitude. Luffy ↔ Joy
      Boy ↔ Nika est au cœur de la théorie.
    </p>
  </div>

  <div class="filters" data-correspondence-filters data-pagefind-ignore hidden>
    <span class="filters__label">Filtrer par niveau</span>
    <div class="filters__buttons" role="group" aria-label="Filtrer les correspondances">
      <button type="button" data-filter="all" aria-pressed="true">Toutes</button>
      <button type="button" data-filter="canon" aria-pressed="false">Canon</button>
      <button type="button" data-filter="theorie-noyau" aria-pressed="false">Noyau</button>
      <button type="button" data-filter="theorie-consequence" aria-pressed="false"
        >Conséquences</button
      >
    </div>
    <p class="filters__status" role="status" aria-live="polite"></p>
  </div>

  <div class="pairs">
    {
      pairs.map((pair) => (
        <section class="pair" id={pair.id} data-pair-status={pair.status}>
          <div class="pair__head">
            <h2 class="pair__title">
              <a href={pair.modern.href}>{pair.modern.label}</a>
              <span class="pair__arrow">→</span>
              <a href={pair.legendary.href}>{pair.legendary.label}</a>
              {pair.divine && (
                <>
                  <span class="pair__arrow">→</span>
                  <a href={pair.divine.href}>{pair.divine.label}</a>
                </>
              )}
            </h2>
            <span
              class="pair__status"
              style={`color:${statusColors[pair.status]}; border-color:${statusColors[pair.status]}`}
            >
              {statusLabels[pair.status]}
            </span>
          </div>

          <p class="pair__desc">{pair.description}</p>

          <div class="pair__cols">
            <div class="pair__col pair__col--moderne">
              <span class="pair__col-type" style="color:#5fb9c2; border-color:#5fb9c2">
                Présent du manga
              </span>
              <a href={pair.modern.href} class="pair__col-link">
                <strong>{pair.modern.label}</strong>
              </a>
            </div>
            <div class="pair__col-arrow">→</div>
            <div class="pair__col pair__col--legendaire">
              <span class="pair__col-type" style="color:#e0ab4e; border-color:#e0ab4e">
                Nom légendaire
              </span>
              <a href={pair.legendary.href} class="pair__col-link">
                <strong>{pair.legendary.label}</strong>
              </a>
            </div>
            {pair.divine && (
              <>
                <div class="pair__col-arrow">→</div>
                <div class="pair__col pair__col--divin">
                  <span class="pair__col-type" style="color:#b07cc6; border-color:#b07cc6">
                    Nom divin / foi
                  </span>
                  <a href={pair.divine.href} class="pair__col-link">
                    <strong>{pair.divine.label}</strong>
                  </a>
                </div>
              </>
            )}
          </div>

          {pair.note && <blockquote class="pair__note">{pair.note}</blockquote>}
        </section>
      ))
    }
  </div>

  <Footer />
</WikiLayout>

<script>
  const filterRoot = document.querySelector<HTMLElement>('[data-correspondence-filters]');
  const filterButtons = Array.from(
    filterRoot?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [],
  );
  const pairCards = Array.from(document.querySelectorAll<HTMLElement>('[data-pair-status]'));
  const filterStatus = filterRoot?.querySelector<HTMLElement>('[role="status"]');

  if (filterRoot && filterButtons.length && pairCards.length) {
    filterRoot.hidden = false;
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        let visible = 0;
        filterButtons.forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        pairCards.forEach((pair) => {
          const matches = filter === 'all' || pair.dataset.pairStatus === filter;
          pair.hidden = !matches;
          if (matches) visible += 1;
        });
        if (filterStatus) {
          filterStatus.textContent = `${visible} correspondance${visible > 1 ? 's' : ''} affichée${visible > 1 ? 's' : ''}.`;
        }
      });
    });
  }
</script>

<style>
  .page-header {
    margin-bottom: 40px;
  }
  .eyebrow {
    color: var(--violet-light);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 12px;
    line-height: 1.15;
  }
  .page-desc {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.65;
  }
  .filters {
    margin: -12px 0 28px;
    padding: 14px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--bg-secondary);
  }
  .filters__label {
    display: block;
    margin-bottom: 10px;
    color: var(--text-main);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .filters__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filters button {
    min-height: 40px;
    padding: 8px 13px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-full);
    background: var(--bg-main);
    color: var(--text-secondary);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .filters button:hover,
  .filters button[aria-pressed='true'] {
    border-color: var(--cyan);
    color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 10%, var(--bg-main));
  }
  .filters button:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  .filters__status {
    min-height: 1.4em;
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 12px;
  }
  .pairs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .pair {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--gradient-card);
    padding: 24px;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .pair__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }
  .pair__title {
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    flex-wrap: wrap;
  }
  .pair__title a {
    color: var(--cyan);
    text-decoration: none;
    transition: text-decoration 0.2s;
    white-space: nowrap;
  }
  .pair__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pair__arrow {
    color: var(--text-muted);
    font-weight: 300;
    font-size: 1.1rem;
  }
  .pair__status {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid;
    background: transparent;
  }
  .pair__desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 20px;
  }
  .pair__cols {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pair__cols::-webkit-scrollbar {
    display: none;
  }
  .pair__col {
    flex: 1;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 18px 12px;
    border: 1px solid var(--border-color);
    background: var(--bg-main);
  }
  .pair__col:first-child {
    border-radius: 12px 0 0 12px;
  }
  .pair__col:last-child {
    border-radius: 0 12px 12px 0;
  }
  .pair__col-type {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid;
  }
  .pair__col-link {
    text-decoration: none;
    color: var(--text-main);
    text-align: center;
    font-size: 15px;
    transition: color 0.2s;
  }
  .pair__col-link:hover {
    color: var(--cyan);
  }
  .pair__col-arrow {
    display: flex;
    align-items: center;
    padding: 0 8px;
    color: var(--violet-light);
    font-size: 1.2rem;
    font-weight: 300;
    flex-shrink: 0;
  }
  .pair__note {
    border-left: 3px solid var(--violet);
    padding: 10px 14px;
    margin: 0;
    color: var(--text-secondary);
    font-style: italic;
    font-size: 13px;
    line-height: 1.55;
    background: color-mix(in srgb, var(--violet) 5%, transparent);
    border-radius: 0 8px 8px 0;
  }
  @media (max-width: 640px) {
    .filters button {
      min-height: 44px;
    }
    .pair {
      padding: 18px;
    }
    .pair__cols {
      flex-direction: column;
    }
    .pair__col:first-child,
    .pair__col:last-child {
      border-radius: 8px;
    }
    .pair__col-arrow {
      transform: rotate(90deg);
      padding: 4px 0;
    }
  }
</style>
