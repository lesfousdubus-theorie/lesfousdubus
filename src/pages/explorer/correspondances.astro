---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface Identity {
  label: string;
  href: string;
  type: 'moderne' | 'legendaire' | 'divin';
}

interface Pair {
  id: string;
  description: string;
  status: 'manga' | 'theorie-centrale' | 'extension' | 'hypothese-recente' | 'projection';
  relation: string;
  modern: Identity;
  legendary: Identity;
  divine?: Identity;
  note?: string;
}

const pairs: Pair[] = [
  {
    id: 'luffy-joy-boy-nika',
    description:
      'Luffy éveille le Fruit modèle Nika et plusieurs personnages le rapprochent de Joy Boy. Joy Boy reste aussi une personne historique du Royaume antique et Luffy affirme son identité propre.',
    status: 'extension',
    relation: 'rapproché de',
    modern: { label: 'Monkey D. Luffy', href: '/theorie/luffy', type: 'moderne' },
    legendary: { label: 'Joy Boy', href: '/theorie/joy-boy', type: 'legendaire' },
    divine: { label: 'Nika', href: '/theorie/nika', type: 'divin' },
    note: 'À Elbaf, Imu appelle Luffy « Joy Boy » ; Luffy répond être Monkey D. Luffy. Une future appellation Joy Boy reste une extension, pas une réincarnation établie.',
  },
  {
    id: 'shirahoshi-poseidon',
    description: 'La princesse sirène est la Poséidon actuelle et commande les Rois des Mers.',
    status: 'manga',
    relation: '=',
    modern: { label: 'Shirahoshi', href: '/theorie/shirahoshi', type: 'moderne' },
    legendary: { label: 'Poséidon', href: '/theorie/poseidon-fiche', type: 'legendaire' },
    note: 'Identification établie. Son rôle avec Noah, Red Line ou la guerre finale reste projeté.',
  },
  {
    id: 'vivi-lili',
    description:
      'Lili est historiquement liée à la dispersion des Ponéglyphes. Vivi pourrait accomplir dans le futur un rôle analogue, sans être démontrée comme la même personne.',
    status: 'projection',
    relation: 'rôle analogue ?',
    modern: { label: 'Nefertari Vivi', href: '/theorie/nefertari-vivi', type: 'moderne' },
    legendary: { label: 'Nefertari D. Lili', href: '/theorie/lili', type: 'legendaire' },
    note: 'La ressemblance et les parallèles narratifs ne prouvent ni identité commune, ni cheveux de Lili, ni retour temporel.',
  },
  {
    id: 'teach-davy-jones',
    description:
      'Les noms Teach, Xebec et Davy Jones alimentent un motif possible d’erreur d’identité chez Imu.',
    status: 'hypothese-recente',
    relation: 'confondu avec ?',
    modern: { label: 'Marshall D. Teach', href: '/theorie/teach', type: 'moderne' },
    legendary: { label: 'Davy Jones', href: '/theorie/davy-jones-fiche', type: 'legendaire' },
    note: 'Branche récente : ni identité ni titre futur ne sont établis.',
  },
  {
    id: 'roger-joy-boy',
    description:
      'Une branche antérieure attribuait une silhouette à Roger jeune et envisageait une confusion Roger/Joy Boy.',
    status: 'hypothese-recente',
    relation: '≠ au ch. 1190',
    modern: { label: 'Gol D. Roger', href: '/theorie/gol-d-roger', type: 'moderne' },
    legendary: { label: 'Joy Boy', href: '/theorie/joy-boy', type: 'legendaire' },
    note: 'Le texte disponible du chapitre 1190 montre Imu distinguant Roger de Joy Boy : objection majeure à la confusion simple. La branche reste évolutive, mise à jour au 1188–1190.',
  },
  {
    id: 'zoro-ryuma',
    description:
      'Zoro pourrait accomplir un exploit analogue à Ryuma ; le transport de son corps ou de ses sabres vers le passé est une projection avancée.',
    status: 'projection',
    relation: 'pourrait rappeler',
    modern: { label: 'Roronoa Zoro', href: '/theorie/zoro', type: 'moderne' },
    legendary: { label: 'Shimotsuki Ryuma', href: '/theorie/shimotsuki-ryuma', type: 'legendaire' },
    note: 'Zoro a blessé Kaido sur Onigashima. Le corps de Ryuma, Shusui et l’abandon d’autres sabres ne sont pas des faits futurs établis.',
  },
  {
    id: 'brook-dozan',
    description:
      'Les chapitres 1183–1184 ouvrent une piste entre Brook, Dōzan et une version ancienne de Binks no Sake.',
    status: 'hypothese-recente',
    relation: 'lié à ?',
    modern: { label: 'Brook', href: '/theorie/brook', type: 'moderne' },
    legendary: { label: 'Dōzan', href: '/theorie/dozan', type: 'legendaire' },
    note: 'Brook n’est pas certifié Dōzan ni auteur unique de la chanson. Sa chronologie se situe environ entre −80 et −50.',
  },
  {
    id: 'loki-nidhogg',
    description:
      'Loki pourrait inspirer ou accomplir le motif de Nidhogg dans une lecture future de la mythologie d’Elbaf.',
    status: 'hypothese-recente',
    relation: 'pourrait devenir',
    modern: { label: 'Loki', href: '/theorie/loki', type: 'moderne' },
    legendary: { label: 'Nidhogg', href: '/theorie/nidhogg-ratatoskr', type: 'legendaire' },
    note: 'L’identité Loki/Nidhogg et le modèle exact de son Fruit restent ouverts.',
  },
  {
    id: 'usopp-louis-arnot',
    description:
      'Usopp pourrait écrire ou transmettre un texte associé à Louis Arnot ou au Harley.',
    status: 'projection',
    relation: 'pourrait écrire comme',
    modern: { label: 'Usopp', href: '/theorie/elbaf-harley', type: 'moderne' },
    legendary: { label: 'Louis Arnot', href: '/theorie/elbaf-harley', type: 'legendaire' },
    note: 'Branche distincte du mécanisme central des Ponéglyphes ; aucune identité commune n’est établie.',
  },
  {
    id: 'franky-emeth',
    description:
      'Emeth pourrait être un Battle Franky construit dans le futur puis transporté physiquement, branche plus avancée que la transmission d’information.',
    status: 'projection',
    relation: 'BF-39 ?',
    modern: { label: 'Franky / BF-39', href: '/theorie/emeth-futur', type: 'moderne' },
    legendary: { label: 'Emeth', href: '/theorie/emeth-futur', type: 'legendaire' },
    note: 'Manga : le Haki stocké dans Emeth est attribué au Joy Boy historique. Théorie conditionnelle : il pourrait provenir du Luffy de fin d’aventure.',
  },
];
---

<WikiLayout
  title="Correspondances interactives"
  seoTitle="Correspondances : Luffy/Joy Boy, Vivi/Lili | Les Fous du Bus"
  description="Correspondances interactives : identités établies, parallèles, hypothèses récentes et projections clairement séparées."
  currentPath="/explorer/correspondances"
>
  <div class="page-header">
    <p class="eyebrow">🔗 Tableau des identités</p>
    <h1>Correspondances proposées par la théorie</h1>
    <p class="page-desc">
      Une flèche ne signifie plus automatiquement « même personne ». Chaque relation précise s'il
      s'agit d'une identité établie, d'un rapprochement, d'une hypothèse récente ou d'une
      projection. Le mécanisme central reste la transmission d'information par les Ponéglyphes ; ces
      correspondances en sont des branches.
    </p>
  </div>

  <div class="pairs">
    {
      pairs.map((pair) => (
        <section class="pair" id={pair.id} data-pair-status={pair.status}>
          <div class="pair__head">
            <h2 class="pair__title">
              <a href={pair.modern.href}>{pair.modern.label}</a>
              <span class="pair__arrow">{pair.relation}</span>
              <a href={pair.legendary.href}>{pair.legendary.label}</a>
              {pair.divine && (
                <>
                  <span class="pair__arrow">· lié à ·</span>
                  <a href={pair.divine.href}>{pair.divine.label}</a>
                </>
              )}
            </h2>
          </div>

          <p class="pair__desc">{pair.description}</p>

          <div class="pair__cols">
            <div class="pair__col pair__col--moderne">
              <span class="pair__col-type" style="color:#5fb9c2; border-color:#5fb9c2">
                Figure de référence
              </span>
              <a href={pair.modern.href} class="pair__col-link">
                <strong>{pair.modern.label}</strong>
              </a>
            </div>
            <div class="pair__col-arrow">{pair.relation}</div>
            <div class="pair__col pair__col--legendaire">
              <span class="pair__col-type" style="color:#e0ab4e; border-color:#e0ab4e">
                Figure comparée
              </span>
              <a href={pair.legendary.href} class="pair__col-link">
                <strong>{pair.legendary.label}</strong>
              </a>
            </div>
            {pair.divine && (
              <>
                <div class="pair__col-arrow">·</div>
                <div class="pair__col pair__col--divin">
                  <span class="pair__col-type" style="color:#b07cc6; border-color:#b07cc6">
                    Nom divin / foi
                  </span>
                  <a href={pair.divine.href} class="pair__col-link">
                    <strong>{pair.divine.label}</strong>
                  </a>
                </div>
              </>
            )}
          </div>

          {pair.note && <blockquote class="pair__note">{pair.note}</blockquote>}
        </section>
      ))
    }
  </div>

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: 40px;
  }
  .eyebrow {
    color: var(--violet-light);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 12px;
    line-height: 1.15;
  }
  .page-desc {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.65;
  }
  .pairs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .pair {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--gradient-card);
    padding: 24px;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .pair__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }
  .pair__title {
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    flex-wrap: wrap;
  }
  .pair__title a {
    color: var(--cyan);
    text-decoration: none;
    transition: text-decoration 0.2s;
    white-space: nowrap;
  }
  .pair__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pair__arrow {
    color: var(--text-muted);
    font-weight: 300;
    font-size: 1.1rem;
  }
  .pair__desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 20px;
  }
  .pair__cols {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pair__cols::-webkit-scrollbar {
    display: none;
  }
  .pair__col {
    flex: 1;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 18px 12px;
    border: 1px solid var(--border-color);
    background: var(--bg-main);
  }
  .pair__col:first-child {
    border-radius: 12px 0 0 12px;
  }
  .pair__col:last-child {
    border-radius: 0 12px 12px 0;
  }
  .pair__col-type {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid;
  }
  .pair__col-link {
    text-decoration: none;
    color: var(--text-main);
    text-align: center;
    font-size: 15px;
    transition: color 0.2s;
  }
  .pair__col-link:hover {
    color: var(--cyan);
  }
  .pair__col-arrow {
    display: flex;
    align-items: center;
    padding: 0 8px;
    color: var(--violet-light);
    font-size: 1.2rem;
    font-weight: 300;
    flex-shrink: 0;
  }
  .pair__note {
    border-left: 3px solid var(--violet);
    padding: 10px 14px;
    margin: 0;
    color: var(--text-secondary);
    font-style: italic;
    font-size: 13px;
    line-height: 1.55;
    background: color-mix(in srgb, var(--violet) 5%, transparent);
    border-radius: 0 8px 8px 0;
  }
  @media (max-width: 640px) {
    .pair {
      padding: 18px;
    }
    .pair__cols {
      flex-direction: column;
    }
    .pair__col:first-child,
    .pair__col:last-child {
      border-radius: 8px;
    }
    .pair__col-arrow {
      transform: rotate(90deg);
      padding: 4px 0;
    }
  }
</style>
