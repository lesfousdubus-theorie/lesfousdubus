---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
---

<WikiLayout title="Carte mentale" seoTitle="Carte mentale One Piece : la chaîne causale de la théorie | Les Fous du Bus" description="Carte mentale causale de la théorie des Fous du Bus : Blue Star → Laugh Tale → temps → Ponéglyphes → Siècle oublié → Joy Boy → peuples & armes → Imu → guerre finale → All Blue / One Piece." image="/og-carte-mentale.png" currentPath="/explorer/carte-mentale">
  <div class="page-header">
    <div class="eyebrow">🧠 Carte causale</div>
    <h1>Carte mentale de la théorie</h1>
    <p class="page-desc">
      Une lecture causale de la théorie, de la géographie de Blue Star jusqu'au One Piece.
      Chaque nœud renvoie vers la fiche correspondante. Les couleurs reprennent les quatre
      niveaux du <a href="/theorie/theorie-complete#niveaux-de-lecture">chapitre&nbsp;21</a>&nbsp;:
      <span class="legend"><span class="dot dot--canon"></span> fait établi</span>
      <span class="legend"><span class="dot dot--central"></span> noyau de la théorie</span>
      <span class="legend"><span class="dot dot--elevee"></span> conséquence</span>
      <span class="legend"><span class="dot dot--hypothese"></span> mécanisme spéculatif</span>
    </p>
  </div>

  <!-- Mind map container -->
  <div class="mindmap-wrapper" id="mindmap-wrapper">
    <div class="mindmap-controls">
      <button id="zoom-in" class="control-btn" aria-label="Zoom avant">+</button>
      <button id="zoom-out" class="control-btn" aria-label="Zoom arrière">−</button>
      <button id="zoom-reset" class="control-btn" aria-label="Réinitialiser">⟲</button>
    </div>
    <svg
      id="mindmap-svg"
      viewBox="0 0 1400 900"
      class="mindmap-svg"
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label="Carte causale interactive de la théorie. Chaque nœud ouvre une fiche détaillée."
    >
      <defs>
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
        </marker>
      </defs>
      <g id="connections"></g>
      <g id="nodes"></g>
    </svg>
  </div>

  <!-- Version textuelle de la carte causale -->
  <section class="textual" aria-label="Version textuelle de la carte causale">
    <h2>La chaîne causale, de la géographie au trésor</h2>
    <ol class="chain">
      <li><a href="/theorie/blue-star"><strong>Blue Star</strong></a> — une planète à 90 % d'eau, coupée en deux par la Red Line. Le point de départ est <em>géographique</em>, pas temporel.</li>
      <li><a href="/theorie/laugh-tale"><strong>Laugh Tale</strong></a> — la dernière île, que personne n'a retrouvée en huit cents ans. L'impossibilité géographique de faire le tour du monde (trois Red Line sans issue) est le premier indice. Pourquoi reste-t-elle introuvable ?</li>
      <li><a href="/theorie/road-poneglyphes"><strong>La quatrième coordonnée : le temps</strong></a> — et si le problème n'était pas <em>où</em> est le One Piece, mais <em>quand</em> il est ? Les Road Ponéglyphes encoderaient une coordonnée temporelle.</li>
      <li><a href="/theorie/poneglyphes"><strong>Les Ponéglyphes</strong></a> — stèles indestructibles gravées depuis huit cents ans… qui raconteraient en réalité l'avenir. C'est le mécanisme fondamental : la mémoire de l'avenir.</li>
      <li><a href="/theorie/siecle-oublie"><strong>Le Siècle oublié</strong></a> — les cent ans effacés par le Gouvernement mondial ne seraient pas un passé disparu ; ils seraient en train de se produire maintenant, sous nos yeux.</li>
      <li><a href="/theorie/royaume-antique"><strong>Le Royaume antique</strong></a> — <em>conséquence envisagée par la théorie</em> : ce que le monde croit être une civilisation perdue pourrait être le monde à construire par Luffy et ses alliés. Les technologies « antiques » pourraient alors être moins des reliques à exhumer que des inventions à venir.</li>
      <li><a href="/theorie/joy-boy"><strong>Joy Boy</strong></a> / <a href="/theorie/nika">Nika</a> / <a href="/theorie/luffy">Luffy</a> — <em>noyau de la théorie</em> : Joy Boy, Nika et Luffy désigneraient trois regards sur une même figure à la fin de l’aventure. Les peuples ont attendu un libérateur ; Luffy pourrait devenir celui que l’Histoire nommera Joy Boy.</li>
      <li><a href="/theorie/peuples-royaumes"><strong>Peuples & missions</strong></a> — Ryugu, Wa no Kuni, les Minks, les Shandias, les Boucaniers, les géants d'Elbaf : chacun conserve depuis huit siècles une mission qui prépare le Jour du Serment. Les <a href="/theorie/armes-antiques">Armes antiques</a> (Poséidon, Pluton, Uranus) en font partie.</li>
      <li><a href="/theorie/imu-nerona"><strong>Imu</strong></a> — souverain caché du monde, il craint non pas son passé mais son avenir. La théorie envisage que la préscience puisse expliquer pourquoi il confond les générations (Xebec/Davy Jones, Titi/Vivi, Roger/Joy Boy) et persécute tous ceux qui ressemblent à la silhouette qu'il a vue.</li>
      <li><a href="/theorie/guerre-finale"><strong>Guerre finale</strong></a> — la coalition de Joy Boy contre le Gouvernement mondial. Red Line tombe, la mer monte (Déluge), Noah évacue les Hommes-Poissons.</li>
      <li><a href="/theorie/all-blue"><strong>All Blue</strong></a> & <a href="/theorie/one-piece-histoire"><strong>One Piece</strong></a> — les quatre mers se rejoignent en une seule pièce, et le trésor de Laugh Tale serait l'histoire elle-même, celle que nous lisons depuis le chapitre 1. Le début côtoie la fin.</li>
    </ol>
  </section>

  <Footer />
</WikiLayout>

<script>
  // @ts-nocheck
  // ─── Causal chain data ──────────────────────────────────────
  // Left-to-right flowing causal path, organized in "lanes" that zig-zag
  // vertically to fill the SVG width nicely.
  const W = 1400, H = 900;

  // 11 main nodes in order, each with {slug, title, color, certainty, size}
  const chain = [
    { slug: 'blue-star',           title: 'Blue Star',                  level: 'central',   x: 120,  y: 200 },
    { slug: 'laugh-tale',          title: 'Laugh Tale',                 level: 'central',   x: 270,  y: 380 },
    { slug: 'road-poneglyphes',     title: 'Quatrième\ncoordonnée : temps', level: 'elevee', x: 420,  y: 200 },
    { slug: 'poneglyphes',          title: 'Ponéglyphes',                level: 'central',   x: 560,  y: 380 },
    { slug: 'siecle-oublie',       title: 'Siècle oublié',              level: 'central',   x: 700,  y: 200 },
    { slug: 'royaume-antique',     title: 'Conséquence :\nRoyaume antique',            level: 'elevee',    x: 840,  y: 380 },
    { slug: 'joy-boy',             title: 'Noyau : Joy Boy /\nNika / Luffy',    level: 'central',   x: 980,  y: 200 },
    { slug: 'peuples-royaumes',    title: 'Peuples, missions\n& Armes antiques', level: 'elevee', x: 1120, y: 380 },
    { slug: 'imu-nerona',    title: 'Imu',                        level: 'central',   x: 980,  y: 600 },
    { slug: 'guerre-finale',       title: 'Guerre finale',              level: 'elevee',    x: 700,  y: 700 },
    { slug: 'all-blue',            title: 'All Blue &\nOne Piece',      level: 'hypothese', x: 420,  y: 600 },
  ];

  // Sub-nodes branching off a main node
  const subs = [
    { parent: 'laugh-tale',       slug: 'lodestar',         title: 'Lodestar',         x: 220, y: 510, level: 'canon' },
    { parent: 'laugh-tale',       slug: 'one-piece-histoire', title: 'One Piece',       x: 330, y: 510, level: 'hypothese' },
    { parent: 'poneglyphes',       slug: 'rio-poneglyphe',     title: 'Rio Ponéglyphe',   x: 510, y: 510, level: 'central' },
    { parent: 'poneglyphes',       slug: 'communication-temps', title: 'Communication\ntemporelle (1187–88)', x: 610, y: 520, level: 'hypothese' },
    { parent: 'siecle-oublie',    slug: 'professeur-clover-et-ohara', title: 'Clover & Ohara', x: 650, y: 90, level: 'canon' },
    { parent: 'royaume-antique',  slug: 'vegapunk',          title: 'Vegapunk',         x: 790, y: 510, level: 'canon' },
    { parent: 'royaume-antique',  slug: 'energie-antique',   title: 'Énergie antique',  x: 890, y: 520, level: 'elevee' },
    { parent: 'joy-boy',          slug: 'nika',              title: 'Nika',             x: 1020, y: 90, level: 'canon' },
    { parent: 'joy-boy',          slug: 'luffy',             title: 'Luffy',            x: 930, y: 90,  level: 'canon' },
    { parent: 'peuples-royaumes', slug: 'armes-antiques',    title: 'Armes antiques',   x: 1210, y: 510, level: 'elevee' },
    { parent: 'peuples-royaumes', slug: 'poseidon-fiche',    title: 'Poséidon',         x: 1120, y: 520, level: 'canon' },
    { parent: 'peuples-royaumes', slug: 'pluton-fiche',      title: 'Pluton',           x: 1280, y: 400, level: 'elevee' },
    { parent: 'peuples-royaumes', slug: 'zunesha-fiche',     title: 'Zunesha',          x: 1280, y: 280, level: 'elevee' },
    { parent: 'peuples-royaumes', slug: 'wa-no-kuni',        title: 'Wa no Kuni',       x: 1280, y: 520, level: 'elevee' },
    { parent: 'imu-nerona', slug: 'gouvernement-mondial', title: 'GM',           x: 870, y: 620, level: 'canon' },
    { parent: 'imu-nerona', slug: 'vingt-rois',        title: 'Vingt Rois',       x: 1080, y: 690, level: 'elevee' },
    { parent: 'imu-nerona', slug: 'la-prescience-et-imu', title: 'Malédiction\nde la préscience', x: 1050, y: 520, level: 'hypothese' },
    { parent: 'guerre-finale',    slug: 'deluge-all-blue',   title: 'Déluge',           x: 570, y: 780, level: 'elevee' },
    { parent: 'guerre-finale',    slug: 'red-line',          title: 'Chute de\nRed Line', x: 780, y: 790, level: 'hypothese' },
    { parent: 'guerre-finale',    slug: 'noah',              title: 'Noah',             x: 840, y: 760, level: 'canon' },
    { parent: 'all-blue',         slug: 'binks-no-sake',     title: 'Binks no Sake',    x: 300, y: 720, level: 'elevee' },
    { parent: 'blue-star',        slug: 'grand-line',        title: 'Grand Line',       x: 70,  y: 90,  level: 'canon' },
    { parent: 'blue-star',        slug: 'red-line',          title: 'Red Line',         x: 170, y: 90,  level: 'canon' },
  ];

  // Cross-links (semantic connections beyond the causal chain)
  const crossLinks = [
    { from: 'joy-boy', to: 'guerre-finale', label: 'libère' },
    { from: 'poneglyphes', to: 'imu-nerona', label: 'lus par Imu' },
    { from: 'laugh-tale', to: 'one-piece-histoire', label: 'trésor' },
  ];

  const levelColors = {
    canon:     '#8899aa',
    central:  '#5fb9c2',
    elevee:   '#e0ab4e',
    hypothese:'#b07cc6',
  };

  // ─── Rendering helpers ───────────────────────────────────────
  const svg = document.getElementById('mindmap-svg');
  const connectionsGroup = document.getElementById('connections');
  const nodesGroup = document.getElementById('nodes');

  const nodePos = {};
  const allNodes = [...chain, ...subs];
  allNodes.forEach(n => nodePos[n.slug] = { x: n.x, y: n.y });

  const edgeElements = [];

  function drawPath(x1, y1, x2, y2, color, dashed = false, opacity = 0.45, arrow = false, edge = null) {
    const dx = x2 - x1, dy = y2 - y1;
    const mx1 = x1 + dx * 0.5;
    const my1 = y1 + dy * 0.15;
    const mx2 = x1 + dx * 0.5;
    const my2 = y2 - dy * 0.15;
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', `M${x1},${y1} C${mx1},${my1} ${mx2},${my2} ${x2},${y2}`);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', color);
    path.setAttribute('stroke-width', '2');
    path.setAttribute('stroke-opacity', String(opacity));
    if (dashed) path.setAttribute('stroke-dasharray', '6,4');
    if (arrow) path.setAttribute('marker-end', 'url(#arrow)');
    path.style.color = color;
    connectionsGroup.appendChild(path);
    if (edge) edgeElements.push({ el: path, baseOpacity: opacity, a: edge.a, b: edge.b });
    return path;
  }

  function drawStraight(x1, y1, x2, y2, color, dashed = false, opacity = 0.45, edge = null) {
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    path.setAttribute('x1', x1); path.setAttribute('y1', y1);
    path.setAttribute('x2', x2); path.setAttribute('y2', y2);
    path.setAttribute('stroke', color);
    path.setAttribute('stroke-width', '1.5');
    path.setAttribute('stroke-opacity', String(opacity));
    if (dashed) path.setAttribute('stroke-dasharray', '4,3');
    connectionsGroup.appendChild(path);
    if (edge) edgeElements.push({ el: path, baseOpacity: opacity, a: edge.a, b: edge.b });
    return path;
  }

  // Draw main causal chain (connections between consecutive chain nodes)
  const chainLabels = [
    'problème géographique',
    'quatrième coordonnée',
    'mécanisme',
    'racontent l\'avenir',
    'vient du futur',
    'conséquence',
    'préparent',
    'craint',
    'provoque',
    'crée',
  ];
  for (let i = 0; i < chain.length - 1; i++) {
    const a = chain[i], b = chain[i+1];
    drawPath(a.x, a.y, b.x, b.y, levelColors[b.level] || '#8899aa', false, 0.55, true, { a: a.slug, b: b.slug });
    // Add label at midpoint
    const mx = (a.x + b.x) / 2;
    const my = (a.y + b.y) / 2;
    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.setAttribute('x', mx);
    label.setAttribute('y', my - 8);
    label.setAttribute('text-anchor', 'middle');
    label.setAttribute('fill', '#aeb7c2');
    label.setAttribute('font-size', '11');
    label.setAttribute('font-family', 'Inter, system-ui, sans-serif');
    label.setAttribute('pointer-events', 'none');
    label.textContent = chainLabels[i] || '';
    connectionsGroup.appendChild(label);
  }
  // Close the loop back visually (11 → 1? Optional - keep subtle)
  drawPath(chain[chain.length-1].x, chain[chain.length-1].y, chain[0].x, chain[0].y, '#8899aa', true, 0.18, false, { a: chain[chain.length-1].slug, b: chain[0].slug });

  // Draw sub-node connections
  subs.forEach(s => {
    const p = nodePos[s.parent];
    if (!p) return;
    drawStraight(p.x, p.y, s.x, s.y, levelColors[s.level] || '#8899aa', false, 0.35, { a: s.parent, b: s.slug });
  });

  // Draw cross-links
  crossLinks.forEach(l => {
    const a = nodePos[l.from], b = nodePos[l.to];
    if (a && b) drawPath(a.x, a.y, b.x, b.y, '#8899aa', true, 0.22, false, { a: l.from, b: l.to });
  });

  // ─── Draw nodes ──────────────────────────────────────────────
  function addText(parent, text, x, y, size, fill, bold) {
    const lines = text.split('\n');
    const lineHeight = size * 1.3;
    const startY = y - ((lines.length - 1) * lineHeight) / 2;
    lines.forEach((line, i) => {
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', x);
      t.setAttribute('y', startY + i * lineHeight);
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('dominant-baseline', 'central');
      t.setAttribute('fill', fill);
      t.setAttribute('font-size', size);
      t.setAttribute('font-weight', bold ? '700' : '500');
      t.setAttribute('font-family', 'Inter, system-ui, sans-serif');
      t.setAttribute('pointer-events', 'none');
      t.textContent = line;
      parent.appendChild(t);
    });
  }

  function makeNode(n, isMain) {
    const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    g.style.cursor = 'pointer';
    g.setAttribute('class', 'mindmap-node');
    // Accessible au clavier : le <g> devient un lien focusable (la version
    // textuelle en bas de page reste le secours sémantique).
    g.setAttribute('tabindex', '0');
    g.setAttribute('role', 'link');
    g.setAttribute('aria-label', n.title.replace(/\n/g, ' '));

    const color = levelColors[n.level] || '#8899aa';
    const lines = n.title.split('\n');
    const maxLen = Math.max(...lines.map(l => l.length));
    const w = isMain ? Math.max(110, maxLen * 8.5 + 30) : Math.max(75, maxLen * 7 + 22);
    const h = isMain ? lines.length * 19 + 22 : lines.length * 16 + 18;

    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    rect.setAttribute('x', n.x - w/2);
    rect.setAttribute('y', n.y - h/2);
    rect.setAttribute('width', w);
    rect.setAttribute('height', h);
    rect.setAttribute('rx', isMain ? '12' : '8');
    rect.setAttribute('fill', 'rgba(14,23,34,0.92)');
    rect.setAttribute('stroke', color);
    rect.setAttribute('stroke-width', isMain ? '2' : '1.3');
    rect.setAttribute('stroke-opacity', '0.85');
    if (isMain && n.level === 'central') rect.setAttribute('filter', 'url(#glow)');
    g.appendChild(rect);

    addText(g, n.title, n.x, n.y, isMain ? 13 : 10.5, '#f3efe6', isMain);

    g.addEventListener('mouseenter', () => {
      rect.setAttribute('stroke-opacity', '1');
      rect.setAttribute('stroke-width', isMain ? '2.8' : '2');
      highlightConnections(n.slug);
    });
    g.addEventListener('mouseleave', () => {
      rect.setAttribute('stroke-opacity', '0.85');
      rect.setAttribute('stroke-width', isMain ? '2' : '1.3');
      clearHighlight();
    });
    // Indicateur de focus clavier (même effet visuel que le survol) : le
    // chemin causal connecté au nœud se met aussi en surbrillance.
    g.addEventListener('focus', () => {
      rect.setAttribute('stroke-opacity', '1');
      rect.setAttribute('stroke-width', isMain ? '2.8' : '2');
      highlightConnections(n.slug);
    });
    g.addEventListener('blur', () => {
      rect.setAttribute('stroke-opacity', '0.85');
      rect.setAttribute('stroke-width', isMain ? '2' : '1.3');
      clearHighlight();
    });
    const navigate = () => { window.location.href = `/theorie/${n.slug}`; };
    g.addEventListener('click', navigate);
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        navigate();
      }
    });

    nodesGroup.appendChild(g);
  }

  // ─── Mise en surbrillance du chemin connecté ──────────────────
  // Survol/focus d'un nœud : les arêtes qui le touchent restent nettes,
  // le reste du graphe s'estompe pour faire ressortir le chemin causal.
  function highlightConnections(slug) {
    edgeElements.forEach(({ el, a, b }) => {
      const connected = a === slug || b === slug;
      el.setAttribute('stroke-opacity', connected ? '1' : '0.08');
      if (connected) el.setAttribute('stroke-width', el.tagName === 'path' ? '3' : '2.2');
    });
  }
  function clearHighlight() {
    edgeElements.forEach(({ el, baseOpacity }) => {
      el.setAttribute('stroke-opacity', String(baseOpacity));
      el.removeAttribute('stroke-width');
      el.setAttribute('stroke-width', el.tagName === 'path' ? '2' : '1.5');
    });
  }

  subs.forEach(s => makeNode(s, false));
  chain.forEach(c => makeNode(c, true));

  // ─── Zoom & Pan ──────────────────────────────────────────────
  // Pointer Events unifie souris/tactile/stylet : le glisser-déposer et le
  // pincement à deux doigts (pinch-zoom) fonctionnent donc aussi sur mobile,
  // là où l'ancienne implémentation « mousedown/mousemove » ignorait le tactile.
  let scale = 1, panX = 0, panY = 0;
  const minScale = 0.4, maxScale = 2.5;
  function updateViewBox() {
    const w = W / scale, h = H / scale;
    const x = (W - w)/2 + panX;
    const y = (H - h)/2 + panY;
    svg.setAttribute('viewBox', `${x} ${y} ${w} ${h}`);
  }
  document.getElementById('zoom-in').addEventListener('click', () => { scale = Math.min(maxScale, scale * 1.25); updateViewBox(); });
  document.getElementById('zoom-out').addEventListener('click', () => { scale = Math.max(minScale, scale / 1.25); updateViewBox(); });
  document.getElementById('zoom-reset').addEventListener('click', () => { scale = 1; panX = 0; panY = 0; updateViewBox(); });

  const wrapper = document.getElementById('mindmap-wrapper');
  wrapper.addEventListener('wheel', (e) => { e.preventDefault(); scale = Math.max(minScale, Math.min(maxScale, scale * (e.deltaY < 0 ? 1.08 : 0.93))); updateViewBox(); }, { passive: false });

  // Un seul pointeur actif = pan ; deux pointeurs (tactile) = pinch-zoom.
  const activePointers = new Map();
  let lastPanPoint = null;
  let lastPinchDistance = null;

  const pointFromEvent = (e) => ({ x: e.clientX, y: e.clientY });
  const midpoint = (a, b) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });
  const distance = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);

  svg.addEventListener('pointerdown', (e) => {
    if (e.target.closest('.mindmap-node')) return;
    svg.setPointerCapture(e.pointerId);
    activePointers.set(e.pointerId, pointFromEvent(e));
    if (activePointers.size === 1) {
      lastPanPoint = pointFromEvent(e);
      svg.style.cursor = 'grabbing';
    } else if (activePointers.size === 2) {
      const pts = [...activePointers.values()];
      lastPinchDistance = distance(pts[0], pts[1]);
    }
  });

  svg.addEventListener('pointermove', (e) => {
    if (!activePointers.has(e.pointerId)) return;
    activePointers.set(e.pointerId, pointFromEvent(e));

    if (activePointers.size === 2) {
      // Pinch-zoom : le facteur de zoom suit la variation de distance entre
      // les deux doigts ; le pan n'est pas ajusté (recentrage simple au reset).
      const pts = [...activePointers.values()];
      const dist = distance(pts[0], pts[1]);
      if (lastPinchDistance) {
        const factor = dist / lastPinchDistance;
        scale = Math.max(minScale, Math.min(maxScale, scale * factor));
        updateViewBox();
      }
      lastPinchDistance = dist;
      return;
    }

    if (activePointers.size === 1 && lastPanPoint) {
      const p = pointFromEvent(e);
      panX -= (p.x - lastPanPoint.x) / scale;
      panY -= (p.y - lastPanPoint.y) / scale;
      lastPanPoint = p;
      updateViewBox();
    }
  });

  const endPointer = (e) => {
    activePointers.delete(e.pointerId);
    if (activePointers.size < 2) lastPinchDistance = null;
    if (activePointers.size === 1) {
      // Un doigt reste posé : on repart du pan sans saut visuel.
      lastPanPoint = [...activePointers.values()][0];
    } else {
      lastPanPoint = null;
      svg.style.cursor = 'grab';
    }
  };
  svg.addEventListener('pointerup', endPointer);
  svg.addEventListener('pointercancel', endPointer);
  svg.addEventListener('pointerleave', (e) => {
    if (activePointers.size <= 1) endPointer(e);
  });

  // Empêche le geste tactile natif (scroll de page / zoom navigateur) de
  // rentrer en conflit avec notre pan/pinch maison à l'intérieur du widget.
  svg.style.touchAction = 'none';
  svg.style.cursor = 'grab';
</script>

