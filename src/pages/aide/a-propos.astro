---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Aide', href: '/aide' },
  { label: 'À propos' },
];

// L'état de fraîcheur est dérivé des fiches de chapitres, jamais écrit en dur :
// il ne peut donc pas devenir faux si l'on oublie de mettre à jour cette page.
const chapters = await getCollection('chapters');
const latestChapter = chapters.sort((a, b) => b.data.chapter - a.data.chapter)[0];
---

<WikiLayout title="À propos" seoTitle="À propos — Les Fous du Bus : projet et méthode | Les Fous du Bus" description="À propos du wiki Les Fous du Bus : projet fan-made, théorie du Siècle oublié est le présent, méthode, sources et démarche éditoriale." currentPath="/aide/a-propos">
  <Breadcrumb items={breadcrumbItems} />
  <div class="page-header">
    <h1>À propos</h1>
  </div>

  <div class="content">
    <section class="section">
      <h2>Le projet</h2>
      <p>
        <strong>Les Fous du Bus</strong> est un wiki éditorial et interactif consacré à une théorie sur
        <em>One Piece</em> : certaines informations attribuées au passé pourraient provenir d’un futur vécu
        par Luffy et ses alliés, puis être conservées par les Ponéglyphes.
      </p>
      <p>
        Le site a pour objectif de structurer, documenter, développer et faire évoluer cette théorie
        au fil des nouveaux chapitres de <em>One Piece</em>.
      </p>
      {
        latestChapter && (
          <p class="freshness">
            <span class="freshness__dot" aria-hidden="true" />
            <span>
              Contenu à jour jusqu'au{' '}
              <a href={`/chapitres/${latestChapter.data.chapter}/`}>
                <strong>chapitre {latestChapter.data.chapter}</strong>
              </a>{' '}
              — « {latestChapter.data.title} ».
            </span>
          </p>
        )
      }
    </section>

    <section class="section">
      <h2>Origine de la théorie</h2>
      <p>
        La théorie est attribuée au <strong>Mont Corvo</strong> et provient de la vidéo <a href="https://youtu.be/SgJ25zjMJyo" target="_blank" rel="noopener noreferrer">« Le Siècle oublié est le présent »</a>.
      </p>
      <p>
        Le compte <a href="https://x.com/FoudubusTV_" target="_blank" rel="noopener noreferrer">Fou du Bus TV</a> permet de suivre les échanges et les actualités autour de la théorie.
      </p>
    </section>

    <section class="section">
      <h2>Objectifs</h2>
      <ul>
        <li><strong>Comprendre</strong> la version actuelle de la théorie</li>
        <li><strong>Explorer</strong> les liens entre personnages, lieux, événements et époques</li>
        <li><strong>Suivre</strong> l'apport de chaque nouveau chapitre</li>
      </ul>
    </section>

    <section class="section">
      <h2>Principes</h2>
      <div class="principles">
        <div class="principle-item">
          <h4>Transparence</h4>
          <p>Les corrections et l'évolution de la théorie restent documentées.</p>
        </div>
        <div class="principle-item">
          <h4>Progressivité</h4>
          <p>
            Le HTML statique constitue la base ; l'interactivité est chargée uniquement lorsqu'elle
            apporte une réelle valeur.
          </p>
        </div>
        <div class="principle-item">
          <h4>Ouverture</h4>
          <p>
            Le projet est ouvert : chacun peut consulter le code, proposer des changements ou
            réutiliser les créations originales.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Open source</h2>
      <p>
        Le code source est disponible sur <a
          href="https://github.com/lesfousdubus-theorie/lesfousdubus"
          target="_blank"
          rel="noopener noreferrer">GitHub</a>. Les contributions sont les bienvenues sous forme d'Issues et de Pull Requests.
      </p>
    </section>
  </div>

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: 40px;
  }
  .page-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
  }

  .content {
    line-height: 1.7;
  }

  .section {
    margin-bottom: 40px;
  }
  .section h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
  }
  .section p {
    color: var(--text-secondary);
    font-size: 15px;
    margin-bottom: 12px;
  }
  .section ul {
    padding-left: 20px;
    color: var(--text-secondary);
    font-size: 15px;
  }
  .section li {
    margin-bottom: 8px;
  }
  .section a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .principle-item {
    padding: 16px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .principle-item:hover {
    border-color: color-mix(in srgb, var(--violet) 35%, var(--border-color));
    transform: translateY(-2px);
  }
  .principle-item h4 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .principle-item p {
    font-size: 13.5px;
    margin: 0;
  }

  /* Indicateur de fraîcheur : dérivé de la collection `chapters`. */
  .freshness {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 12px 14px;
    font-size: 14px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--cyan);
    border-radius: var(--border-radius);
  }

  .freshness__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--cyan);
  }
</style>
