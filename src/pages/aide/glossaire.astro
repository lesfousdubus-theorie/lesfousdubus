---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Aide', href: '/aide' },
  { label: 'Glossaire' },
];

interface GlossaryItem {
  term: string;
  canonDef: string;
  theoryDef: string;
  /** Lien vers la fiche complète. */
  link?: string;
  /** Si vrai, les définitions doivent se lire au conditionnel (terme controversé). */
  controversial?: boolean;
  /** Si vrai, mention « terme récent ». */
  recent?: boolean;
}

// L'index alphabétique est généré automatiquement à partir de ce tableau.
// Chaque entrée respecte le format « Dans le manga / Selon la théorie » et renvoie
// vers sa fiche complète. Les termes controversés utilisent le conditionnel.
const glossaryEntries: GlossaryItem[] = [
  // — — A —
  {
    term: 'All Blue',
    canonDef:
      'Mer légendaire où se rencontreraient les quatre mers du monde, rêve du cuisinier Sanji.',
    theoryDef:
      'All Blue pourrait déjà exister ou apparaître si plusieurs mers communiquaient après une rupture de Red Line. Sa création, son emplacement et son lien avec le Déluge restent des projections séparées.',
    link: '/theorie/all-blue',
  },
  {
    term: 'Armes antiques',
    canonDef:
      'Trois armes de destruction massive du monde de One Piece, nommées Poséidon, Pluton et Uranus.',
    theoryDef:
      'Poséidon, Pluton et Uranus pourraient intervenir dans un conflit futur. Leur lien avec Red Line, le Déluge et All Blue reste projeté, sans ordre imposé.',
    link: '/theorie/armes-antiques',
  },
  // — — B — —
  {
    term: 'Blue Star',
    canonDef: 'Nom donné à la planète sur laquelle se déroule l’histoire de One Piece.',
    theoryDef:
      'La géographie de Blue Star fournit le cadre des projections sur Red Line et All Blue. Le mécanisme central porte sur l’information conservée par les Ponéglyphes, non sur un envoi physique de la planète.',
    link: '/theorie/blue-star',
  },
  {
    term: 'Boucaniers',
    canonDef:
      'Peuple persécuté et presque éteint, dont Bartholomew Kuma est le dernier descendant connu.',
    theoryDef:
      'Les Buccaneers transmettent la croyance en Nika. La foi de Kuma entretient un espoir de libération ; elle ne crée littéralement ni le dieu, ni le Fruit, ni Joy Boy.',
    link: '/theorie/boucaniers',
  },
  // — — C — —
  {
    term: 'Calm Belt',
    canonDef:
      'Ceinture de Grand Line où le vent fait défaut, rendant la navigation quasi impossible et isolant les quatre mers.',
    theoryDef:
      'La circulation entre les mers pourrait être bouleversée par une rupture de Red Line, sans que Calm Belt disparaisse automatiquement.',
    link: '/theorie/grand-line',
  },
  {
    term: 'Chevaliers Divins',
    canonDef:
      'Force d’élite de Mary Geoise composée de membres issus des Dragons Célestes ; sa hiérarchie et ses opérations évoluent dans les chapitres récents.',
    theoryDef:
      'Leur lien avec les lignées des Vingt fondateurs peut prolonger un pouvoir héréditaire. Une reconstitution future de la coalition ancienne reste une extension.',
    link: '/theorie/chevaliers-divins',
  },
  // — — D — —
  {
    term: 'Davy Jones',
    canonDef:
      'Nom de légende maritime lié au Davy Back Fight et réemployé par Imu face à Rocks D. Xebec dans les chapitres récents ; les nuances dépendent de la traduction.',
    theoryDef:
      'Teach pourrait prolonger ce motif maritime. Le nom ne lui est pas attribué, sa parenté avec Xebec n’est pas confirmée et cette branche n’appartient pas au noyau des Ponéglyphes.',
    link: '/theorie/davy-jones-fiche',
    controversial: true,
  },
  {
    term: 'Le Déluge',
    canonDef:
      'Submersion annoncée par Vegapunk (chapitre 1113) : le monde serait menacé de sombrer, après que le conflit du Siècle oublié s’est accompagné d’une hausse du niveau marin d’environ 200 mètres.',
    theoryDef:
      'La hausse d’environ 200 mètres appartient au passé établi. Une nouvelle montée comparable, la rupture de Red Line et la naissance d’All Blue sont trois projections distinctes, sans ordre causal confirmé.',
    link: '/theorie/deluge-all-blue',
  },
  {
    term: 'Domi Reversi',
    canonDef:
      'Nom donné dans les transcriptions récentes à une prise de contrôle attribuée à Imu ; cibles, graphie et règles doivent suivre la traduction publiée du chapitre 1186.',
    theoryDef:
      'Le pouvoir retournerait une victime contre ses proches. Son application présente ne prouve pas une domination continue des géants pendant les huit siècles précédents.',
    link: '/theorie/domi-reversi',
    recent: true,
    controversial: true,
  },
  // — — E — —
  {
    term: 'Emeth',
    canonDef:
      'Robot géant vieux de 900 ans découvert sur Egghead, éveillé par le rythme des tambours de la libération (Gear 5).',
    theoryDef:
      'Le manga l’associe au Royaume antique et attribue son Haki au Joy Boy historique. BF-39, une construction par Franky et un transport depuis le futur forment une extension physique distincte.',
    link: '/theorie/emeth-futur',
  },
  // — — F — —
  {
    term: 'Flamme Mère (Mother Flame)',
    canonDef:
      'Source d’énergie créée par Vegapunk, dont un fragment dérobé alimente l’arme employée contre Lulusia. Son rapport exact à l’énergie antique reste inachevé.',
    theoryDef:
      'Le manga n’identifie pas formellement l’arme employée contre Lulusia. La théorie rapproche cette arme d’Uranus et imagine l’Omen d’Imu amplifié par la Mother Flame. Ces rapprochements sont des hypothèses.',
    link: '/theorie/mother-flame',
    controversial: true,
  },
  // — — G — —
  {
    term: 'Galley-La',
    canonDef:
      'Compagnie de charpentiers de Water Seven créée par Iceburg ; les analyses récentes rapprochent son nom d’un groupe de géants, détail à stabiliser avec la traduction.',
    theoryDef:
      'Pluton existe déjà sous Wano. La théorie projette une contribution de Water Seven et de charpentiers géants à cette Arme, sans faire de la ville son origine certaine.',
    link: '/theorie/pluton-water-seven-galley-la',
    controversial: true,
  },
  {
    term: 'Grand Line',
    canonDef:
      'Océan unique traversant le monde perpendiculairement à Red Line, découpé en îles séparées par les Calm Belts.',
    theoryDef:
      'Cadre géographique du voyage. Son fonctionnement ne démontre aucun mécanisme temporel.',
    link: '/theorie/grand-line',
  },
  // — — H — —
  {
    term: 'Harley',
    canonDef:
      'Texte sacré d’Elbaf divisé en trois parties et trois mondes, gravé près de la fresque sur l’Arbre d’Adam.',
    theoryDef:
      'Le texte peut décrire un passé mythifié ou préfigurer un futur. L’attribution à Usopp sous le nom de Louis Arnot reste une branche séparée.',
    link: '/theorie/elbaf-harley',
    controversial: true,
  },
  // — — I — —
  {
    term: 'Imu Nerona',
    canonDef:
      'Souverain occulte siégeant sur le Trône Vide de Mary Geoise et commandant au Gorosei dans le plus grand secret.',
    theoryDef:
      'Imu peut agir d’après des archives, une communication temporelle ou une forme de préscience. Le moyen de connaissance et un règne personnel continu depuis huit siècles restent ouverts.',
    link: '/theorie/imu-nerona',
  },
  // — — J — —
  {
    term: 'Jour du serment',
    canonDef:
      'Expression utilisée par la théorie pour désigner l’accomplissement des promesses (notamment celle faite aux Hommes-Poissons).',
    theoryDef:
      'Nom théorique d’une convergence possible des promesses. Le manga ne synchronise ni toutes les missions ni tous leurs accomplissements.',
    link: '/theorie/peuples-royaumes',
    controversial: true,
  },
  {
    term: 'Joy Boy',
    canonDef:
      'Personne historique du Royaume antique, active environ neuf siècles avant le présent et liée à une promesse non tenue envers la Poséidon de son époque.',
    theoryDef:
      'Joy Boy est une personne historique du Royaume antique. Luffy pourrait accomplir son rôle ou recevoir cette appellation, mais il affirme rester Monkey D. Luffy.',
    link: '/theorie/joy-boy',
    controversial: true,
  },
  // — — L — —
  {
    term: 'Laugh Tale',
    canonDef:
      'Dernière île de Grand Line nommée par Gol D. Roger, abritant le One Piece et la véritable histoire du Siècle oublié.',
    theoryDef:
      'Île réellement atteinte par Roger, qui s’y juge trop tôt. Une communication ou un mécanisme temporel lié au lieu reste une hypothèse évolutive.',
    link: '/theorie/laugh-tale',
  },
  {
    term: 'Lili',
    canonDef:
      'Nefertari Lili, reine du royaume d’Alabasta et l’un des Vingt Rois fondateurs du Gouvernement mondial.',
    theoryDef:
      'Lili est historiquement liée à la dispersion des Ponéglyphes. Vivi pourrait accomplir un rôle analogue dans le futur ; une identité commune serait une variante plus spéculative.',
    link: '/theorie/lili',
    controversial: true,
  },
  {
    term: 'Lodestar',
    canonDef: 'Île de Grand Line considérée comme la fin du chemin des Log Poses.',
    theoryDef:
      'Lodestar et Laugh Tale sont deux étapes distinctes du voyage de Roger. Leur éventuel lien temporel reste une hypothèse de mécanisme, non une identité géographique acquise.',
    link: '/theorie/lodestar',
    controversial: true,
  },
  {
    term: 'Lunariens',
    canonDef:
      'Peuple ancien, autrefois installé sur le site de Mary Geoise (Red Line), avant sa disparition.',
    theoryDef:
      'King et la déduction de Kaido motivent un lien avec Joy Boy, sans établir une mission ou une attente collective de tout le peuple lunarien.',
    link: '/theorie/lunariens',
  },
  // — — M — —
  // (Mother Flame rangé à la lettre F « Flamme Mère »)
  // — — N — —
  {
    term: 'Nika',
    canonDef:
      'Le « Guerrier de la Libération », dieu du soleil réputé faire rire les esclaves et libérer les opprimés, nommé par le Gorosei au chapitre 1044.',
    theoryDef:
      'Nika distingue un mythe de libération et le modèle du Fruit éveillé par Luffy. La foi de Kuma renforce le motif sans prouver qu’elle crée littéralement le dieu.',
    link: '/theorie/nika',
  },
  {
    term: 'Noah',
    canonDef: 'Navire géant reposant au fond de la mer près de l’île des Hommes-Poissons.',
    theoryDef:
      'Noah pourrait servir à transporter ou protéger une population avec l’aide de Poséidon. Son constructeur, sa fonction finale et toute mission collective restent inconnus.',
    link: '/theorie/noah',
  },
  // — — O — —
  {
    term: 'Omen',
    canonDef: 'Terme utilisé par la théorie pour désigner le pouvoir propre d’Imu.',
    theoryDef:
      'Mécanisme récent et spéculatif : un Omen « basique », puis amplifié par la Mother Flame, serait rapproché de l’arme utilisée contre Lulusia et d’Uranus. Piste en cours de construction.',
    link: '/theorie/omen',
    recent: true,
    controversial: true,
  },
  // — — P — —
  {
    term: 'Pluton',
    canonDef:
      'Navire de guerre antique capable de détruire une île, actuellement sous l’ancien Wano ; ses plans de contre-mesure, transmis à Water Seven, ont été brûlés par Franky.',
    theoryDef:
      'Pluton existe sous Wano. Water Seven et des charpentiers géants pourraient contribuer à son activation ou sa transformation future ; ils ne construisent pas nécessairement l’Arme d’origine.',
    link: '/theorie/pluton-fiche',
    controversial: true,
  },
  {
    term: 'Ponéglyphes',
    canonDef:
      'Stèles presque indestructibles gravées grâce au savoir du clan Kozuki ; elles conservent textes historiques, messages, informations sur les Armes et, pour les quatre Road Ponéglyphes, des positions menant à Laugh Tale.',
    theoryDef:
      'Support durable central : une partie du contenu pourrait être créée dans un futur projeté, reçue puis gravée pendant le Siècle oublié. Robin les lit mais ne sait pas les graver.',
    link: '/theorie/poneglyphes',
  },
  {
    term: 'Poséidon',
    canonDef:
      'Arme antique incarnée par la princesse sirène Shirahoshi, capable d’ordonner aux Rois des Mers.',
    theoryDef:
      'Pouvoir réapparaissant à plusieurs siècles d’intervalle. Shirahoshi pourrait agir avec Noah dans le futur, projection distincte de la promesse du Joy Boy historique.',
    link: '/theorie/poseidon-fiche',
  },
  // — — R — —
  {
    term: 'Raftel',
    canonDef: 'Ancien nom de la dernière île, révisé en « Laugh Tale ».',
    theoryDef:
      'Terme historique / terminologie : la fiche complète est celle de Laugh Tale. Raftel est conservé comme alias, sans fiche dupliquée.',
    link: '/theorie/laugh-tale',
  },
  {
    term: 'Red Line',
    canonDef:
      'Continent qui ceinture le globe, croise Grand Line, contribue à séparer les quatre mers et porte Mary Geoise à son sommet.',
    theoryDef:
      'Barrière géographique centrale que la guerre finale pourrait détruire, permettant aux quatre mers de communiquer (All Blue). Le lien Armes antiques → Red Line est un raisonnement de la théorie.',
    link: '/theorie/red-line',
  },
  {
    term: 'Reverse Mountain',
    canonDef:
      'Montagne qui sépare les quatre mers et par laquelle on entre dans Grand Line, unissant les courants des quatre océans.',
    theoryDef:
      'Symbole géographique de la « rencontre des mers » que la théorie relie à l’idée d’un monde tendant vers une seule pièce.',
    link: '/theorie/blue-star',
  },
  {
    term: 'Rio Ponéglyphe',
    canonDef:
      'Récit complet de la véritable histoire que Robin cherche à reconstituer en reliant les textes historiques des Ponéglyphes.',
    theoryDef:
      'Corpus de la véritable histoire. La théorie propose qu’une partie relie passé apparent, événements vécus et information future, sans fixer encore ses auteurs.',
    link: '/theorie/rio-poneglyphe',
  },
  {
    term: 'Road Ponéglyphes',
    canonDef: 'Les quatre Ponéglyphes indiquant les coordonnées de Laugh Tale.',
    theoryDef:
      'Ils donnent quatre positions spatiales dont le croisement désigne Laugh Tale. Toute fonction temporelle supplémentaire reste une hypothèse distincte.',
    link: '/theorie/road-poneglyphes',
  },
  {
    term: 'Royaume antique',
    canonDef:
      'Ancien royaume vaincu lors du Siècle oublié, dont l’existence a été effacée par le Gouvernement mondial.',
    theoryDef:
      'Le Royaume antique est historique. La théorie propose que ses sources puissent décrire une histoire future, sans exiger l’envoi physique du royaume lui-même.',
    link: '/theorie/royaume-antique',
  },
  {
    term: 'Ryuma',
    canonDef:
      'Samouraï légendaire de Wano, surnommé le Dieu de la Lame, réputé avoir tranché un dragon au-dessus de la capitale des Fleurs.',
    theoryDef:
      'Zoro pourrait prolonger la légende de Ryuma. Le parallèle est une projection ; leur identité commune ou un voyage temporel ne sont pas nécessaires.',
    link: '/theorie/ryuma',
    controversial: true,
  },
  // — — S — —
  {
    term: 'Siècle oublié',
    canonDef:
      'Période de 100 ans (environ 900 à 800 ans avant l’ère actuelle) effacée de l’histoire officielle par le Gouvernement mondial.',
    theoryDef:
      'Période historique établie. La théorie porte sur l’origine future possible de certaines informations conservées dans ses sources, pas sur la négation de son existence passée.',
    link: '/theorie/siecle-oublie',
  },
  // — — T — —
  {
    term: 'Toki',
    canonDef: 'Kozuki Toki, épouse de Kozuki Oden, capable de se projeter dans le futur.',
    theoryDef:
      'Son Fruit prouve seulement un déplacement vers le futur. Une communication vers le passé exigerait un autre mécanisme.',
    link: '/theorie/kozuki-toki',
  },
  // — — U — —
  {
    term: 'Uranus',
    canonDef: 'La troisième Arme antique, dont la nature précise n’est pas révélée.',
    theoryDef:
      'Imu pourrait employer la Mother Flame pour alimenter Uranus, activer une autre arme ou atteindre une puissance comparable. Ces possibilités sont concurrentes.',
    link: '/theorie/uranus',
    controversial: true,
    recent: true,
  },
  // — — V — —
  {
    term: 'Vingt Rois',
    canonDef:
      'Les vingt souverains qui fondent le Gouvernement mondial après la guerre ancienne. Dix-neuf familles s’installent à Mary Geoise ; Nefertari Lili refuse d’y vivre et la lignée d’Alabasta demeure dans son royaume.',
    theoryDef:
      'La coalition historique doit être distinguée du Gouvernement actuel et d’une éventuelle alliance future. Les armes vues au chapitre 1189 et leur attribution exacte restent sensibles aux traductions récentes.',
    link: '/theorie/vingt-rois',
  },
  {
    term: 'Volonté du D.',
    canonDef:
      'Initiale portée par certains personnages au destin hors du commun (Luffy, Roger, Teach, Xebec…). Le Gouvernement mondial la traque : Imu a personnellement ordonné de falsifier le nom de Gol D. Roger (chapitre 1190). Sa signification n’a jamais été révélée.',
    theoryDef:
      'Sa signification reste inconnue. La théorie explore une transmission d’information, mais ne réduit pas tous ses porteurs à une lignée unique ni à un message temporel confirmé.',
    link: '/theorie/signification-d',
    controversial: true,
  },
  // — — Z — —
  {
    term: 'Zaza',
    canonDef:
      'Nom rapproché de la déesse de la pluie dans les analyses récentes. Son orthographe, son identité et son lien avec les quatre invocations shandias doivent encore être stabilisés.',
    theoryDef:
      'La pluie de la fresque et plusieurs personnages ont été rapprochés de Zaza, sans identification textuelle. Cette piste n’est pas nécessaire au noyau.',
    link: '/theorie/zaza',
    controversial: true,
  },
  {
    term: 'Zunesha',
    canonDef:
      'Éléphant géant de l’île de Zou, portant un peuple de Minks sur son dos depuis des siècles.',
    theoryDef:
      'Zunesha pourrait contribuer à l’ouverture de Wano et à la libération de Pluton. Son rôle précis, le prochain ordre et le crime ancien restent inconnus.',
    link: '/theorie/zunesha-fiche',
    controversial: true,
  },
];

// Sort alphabetically
glossaryEntries.sort((a, b) => a.term.localeCompare(b.term, 'fr'));

// Group by first letter
const grouped: Record<string, typeof glossaryEntries> = {};
glossaryEntries.forEach((entry) => {
  const letter = entry.term.charAt(0).toUpperCase();
  if (!grouped[letter]) grouped[letter] = [];
  grouped[letter].push(entry);
});
const sortedLetters = Object.keys(grouped).sort((a, b) => a.localeCompare(b, 'fr'));
---

<WikiLayout
  title="Glossaire"
  seoTitle="Glossaire One Piece : Joy Boy et Ponéglyphes | Les Fous du Bus"
  description="Glossaire One Piece : définitions rapides de Joy Boy, Nika, Ponéglyphes, Armes antiques, Siècle oublié et termes clés de la théorie."
  image="/og-glossaire.png"
  currentPath="/aide/glossaire"
>
  <Breadcrumb items={breadcrumbItems} />
  <div class="page-header">
    <h1>Glossaire</h1>
    <p class="page-desc">
      Définitions rigoureuses des termes clés. Chaque notion distingue clairement les éléments
      canons du manga des hypothèses proposées par la théorie, et renvoie vers la fiche complète.
      L'index alphabétique est généré automatiquement.
    </p>
  </div>

  <!-- Alphabet navigation -->
  <div class="alpha-nav" role="navigation" aria-label="Index alphabétique du glossaire">
    {
      sortedLetters.map((letter) => (
        <a href={`#letter-${letter}`} class="alpha-link">
          {letter}
        </a>
      ))
    }
  </div>

  <!-- Glossary entries -->
  {
    sortedLetters.map((letter) => (
      <div class="letter-section" id={`letter-${letter}`}>
        <h2 class="letter-title">{letter}</h2>
        <div class="entries">
          {grouped[letter].map((entry) => (
            <div class="entry-card">
              <div class="entry-head">
                <h3 class="entry-term">{entry.term}</h3>
                {entry.link && (
                  <a class="entry-link" href={entry.link}>
                    Voir la fiche →
                  </a>
                )}
              </div>
              {entry.controversial && (
                <span class="badge badge--controversial">terme interprété</span>
              )}
              {entry.recent && <span class="badge badge--recent">développement récent</span>}
              <div class="entry-blocks">
                <div class="entry-block entry-block--canon">
                  <span class="block-label">Dans le manga</span>
                  <p>{entry.canonDef}</p>
                </div>
                <div class="entry-block entry-block--theory">
                  <span class="block-label">Selon la théorie</span>
                  <p>{entry.theoryDef}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: 32px;
  }
  .page-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .page-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
  }

  .alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 36px;
    padding: 12px 16px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
  }

  .alpha-link {
    width: var(--control-size);
    height: var(--control-size);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .alpha-link:hover,
  .alpha-link:focus-visible {
    background-color: var(--surface);
    color: var(--cyan);
    transform: translateY(-2px);
    outline: 2px solid var(--cyan);
    outline-offset: 1px;
  }

  .letter-section {
    margin-bottom: 36px;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }

  .letter-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--violet);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .entry-card {
    padding: 20px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .entry-term {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }

  .entry-link {
    display: inline-flex;
    min-height: var(--control-size);
    align-items: center;
    font-size: 13px;
    color: var(--cyan);
    text-decoration: none;
    font-weight: 600;
  }
