---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Aide', href: '/aide' },
  { label: 'Glossaire' },
];

interface GlossaryItem {
  term: string;
  canonDef: string;
  theoryDef: string;
  /** Lien vers la fiche complète. */
  link?: string;
  /** Si vrai, les définitions doivent se lire au conditionnel (terme controversé). */
  controversial?: boolean;
  /** Si vrai, mention « terme récent ». */
  recent?: boolean;
}

// L'index alphabétique est généré automatiquement à partir de ce tableau.
// Chaque entrée respecte le format « Dans le manga / Selon la théorie » et renvoie
// vers sa fiche complète. Les termes controversés utilisent le conditionnel.
const glossaryEntries: GlossaryItem[] = [
  // — — A —
  {
    term: 'All Blue',
    canonDef: 'Mer légendaire où se rencontreraient les quatre mers du monde, rêve du cuisinier Sanji.',
    theoryDef: 'Époque qui adviendrait après la destruction de Red Line : les barrières géographiques bouleversées, les quatre mers pourraient enfin communiquer. C’est une conséquence attendue de la guerre finale, pas un lieu existant aujourd’hui.',
    link: '/theorie/all-blue',
  },
  {
    term: 'Armes antiques',
    canonDef: 'Trois armes de destruction massive du monde de One Piece, nommées Poséidon, Pluton et Uranus.',
    theoryDef: 'Outils de la guerre finale : leur lien avec Red Line, le déluge et la réunification des mers est un raisonnement de la théorie. La nature exacte de chacune reste en partie spéculative.',
    link: '/theorie/armes-antiques',
  },
  // — — B — —
  {
    term: 'Blue Star',
    canonDef: 'Nom donné à la planète sur laquelle se déroule l’histoire de One Piece.',
    theoryDef: 'La géographie de Blue Star (Red Line, Grand Line, quatre mers, Calm Belt) est le cadre du renversement central de la théorie : le monde découpé chercherait à redevenir une seule pièce.',
    link: '/theorie/blue-star',
  },
  {
    term: 'Boucaniers',
    canonDef: 'Peuple persécuté et presque éteint, dont Bartholomew Kuma est le dernier descendant connu.',
    theoryDef: 'Peuple porteur de la foi en Nika et « témoin » de l’histoire dans la lecture des Fous du Bus ; la foi de Kuma participerait à la matérialisation du dieu du soleil.',
    link: '/theorie/boucaniers',
  },
  // — — C — —
  {
    term: 'Calm Belt',
    canonDef: 'Ceinture de Grand Line où le vent fait défaut, rendant la navigation quasi impossible et isolant les quatre mers.',
    theoryDef: 'L’une des barrières géographiques que la destruction de Red Line pourrait bouleverser. Le manga ne dit pas qu’elle « disparaît » automatiquement : les quatre mers pourraient simplement enfin communiquer.',
    link: '/theorie/grand-line',
  },
  {
    term: 'Chevaliers Divins',
    canonDef: 'Force d’élite composée de Dragons Célestes, commandée par Figarland Garling et agissant sous les ordres d’Imu.',
    theoryDef: 'Bras armé direct d’Imu, parfois rapproché des silhouettes des statues de Mary Geoise — une lecture d’image non confirmée par le manga.',
    link: '/theorie/chevaliers-divins',
  },
  // — — D — —
  {
    term: 'Davy Jones',
    canonDef: 'Pirate légendaire, cité par Imu au chapitre 1164 à propos de Rocks D. Xebec ; son nom a donné le Davy Back Fight.',
    theoryDef: 'Selon la théorie, Davy Jones ne serait pas un pirate du passé mais le titre que l’Histoire donnerait à Marshall D. Teach, dernier héritier d’une lignée que le Gouvernement aurait tenté d’effacer à God Valley. Hypothèse centrale, à lire au conditionnel.',
    link: '/theorie/davy-jones-fiche',
    controversial: true,
  },
  {
    term: 'Le Déluge',
    canonDef: 'Submersion annoncée par Vegapunk (chapitre 1113) : le monde serait menacé de sombrer, après que le conflit du Siècle oublié s’est accompagné d’une hausse du niveau marin d’environ 200 mètres.',
    theoryDef: 'La théorie considère que ce déluge de 200 mètres reste à venir et le relie à la destruction de Red Line et à la naissance d’All Blue. Le lien entre la hauteur des ponts et ce déluge est un raisonnement de la théorie, pas un fait du manga.',
    link: '/theorie/deluge-all-blue',
  },
  {
    term: 'Domi Reversi',
    canonDef: 'Pouvoir par lequel Imu prend le contrôle d’un individu et en altère le comportement : employé sur Brook (chapitre 1186) et rapproché de la manipulation de Dorry et Brogy.',
    theoryDef: 'L’analyse le qualifie de profondément diabolique : la victime contrôlée est retournée contre ses propres compagnons, ce qui en fait une arme psychologique autant que physique. Mécanisme récent, encore mal cartographié.',
    link: '/theorie/domi-reversi',
    recent: true,
    controversial: true,
  },
  // — — E — —
  {
    term: 'Emeth',
    canonDef: 'Robot géant vieux de 900 ans découvert sur Egghead, éveillé par le rythme des tambours de la libération (Gear 5).',
    theoryDef: 'Création issue du futur et envoyée vers le passé selon la théorie, liée à la Mother Flame et à la guerre finale.',
    link: '/theorie/emeth-futur',
  },
  // — — F — —
  {
    term: 'Flamme Mère (Mother Flame)',
    canonDef: 'Source d’énergie créée par Vegapunk en étudiant Emeth. Une partie a été volée et utilisée pour détruire Lulusia.',
    theoryDef: 'Le manga n’identifie pas formellement l’arme employée contre Lulusia. La théorie rapproche cette arme d’Uranus et imagine l’Omen d’Imu amplifié par la Mother Flame. Ces rapprochements sont des hypothèses.',
    link: '/theorie/mother-flame',
    controversial: true,
  },
  // — — G — —
  {
    term: 'Galley-La',
    canonDef: 'Compagnie de charpentiers de Water Seven, héritière des plans de Pluton ; aussi, nom d’une brigade de géants charpentiers d’Elbaf au grand marteau.',
    theoryDef: 'La théorie unit les deux : l’équipage des géants (rattaché à Loki) rejoindrait Water Seven pour la transformer en Pluton. Hypothèse.',
    link: '/theorie/pluton-water-seven-galley-la',
    controversial: true,
  },
  {
    term: 'Grand Line',
    canonDef: 'Océan unique traversant le monde perpendiculairement à Red Line, découpé en îles séparées par les Calm Belts.',
    theoryDef: 'Espace où l’on ne voyage que linéairement — ce qui, dans la théorie, fait écho à la lecture du temps : impossible de « partir » autrement que vers l’avant.',
    link: '/theorie/grand-line',
  },
  // — — H — —
  {
    term: 'Harley',
    canonDef: 'Texte sacré d’Elbaf divisé en trois parties et trois mondes, gravé près de la fresque sur l’Arbre d’Adam.',
    theoryDef: 'Récit que la théorie lit comme une prophétie du futur (la guerre finale) plutôt que comme un passé. L’hypothèse selon laquelle Usopp en serait l’auteur (sous le nom de Louis Arnot) est une interprétation.',
    link: '/theorie/elbaf-harley',
    controversial: true,
  },
  // — — I — —
  {
    term: 'Imu Nerona',
    canonDef: 'Souverain occulte siégeant sur le Trône Vide de Mary Geoise et commandant au Gorosei dans le plus grand secret.',
    theoryDef: 'Antagoniste central qui verrouillerait le présent pour empêcher une prédiction (Luffy/Joy Boy) de s’accomplir. La nature de son pouvoir (Omen) reste un mécanisme en cours de construction.',
    link: '/theorie/imu-nerona',
  },
  // — — J — —
  {
    term: 'Jour du serment',
    canonDef: 'Expression utilisée par la théorie pour désigner l’accomplissement des promesses (notamment celle faite aux Hommes-Poissons).',
    theoryDef: 'Moment où les peuples et leurs missions convergeaient vers le retour de Joy Boy. Le manga n’utilise pas ce nom comme un événement daté : c’est un concept de lecture.',
    link: '/theorie/peuples-royaumes',
    controversial: true,
  },
  {
    term: 'Joy Boy',
    canonDef: 'Figure légendaire du Siècle oublié, mentionnée sur le Ponéglyphe du Royaume Ryūgū, ayant fait une promesse non tenue il y a 800 ans.',
    theoryDef: 'Les sources récentes entretiennent l’ambiguïté sur la nature du nom : titre, identité ou appellation que le monde donnera à Luffy. La théorie ne le définit pas de façon trop rigide et le rapproche de Luffy.',
    link: '/theorie/joy-boy',
    controversial: true,
  },
  // — — L — —
  {
    term: 'Laugh Tale',
    canonDef: 'Dernière île de Grand Line nommée par Gol D. Roger, abritant le One Piece et la véritable histoire du Siècle oublié.',
    theoryDef: 'Île où la fin rencontre le début selon la théorie ; Roger y serait arrivé « trop tôt ». Raftel en est un ancien nom (voir l’entrée Raftel).',
    link: '/theorie/laugh-tale',
  },
  {
    term: 'Lili',
    canonDef: 'Nefertari Lili, reine du royaume d’Alabasta et l’un des Vingt Rois fondateurs du Gouvernement mondial.',
    theoryDef: 'La théorie rapproche Lili de Vivi (identité de l’histoire) et la relie aux Ponéglyphes dispersés. Ce rapprochement est une hypothèse centrale.',
    link: '/theorie/lili',
    controversial: true,
  },
  {
    term: 'Lodestar',
    canonDef: 'Île de Grand Line considérée comme la fin du chemin des Log Poses.',
    theoryDef: 'Selon la théorie, Lodestar serait Laugh Tale à l’époque de Joy Boy (le futur) : Roger y serait arrivé trop tôt. Hypothèse.',
    link: '/theorie/lodestar',
    controversial: true,
  },
  {
    term: 'Lunariens',
    canonDef: 'Peuple ancien, autrefois installé sur le site de Mary Geoise (Red Line), avant sa disparition.',
    theoryDef: 'Peuple « témoin » de l’histoire dans la théorie, lié aux origines de Red Line et à la préparation du Gouvernement.',
    link: '/theorie/lunariens',
  },
  // — — M — —
  // (Mother Flame rangé à la lettre F « Flamme Mère »)
  // — — N — —
  {
    term: 'Nika',
    canonDef: 'Le « Guerrier de la Libération », dieu du soleil réputé faire rire les esclaves et libérer les opprimés, nommé par le Gorosei au chapitre 1044.',
    theoryDef: 'Forme éveillée de Luffy (Gear 5) perçue à travers la foi des peuples (notamment celle de Kuma). Nika existe parce que les gens y croient.',
    link: '/theorie/nika',
  },
  {
    term: 'Noah',
    canonDef: 'Navire géant reposant au fond de la mer près de l’île des Hommes-Poissons.',
    theoryDef: 'Arche liée au déluge et à la mission des Hommes-Poissons dans la théorie ; son rôle exact reste spéculatif.',
    link: '/theorie/noah',
  },
  // — — O — —
  {
    term: 'Omen',
    canonDef: 'Terme utilisé par la théorie pour désigner le pouvoir propre d’Imu.',
    theoryDef: 'Mécanisme récent et spéculatif : un Omen « basique », puis amplifié par la Mother Flame, serait rapproché de l’arme utilisée contre Lulusia et d’Uranus. Piste en cours de construction.',
    link: '/theorie/omen',
    recent: true,
    controversial: true,
  },
  // — — P — —
  {
    term: 'Pluton',
    canonDef: 'Arme antique décrite comme un navire de guerre capable de détruire des îles ; ses plans sont conservés à Water Seven.',
    theoryDef: 'La théorie propose que Pluton soit Water Seven transformée en vaisseau par les géants de la Galley-La, avant de rejoindre Wa no Kuni. Hypothèse.',
    link: '/theorie/pluton-fiche',
    controversial: true,
  },
  {
    term: 'Ponéglyphes',
    canonDef: 'Stèles de pierre indestructibles gravées par le clan Kozuki pour transmettre l’histoire oubliée et la localisation de Laugh Tale.',
    theoryDef: 'Textes que la théorie situe dans le futur (rédigés par l’alliance de Luffy/Robin) puis transmis vers le passé : le mécanisme central de transmission, sans boucle physique générale.',
    link: '/theorie/poneglyphes',
  },
  {
    term: 'Poséidon',
    canonDef: 'Arme antique incarnée par la princesse sirène Shirahoshi, capable d’ordonner aux Rois des Mers.',
    theoryDef: 'Pouvoir dont l’éveil était attendu pour coïncider avec la venue de Joy Boy (Luffy) dans la lecture de la théorie.',
    link: '/theorie/poseidon-fiche',
  },
  // — — R — —
  {
    term: 'Raftel',
    canonDef: 'Ancien nom de la dernière île, révisé en « Laugh Tale ».',
    theoryDef: 'Terme historique / terminologie : la fiche complète est celle de Laugh Tale. Raftel est conservé comme alias, sans fiche dupliquée.',
    link: '/theorie/laugh-tale',
  },
  {
    term: 'Red Line',
    canonDef: 'Continent rouge traversant le globe du nord au sud, séparant les quatre mers et portant Mary Geoise au sommet.',
    theoryDef: 'Barrière géographique centrale que la guerre finale pourrait détruire, permettant aux quatre mers de communiquer (All Blue). Le lien Armes antiques → Red Line est un raisonnement de la théorie.',
    link: '/theorie/red-line',
  },
  {
    term: 'Reverse Mountain',
    canonDef: 'Montagne qui sépare les quatre mers et par laquelle on entre dans Grand Line, unissant les courants des quatre océans.',
    theoryDef: 'Symbole géographique de la « rencontre des mers » que la théorie relie à l’idée d’un monde tendant vers une seule pièce.',
    link: '/theorie/blue-star',
  },
  {
    term: 'Rio Ponéglyphe',
    canonDef: 'Texte rassemblant la véritable histoire, révélé comme objectif final de la recherche de Robin et de l’alliance de la Nuit d’Éclipse.',
    theoryDef: 'Le message que la théorie relie à l’histoire à venir (le présent en train de se construire) et au jour du serment.',
    link: '/theorie/rio-poneglyphe',
  },
  {
    term: 'Road Ponéglyphes',
    canonDef: 'Les quatre Ponéglyphes indiquant les coordonnées de Laugh Tale.',
    theoryDef: 'Leurs quatre points délimiteraient l’île ; la théorie y voit aussi une lecture temporelle liée au futur (Laugh Tale).',
    link: '/theorie/road-poneglyphes',
  },
  {
    term: 'Royaume antique',
    canonDef: 'Ancien royaume vaincu lors du Siècle oublié, dont l’existence a été effacée par le Gouvernement mondial.',
    theoryDef: 'Dans la théorie, le Royaume antique serait lié à la coalition des peuples et à l’histoire que Luffy est en train d’écrire.',
    link: '/theorie/royaume-antique',
  },
  {
    term: 'Ryuma',
    canonDef: 'Légendaire samouraï de Wano, « Dieu du combat », ayant défendu Wa no Kuni face au dragon.',
    theoryDef: 'La théorie rapproche Zoro de Ryuma (identité de l’histoire), un parallèle largement interprétatif.',
    link: '/theorie/ryuma',
    controversial: true,
  },
  // — — S — —
  {
    term: 'Siècle oublié',
    canonDef: 'Période de 100 ans (environ 900 à 800 ans avant l’ère actuelle) effacée de l’histoire officielle par le Gouvernement mondial.',
    theoryDef: 'Période qui, selon la théorie, n’a pas encore eu lieu : elle correspond à l’histoire que l’équipage de Luffy est en train d’écrire.',
    link: '/theorie/siecle-oublie',
  },
  // — — T — —
  {
    term: 'Toki',
    canonDef: 'Kozuki Toki, épouse de Kozuki Oden, capable de se projeter dans le futur.',
    theoryDef: 'Figure de transmission temporelle dans la théorie, liée à la communication entre les époques.',
    link: '/theorie/kozuki-toki',
  },
  // — — U — —
  {
    term: 'Uranus',
    canonDef: 'La troisième Arme antique, dont la nature précise n’est pas révélée.',
    theoryDef: 'La théorie rapproche Uranus de l’arme utilisée contre Lulusia et de l’Omen d’Imu amplifié par la Mother Flame. Hypothèse récente et spéculative.',
    link: '/theorie/uranus',
    controversial: true,
    recent: true,
  },
  // — — V — —
  {
    term: 'Vingt Rois',
    canonDef:
      'Les vingt souverains fondateurs du Gouvernement mondial ; l’un d’eux (Nefertari) est revenu sur sa décision. Quatorze familles sont identifiées à ce jour, six restent inconnues. Leurs armes, déposées devant le Trône Vide, réapparaissent au chapitre 1189 entre les mains d’Imu et des Chevaliers Divins.',
    theoryDef:
      'Origine de la coalition qui a vaincu le Royaume antique. La théorie identifie ces familles à celles des Chevaliers Divins et du Gorosei, que Garling s’apprêterait à renvoyer sur leurs trônes pour reformer la coalition contre Joy Boy.',
    link: '/theorie/vingt-rois',
  },
  {
    term: 'Volonté du D.',
    canonDef:
      'Initiale portée par certains personnages au destin hors du commun (Luffy, Roger, Teach, Xebec…). Le Gouvernement mondial la traque : Imu a personnellement ordonné de falsifier le nom de Gol D. Roger (chapitre 1190). Sa signification n’a jamais été révélée.',
    theoryDef:
      'Serment de liberté transmis de génération en génération, reliant ses porteurs à la coalition originelle de Joy Boy. Dans la lecture la plus radicale de la théorie, ce n’est pas une lignée biologique mais un message qui remonte le temps.',
    link: '/theorie/signification-d',
    controversial: true,
  },
  // — — Z — —
  {
    term: 'Zaza',
    canonDef: 'Déesse de la pluie, révélée récemment : avec le dieu du soleil Nika, elle est l’une des deux divinités shandias désormais identifiées, tandis que les dieux de la forêt et de la terre restent seulement mentionnés.',
    theoryDef: 'Rapprochée de la pluie visible sur la fresque d’Elbaf ; la théorie lui prête un rôle dans la guerre finale. Déduction, pas un fait du manga.',
    link: '/theorie/zaza',
    controversial: true,
  },
  {
    term: 'Zunesha',
    canonDef: 'Éléphant géant de l’île de Zou, portant un peuple de Minks sur son dos depuis des siècles.',
    theoryDef: 'Figure de la branche Pluton dans la théorie : il interviendrait dans l’ouverture de Wa no Kuni. Rien n’établit qu’il ait une « destination » géographique au sens du manga.',
    link: '/theorie/zunesha-fiche',
    controversial: true,
  },
];

// Sort alphabetically
glossaryEntries.sort((a, b) => a.term.localeCompare(b.term, 'fr'));

// Group by first letter
const grouped: Record<string, typeof glossaryEntries> = {};
glossaryEntries.forEach((entry) => {
  const letter = entry.term.charAt(0).toUpperCase();
  if (!grouped[letter]) grouped[letter] = [];
  grouped[letter].push(entry);
});
const sortedLetters = Object.keys(grouped).sort((a, b) => a.localeCompare(b, 'fr'));
---

<WikiLayout title="Glossaire" seoTitle="Glossaire One Piece : Joy Boy, Nika, Ponéglyphes et Siècle oublié | Les Fous du Bus" description="Glossaire One Piece : définitions rapides de Joy Boy, Nika, Ponéglyphes, Armes antiques, Siècle oublié et termes clés de la théorie." image="/og-glossaire.png" currentPath="/aide/glossaire">
  <Breadcrumb items={breadcrumbItems} />
  <div class="page-header">
    <h1>Glossaire</h1>
    <p class="page-desc">
      Définitions rigoureuses des termes clés. Chaque notion distingue clairement les éléments canons du manga des hypothèses proposées par la théorie, et renvoie vers la fiche complète. L'index alphabétique est généré automatiquement.
    </p>
  </div>

  <!-- Alphabet navigation -->
  <div class="alpha-nav" role="navigation" aria-label="Index alphabétique du glossaire">
    {
      sortedLetters.map((letter) => (
        <a href={`#letter-${letter}`} class="alpha-link">
          {letter}
        </a>
      ))
    }
  </div>

  <!-- Glossary entries -->
  {
    sortedLetters.map((letter) => (
      <div class="letter-section" id={`letter-${letter}`}>
        <h2 class="letter-title">{letter}</h2>
        <div class="entries">
          {grouped[letter].map((entry) => (
            <div class="entry-card">
              <div class="entry-head">
                <h3 class="entry-term">{entry.term}</h3>
                {entry.link && (
                  <a class="entry-link" href={entry.link}>
                    Voir la fiche →
                  </a>
                )}
              </div>
              {entry.controversial && (
                <span class="badge badge--controversial">terme interprété</span>
              )}
              {entry.recent && (
                <span class="badge badge--recent">développement récent</span>
              )}
              <div class="entry-blocks">
                <div class="entry-block entry-block--canon">
                  <span class="block-label">Dans le manga</span>
                  <p>{entry.canonDef}</p>
                </div>
                <div class="entry-block entry-block--theory">
                  <span class="block-label">Selon la théorie</span>
                  <p>{entry.theoryDef}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: 32px;
  }
  .page-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .page-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
  }

  .alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 36px;
    padding: 12px 16px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
  }

  .alpha-link {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .alpha-link:hover,
  .alpha-link:focus-visible {
    background-color: var(--surface);
    color: var(--cyan);
    transform: translateY(-2px);
    outline: 2px solid var(--cyan);
    outline-offset: 1px;
  }

  .letter-section {
    margin-bottom: 36px;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }

  .letter-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--violet);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .entry-card {
    padding: 20px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .entry-term {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }

  .entry-link {
    font-size: 13px;
    color: var(--cyan);
    text-decoration: none;
    font-weight: 600;
  }
  .entry-link:hover {
    text-decoration: underline;
  }

  .badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    margin-bottom: 10px;
