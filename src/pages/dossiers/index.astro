---
import Footer from '@components/Footer.astro';
import WikiLayout from '@layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';
import { siteCategories } from '../../data/siteNavigation';

const publishedArticles = (await getCollection('articles')).filter(
  (article) => article.data.status === 'published' && !article.data.sidebarHidden,
);
const articlesByCategory = new Map(
  siteCategories.map((category) => [
    category.id,
    publishedArticles
      .filter((article) => {
        if (article.id === 'nika') {
          return category.id === 'figures-principales' || category.id === 'dieux-croyances';
        }
        return article.data.category === category.id;
      })
      .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id, 'fr')),
  ]),
);
const searchableCount = [...articlesByCategory.values()].reduce(
  (total, articles) => total + articles.length,
  0,
);
---

<WikiLayout
  title="Dossiers"
  seoTitle="Dossiers de la théorie One Piece | Les Fous du Bus"
  description="Recherchez et filtrez les dossiers de la théorie par thème : monde, temporalité, personnages, Armes antiques, Gouvernement mondial et guerre finale."
  image="/og-dossiers.png"
  currentPath="/dossiers"
>
  <header class="dossiers-hero">
    <p class="eyebrow">Bibliothèque de la théorie</p>
    <h1>Trouvez une réponse,<br /><em>pas une liste infinie.</em></h1>
    <p>
      Recherchez un nom ou choisissez un thème. Les catégories restent repliées tant que vous n’en
      avez pas besoin, afin de garder une vue claire sur l’ensemble du puzzle.
    </p>
  </header>

  <section class="dossier-finder" aria-labelledby="finder-title">
    <h2 id="finder-title" class="sr-only">Rechercher dans les dossiers</h2>
    <label class="finder-search">
      <span>Rechercher</span>
      <input
        type="search"
        placeholder="Ex. Joy Boy, Pluton, Elbaf…"
        autocomplete="off"
        data-dossier-search
      />
    </label>
    <label class="finder-category">
      <span>Thème</span>
      <select data-dossier-category>
        <option value="all">Tous les thèmes</option>
        {siteCategories.map((category) => <option value={category.id}>{category.label}</option>)}
      </select>
    </label>
    <p class="finder-count" aria-live="polite">
      <strong data-result-count>{searchableCount}</strong><span>articles disponibles</span>
    </p>
  </section>

  <nav class="category-shortcuts" aria-label="Accès rapide aux thèmes" data-pagefind-ignore>
    {
      siteCategories.map((category) => (
        <a href={`#${category.id}`} data-category-shortcut={category.id}>
          <span aria-hidden="true">{category.icon}</span>
          {category.shortLabel}
        </a>
      ))
    }
  </nav>

  <div class="dossier-sections" data-dossier-sections>
    {
      siteCategories.map((category, categoryIndex) => {
        const categoryArticles = articlesByCategory.get(category.id) ?? [];
        return (
          <details
            class="dossier-section"
            id={category.id}
            data-dossier-section={category.id}
            open={categoryIndex === 0}
          >
            <summary>
              <span class="dossier-section__icon" aria-hidden="true">
                {category.icon}
              </span>
              <span class="dossier-section__heading">
                <>
                  <strong>{category.label}</strong>
                  <small>{category.description}</small>
                </>
              </span>
              <span class="dossier-section__count">{categoryArticles.length}</span>
              <span class="dossier-section__chevron" aria-hidden="true">
                ⌄
              </span>
            </summary>
            <div class="article-grid">
              {categoryArticles.map((article) => (
                <a
                  href={`/theorie/${article.id}`}
                  class="article-card"
                  data-dossier-article
                  data-search={`${article.data.title} ${article.data.summary ?? ''}`.toLocaleLowerCase(
                    'fr',
                  )}
                >
                  <div>
                    <small>
                      {article.data.navigationType === 'dossier' ? 'Dossier approfondi' : 'Fiche'}
                    </small>
                    <strong>{article.data.title}</strong>
                    {article.data.summary && <p>{article.data.summary}</p>}
                  </div>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </details>
        );
      })
    }
  </div>

  <p class="empty-state" data-empty-state hidden>Aucun dossier ne correspond à cette recherche.</p>

  <Footer />
</WikiLayout>

<style>
  .dossiers-hero {
    max-width: 860px;
    margin: var(--space-3) 0 var(--space-7);
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dossiers-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .dossiers-hero h1 em {
    color: var(--cyan);
    font-style: normal;
  }
  .dossiers-hero > p:last-child {
    max-width: 700px;
    margin: 21px 0 0;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.7;
  }

  .dossier-finder {
    position: sticky;
    z-index: 20;
    top: calc(var(--nav-h) + 8px);
    display: grid;
    grid-template-columns: minmax(250px, 1.5fr) minmax(210px, 0.8fr) auto;
    gap: 10px;
    align-items: end;
    margin-bottom: 14px;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 15px;
    background: color-mix(in srgb, var(--bg-secondary) 94%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 24px var(--shadow-color);
  }
  .finder-search,
  .finder-category {
    display: grid;
    gap: 5px;
  }
  .finder-search > span,
  .finder-category > span {
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .finder-search input,
  .finder-category select {
    width: 100%;
    min-height: 46px;
    padding: 0 13px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--bg-main);
    color: var(--text-main);
    font: inherit;
    font-size: 14px;
  }
  .finder-search input:focus,
  .finder-category select:focus {
    border-color: var(--cyan);
    outline: 2px solid color-mix(in srgb, var(--cyan) 24%, transparent);
  }
  .finder-count {
    min-width: 112px;
    margin: 0;
    padding: 5px 8px;
    text-align: right;
  }
  .finder-count strong,
  .finder-count span {
    display: block;
  }
  .finder-count strong {
    color: var(--cyan);
    font-size: 20px;
  }
  .finder-count span {
    color: var(--text-muted);
    font-size: 11px;
  }

  .category-shortcuts {
    display: flex;
    gap: 7px;
    margin: 0 0 22px;
    padding: 4px 0 8px;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .category-shortcuts a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: var(--control-size);
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-full);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
  }
  .category-shortcuts a:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
  .category-shortcuts a:focus-visible,
  .article-card:focus-visible,
  .dossier-section > summary:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .dossier-sections {
    display: grid;
    gap: 12px;
  }
  .dossier-section {
    scroll-margin-top: calc(var(--nav-h) + 90px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--bg-secondary);
  }
  .dossier-section > summary {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 24px;
    gap: 13px;
    min-height: 86px;
    align-items: center;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  .dossier-section > summary::-webkit-details-marker {
    display: none;
  }
  .dossier-section__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 13px;
    background: var(--surface);
    font-size: 23px;
  }
  .dossier-section__heading {
    min-width: 0;
  }
  .dossier-section__heading strong,
  .dossier-section__heading small {
    display: block;
  }
  .dossier-section__heading strong {
    font-size: 17px;
  }
  .dossier-section__heading small {
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.45;
  }
  .dossier-section__count {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--violet-light);
    font-size: 12px;
    font-weight: 800;
  }
  .dossier-section__chevron {
    color: var(--text-muted);
    font-size: 20px;
    transition: transform 0.16s ease;
  }
  .dossier-section[open] .dossier-section__chevron {
    transform: rotate(180deg);
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-3);
    padding: 0 var(--space-4) var(--space-4);
  }
  .article-card {
    display: flex;
    min-height: 128px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-main);
    color: inherit;
    text-decoration: none;
  }
  .article-card:hover {
    border-color: var(--cyan);
  }
  .article-card small,
  .article-card strong {
    display: block;
  }
  .article-card small {
    color: var(--violet-light);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .article-card strong {
    margin-top: 5px;
    font-size: 15px;
  }
  .article-card p {
    display: -webkit-box;
    margin: 7px 0 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .article-card > span {
    color: var(--cyan);
    font-size: 18px;
  }
  .empty-state {
    padding: 34px;
    border: 1px dashed var(--border-strong);
    border-radius: 14px;
    color: var(--text-secondary);
    text-align: center;
  }

  @media (max-width: 760px) {
    .dossier-finder {
      position: relative;
      top: auto;
      grid-template-columns: 1fr;
    }
    .finder-count {
      display: flex;
      align-items: baseline;
      gap: 7px;
      text-align: left;
    }
    .article-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .dossiers-hero h1 br {
      display: none;
    }
    .dossier-section > summary {
      grid-template-columns: 42px minmax(0, 1fr) auto;
      padding: 12px;
    }
    .dossier-section__icon {
      width: 42px;
      height: 42px;
    }
    .dossier-section__chevron {
      display: none;
    }
    .dossier-section__heading small {
      display: none;
    }
    .article-card {
      min-height: 112px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dossier-section__chevron {
      transition: none;
    }
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-dossier-search]');
  const category = document.querySelector<HTMLSelectElement>('[data-dossier-category]');
  const sections = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-dossier-section]'),
  );
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');

  const normalizeSearch = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('fr')
      .trim();

  const applyDossierFilters = () => {
    const query = normalizeSearch(search?.value ?? '');
    const selectedCategory = category?.value ?? 'all';
    let visibleArticles = 0;

    sections.forEach((section) => {
      const categoryMatches =
        selectedCategory === 'all' || section.dataset.dossierSection === selectedCategory;
      let sectionMatches = 0;
      section.querySelectorAll<HTMLElement>('[data-dossier-article]').forEach((article) => {
        const text = normalizeSearch(article.dataset.search ?? '');
        const matches = categoryMatches && (!query || text.includes(query));
        article.hidden = !matches;
        if (matches) sectionMatches += 1;
      });
      section.hidden = sectionMatches === 0;
      if ((query || selectedCategory !== 'all') && sectionMatches) section.open = true;
      visibleArticles += sectionMatches;
    });

    if (count) count.textContent = String(visibleArticles);
    if (empty) empty.hidden = visibleArticles !== 0;
  };

  search?.addEventListener('input', applyDossierFilters);
  category?.addEventListener('change', applyDossierFilters);

  document.querySelectorAll<HTMLAnchorElement>('[data-category-shortcut]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = document.getElementById(
        link.dataset.categoryShortcut ?? '',
      ) as HTMLDetailsElement | null;
      if (target) target.open = true;
    });
  });

  if (location.hash) {
    const target = document.querySelector<HTMLDetailsElement>(location.hash);
    if (target) target.open = true;
  }
</script>
