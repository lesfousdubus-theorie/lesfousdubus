    font-size: 17px;
    color: var(--violet-light);
    font-weight: 600;
    margin-bottom: 28px;
    letter-spacing: -0.01em;
  }

  .intro-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--cyan);
    padding: 22px 24px;
    border-radius: var(--border-radius-lg);
    margin-bottom: 32px;
  }

