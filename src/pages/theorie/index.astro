---
import Footer from '@components/Footer.astro';
import WikiLayout from '@layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';
import { understandingPaths } from '../../data/siteNavigation';
import { theoryTimeline } from '../../data/theoryTimeline';
import { getRecentArticleUpdates } from '@utils/chapter-updates';

const articles = await getCollection('articles', ({ data }) => data.status === 'published');
const chapters = await getCollection('chapters');
const recentUpdates = getRecentArticleUpdates(articles, chapters, 4);
const pathIcons = ['⚡', '🧭', '📚'];
---

<WikiLayout
  title="La théorie"
  seoTitle="Théorie One Piece : passé, présent et futur | Les Fous du Bus"
  description="Choisissez votre niveau de lecture pour comprendre la théorie des Fous du Bus : explication rapide, résumé en 10 points ou démonstration complète."
  currentPath="/theorie"
>
  <header class="theory-hero">
    <p class="eyebrow">Choisissez votre voyage</p>
    <h1>Une théorie.<br /><em>Trois façons de la comprendre.</em></h1>
    <p>
      Vous n’avez pas besoin de lire tout le wiki pour saisir l’idée. Commencez au niveau qui vous
      convient ; vous pourrez approfondir chaque preuve ensuite, sans perdre le fil.
    </p>
  </header>

  <ol class="reading-levels" aria-label="Niveaux de lecture de la théorie">
    {
      understandingPaths.map((path, index) => (
        <li>
          <a
            href={path.href}
            class:list={['reading-level', { 'reading-level--featured': index === 0 }]}
          >
            <span class="reading-level__icon" aria-hidden="true">
              {pathIcons[index]}
            </span>
            <div class="reading-level__content">
              <span class="reading-level__time">
                Niveau {index + 1}
              </span>
              <h2>{path.label}</h2>
              <p>{path.description}</p>
              <strong>
                {index === 0
                  ? 'Commencer ici'
                  : index === 1
                    ? 'Voir la frise'
                    : 'Lire la démonstration'}{' '}
                <span aria-hidden="true">→</span>
              </strong>
            </div>
          </a>
        </li>
      ))
    }
  </ol>

  <section class="explore-next" aria-labelledby="explore-next-title">
    <div>
      <p class="eyebrow">Après la lecture</p>
      <h2 id="explore-next-title">Passez de la démonstration à l’exploration</h2>
      <p>
        La frise distingue dates établies, périodes approximatives et futurs à ordre ouvert. Les
        dossiers permettent ensuite d’isoler un personnage, un lieu ou un mécanisme précis.
      </p>
    </div>
    <div class="explore-next__links">
      <a href="/theorie/chronologie"
        ><span aria-hidden="true">🕰️</span><strong>Frise chronologique</strong><small
          >{theoryTimeline.length} événements reliés</small
        ></a
      >
      <a href="/dossiers"
        ><span aria-hidden="true">🗂️</span><strong>Dossiers thématiques</strong><small
          >Filtrer les sujets</small
        ></a
      >
      <a href="/explorer"
        ><span aria-hidden="true">🧠</span><strong>Explorer visuellement</strong><small
          >Cartes et correspondances</small
        ></a
      >
    </div>
  </section>

  <section class="recent" aria-labelledby="recent-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">La théorie évolue</p><h2 id="recent-title">Mises à jour récentes</h2>
      </div>
      <a href="/chapitres">Toutes les analyses →</a>
    </div>
    <div class="recent__grid">
      {
        recentUpdates.map(({ article, chapter }) => (
          <a href={`/theorie/${article.id}`}>
            <small>Mis à jour au chapitre {chapter}</small>
            <strong>{article.data.title}</strong>
            <span>{article.data.summary}</span>
          </a>
        ))
      }
    </div>
  </section>

  <Footer />
</WikiLayout>

<style>
  .theory-hero {
    max-width: 850px;
    margin: 12px auto 40px;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .theory-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .theory-hero h1 em {
    color: var(--cyan);
    font-style: normal;
  }
  .theory-hero > p:last-child {
    max-width: 680px;
    margin: 22px auto 0;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.7;
  }

  .reading-levels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reading-levels li {
    min-width: 0;
  }
  .reading-level {
    display: flex;
    min-height: 244px;
    height: 100%;
    gap: var(--space-4);
    padding: var(--card-padding);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .reading-level:hover {
    transform: translateY(-4px);
    border-color: var(--cyan);
    box-shadow: 0 16px 38px var(--shadow-color);
  }
  .reading-level:focus-visible,
  .explore-next__links a:focus-visible,
  .recent__grid a:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
  .reading-level--featured {
    border-color: color-mix(in srgb, var(--cyan) 55%, var(--border-color));
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--cyan) 10%, var(--bg-secondary)),
      var(--bg-secondary)
    );
  }
  .reading-level__icon {
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--surface);
    font-size: 22px;
  }
  .reading-level__content {
    min-width: 0;
  }
  .reading-level__time {
    color: var(--violet-light);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .reading-level h2 {
    margin: 7px 0 8px;
    font-size: 20px;
  }
  .reading-level p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.55;
  }
  .reading-level strong {
    display: block;
    margin-top: 18px;
    color: var(--cyan);
    font-size: 13px;
  }

  .explore-next {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(320px, 1.15fr);
    gap: 36px;
    margin: 56px 0 48px;
    padding: clamp(24px, 5vw, 40px);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    background: var(--surface);
  }
  .explore-next h2,
  .recent h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
  }
  .explore-next p:not(.eyebrow) {
    color: var(--text-secondary);
    line-height: 1.65;
  }
  .explore-next__links {
    display: grid;
    gap: 9px;
  }
  .explore-next__links a {
    display: grid;
    grid-template-columns: 42px 1fr;
    column-gap: 10px;
    min-height: 68px;
    align-items: center;
    padding: 10px 14px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
  }
  .explore-next__links a:hover {
    border-color: var(--cyan);
  }
  .explore-next__links a > span {
    grid-row: 1 / 3;
    font-size: 23px;
  }
  .explore-next__links strong {
    font-size: 14px;
  }
  .explore-next__links small {
    color: var(--text-muted);
    font-size: 12px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }
  .section-heading > a {
    display: inline-flex;
    min-height: var(--control-size);
    align-items: center;
    color: var(--cyan);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .recent__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .recent__grid a {
    display: grid;
    gap: 7px;
    min-height: 150px;
    padding: 20px;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--bg-secondary);
    color: inherit;
    text-decoration: none;
  }
  .recent__grid a:hover {
    border-color: var(--violet);
  }
  .recent__grid small {
    color: var(--violet-light);
    font-size: 12px;
  }
  .recent__grid strong {
    font-size: 16px;
  }
  .recent__grid span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 820px) {
    .explore-next {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .theory-hero {
      text-align: left;
    }
    .theory-hero > p:last-child {
      margin-left: 0;
    }
    .reading-level {
      min-height: 208px;
      padding: var(--space-5);
    }
    .recent__grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-level {
      transition: none;
    }
  }
</style>
