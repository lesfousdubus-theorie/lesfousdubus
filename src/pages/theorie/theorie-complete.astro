---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import { READING_PATH } from '@utils/parcours';
import { getCollection } from 'astro:content';

// Parcours de lecture séquentiel, aligné sur la navigation « article suivant »
// affichée en bas de chaque fiche : une seule source (src/utils/parcours.ts).
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const parcours = READING_PATH.map((slug) => ({
  slug,
  title: allArticles.find((a) => a.id === slug)?.data.title ?? slug,
  href: `/theorie/${slug}`,
}));

const sections = [
  {
    id: 'laugh-tale',
    title: '1. Tout commence avec Laugh Tale',
    text: 'Grand Line fait le tour du monde, mais Red Line empêche une vraie circumnavigation. À la fin de la route se trouve Lodestar, tandis que Laugh Tale reste introuvable. La théorie propose que le problème ne soit pas seulement où se trouve Laugh Tale, mais quand elle se trouve — liée à Lodestar et à une autre époque où Red Line et le Gouvernement mondial auront été bouleversés. C’est ce qui donne sens au “trop tôt” de Roger.',
    links: [
      ['Laugh Tale', '/theorie/laugh-tale'],
      ['Lodestar', '/theorie/lodestar'],
      ['Red Line', '/theorie/red-line'],
    ],
  },
  {
    id: 'poneglyphes-avenir',
    title: '2. Les Ponéglyphes raconteraient l’avenir',
    text: 'C’est le mécanisme fondamental. Les Ponéglyphes existent bien depuis 800 ans, mais les événements qu’ils rapportent ne s’étaient pas nécessairement déjà produits. Ils auraient été créés à partir d’informations venues du futur, puis transmis 800 ans en arrière. Le Rio Ponéglyphe ne raconterait pas seulement une ancienne guerre : il raconterait l’histoire que nous lisons depuis le chapitre 1.',
    links: [
      ['Les Ponéglyphes et le futur', '/theorie/ponelyphes-futur'],
      ['Les Ponéglyphes', '/theorie/ponelyphes'],
      ['Points encore à expliquer', '/verifier/questions'],
    ],
  },
  {
    id: 'joyboy-luffy',
    title: '3. Joy Boy serait Monkey D. Luffy',
    text: 'Dans cette lecture, Joy Boy n’est pas un ancien héros que Luffy répète. C’est l’inverse : Joy Boy est le nom sous lequel Luffy entrera dans l’Histoire. Pendant 800 ans, croyances, objets et promesses ont convergé vers lui. Joy Boy n’est pas l’origine de Luffy, il en est la conséquence — c’est pourquoi Luffy, qui agit librement sans chercher à incarner une légende, finit par la devenir.',
    links: [
      ['Joy Boy', '/theorie/joy-boy'],
      ['Monkey D. Luffy', '/theorie/luffy'],
      ['Zunesha et les tambours', '/theorie/zunesha-fiche'],
    ],
  },
  {
    id: 'trois-noms',
    title: '4. Luffy, Joy Boy et Nika : trois noms pour un même homme',
    text: 'Luffy est son identité, Joy Boy le nom que le monde lui donnera, Nika la figure divine sous laquelle certains peuples l’interprètent. Trois manières de parler d’un même homme, pas trois personnes à trois époques. Cette distinction éclaire la promesse du Royaume Ryugu, l’Éveil et la foi des Boucaniers.',
    links: [
      ['Nika', '/theorie/nika'],
      ['Le Hito Hito no Mi modèle Nika', '/theorie/hito-hito-no-mi-nika'],
      ['La volonté héritée', '/theorie/volonte-heritee'],
    ],
  },
  {
    id: 'autres-figures',
    title: '5. Les autres figures du Siècle oublié appartiendraient au présent',
    text: 'La même logique s’applique à d’autres légendes : Shirahoshi / Poséidon, Vivi / Lili, Teach / Davy Jones, Zoro / Ryuma. Non pas de simples ressemblances, mais l’idée que leurs actions présentes ou futures, transmises vers le passé, sont devenues les légendes que le monde croit anciennes.',
    links: [
      ['Shirahoshi est Poséidon', '/theorie/poseidon'],
      ['Vivi est Lili', '/theorie/lili-vivi-et-les-poneglyphes'],
      ['Teach est Davy Jones', '/theorie/davy-jones'],
    ],
  },
  {
    id: 'peuples-preparation',
    title: '6. Chaque peuple aurait préparé une partie du monde pendant 800 ans',
    text: 'Si les Ponéglyphes portent des informations du futur, ils portent aussi des instructions. Ryugu garde Noah en attendant Poséidon, Wa no Kuni doit ouvrir ses frontières, les Minks sont liés à Zunesha, les Shandias, les Boucaniers, Alabasta… Chaque histoire séparée serait une pièce d’une même préparation pour la guerre finale.',
    links: [
      ['Peuples et royaumes', '/theorie/peuples-royaumes'],
      ['Elbaf et le Harley', '/theorie/elbaf-halley'],
      ['Noah', '/theorie/noah'],
    ],
  },
  {
    id: 'royaume-antique',
    title: '7. Le Royaume antique serait lié au monde qui reste à construire',
    text: 'Vegapunk décrit une civilisation antique à la technologie inexplicablement avancée. Si “l’antique” venait en réalité du futur, le paradoxe disparaît : inventions de Vegapunk, Mother Flame, Emeth et technologies actuelles participeraient à créer le monde que le passé a cru disparu.',
    links: [
      ['Royaume antique', '/theorie/royaume-antique'],
      ['Vegapunk', '/theorie/vegapunk'],
      ['Emeth, le robot du futur', '/theorie/emeth-robot-du-futur'],
    ],
  },
  {
    id: 'imu-avenir',
    title: '8. Imu ne craindrait pas seulement son passé, mais son avenir',
    text: 'Depuis 800 ans, Imu semble obsédé par Joy Boy, Nika et certaines familles. La théorie propose qu’il dispose d’informations incomplètes sur ce qui doit arriver et cherche à empêcher un avenir qu’il ne comprend pas. En voulant effacer l’Histoire et persécuter certains peuples, il aurait créé les conditions de l’apparition de Joy Boy.',
    links: [
      ['Imu Nerona', '/theorie/imu-nerona-fiche'],
      ['La prescience et Imu', '/theorie/la-prescience-et-imu'],
      ['Madame Shirley', '/theorie/madame-shirley'],
    ],
  },
  {
    id: 'grande-guerre',
    title: '9. La Grande Guerre serait encore devant nous',
    text: 'La guerre du Siècle oublié ne serait pas terminée il y a 800 ans, mais celle vers laquelle One Piece se dirige. Luffy, ses alliés, les Armes antiques et les nations préparées se retrouveraient face au Gouvernement mondial. Red Line pourrait tomber, les mers se réunir, All Blue naître : le monde deviendrait littéralement une seule pièce.',
    links: [
      ['Guerre finale', '/theorie/guerre-finale'],
      ['Le Déluge et All Blue', '/theorie/deluge-all-blue'],
      ['All Blue', '/theorie/all-blue'],
    ],
  },
  {
    id: 'retournement',
    title: '10. Le retournement final',
    text: 'Nous pensions que Luffy héritait de Joy Boy ; la révélation serait que Joy Boy, c’est lui. Que les Ponéglyphes racontaient une civilisation disparue ; ils raconteraient le monde à créer. Que Roger avait vu le passé ; il avait vu l’histoire de ceux qui viennent après lui. Depuis le chapitre 1, nous ne revivons pas le Siècle oublié : nous le vivons.',
    links: [
      ['Le Siècle oublié est le présent', '/theorie/siecle-oublie-present'],
      ['Résumé en 10 points', '/theorie/resume'],
      ['Sources et méthode', '/verifier/sources'],
    ],
  },
];
---

<WikiLayout
  title="Théorie complète"
  seoTitle="Théorie complète One Piece : Siècle oublié, Joy Boy et guerre finale | Les Fous du Bus"
  description="La théorie complète du Siècle oublié est le présent : 10 chapitres de Laugh Tale à Joy Boy, des Ponéglyphes du futur à la Grande Guerre — synthèse."
  currentPath="/theorie/theorie-complete"
>
  <article class="complete-page">
    <p class="eyebrow">Synthèse éditoriale</p>
    <h1>La théorie complète</h1>
    <p class="intro">
      Le Siècle oublié n’aurait pas eu lieu il y a 800 ans. Les Ponéglyphes raconteraient l’avenir,
      Joy Boy serait Luffy à la fin de son aventure, et la Grande Guerre serait celle vers laquelle
      le manga se dirige aujourd’hui. Cette page suit la même chaîne causale que le
      <a href="/theorie/resume">Résumé en 10 points</a> et renvoie vers les fiches pour l’argumentation
      détaillée. Les extensions les plus spéculatives (Armes antiques, Mother Flame, Fruits du Démon,
      communication temporelle) sont signalées comme telles.
    </p>
    <nav class="parcours-list" aria-label="Parcours de lecture de la théorie">
      <h2>Parcours de lecture ({parcours.length} étapes)</h2>
      <p class="parcours-list__intro">
        Suivez cet ordre pour lire la théorie comme un livre. Chaque fiche affiche en bas un lien «
        article précédent / article suivant » qui reprend exactement ce parcours.
      </p>
      <ol class="parcours-list__items">
        {
          parcours.map((item, i) => (
            <li>
              <a href={item.href}>
                <span class="parcours-list__num">{i + 1}</span>
                {item.title}
              </a>
            </li>
          ))
        }
      </ol>
      <a class="parcours-list__start" href={parcours[0].href}>Commencer par {parcours[0].title} →</a
      >
    </nav>

    <nav class="toc" aria-label="Sommaire de la théorie">
      <h2>Sommaire — 10 chapitres</h2><ol>
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title.replace(/^\d+\. /, '')}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    {
      sections.map((section) => (
        <section id={section.id} class="theory-section">
          <>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
            <div class="links">
              {section.links.map(([label, href]) => (
                <a href={href}>{label} →</a>
              ))}
            </div>
          </>
        </section>
      ))
    }
    <aside class="method">
      <h2>Comment lire cette synthèse</h2><p>
        Les pages « Vérifier » regroupent preuves, objections et questions ouvertes. Une correspondance
        narrative ou une prédiction ne vaut pas confirmation canonique. Les mécanismes les plus
        spéculatifs — comme l’origine exacte de la Mother Flame ou la nature précise de la
        communication entre époques (ch. 1188) — sont présentés comme des pistes, distinctes du cœur
        historique de la théorie.
      </p><a href="/verifier">Consulter la méthode de vérification →</a>
    </aside>
  </article>
  <Footer />
</WikiLayout>
<style>
  .complete-page {
    max-width: 760px;
  }
  .eyebrow {
    color: var(--violet-light);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .complete-page h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0.4rem 0 12px;
  }
  .intro {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 36px;
  }
  .intro a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .parcours-list {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--gradient-card);
    padding: 22px;
    margin-bottom: 18px;
    border-left: 3px solid var(--cyan);
  }
  .parcours-list h2 {
    font-size: 1.2rem;
    margin: 0 0 8px;
  }
  .parcours-list__intro {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 14px;
    font-size: 0.95rem;
  }
  .parcours-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 4px;
  }
  .parcours-list__items a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .parcours-list__items a:hover {
    background: color-mix(in srgb, var(--cyan) 8%, transparent);
    color: var(--cyan);
  }
  .parcours-list__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--violet) 18%, transparent);
    color: var(--violet-light);
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .parcours-list__start {
    display: inline-block;
    margin-top: 14px;
    color: var(--cyan);
    text-decoration: none;
    font-weight: 600;
  }
  .toc,
  .theory-section,
  .method {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--gradient-card);
    padding: 22px;
    margin-bottom: 18px;
  }
  .toc h2,
  .theory-section h2,
  .method h2 {
    font-size: 1.2rem;
    margin: 0 0 12px;
  }
  .toc ol {
    margin: 0;
    padding-left: 20px;
    columns: 2;
  }
  .toc li {
    margin: 7px 0;
  }
  .toc a,
  .links a,
  .method a {
    color: var(--cyan);
    text-decoration: none;
  }
  .theory-section {
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .theory-section p,
  .method p {
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 15px;
    font-size: 0.93rem;
  }
  .method {
    border-left: 3px solid var(--violet);
  }
  @media (max-width: 600px) {
    .toc ol {
      columns: 1;
    }
  }
</style>
