---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import { READING_PATH } from '@utils/parcours';
import { getCollection } from 'astro:content';

// Données pour le JSON-LD Article (page maîtresse, longue forme) et BreadcrumbList.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
const canonicalPageUrl = `${siteUrl}/theorie/theorie-complete/`;
const ogImageUrl = `${siteUrl}/og-default.png`;
const pageTitle = 'La théorie complète';
const pageSeoTitle =
  'Théorie complète One Piece : le Siècle oublié est le présent — démonstration | Les Fous du Bus';
const pageDescription =
  'La théorie complète du Siècle oublié est le présent : 22 chapitres de Blue Star à Joy Boy, des Ponéglyphes du futur à la Grande Guerre — la démonstration.';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDescription,
  url: canonicalPageUrl,
  image: ogImageUrl,
  articleSection: 'La théorie',
  inLanguage: 'fr-FR',
  author: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalPageUrl,
  },
};

// Petite carte de lecture « en un coup d’œil », reléguée tout en bas de la page.
// Elle n’est plus dans le corps principal : la page se lit désormais comme un seul
// grand article continu. On garde la même source unique (src/utils/parcours.ts).
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const parcours = READING_PATH.map((slug) => ({
  slug,
  title: allArticles.find((a) => a.id === slug)?.data.title ?? slug,
  href: `/theorie/${slug}`,
}));

// Simple aide à la mise en forme : **gras** dans les textes.
const md = (text: string) => text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

type Block =
  | { t: 'p'; text: string }
  | { t: 'ul'; items: string[] }
  | { t: 'quote'; text: string }
  | { t: 'note'; text: string };

interface Section {
  id: string;
  n: number;
  question: string;
  title: string;
  blocks: Block[];
  links: [string, string][];
}

const sections: Section[] = [
  {
    id: 'point-de-depart',
    n: 1,
    question: 'Pourquoi oser renverser la lecture du Siècle oublié ?',
    title: 'Le point de départ',
    blocks: [
      {
        t: 'p',
        text: 'Une bonne histoire se reconnaît à sa fin. John Truby, théoricien du récit, le résume ainsi : une grande fin ne ferme pas l’histoire, elle la **recontextualise**. Elle nous donne envie de tout revoir depuis le début, parce qu’elle rééclaire chaque scène que nous avions mal lue.',
      },
      {
        t: 'p',
        text: 'Les Fous du Bus ont fait ce pari : trouver la fin de *One Piece*. Et leur conviction tient en une phrase — **dans ce monde, c’est le début qui côtoie la fin**. Le Siècle oublié, que tout le monde situe il y a environ huit cents ans, et le présent que nous lisons depuis le chapitre 1.',
      },
      {
        t: 'p',
        text: 'Concrètement : les événements attribués au Siècle oublié — Joy Boy, la Grande Guerre, le Royaume antique, une partie de la véritable histoire du monde — n’auraient **pas encore eu lieu**. Ils appartiendraient à l’époque de Luffy.',
      },
      {
        t: 'p',
        text: 'Le monde croit se souvenir de son passé. Il posséderait en réalité, depuis huit cents ans, des informations venues de son **avenir**. Cette page construit cette démonstration pas à pas, d’un simple problème géographique jusqu’au retournement final — sans jamais poser une conclusion avant d’avoir montré d’où elle vient.',
      },
    ],
    links: [
      ['L’introduction complète', '/theorie/les-bases-du-siecle-oublie'],
      ['Professeur Clover et Ohara', '/theorie/professeur-clover-et-ohara'],
    ],
  },
  {
    id: 'probleme-geographique',
    n: 2,
    question: 'Qu’y a-t-il d’anormal dans la géographie du monde ?',
    title: 'Le problème géographique de Blue Star',
    blocks: [
      {
        t: 'p',
        text: 'Avant d’apprendre la vérité sur ce monde, il faut le comprendre — et cela commence par sa géographie. Blue Star est une planète composée à **90 % d’eau**, divisée en deux par un continent unique : la **Red Line**.',
      },
      {
        t: 'p',
        text: 'Cette anomalie continentale a deux conséquences majeures. Elle crée d’abord un océan unique qui traverse le monde perpendiculairement au continent rouge : la **Grand Line**, avec le Paradis et le Nouveau Monde. Ensuite, coupée comme un gâteau, Blue Star est divisée en quatre mers qui ne peuvent ni se retrouver ni communiquer : West Blue, East Blue, North Blue et South Blue, séparées par la Calm Belt, cette ceinture de Grand Line où le vent fait défaut.',
      },
      {
        t: 'p',
        text: 'Il n’existe donc qu’un seul chemin pour faire le tour du monde, et c’est Grand Line. Pour y naviguer, les marins utilisent des **Log Pose**, seuls instruments fiables sur l’océan unique : ils n’indiquent pas le nord, mais la prochaine île, en réagissant au champ magnétique. Les **Eternal Pose**, eux, pointent toujours vers la même destination.',
      },
      {
        t: 'p',
        text: 'Seulement voilà : un problème que personne n’évoque jamais. À l’heure actuelle, **faire le tour du monde est tout simplement impossible**. Pour traverser le globe via Grand Line, on rencontre Red Line trois fois. Une fois pour emprunter Reverse Mountain, une seconde pour entrer dans le Nouveau Monde, et une troisième à la fin du voyage, au dos de Reverse Mountain — où **aucune issue n’existe**.',
      },
      {
        t: 'p',
        text: 'La dernière île de Grand Line, **Lodestar**, se trouve juste avant ce mur rouge haut de dix mille mètres. Après elle, une seule solution : faire demi-tour, comme le fit Gol D. Roger il y a trente-neuf ans.',
      },
    ],
    links: [
      ['Blue Star', '/theorie/blue-star'],
      ['Grand Line', '/theorie/grand-line'],
      ['Red Line', '/theorie/red-line'],
      ['Lodestar', '/theorie/lodestar'],
    ],
  },
  {
    id: 'laugh-tale',
    n: 3,
    question: 'Pourquoi Laugh Tale est-elle introuvable ?',
    title: 'Lodestar et le mystère de Laugh Tale',
    blocks: [
      {
        t: 'p',
        text: 'On raconte pourtant qu’il existe une ultime île permettant de faire le tour du monde : **Laugh Tale**, là où se trouverait le trésor de Joy Boy, celui que le monde appelle le One Piece, découvert par le roi des pirates il y a vingt-cinq ans.',
      },
      {
        t: 'p',
        text: 'Rappelons une évidence : la Terre est ronde. Faire le tour du monde, comme l’expédition de Magellan, c’est **rentrer à la maison**, revenir au point de départ, là où tout a commencé. Alors, s’il existe une île après Lodestar, une île après le bout du monde, où peut-elle bien se trouver — sinon là où **la fin rencontre le début** ?',
      },
      {
        t: 'p',
        text: 'Et surtout : comment se fait-il que personne ne l’ait trouvée en **huit cents ans** ? Nous savons nous rendre dix mille mètres dans le ciel, dix mille mètres sous les océans, et même sur la Lune. Alors comment un simple « conte du rire » a-t-il pu rester introuvable pendant huit siècles ?',
      },
      {
        t: 'p',
        text: 'Pour garder une cohérence totale entre l’œuvre et sa géographie, une possibilité se dégage : **Laugh Tale n’appartiendrait pas au même moment de l’histoire**. Comment Gol D. Roger a-t-il pu devenir le premier homme à faire le tour du monde alors que Red Line l’en empêche ? Une réponse possible est qu’il se soit rendu à une époque où Red Line n’existe plus : l’époque de Joy Boy.',
      },
      {
        t: 'p',
        text: 'Dans cette version initiale de la théorie, Roger aurait alors **voyagé vers le futur** — là où All Blue existerait, où l’on pourrait naviguer librement, où le Gouvernement mondial n’existerait plus et où l’humanité entière ne formerait plus qu’une seule pièce. C’est à cette époque que se trouverait le One Piece. On précisera au chapitre 18 que la mécanique temporelle exacte reste en construction (notamment depuis les chapitres 1187–1188, qui suggèrent plutôt une « communication à travers le temps » qu’un voyage physique).',
      },
      {
        t: 'quote',
        text: '« Nous sommes arrivés trop tôt. » — Gol D. Roger, sur Laugh Tale (ch. 968).',
      },
    ],
    links: [
      ['Laugh Tale', '/theorie/laugh-tale'],
      ['Lodestar', '/theorie/lodestar'],
      ['Gol D. Roger', '/theorie/gol-d-roger'],
    ],
  },
  {
    id: 'quatrieme-coordonnee',
    n: 4,
    question: 'Et si le problème n’était pas où, mais quand ?',
    title: 'La quatrième coordonnée : le temps',
    blocks: [
      {
        t: 'p',
        text: 'Le paradoxe géographique nous pousse à ajouter une dimension. Comme les humains, nous évoluons dans un cadre à **trois dimensions** : la hauteur, la largeur, la profondeur. La latitude, la longitude et l’altitude suffisent à situer n’importe quel point du globe. Il suffirait donc de trois Road Poneglyphes pour indiquer Laugh Tale dans l’espace.',
      },
      {
        t: 'p',
        text: 'Une hypothèse souvent discutée par la théorie fait du **quatrième** Road Ponéglyphe l’indice d’une coordonnée non plus spatiale, mais **temporelle**. Depuis Einstein — qui a inspiré Vegapunk —, on ajoute le temps comme quatrième dimension, ce qui forme le continuum espace-temps. Laugh Tale ne serait pas uniquement en trois dimensions, mais en **quatre**.',
      },
      {
        t: 'p',
        text: 'Dans cette lecture, il ne faudrait pas se demander *où* est le One Piece, mais **quand** il est. Les quatre Road Poneglyphes indiqueraient chacun une coordonnée, et c’est à leur intersection que se trouverait l’île de Joy Boy — une intersection située dans le temps. C’est une interprétation, pas une lecture littérale du manga.',
      },
      {
        t: 'p',
        text: 'Plusieurs éléments du récit peuvent être lus dans ce sens. Les Log Pose, des boussoles censées indiquer un lieu, se portent au poignet **comme des montres** qui indiquent le temps. Les Eternal Pose, qui pointent une île, ressemblent à des **sabliers**, instruments également temporels. Ces échos peuvent suggérer que Grand Line fonctionne comme une **frise chronologique** que les pirates remontent à la recherche du One Piece ; ils peuvent aussi n’être que des choix de design.',
      },
      {
        t: 'p',
        text: 'Sur l’océan unique, on ne peut voyager que de manière linéaire : impossible de partir, à cause de la Calm Belt. Un seul chemin — aller en avant ou aller en arrière, comme le temps. Et voilà pourquoi Roger, l’homme le plus libre du monde, ne pouvait pas être libre dans le temps lui aussi : **il était arrivé trop tôt**.',
      },
    ],
    links: [
      ['Road Ponéglyphes', '/theorie/road-ponelyphes'],
      ['Une communication à travers le temps', '/theorie/communication-temps'],
      ['Laugh Tale', '/theorie/laugh-tale'],
    ],
  },
  {
    id: 'poneglyphes-avenir',
    n: 5,
    question: 'Pourquoi les Ponéglyphes semblent-ils raconter le passé ?',
    title: 'Les Ponéglyphes et la mémoire de l’avenir',
    blocks: [
      {
        t: 'p',
        text: 'Si Laugh Tale et le One Piece touchent à une époque future, comment le passé a-t-il pu en avoir connaissance ? C’est ici qu’intervient le **mécanisme fondamental** de la théorie : les Ponéglyphes.',
      },
      {
        t: 'p',
        text: 'Les Ponéglyphes existent bien depuis huit cents ans, c’est un fait établi. Mais la théorie défend l’idée que les événements qu’ils rapportent ne se seraient pas nécessairement déjà produits au moment où ils sont apparus. Ils auraient été créés à partir d’informations **venues du futur**, puis transmises huit cents ans en arrière. C’est le cœur spéculatif de la démonstration, pas un fait démontré.',
      },
      {
        t: 'p',
        text: 'Le monde aurait alors pris ces textes pour les vestiges d’une civilisation disparue, alors qu’ils raconteraient en réalité une histoire **encore à venir**. Le Rio Ponéglyphe ne raconterait pas seulement une ancienne guerre : il raconterait l’histoire que nous sommes en train de lire depuis le chapitre 1.',
      },
      {
        t: 'p',
        text: 'Toute la force de cette idée est qu’elle ne vient pas d’une intuition, mais de la chaîne que nous venons de construire : si l’île finale est inaccessible parce qu’elle appartient à une autre époque, alors les seuls messages qui la relient à nous ne peuvent être que des messages adressés depuis cette époque. Les Ponéglyphes seraient la **mémoire de l’avenir**.',
      },
    ],
    links: [
      ['Les Ponéglyphes', '/theorie/poneglyphes'],
      ['Les Ponéglyphes racontent le futur', '/theorie/poneglyphes-futur'],
      ['Le Rio Ponéglyphe', '/theorie/rio-ponelyphe'],
    ],
  },
  {
    id: 'siecle-oublie-royaume-antique',
    n: 6,
    question: 'Pourquoi « l’antique » ressemble-t-il tant au futur ?',
    title: 'Le Siècle oublié et le Royaume antique',
    blocks: [
      {
        t: 'p',
        text: 'C’est ici que se joue la réinterprétation globale du Siècle oublié. Vegapunk décrit une civilisation ancienne dont la technologie semble inexplicablement avancée. Comment une civilisation d’il y a huit cents ans aurait-elle pu être **plus avancée** que le présent ?',
      },
      {
        t: 'p',
        text: 'Pour les Fous du Bus, le paradoxe pourrait s’effondrer d’un coup : **ce que le monde appelle « antique » viendrait en réalité du futur**. Ce ne serait pas le passé qui dépassait le présent, mais l’avenir qui se manifesterait dans le présent. C’est une interprétation forte, qui rend compte d’un faisceau d’indices sans être la seule explication possible.',
      },
      {
        t: 'p',
        text: 'Les Ponéglyphes illustrent cette idée. Réputés indestructibles, ils ont résisté à tout pendant huit cents ans — même Vegapunk n’a jamais su les abîmer. On peut y voir l’indice qu’ils sont faits d’un matériau qui **n’existerait pas encore** à l’époque de leur fabrication (l’analogie : un soldat de l’antiquité face à un bloc d’acier trempé croirait à une matière indestructible). On peut aussi y voir la marque d’une technologie ancienne simplement très en avance sur son temps.',
      },
      {
        t: 'p',
        text: 'Le langage gravé sur les pierres suivrait la même logique dans cette lecture : une langue que personne ne peut lire pendant huit siècles, sauf une archéologue capable de déchiffrer sa **propre écriture future** — Nico Robin. Et les inventions de Vegapunk, la Mother Flame, Emeth, les technologies actuelles participeraient à créer le monde que le passé a ensuite cru disparu.',
      },
      {
        t: 'p',
        text: 'Dans cette lecture, le Royaume antique ne serait donc pas un vestige à exhumer, mais un monde **à construire**. Le Siècle oublié ne serait pas un chapitre terminé : ce serait l’époque que l’histoire de Luffy est en train d’écrire. C’est la thèse centrale des Fous du Bus, pas une vérité démontrée par le manga.',
      },
    ],
    links: [
      ['Le Siècle oublié', '/theorie/siecle-oublie'],
      ['Royaume antique', '/theorie/royaume-antique'],
      ['Les bases du Siècle oublié', '/theorie/les-bases-du-siecle-oublie'],
    ],
  },
  {
    id: 'joy-boy',
    n: 7,
    question: 'Qui est Joy Boy ?',
    title: 'Joy Boy',
    blocks: [
      {
        t: 'p',
        text: 'Maintenant que la mécanique est posée, donnons-lui son visage. Le nom de Joy Boy traverse tout le récit : la promesse au royaume Ryugu, les souvenirs d’Emeth, Zunesha qui se souvient du rythme de son cœur, le « trop tôt » de Roger. Mais qui est-il vraiment ?',
      },
      {
        t: 'p',
        text: 'La nuance centrale de cette théorie est là, et elle est souvent mal résumée : **Joy Boy n’est pas l’origine de Luffy, il en est la conséquence**. Pendant huit cents ans, des croyances, des objets, des promesses ont convergé vers un homme. C’est cette convergence qui crée Joy Boy — pas un ancêtre qui se réincarne.',
      },
      {
        t: 'p',
        text: 'Prenez Emeth. Convaincu d’avoir confondu Joy Boy avec Luffy, le robot ne se serait, dans cette lecture, jamais trompé : Joy Boy n’existerait pas encore, il n’aurait devant lui que Luffy, celui qui doit le devenir. Et quand Emeth dit qu’il n’a pas réussi à faire de lui un roi, c’est son propre geste qui, dans la théorie, ferait de Luffy le roi des pirates. Cette lecture reste une interprétation : le manga n’a pas encore tranché.',
      },
      {
        t: 'p',
        text: 'Zunesha, lui, se souvient du rythme d’un cœur. S’il venait lui aussi du futur — comme le chapitre 15 le suggère à titre d’hypothèse —, alors ce pourrait être du cœur de **Monkey D. Luffy** qu’il se souvient. C’est une possibilité, pas un fait établi : à ce stade, rien n’empêche de lire Zunesha comme un être réellement ancien dont les souvenirs remonteraient au Joy Boy du passé.',
      },
    ],
    links: [
      ['Joy Boy', '/theorie/joy-boy'],
      ['Emeth, le robot du futur', '/theorie/emeth-robot-du-futur'],
      ['Zunesha', '/theorie/zunesha-fiche'],
    ],
  },
  {
    id: 'nika',
    n: 8,
    question: 'Qu’est-ce que Nika a à voir avec tout cela ?',
    title: 'Nika',
    blocks: [
      {
        t: 'p',
        text: 'Il y a une troisième figure, et elle complique le tableau : **Nika**, le dieu du soleil. Sur presque trente ans de manga, son nom n’apparaît que dans les cinq dernières années — ce qui en dit long sur son rôle.',
      },
      {
        t: 'p',
        text: 'Nika est la figure divine sous laquelle certains peuples interprètent le libérateur. C’est la foi des Boucaniers, celle que Bartholomew Kuma a héritée. C’est le mythe derrière le Hito Hito no Mi, modèle Nika, et l’Éveil qui permet à Luffy de libérer les esclaves par le rire.',
      },
      {
        t: 'p',
        text: 'Mais Nika n’est pas nécessairement un dieu ancien qui existait avant les autres. Il serait plutôt **la traduction mythologique** du même homme que l’Histoire appellera Joy Boy. Là où l’Histoire retient « Joy Boy », la foi populaire vénère « Nika ».',
      },
      {
        t: 'p',
        text: 'Les trois noms se rejoignent donc : **Luffy** est son identité, **Joy Boy** le nom que le monde lui donnera, **Nika** la figure divine sous laquelle certains peuples l’interprètent. Trois manières de parler d’un même homme — pas trois personnes à trois époques.',
      },
    ],
    links: [
      ['Nika', '/theorie/nika'],
      ['Le Hito Hito no Mi, modèle Nika', '/theorie/hito-hito-no-mi-nika'],
      ['Kuma et la foi en Nika', '/theorie/kuma-foi-nika'],
    ],
  },
  {
    id: 'luffy',
    n: 9,
    question: 'En quoi Luffy est-il ces figures sans le savoir ?',
    title: 'Monkey D. Luffy',
    blocks: [
      {
        t: 'p',
        text: 'Si Luffy doit devenir Joy Boy, alors tout doit se lire depuis son personnage. Et c’est précisément ce qui rend la théorie cohérente : Luffy **refuse** d’incarner une légende.',
      },
      {
        t: 'p',
        text: 'Luffy ne veut pas être un héros — il le dit lui-même, car un héros partage sa nourriture. Il ne veut pas être un roi : comme Roger, ce seront les citoyens du monde qui le désigneront roi des pirates, jamais lui ne le déclarera. Il ne se prétend ni Nika ni Joy Boy.',
      },
      {
        t: 'p',
        text: 'Or c’est exactement ce qui lui permet de devenir ces figures. Joy Boy étant la **conséquence** de huit siècles d’Histoire — et non leur origine —, ce n’est pas en cherchant à reproduire une légende que Luffy la rejoint, c’est en agissant librement. Toutes les volontés, toutes les promesses, toutes les croyances convergent vers lui parce qu’il ne se plie à aucune.',
      },
      {
        t: 'p',
        text: 'Ainsi, les trois noms ne désignent pas trois personnes : ils décrivent trois regards portés sur le même homme. C’est cette distinction qui éclaire la promesse du royaume Ryugu, l’Éveil et la foi des Boucaniers.',
      },
    ],
    links: [
      ['Monkey D. Luffy', '/theorie/luffy'],
      ['La volonté héritée', '/theorie/volonte-heritee'],
      ['La signification du D.', '/theorie/signification-d'],
    ],
  },
  {
    id: 'roger-shanks',
    n: 10,
    question: 'Pourquoi Roger n’a-t-il rien fait ?',
    title: 'Roger, Shanks et ceux qui attendent',
    blocks: [
      {
        t: 'p',
        text: 'Revenons au roi des pirates, car il est la clé de voûte du calendrier. Roger a atteint Laugh Tale, il a ri, il a compris la vérité — et pourtant il n’a rien fait. Pourquoi ? Parce que ce n’était pas son époque.',
      },
      {
        t: 'p',
        text: '« Nous sommes arrivés trop tôt. » Roger a voyagé jusqu’à l’époque de Joy Boy, mais il n’a pas pu être Joy Boy. Il pouvait être libre dans l’espace, pas encore dans le temps. Il est arrivé **avant** l’heure du serment.',
      },
      {
        t: 'p',
        text: 'Alors Roger a fait la seule chose qui restait : il a **attendu**. « Un jour, quelqu’un naîtra et nous surpassera » (ch. 968). Cette personne, c’est celle que Roger attend, et elle a un nom : celui qui portera la volonté, qui accomplira le voyage au bon moment.',
      },
      {
        t: 'p',
        text: 'Ceux qui attendent, ce sont aussi Shanks, qui transmet le chapeau de paille ; Rayleigh, qui veille ; l’équipage qui a tout compris sans pouvoir agir. La théorie donne ainsi un sens précis au fameux « trop tôt » : Roger n’était pas en retard sur un passé, il était **en avance sur un avenir** qui devait encore se construire.',
      },
    ],
    links: [
      ['Gol D. Roger', '/theorie/gol-d-roger'],
      ['Shanks', '/theorie/shanks'],
      ['One Piece : l’histoire', '/theorie/one-piece-histoire'],
    ],
  },
  {
    id: 'poseidon-shirahoshi',
    n: 11,
    question: 'Pourquoi l’arme la plus redoutée est-elle une petite sirène ?',
    title: 'Poséidon et Shirahoshi',
    blocks: [
      {
        t: 'p',
        text: 'La même logique s’applique aux grandes figures du Siècle oublié. Commençons par Poséidon, l’une des Armes antiques — celle qui commande les Rois des Mers. Et regardons qui la théorie y voit.',
      },
      {
        t: 'p',
        text: '**Shirahoshi est Poséidon.** La princesse du royaume Ryugu, ceinte d’un pouvoir que le monde redoute. Ce n’est pas une réincarnation : c’est la même histoire qui se joue, une histoire dont le passé n’a conservé que la légende.',
