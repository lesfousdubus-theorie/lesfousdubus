---
import WikiLayout from '@layouts/WikiLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ReadingProgressBar from '@components/ReadingProgressBar.astro';
import TheoryMechanism from '@components/TheoryMechanism.astro';
import Footer from '@components/Footer.astro';

const sections = [
  {
    id: 'introduction',
    number: '00',
    title: 'Comment lire cette théorie',
    icon: '◈',
    level: 'theorie-centrale',
    levelLabel: 'Théorie centrale',
    source: 'Cadre éditorial de la théorie — mis à jour au chapitre 1190',
    summary:
      'La théorie suit une chronologie du passé apparent vers un futur qui pourrait avoir produit certaines informations conservées dans ce passé. Elle ne postule pas une boucle temporelle générale.',
    points: [
      'Manga : Joy Boy a vécu il y a environ neuf siècles et appartenait au Royaume antique.',
      'Théorie centrale : des informations du futur pourraient avoir été transmises vers le passé puis conservées par les Ponéglyphes.',
      'Extensions : communication directe, préscience, Harley, Emeth et déplacements physiques restent des mécanismes distincts et non nécessaires au noyau.',
    ],
  },
  {
    id: 'vague-submersion',
    number: '01',
    title: 'Le monde a déjà été submergé de 200 mètres',
    icon: '≋',
    level: 'manga',
    levelLabel: 'Manga',
    source: 'Manga, chapitres 1114–1116',
    summary:
      "Vegapunk révèle qu'une guerre du Siècle oublié a englouti les anciens continents. Une nouvelle montée massive est possible, mais elle demeure une projection.",
    points: [
      "La hausse historique d'environ 200 mètres est un fait rapporté par Vegapunk.",
      "L'emploi récent de la Mother Flame a produit une montée mondiale d'environ un mètre.",
      "Rien n'établit qu'un royaume détruit équivaut à une hausse répétée ni qu'il faudrait 199 tirs supplémentaires.",
    ],
  },
  {
    id: 'peuples-missions',
    number: '02',
    title: 'Des peuples transmettent des missions sur plusieurs siècles',
    icon: '⌁',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 628, 649, 967–968, 1049–1055 ; synthèse théorique',
    summary:
      'Minks, hommes-poissons, Kozuki, géants et autres peuples gardent des promesses, textes ou préparatifs. La théorie les relie sans dater toutes leurs missions de −800.',
    points: [
      "Le pacte de Joy Boy avec l'île des Hommes-Poissons et la fermeture de Wano ont des ancrages anciens.",
      'Zunesha est puni depuis des siècles ; les raisons exactes et la date de chaque mission restent inconnues.',
      'Les préparatifs ont pu apparaître et évoluer pendant toute la longue veille, de −799 au présent.',
    ],
  },
  {
    id: 'echec-roger',
    number: '03',
    title: 'Roger atteint Laugh Tale, mais arrive trop tôt',
    icon: '☠',
    level: 'manga',
    levelLabel: 'Manga',
    source: 'Manga, chapitres 966–968',
    summary:
      "L'équipage de Roger atteint Laugh Tale après être allé à Lodestar et avoir recherché les Road Ponéglyphes. Il découvre l'histoire et comprend être arrivé trop tôt.",
    points: [
      'Lodestar est la dernière île indiquée par le Log Pose, pas une destination temporelle établie.',
      "Roger atteint Laugh Tale avec son équipage ; il n'est pas le seul homme à y être arrivé.",
      "L'attente de Poséidon est canonique. L'idée qu'il identifie explicitement un futur Joy Boy précis est une lecture théorique.",
    ],
  },
  {
    id: 'poneglyphes',
    number: '04',
    title: "Les Ponéglyphes assurent la transmission d'informations",
    icon: '▣',
    level: 'theorie-centrale',
    levelLabel: 'Théorie centrale',
    source: 'Manga, chapitres 301, 395, 967, 1055 ; théorie de la mémoire future',
    summary:
      "Le noyau propose que des informations issues d'événements futurs soient devenues les textes, promesses ou plans lus comme des traces antiques.",
    points: [
      'Les stèles indestructibles et leur langue assurent une conservation matérielle exceptionnelle.',
      'Robin sait les lire ; le manga ne lui attribue pas le savoir de les graver.',
      "Le transport physique d'un monde futur entier n'est pas requis : textes, descriptions, plans ou objets suffiraient.",
    ],
  },
  {
    id: 'trois-armes',
    number: '05',
    title: 'Les trois Armes antiques convergent vers la crise finale',
    icon: '⚔',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 649, 1055, 1060, 1086 ; projection théorique',
    summary:
      "Poséidon est Shirahoshi et Pluton existe sous Wano. Uranus n'est pas identifié : Imu pourrait employer la Mother Flame pour atteindre une puissance associée à Uranus.",
    points: [
      'Poséidon commande les Rois des Mers.',
      "Pluton est sous l'ancien Wano ; Water Seven pourrait seulement contribuer à sa reconstruction, sa transformation ou son usage.",
      "L'arme ayant frappé Lulusia n'est pas nommée Uranus dans le manga.",
    ],
  },
  {
    id: 'fruit-demon',
    number: '06',
    title: 'Les Fruits du Démon pourraient s’être diffusés récemment',
    icon: '◆',
    level: 'hypothese-recente',
    levelLabel: 'Hypothèse récente',
    source: 'Manga, chapitres 1044, 1069 et 1186 ; chronologie de Brook',
    summary:
      "Le manga distingue le mythe ancien de Nika, le modèle du Fruit de Luffy et son éveil. L'hypothèse d'une diffusion massive des Fruits au dernier siècle cherche à expliquer des témoignages divergents.",
    points: [
      'Nika est un nom mythique ancien ; Hito Hito no Mi, modèle Nika est le nom du Fruit.',
      "Gear 5 est l'éveil observé chez Luffy, qui continue de se présenter comme Monkey D. Luffy.",
      "Brook dit ne pas connaître les Fruits vers −62, tandis que les géants et Imu évoquent des savoirs plus anciens : c'est une tension, pas une preuve décisive.",
    ],
  },
  {
    id: 'gouvernement-mondial',
    number: '07',
    title: 'Le Gouvernement mondial efface la mémoire',
    icon: '♜',
    level: 'manga',
    levelLabel: 'Manga',
    source: 'Manga, chapitres 395–398, 1084–1086, 1114–1116',
    summary:
      "Les Vingt Royaumes ont fondé le Gouvernement mondial et le système réprime l'étude du Siècle oublié. Le règne personnel et continu d'Imu pendant huit siècles reste hypothétique.",
    points: [
      'Le Gouvernement mondial et son interdiction historique sont canoniques.',
      'Imu occupe le Trône vacant au présent et semble lié aux fondateurs, sans biographie complète confirmée.',
      'Poneglyphes, communication temporelle et préscience sont trois explications alternatives à son éventuelle connaissance du futur.',
    ],
  },
  {
    id: 'guerre-finale',
    number: '08',
    title: 'Une guerre mondiale pourrait renverser le système',
    icon: '✦',
    level: 'projection',
    levelLabel: 'Projection',
    source: 'Manga, chapitres 576, 1083–1086, 1116 ; projection de guerre finale',
    summary:
      "Barbe Blanche annonce une guerre mondiale après la découverte du One Piece. Les camps et l'ordre Water Seven, Pluton, Wano, Noah et Red Line ne sont pas fixés.",
    points: [
      'Le conflit entre révolutionnaires, pirates et Gouvernement est déjà engagé.',
      "La théorie conserve plusieurs futurs possibles plutôt qu'une seule séquence obligatoire.",
      'Une nouvelle submersion comparable à celle du passé est un risque projeté, pas un fait futur acquis.',
    ],
  },
  {
    id: 'zoro-ryuma',
    number: '09',
    title: 'Zoro pourrait accomplir la légende de Ryuma',
    icon: '刀',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 467, 937, 1001, 1010 ; extension Zoro/Ryuma',
    summary:
      "Zoro a vaincu le zombie portant le corps de Ryuma puis blessé Kaido sur Onigashima. Un retour vers l'ancien Wano expliquerait d'autres échos, sans être requis par le noyau.",
    points: [
      'Ryuma est le héros qui a abattu un dragon au-dessus de la capitale des Fleurs.',
      'Zoro a scarifié Kaido sur Onigashima : ce ne sont ni le même lieu ni le même exploit.',
      'Retour temporel, dépouille, Shusui final et abandon de ses autres sabres sont des projections avancées.',
    ],
  },
  {
    id: 'vivi-lili',
    number: '10',
    title: 'Vivi pourrait accomplir le rôle attribué à Lili',
    icon: '♛',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 1084–1086, 1116 ; extension Vivi/Lili',
    summary:
      'Lili est historiquement liée à la dispersion des Ponéglyphes. Vivi pourrait jouer un rôle analogue dans le futur ; une identité commune reste une hypothèse distincte.',
    points: [
      "Lili n'a pas rejoint Mary Geoise et sa lettre porte le D.",
      'Un portrait ancien ressemble à Vivi sans établir couleur de cheveux, identité ou destin identiques.',
      'La disparition de Vivi, son retour à Alabasta et un éventuel règne de Koza ne sont pas établis.',
    ],
  },
  {
    id: 'joy-boy-luffy',
    number: '11',
    title: 'Luffy hérite du symbole de libération sans perdre son identité',
    icon: '☀',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 1043–1044, 1115 et 1187–1188',
    summary:
      "Joy Boy est une figure historique du Royaume antique. À Elbaf, Imu appelle Luffy « Joy Boy », mais Luffy répond qu'il est Monkey D. Luffy.",
    points: [
      "Zunesha associe le retour de Joy Boy au rythme de l'éveil du Fruit.",
      'Imu distingue le souvenir du premier Joy Boy de Luffy au chapitre 1188.',
      "La théorie propose que le rôle de Joy Boy soit la conséquence de huit siècles d'héritages convergents, non une origine que Luffy reproduirait mécaniquement.",
    ],
  },
  {
    id: 'loki-nidhogg',
    number: '12',
    title: 'Loki pourrait rejouer le motif de Nidhogg',
    icon: '♢',
    level: 'hypothese-recente',
    levelLabel: 'Hypothèse récente',
    source: 'Manga, arc d’Elbaf ; rapprochement mythologique théorique',
    summary:
      "Les motifs nordiques d'Elbaf permettent une comparaison avec Nidhogg, mais aucun rôle temporel ou cosmique précis de Loki n'est encore établi.",
    points: [
      "Le nom et l'imaginaire nordiques sont observables.",
      "L'équivalence Loki/Nidhogg est interprétative.",
      'Toute mission dans la guerre finale reste un futur possible.',
    ],
  },
  {
    id: 'shirahoshi-poseidon',
    number: '13',
    title: 'Shirahoshi peut commander les Rois des Mers',
    icon: '♆',
    level: 'manga',
    levelLabel: 'Manga',
    source: 'Manga, chapitres 626, 647–649, 967–968',
    summary:
      "Shirahoshi est Poséidon. Son rôle futur avec Noah ou une évacuation de masse est plausible mais n'a pas encore eu lieu.",
    points: [
      'Son pouvoir et la renaissance cyclique de Poséidon sont établis.',
      "Roger apprend qu'elle naîtra dix ans plus tard et grandira ensuite.",
      'Noah, Red Line et All Blue doivent rester des prédictions séparées.',
    ],
  },
  {
    id: 'momonosuke-pluton',
    number: '14',
    title: "Momonosuke reporte l'ouverture de Wano",
    icon: '竜',
    level: 'manga',
    levelLabel: 'Manga',
    source: 'Manga, chapitres 920, 1049–1055',
    summary:
      "Toki a envoyé Momonosuke, Kin'emon, Kanjuro, Raizo et Kiku vingt ans dans le futur — pas Hiyori. Momonosuke décide de ne pas ouvrir immédiatement les frontières.",
    points: [
      'Pluton existe sous Wano et son accès est lié à la destruction des murs du pays.',
      'Momonosuke entend Zunesha mais ne connaît pas le procédé de gravure des Ponéglyphes.',
      "Sukiyaki vit encore et sait lire et graver l'écriture Kozuki.",
    ],
  },
  {
    id: 'imu',
    number: '15',
    title: 'Imu peut mal identifier les héritiers du passé',
    icon: '♙',
    level: 'hypothese-recente',
    levelLabel: 'Hypothèse récente',
    source: 'Manga, chapitres 1084–1086 et 1187–1190 ; motif interprétatif',
    summary:
      "Imu reconnaît des noms et des motifs anciens, mais les chapitres récents ne prouvent ni omniscience ni mécanisme précis. Le motif « Imu se trompe d'identité » reste secondaire.",
    points: [
      "Imu appelle Luffy Joy Boy, puis se souvient d'un premier Joy Boy distinct.",
      'Imu distingue Roger de Joy Boy au chapitre 1190, ce qui fragilise une confusion simple Roger/Joy Boy.',
      "Xebec/Davy Jones, Roger/Joy Boy et Vivi/Lili doivent être examinés séparément, sans chaîne d'identités imposée.",
    ],
  },
  {
    id: 'emeth',
    number: '16',
    title: 'Emeth pourrait transporter un héritage physique',
    icon: '⚙',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 1065, 1111–1122 ; extension Emeth/BF-39',
    summary:
      'Emeth a attaqué Mary Geoise deux cents ans avant Egghead et conserve le Haki de Joy Boy. La théorie explore un transport physique distinct de la transmission des textes.',
    points: [
      "L'attaque de −200, l'énergie inconnue et le nœud de Haki sont canoniques.",
      "Le Haki stocké pourrait, dans la théorie, être celui du Luffy de fin d'aventure ; le manga l'attribue au Joy Boy historique selon les souvenirs d'Emeth.",
      'Le nom BF-39 et un retour temporel sont des constructions théoriques.',
    ],
  },
  {
    id: 'usopp-arnot',
    number: '17',
    title: 'Usopp pourrait inspirer Louis Arnot',
    icon: '✧',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 115–116 et arc d’Elbaf ; extension Usopp/Louis Arnot',
    summary:
      "Les écrits de Louis Arnot peuvent être rapprochés des récits d'Usopp. Leur identité ou une transmission vers le passé n'est toutefois pas nécessaire à la théorie principale.",
    points: [
      'Louis Arnot est un explorateur cité par Nami.',
      'Usopp transforme souvent ses inventions en vérités ultérieures.',
      'Le lien personnel et temporel reste spéculatif.',
    ],
  },
  {
    id: 'brook-musique',
    number: '18',
    title: 'Brook conserve une mémoire musicale antérieure à Roger',
    icon: '♫',
    level: 'extension',
    levelLabel: 'Extension de la théorie',
    source: 'Manga, chapitres 442, 486–488 ; frise −80 à −50',
    summary:
      'Entre son enfance et la disparition des Rumbar, Brook relie passé royal, chansons, ignorance des Fruits et Binks no Sake. Ce mini-segment ne prouve pas un voyage temporel.',
    points: [
      'Vers −80/−70 : enfance, chanson prototype et passé militaire dans un royaume associé à Dōzan.',
      'Vers −62 : Brook dit ne pas connaître les Fruits du Démon ; Binks no Sake existe déjà avant le voyage de Roger.',
      "Vers −52 : les Rumbar sont massacrés et Brook revient grâce à son Fruit avant d'errer dans le Triangle de Florian.",
    ],
  },
  {
    id: 'laugh-tale',
    number: '19',
    title: 'Laugh Tale pourrait combiner lieu et mécanisme temporel',
    icon: '◎',
    level: 'hypothese-recente',
    levelLabel: 'Hypothèse récente',
    source: 'Manga, chapitres 966–968 et 1188 ; hypothèse Road Ponéglyphes/temps',
    summary:
      'Les quatre Road Ponéglyphes donnent quatre positions spatiales dont le croisement désigne Laugh Tale. Une fonction temporelle reste une hypothèse, revue après le chapitre 1188.',
    points: [
      'Trois points ne suffisent pas à reproduire le mécanisme canonique : les quatre inscriptions sont requises.',
      'Le rôle exact du quatrième Road Ponéglyphe reste ouvert.',
      'Communication reçue par Roger vers −25, réception future vers −800 ou réponse de Luffy à Laugh Tale sont des branches possibles, pas une version définitive.',
    ],
  },
  {
    id: 'one-piece',
    number: '20',
    title: 'Le One Piece pourrait contenir la véritable histoire vécue par Luffy',
    icon: '⊕',
    level: 'projection',
    levelLabel: 'Projection',
    source: 'Manga, chapitres 967–968 ; projection sur la nature du One Piece',
    summary:
      "Roger a trouvé un trésor réel laissé par Joy Boy et a ri. La théorie propose qu'une mémoire d'événements vécus au présent puisse compléter la véritable histoire.",
    points: [
      "L'existence d'un trésor concret et la découverte de la vérité par l'équipage sont canoniques.",
      "Son contenu exact n'est pas révélé.",
      'Un texte, un enregistrement ou des informations futures sont des possibilités, non des certitudes.',
    ],
  },
  {
    id: 'conclusion',
    number: '21',
    title: 'Du passé apparent au futur créateur de mémoire',
    icon: '∞',
    level: 'theorie-centrale',
    levelLabel: 'Théorie centrale',
    source: 'Synthèse éditoriale — état de la théorie au chapitre 1190',
    summary:
      'Le passé apparent contient des sources qui pourraient décrire des informations futures ; le présent montre les événements vécus ; le futur projeté pourrait créer la mémoire ensuite attribuée au passé.',
    points: [
      'Théorie centrale : informations futures → conservation par les Ponéglyphes → héritage au présent.',
      'Alternatives : préscience ou communication directe peuvent expliquer certains dialogues sans transport matériel.',
      'Branches : Harley, Emeth/BF-39, Zoro/Ryuma, Vivi/Lili, Loki/Nidhogg et Usopp/Arnot restent révisables indépendamment.',
    ],
  },
];

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'La théorie', href: '/theorie' },
  { label: 'Théorie complète' },
];
---

<WikiLayout
  title="La théorie complète"
  description="Synthèse structurée de la théorie : faits du manga, mécanisme central par les Ponéglyphes, extensions, hypothèses récentes et projections."
  currentPath="/theorie/theorie-complete"
>
  <ReadingProgressBar />
  <Breadcrumb items={breadcrumbItems} />

  <article class="theory-complete" data-pagefind-body>
    <header class="theory-hero">
      <p class="theory-hero__eyebrow">État de la théorie · chapitre 1190</p>
      <h1>La théorie complète</h1>
      <p class="theory-hero__lead">
        Une lecture du <strong>passé apparent</strong> vers un <strong
          >futur qui pourrait avoir créé certaines de ses informations</strong
        > — sans imposer une boucle temporelle générale.
      </p>
      <div class="theory-hero__meta">
        <span>22 chapitres</span><span>·</span><span>5 niveaux de preuve</span><span>·</span><span
          >Théorie centrale révisable</span
        >
      </div>
    </header>

    <aside class="paradox-card" aria-label="Paradoxe central">
      <strong>Paradoxe central permanent</strong>
      <span>Passé apparent : informations du futur</span>
      <span aria-hidden="true">→</span>
      <span>Présent : événements vécus</span>
      <span aria-hidden="true">→</span>
      <span>Futur projeté : création possible de la mémoire</span>
    </aside>

    <aside class="status-key" aria-label="Niveaux éditoriaux">
      <span class="status-key__item status-key__item--manga">Manga</span>
      <span class="status-key__item status-key__item--theorie-centrale">Théorie centrale</span>
      <span class="status-key__item status-key__item--extension">Extension</span>
      <span class="status-key__item status-key__item--hypothese-recente">Hypothèse récente</span>
      <span class="status-key__item status-key__item--projection">Projection</span>
    </aside>

    <nav class="chapter-nav" aria-label="Chapitres de la théorie">
      <h2>Sommaire</h2>
      <div class="chapter-nav__grid">
        {
          sections.map((section) => (
            <a href={`#${section.id}`} class="chapter-nav__item">
              <span class="chapter-nav__number">{section.number}</span>
              <span class="chapter-nav__title">{section.title}</span>
            </a>
          ))
        }
      </div>
    </nav>

    <TheoryMechanism />

    <div class="theory-sections">
      {
        sections.map((section) => (
          <section id={section.id} class={`theory-section theory-section--${section.level}`}>
            <div class="theory-section__header">
              <span class="theory-section__number">{section.number}</span>
              <span class="theory-section__icon" aria-hidden="true">
                {section.icon}
              </span>
              <div>
                <p class={`theory-section__status status-${section.level}`}>{section.levelLabel}</p>
                <h2>{section.title}</h2>
              </div>
            </div>
            <p class="theory-section__summary">{section.summary}</p>
            <ul class="theory-section__points">
              {section.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <p class="theory-section__source">
              <strong>Sources :</strong> {section.source}
            </p>
          </section>
        ))
      }
    </div>

    <footer class="theory-footer">
      <p>
        <strong>Principe de révision :</strong> une certitude d’existence ne fixe pas automatiquement
        sa date. Chaque proposition doit distinguer date établie, période approximative, époque inconnue
        ou ordre projeté.
      </p>
      <div class="theory-footer__actions">
        <a href="/theorie/resume" class="btn-primary">Lire le résumé en 10 points</a>
        <a href="/theorie/chronologie" class="btn-secondary">Explorer la chronologie</a>
        <a href="/chapitres" class="btn-secondary">Voir les mises à jour</a>
      </div>
    </footer>
  </article>

  <Footer />
</WikiLayout>

<style>
  .theory-complete {
    max-width: 880px;
    margin: 0 auto;
  }
  .theory-hero {
    text-align: center;
    padding: 44px 24px 30px;
  }
  .theory-hero__eyebrow {
    color: var(--violet-light);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .theory-hero h1 {
    margin: 8px 0 16px;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.05;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .theory-hero__lead {
    max-width: 700px;
    margin: 0 auto;
    color: var(--text-secondary);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .theory-hero__meta {
    display: flex;
    justify-content: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 18px;
    color: var(--text-muted);
    font-size: 12px;
  }
  .paradox-card,
  .status-key {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0;
    padding: 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 13px;
  }
  .paradox-card {
    border-left: 3px solid var(--accent-gold);
  }
  .paradox-card strong {
    width: 100%;
    color: var(--text-main);
    text-align: center;
  }
  .status-key__item,
  .theory-section__status {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 3px 9px;
