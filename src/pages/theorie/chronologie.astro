---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface TimelineEvent {
  date: string;
  title: string;
  desc: string;
  image?: string;
  chapter?: string;
  highlight?: boolean;
}

const officialTimeline: TimelineEvent[] = [
  {
    date: "Il y a ~900 ans",
    title: "L'Apogée du Royaume Antique",
    desc: "Une civilisation scientifiquement et techniquement très avancée domine le monde avant d'être mystérieusement détruite.",
    image: "/images/threads/professeur-clover-et-ohara/img_3.jpg",
    chapter: "Chapitre 395"
  },
  {
    date: "Il y a ~800 ans",
    title: "La Coalition des 20 Rois",
    desc: "L'alliance des 20 familles fondatrices affronte le Royaume Antique et fonde le Gouvernement Mondial à Mary Geoise.",
    image: "/images/threads/coalition-des-20-rois/img_1.jpg",
    chapter: "Chapitre 1084"
  },
  {
    date: "Il y a ~800 ans",
    title: "La Disparition de la Reine Lili",
    desc: "La reine Nefertari Lili d'Alabasta refuse d'habiter à Mary Geoise et disparaît après la dispersion des Ponéglyphes.",
    image: "/images/threads/lili-vivi-et-les-poneglyphes/img_1.jpg",
    chapter: "Chapitre 1085"
  },
  {
    date: "Il y a ~800 ans",
    title: "La Gravure des Ponéglyphes",
    desc: "Le clan Kozuki de Wano Kuni taille les stèles indestructibles pour transmettre l'histoire à la postérité.",
    image: "/images/threads/les-bases-du-siecle-oublie/img_2.jpg",
    chapter: "Chapitre 818"
  },
  {
    date: "Il y a 200 ans",
    title: "L'Attaque du Robot Géant",
    desc: "Le robot colossale Emeth gravit Red Line et s'attaque à Mary Geoise avant de tomber en panne faute d'énergie.",
    image: "/images/threads/emeth-robot-du-futur/img_6.png",
    chapter: "Chapitre 1067"
  },
  {
    date: "Il y a 25 ans",
    title: "Le Voyage de Gol D. Roger",
    desc: "Roger et son équipage atteignent Laugh Tale, découvrent le trésor mais réalisent qu'ils sont 'arrivés trop tôt'.",
    image: "/images/threads/silhouette-scan-1181-roger/img_6.jpg",
    chapter: "Chapitre 967"
  },
  {
    date: "Présent",
    title: "L'Éveil du Nika & le Message",
    desc: "Luffy éveille le Gear 5 sur Egghead. Vegapunk diffuse son message mondial révélant le cataclysme du monde.",
    image: "/images/threads/professeur-clover-et-ohara/img_6.png",
    chapter: "Chapitre 1113"
  }
];

const theoryTimeline: TimelineEvent[] = [
  {
    date: "Étape 1 (Présent)",
    title: "Luffy écrit l'Histoire (Joy Boy vs 20 Rois)",
    desc: "La véritable guerre sainte se déroule actuellement sous nos yeux. Luffy et ses alliés affrontent Imu et les Doyens/Chevaliers Divins.",
    image: "/images/threads/coalition-des-20-rois/img_5.png",
    highlight: true,
    chapter: "Chapitres actuels"
  },
  {
    date: "Étape 2 (Futur Proche)",
    title: "La Guerre Finale & le Déluge Imminent",
    desc: "L'utilisation des Armes Antiques provoque la destruction de Red Line, la montée des eaux et la naissance de la mer All Blue.",
    image: "/images/threads/le-deluge-et-all-blue/img_7.jpg",
    highlight: true,
    chapter: "Bataille finale"
  },
  {
    date: "Étape 3 (Futur)",
    title: "Rédaction & Taillage des Ponéglyphes",
    desc: "Nico Robin rédige la chronique des exploits accomplis, Momonosuke taille la pierre indestructible et Vivi prépare la dispersion.",
    image: "/images/threads/les-bases-du-siecle-oublie/img_3.jpg",
    highlight: true
  },
  {
    date: "Étape 4 (Rupture Temporelle)",
    title: "L'Envoi 800 ans en Arrière (La Boucle)",
    desc: "Vivi/Lili renvoie les Ponéglyphes, le robot Emeth (construit par Franky) et les reliques 800 ans dans le passé.",
    image: "/images/threads/lili-vivi-et-les-poneglyphes/img_3.jpg",
    highlight: true
  },
  {
    date: "Étape 5 (Passé Reçu)",
    title: "La Préparation des Peuples Anciens",
    desc: "Les ancêtres reçoivent les pierres du futur. Les Hommes-Poissons construisent l'Arche Noah et Wano ferme ses frontières en attente du Nika.",
    image: "/images/threads/les-bases-du-siecle-oublie/img_4.jpg"
  },
  {
    date: "Étape 6 (Résonance)",
    title: "Roger découvre le Récit du Futur",
    desc: "Roger lit sur Laugh Tale les aventures futures de Luffy (Joy Boy) et s'exclame : 'J'aurais tant aimé vivre à ton époque !'",
    image: "/images/threads/silhouette-scan-1181-roger/img_6.jpg"
  }
];
---

<WikiLayout title="Chronologie" currentPath="/theorie/chronologie">
  <div class="page-header">
    <span class="badge-tag">Mise à jour — Analyse & Frictions</span>
    <h1>Chronologie Comparative & Boucle Temporelle</h1>
    <p class="page-desc">
      Confrontation directe entre la <strong>Chronologie Officielle</strong> transmise par le Gouvernement Mondial et la <strong>Chronologie des Fous du Bus</strong> basée sur l'inversion temporelle.
    </p>
    <div class="scroll-instruction">
      <span>↔ Faites défiler horizontalement de gauche à droite pour parcourir les événements</span>
    </div>
  </div>

  <!-- SECTION 1: CHRONOLOGIE OFFICIELLE (CYAN THEME) -->
  <section class="timeline-section timeline-section--official">
    <div class="section-header">
      <h2 class="section-title text-cyan">
        <span class="badge-manga">Version Officielle</span>
        La Chronologie Raconte par le Monde
      </h2>
      <p class="section-desc">L'histoire perçue chronologiquement depuis l'Antiquité (-800 ans) jusqu'au présent.</p>
    </div>

    <!-- Arrow track & scroll container -->
    <div class="horizontal-scroll-container">
      <div class="arrow-timeline arrow-timeline--official">
        <div class="arrow-line"></div>
        <div class="arrow-head"></div>

        <div class="events-track">
          {officialTimeline.map((item, idx) => (
            <div class="event-card">
              <div class="event-step-number">{idx + 1}</div>
              <div class="event-node"></div>
              <div class="event-date">{item.date}</div>
              
              <div class="event-card-inner">
                {item.image && (
                  <div class="event-img-wrap">
                    <img src={item.image} alt={item.title} loading="lazy" />
                  </div>
                )}
                <div class="event-card-body">
                  {item.chapter && <span class="event-chapter">{item.chapter}</span>}
                  <h4>{item.title}</h4>
                  <p>{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: CHRONOLOGIE DES FOUS DU BUS (VIOLET/GOLD THEME) -->
  <section class="timeline-section timeline-section--theory mt-12">
    <div class="section-header">
      <h2 class="section-title text-violet">
        <span class="badge-theory">Théorie des Fous du Bus</span>
        La Véritable Boucle Temporelle
      </h2>
      <p class="section-desc">Le Siècle Oublié n'est pas le passé : c'est le présent et le futur que Luffy et ses alliés écrivent maintenant.</p>
    </div>

    <!-- Arrow track & scroll container -->
    <div class="horizontal-scroll-container">
      <div class="arrow-timeline arrow-timeline--theory">
        <div class="arrow-line"></div>
        <div class="arrow-head"></div>

        <div class="events-track">
          {theoryTimeline.map((item, idx) => (
            <div class={`event-card ${item.highlight ? 'event-card--highlight' : ''}`}>
              <div class="event-step-number event-step-number--theory">{idx + 1}</div>
              <div class="event-node event-node--theory"></div>
              <div class="event-date event-date--theory">{item.date}</div>
              
              <div class="event-card-inner">
                {item.image && (
                  <div class="event-img-wrap">
                    <img src={item.image} alt={item.title} loading="lazy" />
                  </div>
                )}
                <div class="event-card-body">
                  {item.chapter && <span class="event-chapter event-chapter--theory">{item.chapter}</span>}
                  <h4>{item.title}</h4>
                  <p>{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SYNTHESIS NOTE -->
  <div class="info-box mt-12">
    <h3>💡 Clé de compréhension de la théorie</h3>
    <p>
      Dans la version officielle, l'histoire va de gauche à droite de manière linéaire (-800 ans → Présent). Dans la théorie des Fous du Bus, les événements que nous lisons aujourd'hui (Étape 1 à 3) sont envoyés vers le passé (Étape 4) pour former le récit que les peuples du monde ont lu pendant 800 ans !
    </p>
  </div>

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: 32px;
  }

  .badge-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 12%, transparent);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
    border: 1px solid color-mix(in srgb, var(--cyan) 25%, transparent);
  }

  .page-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .page-desc {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 750px;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .scroll-instruction {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 12%, transparent);
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent-gold) 25%, transparent);
  }

  .timeline-section {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-xl);
    padding: 24px;
    position: relative;
    overflow: hidden;
  }

  .section-header {
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 20px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .section-desc {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .badge-manga {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--cyan) 16%, transparent);
    color: var(--cyan);
    border: 1px solid color-mix(in srgb, var(--cyan) 30%, transparent);
  }

  .badge-theory {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--violet) 18%, transparent);
    color: var(--violet-light);
    border: 1px solid color-mix(in srgb, var(--violet) 35%, transparent);
  }

  /* HORIZONTAL SCROLL CONTAINER & ARROW TRACK */
  .horizontal-scroll-container {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 16px;
    padding-top: 10px;
    scroll-behavior: smooth;
  }

  .horizontal-scroll-container::-webkit-scrollbar {
    height: 8px;
  }

  .horizontal-scroll-container::-webkit-scrollbar-track {
    background: var(--surface);
    border-radius: 4px;
  }

  .horizontal-scroll-container::-webkit-scrollbar-thumb {
    background: var(--cyan);
    border-radius: 4px;
  }

  .timeline-section--theory .horizontal-scroll-container::-webkit-scrollbar-thumb {
    background: var(--violet);
  }

  .arrow-timeline {
    position: relative;
    display: inline-block;
    min-width: max-content;
    padding-right: 60px;
    padding-left: 20px;
  }

  /* Main horizontal Arrow Line */
  .arrow-line {
    position: absolute;
    top: 38px;
    left: 0;
    right: 40px;
    height: 4px;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--glow-cyan);
    z-index: 1;
  }

  .arrow-timeline--theory .arrow-line {
    background: var(--gradient-border);
    box-shadow: 0 0 10px var(--glow-violet);
  }

  .arrow-head {
    position: absolute;
    top: 30px;
    right: 20px;
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 20px solid var(--cyan);
    z-index: 1;
  }

  .arrow-timeline--theory .arrow-head {
    border-left-color: var(--violet-light);
  }

  /* Events track flex layout */
  .events-track {
    display: flex;
    gap: 28px;
    position: relative;
    z-index: 2;
    padding-top: 20px;
  }

  .event-card {
    display: flex;
    flex-direction: column;
    width: 280px;
    flex-shrink: 0;
    position: relative;
  }

  .event-step-number {
    position: absolute;
    top: -24px;
    left: 0;
    font-size: 11px;
    font-weight: 800;
    color: var(--cyan);
    text-transform: uppercase;
  }

  .event-step-number--theory {
    color: var(--violet-light);
  }

  .event-node {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-main);
    border: 3px solid var(--cyan);
    margin-bottom: 12px;
    box-shadow: 0 0 10px var(--glow-cyan);
    flex-shrink: 0;
  }

  .event-node--theory {
    border-color: var(--violet-light);
    box-shadow: 0 0 10px var(--glow-violet);
  }

  .event-date {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--cyan);
    margin-bottom: 8px;
  }

  .event-date--theory {
    color: var(--accent-gold);
  }

  .event-card-inner {
    background-color: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .event-card:hover .event-card-inner {
    transform: translateY(-4px);
    border-color: var(--cyan);
  }

  .timeline-section--theory .event-card:hover .event-card-inner {
    border-color: var(--violet);
  }

  .event-card--highlight .event-card-inner {
    border: 1px solid var(--violet);
    box-shadow: 0 4px 20px var(--glow-violet);
  }

  .event-img-wrap {
    width: 100%;
    height: 140px;
    overflow: hidden;
    background: var(--bg-main);
    border-bottom: 1px solid var(--border-color);
  }

  .event-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .event-card:hover .event-img-wrap img {
    transform: scale(1.06);
  }

  .event-card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .event-chapter {
    font-size: 11px;
    font-weight: 700;
    color: var(--cyan);
    margin-bottom: 4px;
    display: inline-block;
  }

  .event-chapter--theory {
    color: var(--accent-gold);
  }

  .event-card-body h4 {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 8px;
    line-height: 1.35;
  }

  .event-card-body p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .info-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--violet);
    padding: 20px 24px;
    border-radius: var(--border-radius-lg);
  }

  .info-box h3 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .info-box p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
</style>
