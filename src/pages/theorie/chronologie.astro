---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface LoopStep {
  id: number;
  surTitle: string;
  title: string;
  text: string;
  tags: string[];
  image: string;
  chapterBadge?: string;
}

const loopSteps: LoopStep[] = [
  {
    id: 1,
    surTitle: "Présent du manga",
    title: "Le monde actuel",
    text: "Selon la théorie, l’histoire centrale se déroule maintenant. Luffy progresse sur Grand Line, libère des peuples, rassemble sans le savoir la future coalition de Joy Boy et s’approche du moment où tout doit basculer. Imu, de son côté, gouverne dans l’ombre et cherche à empêcher l’avenir qu’il redoute.",
    tags: ["Luffy", "Imu", "Alliés", "Coalition"],
    image: "/images/threads/coalition-des-20-rois/img_5.png",
    chapterBadge: "Présent"
  },
  {
    id: 2,
    surTitle: "Clé de la théorie",
    title: "Laugh Tale et le “trop tôt” de Roger",
    text: "La théorie propose que Laugh Tale ne soit pas seulement une destination cachée dans l’espace, mais aussi un lieu lié au temps. Roger y serait arrivé trop tôt, ce qui expliquerait pourquoi il a compris quelque chose d’essentiel sans pouvoir agir lui-même.",
    tags: ["Laugh Tale", "Roger", "Lodestar", "Temps"],
    image: "/images/threads/silhouette-scan-1181-roger/img_6.jpg",
    chapterBadge: "Chapitre 967"
  },
  {
    id: 3,
    surTitle: "Futur proche",
    title: "La guerre finale",
    text: "Dans la lecture des Fous du Bus, la grande guerre n’appartient pas au passé : elle arrive. Luffy et ses alliés affronteront Imu, le Gouvernement mondial, les Dragons Célestes et les forces qui maintiennent le monde dans l’oppression.",
    tags: ["Guerre finale", "Imu", "Gouvernement mondial", "Joy Boy"],
    image: "/images/threads/coalition-des-20-rois/img_2.jpg",
    chapterBadge: "Futur Proche"
  },
  {
    id: 4,
    surTitle: "Conséquence de la guerre",
    title: "Le déluge et la transformation du monde",
    text: "La théorie avance que l’utilisation des Armes antiques provoquera la destruction de Red Line, la montée des eaux et la naissance d’un nouveau monde. Ce bouleversement rendrait possibles All Blue, la réunion des peuples et l’accomplissement de plusieurs promesses majeures du récit.",
    tags: ["Red Line", "Déluge", "All Blue", "Armes antiques"],
    image: "/images/threads/le-deluge-et-all-blue/img_7.jpg",
    chapterBadge: "Changement de monde"
  },
  {
    id: 5,
    surTitle: "Futur",
    title: "Le monde que l’histoire appellera “Royaume antique”",
    text: "Selon la théorie, ce que le monde considère plus tard comme le “Royaume antique” pourrait en réalité être le monde futur né après la guerre. Ce royaume ne serait pas une civilisation disparue du passé, mais un monde nouveau, technologiquement avancé, créé après la victoire de Luffy et de ses alliés.",
    tags: ["Royaume antique", "Futur", "Technologie", "Vegapunk"],
    image: "/images/threads/professeur-clover-et-ohara/img_3.jpg",
    chapterBadge: "Nouvel Âge"
  },
  {
    id: 6,
    surTitle: "Mémoire du futur",
    title: "La rédaction et la transmission de l’histoire",
    text: "Dans cette théorie, l’histoire véritable serait ensuite gravée, transmise ou envoyée vers le passé. Les Ponéglyphes deviendraient alors une mémoire du futur : non pas le récit d’un passé oublié, mais le témoignage des événements que Luffy et ses alliés auront réellement vécus.",
    tags: ["Ponéglyphes", "Robin", "Mémoire", "Transmission"],
    image: "/images/threads/les-bases-du-siecle-oublie/img_3.jpg",
    chapterBadge: "Gravure"
  },
  {
    id: 7,
    surTitle: "Il y a 800 ans",
    title: "Le passé reçoit les traces du futur",
    text: "Une fois ces informations reçues dans le passé, le monde interprète cette mémoire comme l’histoire d’une époque ancienne. C’est là que naissent les missions de conservation : protéger Noah, transmettre le nom de Nika, garder certains Ponéglyphes, préserver des royaumes, attendre Joy Boy.",
    tags: ["Noah", "Nika", "Alabasta", "Wa no Kuni", "Shandora", "Zou"],
    image: "/images/threads/lili-vivi-et-les-poneglyphes/img_3.jpg",
    chapterBadge: "800 ans plus tôt"
  },
  {
    id: 8,
    surTitle: "Boucle complète",
    title: "Huit siècles d’attente aboutissent à Luffy",
    text: "Pendant huit siècles, peuples, royaumes et témoins attendent l’accomplissement de cette histoire. Le présent du manga devient alors le point où la boucle se referme : Luffy accomplit ce que le monde croyait être le passé, et devient la figure que l’histoire nommera Joy Boy.",
    tags: ["Luffy", "Joy Boy", "Boucle", "Accomplissement"],
    image: "/images/threads/emeth-robot-du-futur/img_6.png",
    chapterBadge: "Boucle accomplie"
  }
];
---

<WikiLayout title="La Véritable Boucle Temporelle — Chronologie" currentPath="/theorie/chronologie">
  <div class="chrono-page-header">
    <div class="header-badge">
      <span class="pulse-dot"></span>
      <span>Lecture théorique des Fous du Bus</span>
    </div>
    
    <h1>La Véritable Boucle Temporelle</h1>
    
    <p class="header-subtitle">
      Selon la théorie des Fous du Bus, le Siècle oublié ne correspond pas à un passé ancien, mais au futur de Luffy et de ses alliés, ensuite transmis au passé.
    </p>

    <!-- STEPPER CONTROL BAR -->
    <div class="stepper-bar" id="stepper-bar" data-pagefind-ignore>
      <div class="stepper-track-bg"></div>
      <div class="stepper-progress" id="stepper-progress"></div>
      
      {loopSteps.map((step) => (
        <button
          class={`stepper-node ${step.id === 1 ? 'is-active' : ''}`}
          data-step={step.id}
          title={`Étape ${step.id} : ${step.title}`}
          aria-label={`Aller à l'étape ${step.id}`}
        >
          <span class="stepper-num">{step.id}</span>
          <span class="stepper-label">{step.surTitle}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- HORIZONTAL SNAP SLIDER CONTAINER WITH LOOP BACK ARC -->
  <div class="timeline-container-wrap">
    
    <!-- Visual Loop-Back Connector Badge -->
    <div class="loop-return-banner" id="loop-return-banner">
      <div class="loop-return-content">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
        <span>La boucle se referme : de l'étape 8 retour à l'étape 1</span>
      </div>
    </div>

    <!-- Scrollable track -->
    <div class="timeline-slider" id="timeline-slider">
      <!-- Glow Track Line -->
      <div class="slider-track-line"></div>

      {loopSteps.map((step) => (
        <div class="step-card-item" id={`step-card-${step.id}`} data-step-id={step.id}>
          <div class="card-node-indicator">
            <div class="node-dot">
              <span>{step.id}</span>
            </div>
            <div class="node-connector"></div>
          </div>

          <div class="card-box">
            <div class="card-header-tag">
              <span class="sur-title">{step.surTitle}</span>
              {step.chapterBadge && <span class="badge-chip">{step.chapterBadge}</span>}
            </div>

            <div class="card-media">
              <img src={step.image} alt={step.title} loading="lazy" />
              <div class="card-media-overlay"></div>
            </div>

              <div class="card-content">
                <h3>{step.title}</h3>
                <p>{step.text}</p>

                <div class="card-tags">
                  {step.tags.map((tag) => (
                    <span class="tag-pill">#{tag}</span>
                  ))}
                </div>

                {step.id === 8 && (
                  <button id="btn-loop-restart" class="btn-loop-restart">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                      <path d="M3 3v5h5"></path>
                    </svg>
                    <span>Boucler le cycle → Étape 1</span>
                  </button>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  <!-- EXPLANATORY COMPLEMENTARY BLOCK -->
  <div class="explanation-box mt-12">
    <div class="explanation-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
    </div>
    
    <div class="explanation-body">
      <h2>Comment lire cette frise ?</h2>
      <p>
        Cette chronologie ne présente pas une simple suite linéaire d’événements. Elle montre la logique de la théorie des Fous du Bus :
      </p>
      
      <ul class="explanation-list">
        <li><strong>1. Le présent produit le futur</strong> : Luffy et ses alliés combattent actuellement les maîtres du monde.</li>
        <li><strong>2. Ce futur est transmis au passé</strong> : la mémoire des événements accomplis est envoyée 800 ans en arrière via les Ponéglyphes.</li>
        <li><strong>3. Le passé prépare pendant huit siècles le retour de cet avenir</strong> : les peuples anciens protègent les stèles et attendent la promesse.</li>
        <li><strong>4. Le présent accomplit ce que l’histoire croyait déjà révolu</strong> : Luffy rééveille la légende que le monde prenait pour un mythe ancien.</li>
      </ul>

      <div class="isolated-quote">
        « Le futur devient le passé, puis le passé prépare le présent. »
      </div>
    </div>
  </div>

  <Footer />
</WikiLayout>

<style>
  /* COLOR PALETTE VARIABLES ACCORDING TO SPEC */
  :root {
    --bg-dark-main: #07020A;
    --bg-dark-sec: #160B27;
    --surface-dark: #22124A;
    --violet-elec: #6E3BBC;
    --magenta-energy: #AD57A7;
    --cyan-teal: #4DE7FF;
    --text-bright: #FEFBF8;
    --text-muted: #DDE4EA;
    --gold-accent: #F4B63F;
  }

  .chrono-page-header {
    margin-bottom: 32px;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--violet-elec) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--violet-elec) 35%, transparent);
    color: var(--cyan-teal);
    font-size: 12.5px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--cyan-teal);
    box-shadow: 0 0 10px var(--cyan-teal);
    animation: pulse-glow 2s infinite ease-in-out;
  }

  @keyframes pulse-glow {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; box-shadow: 0 0 16px var(--cyan-teal); }
  }

  .chrono-page-header h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    color: var(--text-bright);
    margin-bottom: 14px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--text-bright) 0%, var(--cyan-teal) 50%, var(--magenta-energy) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-subtitle {
    font-size: 16.5px;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* STEPPER NAVIGATION BAR */
  .stepper-bar {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-dark-sec);
    border: 1px solid color-mix(in srgb, var(--violet-elec) 30%, transparent);
    border-radius: 16px;
    padding: 12px 18px;
    margin-bottom: 24px;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .stepper-bar::-webkit-scrollbar {
    display: none;
  }

  .stepper-track-bg {
    position: absolute;
    top: 50%;
    left: 40px;
    right: 40px;
    height: 3px;
    background: color-mix(in srgb, var(--surface-dark) 80%, white 20%);
    z-index: 1;
    transform: translateY(-50%);
  }

  .stepper-progress {
    position: absolute;
    top: 50%;
    left: 40px;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--cyan-teal), var(--violet-elec), var(--gold-accent));
    z-index: 2;
    transform: translateY(-50%);
    transition: width 0.3s ease;
    box-shadow: 0 0 12px var(--cyan-teal);
  }

  .stepper-node {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .stepper-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-dark);
    border: 2px solid color-mix(in srgb, var(--violet-elec) 40%, transparent);
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .stepper-node:hover .stepper-num {
    border-color: var(--cyan-teal);
    color: var(--cyan-teal);
    transform: scale(1.1);
  }

  .stepper-node.is-active .stepper-num {
    background: var(--violet-elec);
    border-color: var(--cyan-teal);
    color: white;
    box-shadow: 0 0 16px var(--violet-elec);
    transform: scale(1.18);
  }

  .stepper-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .stepper-node.is-active .stepper-label {
    color: var(--cyan-teal);
    opacity: 1;
    font-weight: 700;
  }

  /* TIMELINE SLIDER CONTAINER */
  .timeline-container-wrap {
    position: relative;
    margin-bottom: 40px;
  }

  .loop-return-banner {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }

  .loop-return-content {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--violet-elec) 25%, transparent), color-mix(in srgb, var(--gold-accent) 25%, transparent));
    border: 1px solid var(--gold-accent);
    color: var(--gold-accent);
    font-size: 13.5px;
    font-weight: 700;
    box-shadow: 0 0 20px rgba(244, 182, 63, 0.25);
  }

  .timeline-slider {
    position: relative;
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 30px 10px 24px;
    scrollbar-width: thin;
    scrollbar-color: var(--violet-elec) var(--surface-dark);
  }

  .timeline-slider::-webkit-scrollbar {
    height: 8px;
  }

  .timeline-slider::-webkit-scrollbar-track {
    background: var(--bg-dark-sec);
    border-radius: 4px;
  }

  .timeline-slider::-webkit-scrollbar-thumb {
    background: var(--violet-elec);
    border-radius: 4px;
  }

  .slider-track-line {
    position: absolute;
    top: 48px;
    left: 20px;
    right: 20px;
    height: 4px;
    background: linear-gradient(90deg, var(--cyan-teal) 0%, var(--violet-elec) 50%, var(--gold-accent) 100%);
    box-shadow: 0 0 14px var(--violet-elec);
    z-index: 1;
  }

  .step-card-item {
    scroll-snap-align: center;
    flex-shrink: 0;
    width: 320px;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .card-node-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
  }

  .node-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-dark-main);
    border: 3px solid var(--violet-elec);
    color: var(--cyan-teal);
    font-weight: 800;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px var(--violet-elec);
    transition: all 0.3s ease;
  }

  .step-card-item:hover .node-dot {
    border-color: var(--cyan-teal);
    box-shadow: 0 0 24px var(--cyan-teal);
    transform: scale(1.15);
  }

  .node-connector {
    width: 2px;
    height: 16px;
    background: color-mix(in srgb, var(--violet-elec) 50%, transparent);
  }

  .card-box {
    background: var(--bg-dark-sec);
    border: 1px solid color-mix(in srgb, var(--surface-dark) 90%, var(--violet-elec) 30%);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  .step-card-item:hover .card-box {
    border-color: var(--violet-elec);
    box-shadow: 0 12px 36px color-mix(in srgb, var(--violet-elec) 25%, transparent);
    transform: translateY(-4px);
  }

  .card-header-tag {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px 10px;
    background: color-mix(in srgb, var(--surface-dark) 50%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--violet-elec) 20%, transparent);
  }

  .sur-title {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--gold-accent);
  }

  .badge-chip {
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--cyan-teal) 15%, transparent);
    color: var(--cyan-teal);
    border: 1px solid color-mix(in srgb, var(--cyan-teal) 30%, transparent);
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 160px;
    overflow: hidden;
    background: var(--bg-dark-main);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .step-card-item:hover .card-media img {
    transform: scale(1.08);
  }

  .card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, var(--bg-dark-sec) 100%);
  }

  .card-content {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-content h3 {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text-bright);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .card-content p {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
    flex: 1;
  }

  .btn-loop-restart {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    background: linear-gradient(90deg, var(--violet-elec), var(--cyan-teal));
    color: white;
    font-size: 13px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--violet-elec) 40%, transparent);
    transition: all 0.25s ease;
  }

  .btn-loop-restart:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 22px color-mix(in srgb, var(--cyan-teal) 50%, transparent);
  }

  .tag-pill {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface-dark);
    color: var(--cyan-teal);
    border: 1px solid color-mix(in srgb, var(--cyan-teal) 20%, transparent);
  }

  /* EXPLANATION BOX */
  .explanation-box {
    background: var(--bg-dark-sec);
    border: 1px solid var(--violet-elec);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    gap: 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), inset 0 0 20px color-mix(in srgb, var(--violet-elec) 15%, transparent);
  }

  .explanation-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--violet-elec) 20%, transparent);
    border: 1px solid var(--violet-elec);
    color: var(--cyan-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .explanation-body h2 {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-bright);
    margin-bottom: 12px;
  }

  .explanation-body p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .explanation-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .explanation-list li {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
    padding-left: 20px;
    position: relative;
  }

  .explanation-list li::before {
    content: "•";
    position: absolute;
    left: 4px;
    color: var(--cyan-teal);
    font-weight: bold;
  }

  .explanation-list strong {
    color: var(--text-bright);
  }

  .isolated-quote {
    font-size: 18px;
    font-weight: 800;
    color: var(--gold-accent);
    text-align: center;
    padding: 16px 20px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--gold-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--gold-accent) 30%, transparent);
    letter-spacing: 0.3px;
    box-shadow: 0 0 24px color-mix(in srgb, var(--gold-accent) 15%, transparent);
  }

  /* MOBILE ADAPTATION */
  @media (max-width: 768px) {
    .step-card-item {
      width: 85vw;
      max-width: 340px;
    }

    .explanation-box {
      flex-direction: column;
      padding: 20px;
    }

    .stepper-label {
      display: none;
    }
  }
</style>

<script>
  // Stepper & Slider Synchronization
  const slider = document.getElementById('timeline-slider');
  const stepperProgress = document.getElementById('stepper-progress');
  const stepperNodes = document.querySelectorAll('.stepper-node');
  const cards = document.querySelectorAll('.step-card-item');

  if (slider && stepperNodes.length > 0) {
    // Click stepper node -> Scroll to card
    stepperNodes.forEach((node) => {
      node.addEventListener('click', () => {
        const stepId = node.getAttribute('data-step');
        const targetCard = document.getElementById(`step-card-${stepId}`);
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });

    // Update active stepper state on scroll
    const updateActiveStep = () => {
      const sliderRect = slider.getBoundingClientRect();
      const sliderCenter = sliderRect.left + sliderRect.width / 2;

      let closestCard = cards[0];
      let minDistance = Infinity;

      cards.forEach((card) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(sliderCenter - cardCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestCard = card;
        }
      });

      const activeId = closestCard.getAttribute('data-step-id');
      if (activeId) {
        stepperNodes.forEach((node) => {
          if (node.getAttribute('data-step') === activeId) {
            node.classList.add('is-active');
          } else {
            node.classList.remove('is-active');
          }
        });

        // Update progress line width
        const totalSteps = stepperNodes.length;
        const currentIdx = parseInt(activeId, 10) - 1;
        const percentage = (currentIdx / (totalSteps - 1)) * 100;
        if (stepperProgress) {
          stepperProgress.style.width = `${percentage}%`;
        }
      }
    };

    const btnLoopRestart = document.getElementById('btn-loop-restart');
    btnLoopRestart?.addEventListener('click', () => {
      const step1 = document.getElementById('step-card-1');
      step1?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });

    slider.addEventListener('scroll', updateActiveStep);
    updateActiveStep();
  }
</script>
