---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';

interface Possibility {
  id: number;
  title: string;
  description: string;
  status: string;
}

const possibilities: Possibility[] = [
  {
    id: 1,
    title: "Transmission d'informations vers le passé",
    description: "Les Ponéglyphes (et éventuellement d'autres supports) portent un message du futur vers le passé.",
    status: "Principale"
  },
  {
    id: 2,
    title: "Communication entre époques",
    description: "Dispositif inconnu (comparable à la boule de cristal de Shirley) permettant un échange entre époques.",
    status: "Ouverte (chapitre 1188)"
  },
  {
    id: 3,
    title: "Perception / préscience",
    description: "Certaines figures (Shirley, hypothèse Imu) perçoivent des fragments du futur sans déplacement.",
    status: "Extension récente"
  },
  {
    id: 4,
    title: "Déplacement temporel ponctuel",
    description: "Déplacements limités ou projections ponctuelles (pas de boucle physique généralisée).",
    status: "Spéculative"
  }
];
---

<WikiLayout title="La mémoire de l'avenir — Chronologie" seoTitle="Chronologie One Piece : mémoire de l'avenir et mécanismes temporels | Les Fous du Bus" description="Chronologie et mécanismes temporels selon les Fous du Bus : transmission d'informations, communication entre époques, préscience. Mécanisme exact non résolu." image="/og-chronologie.png" currentPath="/theorie/chronologie">
  <div class="chrono-page-header">
    <div class="header-badge">
      <span class="pulse-dot"></span>
      <span>Lecture théorique des Fous du Bus</span>
    </div>
    
    <h1>La mémoire de l'avenir</h1>
    
    <p class="header-subtitle">
      La théorie complète reconnaît plusieurs possibilités de communication temporelle. Le mécanisme exact n’est pas fixé. La transmission des Ponéglyphes est le cœur du dispositif.
    </p>
  </div>

  <div class="possibilities">
    <h2>Quatre possibilités actuellement envisagées</h2>
    <div class="poss-grid">
      {possibilities.map((p) => (
        <div class="poss-card">
          <div class="poss-header">
            <span class="poss-id">{p.id}</span>
            <span class="poss-status">{p.status}</span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="note-box">
    <strong>Mécanisme exact : non résolu.</strong><br />
    La théorie complète (chapitres 3–5) fait déjà cette distinction. Les chapitres 1187–1188 ouvrent la possibilité d’une communication directe sans boucle physique généralisée.
  </div>

  <div class="links">
    <a href="/theorie/theorie-complete">Lire la théorie complète →</a>
    <a href="/theorie/communication-temps">Communication à travers le temps →</a>
    <a href="/explorer/chronologie-comparative">Chronologie comparative →</a>
  </div>

  <Footer />
</WikiLayout>

<style>
  .chrono-page-header { margin-bottom: 32px; }
  .header-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: color-mix(in srgb, var(--violet) 15%, transparent); border: 1px solid color-mix(in srgb, var(--violet) 35%, transparent); color: var(--cyan); font-size: 12.5px; font-weight: 600; margin-bottom: 16px; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background-color: var(--cyan); box-shadow: 0 0 10px var(--cyan); animation: pulse-glow 2s infinite ease-in-out; }
  @keyframes pulse-glow { 0%,100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.4); opacity: 1; box-shadow: 0 0 16px var(--cyan); } }
  .chrono-page-header h1 { font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 800; color: var(--text-main); margin-bottom: 14px; }
  .header-subtitle { font-size: 16.5px; color: var(--text-secondary); max-width: 820px; line-height: 1.6; }

  .possibilities { margin: 40px 0; }
  .possibilities h2 { font-size: 1.35rem; margin-bottom: 16px; }
  .poss-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .poss-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px; }
  .poss-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .poss-id { font-weight: 800; color: var(--cyan); }
  .poss-status { font-size: 11px; padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, var(--accent-gold) 15%, transparent); color: var(--accent-gold); }
  .poss-card h3 { font-size: 15px; margin: 6px 0 8px; }
  .poss-card p { font-size: 13.5px; color: var(--text-secondary); line-height: 1.5; }

  .note-box { background: var(--surface); border-left: 4px solid var(--violet); padding: 18px 20px; border-radius: 10px; margin: 32px 0; font-size: 14.5px; }
  .links { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 32px; }
  .links a { color: var(--cyan); text-decoration: none; font-weight: 600; }
</style>
