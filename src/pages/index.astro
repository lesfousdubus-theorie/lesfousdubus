---
import WikiLayout from '@layouts/WikiLayout.astro';
import ChapterBanner from '@components/ChapterBanner.astro';
import CategoryCard from '@components/CategoryCard.astro';
import ArticleListItem from '@components/ArticleListItem.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';
import { categoryLabel, effectLabel } from '@utils/labels';
import { getRecentArticleUpdates } from '@utils/chapter-updates';
import { siteCategories } from '../data/siteNavigation';

// Miniature de la façade vidéo. Priorité à la vignette auto-hébergée
// (public/images/video-cover.webp, produite par scripts/fetch-video-cover.sh) :
// dans ce cas, aucune requête YouTube avant le clic. Si elle manque (sandbox
// sans réseau YouTube), repli distant maxresdefault → hqdefault → og-default.
import { existsSync } from 'node:fs';
const VIDEO_ID = 'SgJ25zjMJyo';
const localVideoCover = ['/images/video-cover.webp', '/images/video-cover.jpg'].find((src) =>
  existsSync(new URL(`../../public${src}`, import.meta.url)),
);
const videoCoverSrc = localVideoCover ?? `https://img.youtube.com/vi/${VIDEO_ID}/maxresdefault.jpg`;
// Chaîne de replis : hqdefault (toujours présente) puis carte OG locale.
const videoCoverFallback = `this.onerror=function(){this.onerror=null;this.src='/og-default.jpg';};this.src='https://img.youtube.com/vi/${VIDEO_ID}/hqdefault.jpg';`;

const chapters = await getCollection('chapters');
const articles = await getCollection(
  'articles',
  ({ data }) => data.status === 'published' && !data.sidebarHidden,
);
const latestChapter = chapters.sort((a, b) => b.data.chapter - a.data.chapter)[0];
const recentArticleUpdates = getRecentArticleUpdates(articles, chapters, 4);
const countByCategory = (cat: string) =>
  articles.filter((a: any) => a.data.category === cat).length;
---

<WikiLayout
  title="La mémoire de l’avenir — Théorie One Piece"
  description="Une théorie sur des informations futures conservées par les Ponéglyphes, du passé apparent au présent vécu et aux futurs possibles de Luffy."
  image="/og-default.jpg"
  currentPath="/"
>
  <div class="hero">
    <div class="hero-badge">
      <span class="hero-badge__dot"></span>
      <span>La théorie</span>
    </div>
    <h1 class="hero-title">
      La mémoire<span class="text-gradient">de l’avenir</span>
    </h1>
    <svg
      class="wave-rule hero-wave"
      viewBox="0 0 240 12"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 6 Q15 1 30 6 T60 6 T90 6 T120 6 T150 6 T180 6 T210 6 T240 6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"></path>
    </svg>

    <div class="hero-text">
      <p>
        Et si certaines sources du passé conservaient des informations créées dans un futur encore
        possible ? Les Ponéglyphes forment le support central de cette lecture ; communication,
        préscience et transport physique restent des branches séparées.
      </p>
    </div>

    <div class="hero-cta">
      <a href="/theorie/resume" class="btn-primary">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path
            d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg
        >
        Lire le résumé (10 points)
      </a>
      <a href="/theorie/chronologie" class="btn-secondary">
        Frise chronologique
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </a>
      <a href="/theorie/theorie-complete" class="btn-secondary">Théorie complète</a>
    </div>
  </div>

  <h2 class="section-title">
    <span class="section-title__accent"></span>
    Comprendre la théorie
  </h2>
  <div class="understand-grid">
    <a class="understand-card" href="/theorie/resume">
      <span class="understand-step">1</span>
      <h3>Le résumé en 10 points</h3>
      <p>La chaîne complète, ses arguments principaux et ce qui reste encore inexpliqué.</p>
    </a>
    <a class="understand-card" href="/theorie/chronologie">
      <span class="understand-step">2</span>
      <h3>La frise chronologique</h3>
      <p>Passé apparent, présent vécu et futurs possibles, dans l’ordre de la lecture.</p>
    </a>
    <a class="understand-card" href="/theorie/theorie-complete">
      <span class="understand-step">3</span>
      <h3>La théorie complète</h3>
      <p>La démonstration continue en 22 chapitres, du début à la fin.</p>
    </a>
  </div>

  <section class="video-section" aria-labelledby="video-section-title">
    <div class="video-section__header">
      <p class="video-section__eyebrow">Présentation vidéo</p>
      <h2 id="video-section-title">Voir la théorie en images</h2>
      <p>
        La vidéo complète le parcours de lecture : commencez par le résumé si vous voulez d’abord
        comprendre la structure.
      </p>
    </div>
    <div class="video-facade" id="video-facade">
      <img
        id="video-facade__img"
        src={videoCoverSrc}
        onerror={localVideoCover ? undefined : videoCoverFallback}
        alt="Miniature de la vidéo de présentation de la théorie"
        class="video-facade__img"
        loading="lazy"
      />
      <button
        type="button"
        id="video-facade__trigger"
        class="video-facade__overlay"
        aria-label="Lire la vidéo de présentation"
      >
        <div class="video-facade__play">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="white"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
        </div>
        <span class="video-facade__label">Regarder la présentation</span>
      </button>
    </div>

    <script>
      const facade = document.getElementById('video-facade');
      const loadVideo = () => {
        if (facade && !facade.dataset.loaded) {
          facade.dataset.loaded = 'true';
          facade.innerHTML = `<iframe
            class="absolute top-0 left-0 w-full h-full"
            src="https://www.youtube.com/embed/SgJ25zjMJyo?si=pXYc71i2i7G5tG5h&autoplay=1"
            title="Présentation vidéo de la théorie (YouTube)"
            style="border: none;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>`;
        }
      };
      document.getElementById('video-facade__trigger')?.addEventListener('click', loadVideo);
    </script>
  </section>

  {
    latestChapter && (
      <ChapterBanner
        chapter={String(latestChapter.data.chapter)}
        title={latestChapter.data.title}
        effect={effectLabel(latestChapter.data.effect)}
        href={`/chapitres/${latestChapter.data.chapter}`}
      />
    )
  }

  <h2 class="section-title">
    <span class="section-title__accent"></span>
    Dossiers
  </h2>
  <div class="grid">
    {
      siteCategories.map((category) => (
        <CategoryCard
          icon={category.icon}
          title={category.label}
          description={category.description}
          href={`/dossiers#${category.id}`}
          count={countByCategory(category.id)}
        />
      ))
    }
  </div>

  <div class="dossiers-footer">
    <a href="/dossiers" class="btn-see-all">Voir tous les dossiers →</a>
  </div>

  {
    latestChapter && (
      <p class="last-update">
        Dernière mise à jour de la théorie : <strong>chapitre {latestChapter.data.chapter}</strong>{' '}
        — {latestChapter.data.title}.
      </p>
    )
  }

  <h2 class="section-title">
    <span class="section-title__accent"></span>
    Articles récents
  </h2>
  <div class="article-list">
    {
      recentArticleUpdates.map(({ article }) => (
        <ArticleListItem
          title={article.data.title}
          category={categoryLabel(article.data.category)}
          href={`/theorie/${article.id}`}
          summary={article.data.summary}
        />
      ))
    }
  </div>

  <Footer />
</WikiLayout>

<style>
  /* ===== HERO (contained block) ===== */
  .hero {
    position: relative;
    margin-bottom: 48px;
    padding: 40px 40px 36px;
    border-radius: var(--border-radius-xl);
    border: 1px solid var(--border-color);
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--bg-secondary) 92%, transparent),
      color-mix(in srgb, var(--surface) 60%, transparent)
    );
    box-shadow: 0 20px 60px color-mix(in srgb, var(--bg-main) 45%, transparent);
    overflow: hidden;
  }

  /* Thin gradient line crowning the hero block */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--gradient-hero);
    opacity: 0.55;
    z-index: 1;
    pointer-events: none;
  }

  .hero > * {
    position: relative;
    z-index: 1;
    /* Staggered entrance */
    animation: hero-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-badge {
    animation-delay: 0.05s;
  }
  .hero-title {
    animation-delay: 0.12s;
  }
  .hero-wave {
    animation-delay: 0.18s;
  }
  .hero-text {
    animation-delay: 0.24s;
  }
  .hero-cta {
    animation-delay: 0.3s;
  }
  .video-facade {
    animation-delay: 0.38s;
  }

  .hero-wave {
    max-width: 300px;
    margin: 6px 0 22px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--violet-light);
    margin-bottom: 16px;
    padding: 7px 15px;
    border-radius: 100px;
    background: color-mix(in srgb, var(--violet) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--violet) 20%, transparent);
  }

  .hero-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--violet-light);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Respect reduced motion for custom animations */
  @media (prefers-reduced-motion: reduce) {
    .hero-badge__dot {
      animation: none !important;
    }
    .hero > * {
      animation: none !important;
    }
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  /* « est le présent » passe sur sa propre ligne sans <br> codé en dur :
     le retour à la ligne est géré par le CSS et reste équilibré. */
  .hero-title .text-gradient {
    display: block;
  }

  .hero-text {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.75;
  }

  .hero-text p + p {
    margin-top: 12px;
  }

  .hero-text__more {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-text__more {
      display: block;
    }
  }

  /* ===== CTA BUTTONS ===== */
  .hero-cta {
    display: flex;
    gap: 9px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    background: var(--gradient-border);
    color: var(--on-accent);
    border-radius: var(--border-radius-md);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 2px 12px var(--glow-violet);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px var(--glow-violet);
  }

  .btn-primary:active {
    transform: translateY(0) scale(0.97);
    box-shadow: 0 2px 8px var(--glow-violet);
  }

  .btn-secondary {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background-color: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-secondary svg {
    transition: transform 0.25s ease;
  }

  .btn-secondary:hover {
    border-color: var(--cyan-dim);
    color: var(--cyan);
    box-shadow: 0 0 16px var(--glow-cyan);
  }

  .btn-secondary:hover svg {
    transform: translateX(3px);
  }

  .btn-secondary:active {
    transform: scale(0.97);
    box-shadow: 0 0 8px var(--glow-cyan);
  }

  /* ===== VIDEO FACADE ===== */
  .video-section {
    margin: var(--space-6) 0 48px;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-xl);
    background: color-mix(in srgb, var(--bg-secondary) 78%, transparent);
  }

  .video-section__header {
    max-width: 680px;
    margin-bottom: var(--space-4);
  }

  .video-section__eyebrow {
    margin: 0 0 7px;
    color: var(--cyan);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .video-section h2 {
    margin: 0 0 8px;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  .video-section p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }

  .video-facade {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    margin-top: 0;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .video-facade:hover {
    border-color: color-mix(in srgb, var(--violet) 40%, var(--border-color));
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.4),
      0 0 20px var(--glow-violet);
  }

  .video-facade__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-facade__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-main) 78%, transparent) 0%,
      color-mix(in srgb, var(--bg-main) 28%, transparent) 50%,
      color-mix(in srgb, var(--bg-main) 8%, transparent) 100%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: background 0.3s ease;
    width: 100%;
    border: 0;
    padding: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  .video-facade__overlay:focus-visible {
    outline: 3px solid var(--cyan);
    outline-offset: -5px;
  }

  .video-facade:hover .video-facade__overlay {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-main) 86%, transparent) 0%,
      color-mix(in srgb, var(--bg-main) 38%, transparent) 50%,
      color-mix(in srgb, var(--bg-main) 12%, transparent) 100%
    );
  }

  .video-facade__play {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--violet);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px var(--glow-violet);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .video-facade:hover .video-facade__play {
    transform: scale(1.1);
    box-shadow: 0 6px 30px var(--glow-violet);
  }

  .video-facade__label {
    font-size: 14px;
    color: var(--text-main);
    font-weight: 500;
  }

  /* ===== SECTION TITLES ===== */
  .section-title {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    margin-top: 56px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-title__accent {
    display: inline-block;
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-border);
    flex-shrink: 0;
  }

  .section-title:first-of-type {
    margin-top: 0;
  }

  /* ===== GRID & LIST ===== */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: var(--grid-gap);
    align-items: stretch;
  }

  .article-list {
    display: grid;
    gap: var(--space-3);
  }

  .dossiers-footer {
    margin-top: 20px;
    text-align: center;
  }

  .btn-see-all {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    color: var(--cyan);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-see-all:hover {
    border-color: var(--cyan);
    transform: translateY(-2px);
  }

  .btn-see-all:active {
    transform: translateY(0) scale(0.98);
  }

  .understand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: var(--grid-gap);
    margin-bottom: var(--space-6);
  }

  .understand-card {
    display: block;
    min-height: 156px;
    height: 100%;
    padding: var(--card-padding);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--gradient-card);
    text-decoration: none;
    color: var(--text-main);
    transition:
      transform 0.2s,
      border-color 0.2s;
  }

  .understand-card:hover {
    transform: translateY(-3px);
    border-color: var(--violet);
    box-shadow:
      0 10px 32px rgba(0, 0, 0, 0.15),
      0 0 16px var(--glow-violet);
  }

  .understand-card:active {
    transform: translateY(-1px) scale(0.98);
  }

  .understand-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--gradient-border);
    margin-bottom: 10px;
  }

  .understand-card h3 {
    font-size: 16px;
    margin: 0 0 8px;
  }

  .understand-card p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .last-update {
    font-size: 13px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-gold);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    margin-bottom: 8px;
  }

  .last-update strong {
    color: var(--accent-gold);
  }

  @media (max-width: 640px) {
    .hero {
      margin-bottom: var(--space-6);
      padding: 32px 20px 28px;
    }
    .hero-cta {
      flex-direction: column;
    }
    .hero-cta .btn-primary,
    .hero-cta .btn-secondary {
      width: 100%;
      justify-content: center;
    }
    .section-title {
      margin-top: 40px;
      font-size: 17.5px;
    }
    .video-facade__play {
      width: 52px;
      height: 52px;
    }
    .video-facade__play svg {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 380px) {
    .hero {
      padding: 28px 16px 24px;
    }
  }
</style>
