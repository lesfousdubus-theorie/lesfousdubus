---
import WikiLayout from '@layouts/WikiLayout.astro';
import ChapterBanner from '@components/ChapterBanner.astro';
import CategoryCard from '@components/CategoryCard.astro';
import ArticleListItem from '@components/ArticleListItem.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';
import { categoryLabel, effectLabel } from '@utils/labels';
import { getRecentArticleUpdates } from '@utils/chapter-updates';

const chapters = await getCollection('chapters');
const articles = await getCollection('articles', ({ data }) => data.status === 'published' && !data.sidebarHidden);
const latestChapter = chapters.sort((a, b) => b.data.chapter - a.data.chapter)[0];
const recentArticleUpdates = getRecentArticleUpdates(articles, chapters, 4);

const badgeColorByEffect = {
  fondation: 'cyan',
  approfondissement: 'gold',
  'nouvelle-piste': 'violet',
  modification: 'gold',
  'piste-abandonnee': 'textSecondary',
} as const;
---

<WikiLayout
  title="Le Siècle oublié est le présent — Théorie One Piece"
  description="Et si le Siècle oublié n'avait pas eu lieu il y a 800 ans ? Les Ponéglyphes raconteraient l'avenir, Joy Boy serait Luffy et la Grande Guerre approche."
  image="/og-default.png"
  currentPath="/"
>
  <div class="hero">
    <div class="hero-badge">
      <span class="hero-badge__dot"></span>
      <span>La théorie</span>
    </div>
    <h1 class="hero-title">
      Le Siècle oublié<br /><span class="text-gradient">est le présent</span>
    </h1>
    <svg
      class="wave-rule hero-wave"
      viewBox="0 0 240 12"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 6 Q15 1 30 6 T60 6 T90 6 T120 6 T150 6 T180 6 T210 6 T240 6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"></path>
    </svg>

    <div class="hero-text">
      <p>
        Et si le Siècle oublié n’avait pas eu lieu il y a 800 ans ? Selon la théorie des Fous du Bus,
        les Ponéglyphes raconteraient l’avenir, Joy Boy serait Luffy à la fin de son aventure, et la
        Grande Guerre serait celle vers laquelle le manga se dirige aujourd’hui.
      </p>
    </div>

    <div class="hero-cta">
      <a href="/theorie/resume" class="btn-primary">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path
            d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg
        >
        Lire le résumé (10 points)
      </a>
      <a href="/theorie/theorie-complete" class="btn-secondary">
        Théorie complète
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </a>
      {latestChapter && (
        <a href={`/chapitres/${latestChapter.data.chapter}`} class="btn-secondary">
          Dernier chapitre analysé
        </a>
      )}
    </div>

    <div
      class="video-facade"
      id="video-facade"
      role="button"
      aria-label="Lire la vidéo de présentation"
      tabindex="0"
    >
      <img
        src="https://img.youtube.com/vi/SgJ25zjMJyo/maxresdefault.jpg"
        alt="Vidéo de présentation de la théorie"
        class="video-facade__img"
        loading="lazy"
        onerror="this.onerror=null; this.src='https://img.youtube.com/vi/SgJ25zjMJyo/hqdefault.jpg';"
      />
      <div class="video-facade__overlay">
        <div class="video-facade__play">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="white"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
        </div>
        <span class="video-facade__label">Regarder la présentation</span>
      </div>
    </div>

    <script>
      const facade = document.getElementById('video-facade');
      const loadVideo = () => {
        if (facade && !facade.dataset.loaded) {
          facade.dataset.loaded = 'true';
          facade.innerHTML = `<iframe
            class="absolute top-0 left-0 w-full h-full"
            src="https://www.youtube.com/embed/SgJ25zjMJyo?si=pXYc71i2i7G5tG5h&autoplay=1"
            title="YouTube video player"
            style="border: none;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>`;
        }
      };
      facade?.addEventListener('click', loadVideo);
      facade?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          loadVideo();
        }
      });
    </script>
  </div>

  {latestChapter && (
    <ChapterBanner
      chapter={String(latestChapter.data.chapter)}
      title={latestChapter.data.title}
      effect={effectLabel(latestChapter.data.effect)}
      href={`/chapitres/${latestChapter.data.chapter}`}
    />
  )}

  <h2 class="section-title">
    <span class="section-title__accent"></span>
    Dossiers principaux
  </h2>
  <div class="grid">
    <CategoryCard
      icon="🌍"
      title="Monde et destinations"
      description="Blue Star, Grand Line, Laugh Tale, Lodestar : la géographie comme point de départ du raisonnement."
      href="/dossiers#monde-destinations"
    />
    <CategoryCard
      icon="📜"
      title="Histoire et temporalité"
      description="Siècle oublié, Ponéglyphes, voyage temporel et communication à travers les époques."
      href="/dossiers#histoire-temporalite"
    />
    <CategoryCard
      icon="🎭"
      title="Figures principales"
      description="Luffy, Joy Boy, Nika, Roger : les acteurs centraux de la théorie."
      href="/dossiers#figures-principales"
    />
    <CategoryCard
      icon="🔱"
      title="Armes antiques"
      description="Poséidon, Pluton, Uranus, Noah : leur véritable fonction et leur rôle dans la guerre finale."
      href="/dossiers#armes-antiques"
    />
    <CategoryCard
      icon="⚡"
      title="Technologies et pouvoirs"
      description="Vegapunk, Mother Flame, Fruits du Démon, Emeth et les connaissances perdues."
      href="/dossiers#technologies-pouvoirs"
    />
    <CategoryCard
      icon="⚖️"
      title="Gouvernement et guerre finale"
      description="Imu, Gorosei, Déluge, destruction de Red Line et création d'All Blue."
      href="/dossiers#gouvernement-mondial"
    />
  </div>

  <div class="dossiers-footer">
    <a href="/dossiers" class="btn-see-all">Voir tous les dossiers →</a>
  </div>

  <div class="reading-guide">
    <span class="reading-guide__icon">💡</span>
    <span class="reading-guide__text">
      Les articles utilisent des badges de certitude (<a href="/aide/glossaire" class="reading-guide__link">Canon</a>, Interprétation, Hypothèse) pour distinguer les faits établis des suppositions.
      <a href="/aide/glossaire" class="reading-guide__link">Consultez le glossaire →</a>
    </span>
  </div>

  <h2 class="section-title">
    <span class="section-title__accent"></span>
    Comprendre la théorie
  </h2>
  <div class="understand-grid">
    <a class="understand-card" href="/theorie/resume">
      <span class="understand-step">1</span>
      <span class="understand-time">30 secondes</span>
      <h3>Le résumé en 10 points</h3>
      <p>L'idée centrale et l'argument principal, en une lecture rapide.</p>
    </a>
    <a class="understand-card" href="/explorer/carte-mentale">
      <span class="understand-step">2</span>
      <span class="understand-time">5–10 minutes</span>
      <h3>La carte mentale</h3>
      <p>Les grandes connexions de la théorie, d'un seul coup d'œil.</p>
    </a>
    <a class="understand-card" href="/theorie/theorie-complete">
      <span class="understand-step">3</span>
      <span class="understand-time">30–60 minutes</span>
      <h3>La théorie complète</h3>
      <p>La démonstration continue en 22 chapitres, du début à la fin.</p>
    </a>
  </div>

  {latestChapter && (
    <p class="last-update">
      Dernière mise à jour de la théorie : <strong>chapitre {latestChapter.data.chapter}</strong> — {latestChapter.data.title}.
    </p>
  )}

  <h2 class="section-title">
    <span class="section-title__accent"></span>
    Articles récents
  </h2>
  <div class="article-list">
    {
      recentArticleUpdates.map(({ article, chapter }) => {
        const chapterEntry = chapters.find((entry) => entry.data.chapter === chapter);
        const effect = chapterEntry?.data.effect ?? 'modification';
        return (
          <ArticleListItem
            badge={effectLabel(effect)}
            badgeColor={badgeColorByEffect[effect]}
            title={article.data.title}
            category={categoryLabel(article.data.category)}
            href={`/theorie/${article.id}`}
            summary={article.data.summary}
          />
        );
      })
    }
  </div>

  <Footer />
</WikiLayout>

<style>
  /* ===== HERO (contained block) ===== */
  .hero {
    position: relative;
    margin-bottom: 48px;
    padding: 40px 40px 36px;
    border-radius: var(--border-radius-xl);
    border: 1px solid var(--border-color);
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--bg-secondary) 92%, transparent),
      color-mix(in srgb, var(--surface) 60%, transparent)
    );
    box-shadow: 0 20px 60px color-mix(in srgb, var(--bg-main) 45%, transparent);
    overflow: hidden;
  }

  /* Thin gradient line crowning the hero block */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--gradient-hero);
    opacity: 0.55;
    z-index: 1;
    pointer-events: none;
  }

  .hero > * {
    position: relative;
    z-index: 1;
    /* Staggered entrance */
    animation: hero-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-badge {
    animation-delay: 0.05s;
  }
  .hero-title {
    animation-delay: 0.12s;
  }
  .hero-wave {
    animation-delay: 0.18s;
  }
  .hero-text {
    animation-delay: 0.24s;
  }
  .hero-cta {
    animation-delay: 0.3s;
  }
  .video-facade {
    animation-delay: 0.38s;
  }

  .hero-wave {
    max-width: 300px;
    margin: 6px 0 22px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--violet-light);
    margin-bottom: 16px;
    padding: 7px 15px;
    border-radius: 100px;
    background: color-mix(in srgb, var(--violet) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--violet) 20%, transparent);
  }

  .hero-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--violet-light);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Respect reduced motion for custom animations */
  @media (prefers-reduced-motion: reduce) {
    .hero-badge__dot {
      animation: none !important;
    }
    .hero > * {
      animation: none !important;
    }
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .hero-text {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.75;
  }

  .hero-text p + p {
    margin-top: 12px;
  }

  .hero-text__more {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-text__more {
      display: block;
    }
  }

  /* ===== CTA BUTTONS ===== */
  .hero-cta {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    background: var(--gradient-border);
    color: var(--bg-main); /* contraste AA >= 4.5:1 sur le dégradé, dans les deux thèmes */
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 2px 12px var(--glow-violet);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px var(--glow-violet);
  }

  .btn-primary:active {
    transform: translateY(0) scale(0.97);
    box-shadow: 0 2px 8px var(--glow-violet);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 22px;
    background-color: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-secondary svg {
    transition: transform 0.25s ease;
  }

  .btn-secondary:hover {
    border-color: var(--cyan-dim);
    color: var(--cyan);
    box-shadow: 0 0 16px var(--glow-cyan);
  }

  .btn-secondary:hover svg {
    transform: translateX(3px);
  }

  .btn-secondary:active {
    transform: scale(0.97);
    box-shadow: 0 0 8px var(--glow-cyan);
  }

  /* ===== VIDEO FACADE ===== */
  .video-facade {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    margin-top: 32px;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .video-facade:hover {
    border-color: color-mix(in srgb, var(--violet) 40%, var(--border-color));
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.4),
      0 0 20px var(--glow-violet);
  }

  .video-facade__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-facade__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(7, 2, 10, 0.7) 0%,
      rgba(7, 2, 10, 0.3) 50%,
      rgba(7, 2, 10, 0.1) 100%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: background 0.3s ease;
  }

  .video-facade:hover .video-facade__overlay {
    background: linear-gradient(
      to top,
      rgba(7, 2, 10, 0.8) 0%,
      rgba(7, 2, 10, 0.4) 50%,
      rgba(7, 2, 10, 0.15) 100%
    );
  }

  .video-facade__play {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--violet);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px var(--glow-violet);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .video-facade:hover .video-facade__play {
    transform: scale(1.1);
    box-shadow: 0 6px 30px var(--glow-violet);
  }

  .video-facade__label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  /* ===== SECTION TITLES ===== */
  .section-title {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    margin-top: 56px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-title__accent {
    display: inline-block;
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-border);
    flex-shrink: 0;
  }

  .section-title:first-of-type {
    margin-top: 0;
  }

  /* ===== GRID & LIST ===== */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .dossiers-footer {
    margin-top: 20px;
    text-align: center;
  }

  .btn-see-all {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    color: var(--cyan);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-see-all:hover {
    border-color: var(--cyan);
    transform: translateY(-2px);
  }

  .btn-see-all:active {
    transform: translateY(0) scale(0.98);
  }

  .reading-guide {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 18px;
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--violet);
    border-radius: var(--border-radius);
    background: color-mix(in srgb, var(--violet) 5%, transparent);
    margin-bottom: 8px;
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .reading-guide__icon {
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .reading-guide__link {
    color: var(--cyan);
    text-decoration: none;
    font-weight: 500;
  }

  .reading-guide__link:hover {
    text-decoration:E underline;
  }

  .understand-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .understand-card {
    display: block;
    padding: 22px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--gradient-card);
    text-decoration: none;
    color: var(--text-main);
    transition: transform 0.2s, border-color 0.2s;
  }

  .understand-card:hover {
    transform: translateY(-3px);
    border-color: var(--violet);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.15), 0 0 16px var(--glow-violet);
  }

  .understand-card:active {
    transform: translateY(-1px) scale(0.98);
  }

  .understand-time {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--violet-light);
    margin-bottom: 10px;
  }

  .understand-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    color: var(--bg-main);
    background: var(--gradient-border);
    margin-bottom: 10px;
  }

  .understand-card h3 {
    font-size: 16px;
    margin: 0 0 8px;
  }

  .understand-card p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .last-update {
    font-size: 13px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-gold);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    margin-bottom: 8px;
  }

  .last-update strong {
    color: var(--accent-gold);
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .understand-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .understand-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      margin-bottom: 32px;
      padding: 28px 20px 24px;
    }
    .section-title {
      margin-top: 40px;
      font-size: 17.5px;
    }
    .video-facade__play {
      width: 52px;
      height: 52px;
    }
    .video-facade__play svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
