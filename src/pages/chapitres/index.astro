---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('chapters');
const sortedChapters = chapters.sort((a, b) => b.data.chapter - a.data.chapter);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
const chapitresJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Analyses de chapitres',
  itemListElement: sortedChapters.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Chapitre ${c.data.chapter} — ${c.data.title}`,
    url: `${siteUrl}/chapitres/${c.data.chapter}/`,
  })),
};
const chapitresBreadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Chapitres', item: `${siteUrl}/chapitres/` },
  ],
};
---

<WikiLayout
  title="Chapitres"
  seoTitle="Chapitres One Piece : analyses et théorie | Les Fous du Bus"
  description="Suivez la théorie au fil des chapitres One Piece : analyses et mises à jour à chaque sortie."
  image="/og-chapitres.png"
  currentPath="/chapitres"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(chapitresJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(chapitresBreadcrumbLd)} />
  <div class="page-header">
    <div class="text-accentGold font-semibold tracking-widest uppercase text-sm mb-3">Suivi</div>
    <h1>Chapitres</h1>
    <p class="page-desc">
      Suivez l'évolution de la théorie au fil des chapitres de <em>One Piece</em>. Chaque analyse
      apporte de nouvelles pistes, des éclaircissements et des correspondances avec le récit.
    </p>
  </div>

  <div class="chapter-tools" aria-label="Accès rapides">
    <a href="/chapitres/predictions">
      <strong>Scénarios suivis</strong>
      <span>Voir les pistes ouvertes</span>
    </a>
    <a href="/chapitres/modifications">
      <strong>Articles mis à jour</strong>
      <span>Suivre ce qui change dans la théorie</span>
    </a>
  </div>

  <h2 class="section-title">Analyses chapitre par chapitre</h2>
  <div class="chapter-list">
    {
      sortedChapters.flatMap((ch, index) => {
        const next = sortedChapters[index + 1];
        const card = (
          <a href={`/chapitres/${ch.data.chapter}`} class="chapter-item">
            <div class="chapter-item__badges">
              <span class="badge-chapter">Chap {ch.data.chapter}</span>
            </div>
            <h3>{ch.data.title}</h3>
            {ch.data.summary && <p class="chapter-item__desc">{ch.data.summary}</p>}
          </a>
        );

        if (ch.data.chapter > 1185 && next && next.data.chapter < 1185) {
          return [
            card,
            <div class="chapter-item chapter-item--empty">
              <div class="chapter-item__badges">
                <span class="badge-chapter badge-chapter--muted">Chap 1185</span>
              </div>
              <h3>Aucune analyse disponible pour le chapitre 1185</h3>
              <p class="chapter-item__desc">
                Il n'existe pas de transcription source correspondante pour ce chapitre. Ce n'est
                pas un oubli technique.
              </p>
            </div>,
          ];
        }

        return [card];
      })
    }
  </div>

  <Footer />
</WikiLayout>

<style>
  .page-header {
    margin-bottom: var(--section-gap);
  }

  .page-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .page-desc {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.6;
  }

  .chapter-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }

  .chapter-tools a {
    display: grid;
    gap: 4px;
    min-height: 74px;
    align-content: center;
    padding: 14px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--bg-secondary);
    color: var(--text-main);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .chapter-tools a:hover {
    border-color: var(--cyan);
    transform: translateY(-2px);
  }

  .chapter-tools strong {
    color: var(--cyan);
    font-size: 14px;
    font-weight: 700;
  }

  .chapter-tools span {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.4;
  }

  .chapter-item:focus-visible,
  .chapter-tools a:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .section-title {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
  }

  .chapter-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--section-gap);
  }

  .chapter-item {
    display: block;
    min-height: 112px;
    padding: var(--space-5);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .chapter-item:hover {
    border-color: var(--cyan);
    transform: translateY(-2px);
  }

  .chapter-item__badges {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .badge-chapter {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 10%, transparent);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .chapter-item h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 6px;
  }

  .chapter-item__desc {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Chapitre sans analyse */
  .chapter-item--empty {
    cursor: default;
    opacity: 0.55;
    border-style: dashed;
    pointer-events: none;
  }

  .chapter-item--empty:hover {
    border-color: var(--border-color);
    transform: none;
  }

  .badge-chapter--muted {
    color: var(--text-muted);
    background: color-mix(in srgb, var(--text-muted) 8%, transparent);
  }

  @media (max-width: 640px) {
    .page-header {
      margin-bottom: var(--space-7);
    }

    .chapter-item {
      min-height: 0;
      padding: var(--space-4);
    }
  }
</style>
