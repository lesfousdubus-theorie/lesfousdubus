---
import WikiLayout from '@layouts/WikiLayout.astro';
import Footer from '@components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((entry) => ({
    params: { chapter: String(entry.data.chapter) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allChapters = (await getCollection('chapters')).sort(
  (a, b) => a.data.chapter - b.data.chapter,
);
const articles = await getCollection('articles', ({ data }) => data.status === 'published');
const affectedArticles = entry.data.updatedArticles
  .map((id) => articles.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
const chapterIndex = allChapters.findIndex((c) => c.data.chapter === entry.data.chapter);
const prevChapter = chapterIndex > 0 ? allChapters[chapterIndex - 1] : null;
const nextChapter =
  chapterIndex >= 0 && chapterIndex < allChapters.length - 1 ? allChapters[chapterIndex + 1] : null;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lesfousdubus.sbs';
// Google tronque le <title> autour de 60-65 caractères. « de One Piece » et
// « : analyse et théorie » coûtaient 33 caractères sans rien apporter : le
// contexte One Piece est déjà porté par le titre du chapitre et le suffixe de
// marque. Le mot-clé reste présent dans la meta description et le H1.
const chapterSeoTitle =
  entry.data.seoTitle ?? `Chapitre ${entry.data.chapter} — ${entry.data.title} | Les Fous du Bus`;
// Le titre ne porte plus « One Piece » (trop long en SERP) : on garantit donc
// que la description le contient toujours, y compris quand la fiche fournit son
// propre summary.
const rawChapterDescription =
  entry.data.summary ?? `${entry.data.title} et son apport à la théorie du Siècle oublié.`;
const chapterDescription = /one piece/i.test(rawChapterDescription)
  ? rawChapterDescription
  : `Chapitre ${entry.data.chapter} de One Piece — ${rawChapterDescription}`;
const canonicalChapterUrl = new URL(`/chapitres/${entry.data.chapter}/`, siteUrl).toString();
const chapterJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Chapitre ${entry.data.chapter} — ${entry.data.title}`,
  description: chapterDescription,
  url: canonicalChapterUrl,
  image: new URL('/og-default.jpg', siteUrl).toString(),
  articleSection: 'Chapitres',
  inLanguage: 'fr-FR',
  author: { '@type': 'Organization', name: 'Les Fous du Bus', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'Les Fous du Bus',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: new URL('/logo.png', siteUrl).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalChapterUrl },
};
const chapterBreadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Chapitres', item: siteUrl + '/chapitres/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Chapitre ${entry.data.chapter}`,
      item: canonicalChapterUrl,
    },
  ],
};
---

<WikiLayout
  title={`Chapitre ${entry.data.chapter} — ${entry.data.title}`}
  seoTitle={chapterSeoTitle}
  description={chapterDescription}
  type="article"
  currentPath={`/chapitres/${entry.data.chapter}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(chapterJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(chapterBreadcrumbLd)} />
  <div class="chapter-header">
    <div class="chapter-badges">
      <span class="badge-chapter">Chapitre {entry.data.chapter}</span>
      <span class="badge-designation">Synthèse de l'analyse</span>
    </div>
    <h1>{entry.data.title}</h1>
    <p class="chapter-designation">
      Cette page est une <strong>synthèse</strong> de la transcription de l'analyse du chapitre. Elle
      conserve les grands arguments du fichier source, reformulés pour la lecture en ligne.
    </p>
  </div>

  <div class="content">
    <Content />
  </div>

  {
    affectedArticles.length > 0 && (
      <section class="impact-box" aria-labelledby="impact-title">
        <h3 id="impact-title">Ce que ce chapitre change dans la théorie</h3>
        <p class="impact-intro">Les fiches suivantes sont directement concernées :</p>
        <ul class="impact-list">
          {affectedArticles.map((article) => (
            <li>
              <a href={`/theorie/${article.id}`}>{article.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <nav class="chapter-pager" aria-label="Chapitres précédent et suivant">
    {
      prevChapter && (
        <a
          class="chapter-pager__link chapter-pager__link--prev"
          href={`/chapitres/${prevChapter.data.chapter}`}
        >
          <span class="chapter-pager__dir">← Chapitre {prevChapter.data.chapter}</span>
          <span class="chapter-pager__title">{prevChapter.data.title}</span>
        </a>
      )
    }
    <a class="chapter-pager__link chapter-pager__link--all" href="/chapitres">
      <span class="chapter-pager__dir">Tous</span>
      <span class="chapter-pager__title">Les analyses</span>
    </a>
    {
      nextChapter && (
        <a
          class="chapter-pager__link chapter-pager__link--next"
          href={`/chapitres/${nextChapter.data.chapter}`}
        >
          <span class="chapter-pager__dir">Chapitre {nextChapter.data.chapter} →</span>
          <span class="chapter-pager__title">{nextChapter.data.title}</span>
        </a>
      )
    }
  </nav>

  <Footer />
</WikiLayout>

<style>
  .chapter-header {
    margin-bottom: 40px;
  }

  .chapter-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .badge-chapter {
    font-size: 12.5px;
    font-weight: 500;
    padding: 4px 9px;
    border-radius: 6px;
    background-color: color-mix(in srgb, var(--cyan) 10%, transparent);
    color: var(--cyan);
    border: 1px solid color-mix(in srgb, var(--cyan) 20%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badge-designation {
    font-size: 12.5px;
    font-weight: 500;
    padding: 4px 9px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background-color: color-mix(in srgb, var(--accent-gold) 12%, transparent);
    color: var(--accent-gold);
    border: 1px solid color-mix(in srgb, var(--accent-gold) 25%, transparent);
  }

  .chapter-designation {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 700px;
    margin-bottom: 8px;
  }

  .impact-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--cyan);
    border-radius: var(--border-radius-lg);
    padding: 20px;
    margin: 32px 0 40px;
  }

  .impact-box h3 {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .impact-intro {
    font-size: 13.5px;
    color: var(--text-secondary);
    margin: 0 0 10px;
  }

  .impact-list {
    margin: 0 0 12px !important;
    padding-left: 1.2rem !important;
  }

  .impact-list a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .chapter-header h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  /* chapter-summary supprimé : reste uniquement en meta/SEO */

  .content {
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .content :global(h2) {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .content :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--violet);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .content :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .themes-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: 20px;
    margin-bottom: 40px;
  }

  .themes-box h3 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .themes-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .theme-tag {
    display: inline-block;
    padding: 4px 10px;
    font-size: 12.5px;
    border-radius: 6px;
    background-color: var(--surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .chapter-pager {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
    margin: 32px 0 40px;
  }
  .chapter-pager__link {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--bg-main);
    text-decoration: none;
    color: var(--text-main);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  a.chapter-pager__link:hover {
    border-color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 6%, transparent);
  }
  a.chapter-pager__link:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
  .chapter-pager__link--next {
    text-align: right;
  }
  .chapter-pager__link--all {
    align-items: center;
    justify-content: center;
    text-align: center;
    border-style: dashed;
  }
  .chapter-pager__dir {
    font-size: 12px;
    color: var(--text-secondary);
  }
  .chapter-pager__title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-main);
  }
  a.chapter-pager__link:hover .chapter-pager__title {
    color: var(--cyan);
  }
  @media (max-width: 680px) {
    .chapter-pager {
      grid-template-columns: 1fr 1fr;
    }
    .chapter-pager__link--all {
      display: none;
    }
  }

  .nav-links {
    display: flex;
    gap: 12px;
    margin-bottom: 40px;
  }

  .nav-link {
    display: inline-block;
    padding: 9px 16px;
    background-color: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-main);
    text-decoration: none;
    font-size: 13.5px;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-link:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--bg-main) 45%, transparent);
  }
</style>
